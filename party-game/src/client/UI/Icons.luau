Icons.Aliases = {
	Next = { Name = "Arrow", Rotation = 0 },
	Back = { Name = "Arrow", Rotation = 180 },
	Previous = { Name = "Arrow", Rotation = 180 },
}

function Icons.image(name: string, state: string?, light: boolean?)
	local alias = Icons.Aliases[name]
	local entry = Icons.Registry[if alias then alias.Name else name]
	local atlas = entry and Icons.AtlasIds[entry.Atlas]
	if not atlas then
		return nil
	end
	local offset = if light and entry.Light then entry.Light else entry.Offset
	local colour = Color3.new(1, 1, 1)
	if light and entry.Light then
		colour = DEEP -- outline cells are white line art
	elseif entry.Tint then
		colour = if state == "Selected" then GOLD elseif state == "Disabled" then GREY elseif light then DEEP else CREAM
	end
	return {
		Image = atlas,
		ImageRectOffset = Vector2.new(offset[1], offset[2]),
		ImageRectSize = Vector2.new(CELL, CELL),
		ImageColor3 = colour,
		ImageTransparency = if state == "Disabled" then 0.5 else 0,
		Rotation = if alias then alias.Rotation else 0,
	}
end

-- shortcut: PlayStation detection relies on GetStringForKeyCode reporting the pad's own button
-- name ("ButtonCross"); NOT verified on real hardware yet. Unknown pads use the neutral prompt.
function Icons.gamepadFamily(): string
	if #UserInputService:GetConnectedGamepads() == 0 then
		return "Generic" -- Studio and some clients report "ButtonA" even with no pad connected
	end
	local ok, label = pcall(UserInputService.GetStringForKeyCode, UserInputService, Enum.KeyCode.ButtonA)
	if ok and label == "ButtonCross" then
		return "PlayStation"
	elseif ok and label == "ButtonA" then
		return "Xbox"
	end
	return "Generic"
end

local XBOX = {
	ButtonA = "XboxA", ButtonB = "XboxB", ButtonX = "XboxX", ButtonY = "XboxY",
	ButtonL1 = "XboxLB", ButtonR1 = "XboxRB", ButtonSelect = "XboxView",
	DPadUp = "XboxUp", DPadDown = "XboxDown", DPadLeft = "XboxLeft", DPadRight = "XboxRight",
}
local PLAYSTATION = {
	ButtonA = "PSCross", ButtonB = "PSCircle", ButtonX = "PSSquare", ButtonY = "PSTriangle",
	ButtonL1 = "PSL1", ButtonR1 = "PSR1", ButtonSelect = "PSCreate",
	DPadUp = "PSUp", DPadDown = "PSDown", DPadLeft = "PSLeft", DPadRight = "PSRight",
}
local KEYS = {
	Space = "KeySpace", Return = "KeyEnter", Backspace = "KeyBackspace", M = "KeyM", E = "KeyE",
	Q = "KeyQ", B = "KeyB", W = "KeyW", A = "KeyA", S = "KeyS", D = "KeyD",
	Left = "KeyLeft", Right = "KeyRight", Up = "KeyUp", Down = "KeyDown",
}

function Icons.button(keyCode: Enum.KeyCode): string?
	local key = keyCode.Name
	if KEYS[key] then
		return KEYS[key]
	end
	local family = Icons.gamepadFamily()
	if family == "PlayStation" then
		return PLAYSTATION[key]
	elseif family == "Xbox" then
		return XBOX[key]
	end
	return if XBOX[key] then "GamepadAction" else nil -- neutral circle; the letter stays native text
end

return Icons
