<roblox version="4">
  <Item class="ReplicatedStorage" referent="0">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="1">
      <Properties>
        <string name="Name">PartyShared</string>
      </Properties>
      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config
	Shared tuning knobs for the party framework. Safe to require from server and client.
	Everything timing/coin related lives here so designers can tweak without touching logic.
]]

local Config = {}

-- Match shape ---------------------------------------------------------------

-- Every round always has exactly this many participants; bots fill empty slots.
Config.PlayersPerMatch = 4

-- Layouts a minigame can declare in Info.Layout.
Config.Layouts = {
	FFA = "FFA", -- everyone for themselves
	OneVsThree = "1v3", -- one solo player vs a team of three
	TwoVsTwo = "2v2", -- two teams of two
	Duel = "Duel", -- exactly two players (board Duel spaces); never in the normal vote
}

-- Phase timings (seconds) ----------------------------------------------------

Config.IntermissionDuration = 5 -- lobby wait before the vote opens
Config.VoteChoices = 3 -- cards shown on the vote screen
Config.VoteDuration = 12
Config.InstructionsDuration = 7
Config.CountdownFrom = 3
Config.FinishBannerDuration = 2 -- "FINISH!" beat before teleporting back
Config.ResultsDuration = 8

-- Coins ----------------------------------------------------------------------

-- Coins awarded by placement. Ties share a placement, so two 1st places both get 10.
Config.CoinsByPlacement = { 10, 6, 3, 1 }

-- Match (board game) ------------------------------------------------------------

Config.Match = {
	-- Defaults; the host can change these in the waiting room.
	BoardRounds = 5, -- each round = every seat takes one turn, then one minigame
	BoardRoundChoices = { 3, 5, 8, 12 },
	BotDifficulty = "Normal",
	-- bot.Skill is rolled in this range (0..1). Minigame bots and board decisions both use it.
	BotDifficulties = {
		Easy = { 0.1, 0.45 },
		Normal = { 0.35, 0.85 },
		Hard = { 0.75, 1 },
	},
	BotDifficultyOrder = { "Easy", "Normal", "Hard" },
	Board = "Classic", -- default board: module name in PartyServer/Board/Boards
	Boards = { "Classic", "MagicalFestival" }, -- boards the host can pick (in this order)
	-- "Board": full board party.  "Minigames": back-to-back minigames only, most coins wins.
	Mode = "Board",
	Modes = { "Board", "Minigames" },
	WaitingRoomDuration = 15, -- seconds the waiting room counts down before a match
	StandingsDuration = 10, -- final standings screen
	PreBonusDuration = 5, -- standings before the bonus awards
	BonusDuration = 7, -- the bonus awards card
	OrderRollTimeout = 10, -- players who don't roll for turn order in time roll automatically
	-- How bots play the board at each difficulty (see Board/BotBrain).
	--   RandomChoice    chance any decision is made at random instead of thought through
	--   ItemUseChance   chance a bot uses an item when it has a good reason to
	--   SaveFactor      share of the Crown price kept in reserve before shopping (0..1)
	--   LookAhead       spaces scored down each fork branch (0 = don't look)
	--   CosmeticSpend   only buy cosmetics with at least this many coins to spare
	BotBehavior = {
		Easy = { RandomChoice = 0.6, ItemUseChance = 0.3, SaveFactor = 0, LookAhead = 0, CosmeticSpend = 0 },
		Normal = { RandomChoice = 0.2, ItemUseChance = 0.7, SaveFactor = 0.6, LookAhead = 6, CosmeticSpend = 15 },
		Hard = { RandomChoice = 0, ItemUseChance = 1, SaveFactor = 1, LookAhead = 10, CosmeticSpend = 25 },
	},
}

-- Rejoining: a player who leaves mid-match has their seat kept for their UserId until the
-- match ends (a bot plays it meanwhile) and gets it back if they rejoin. Off = old behavior
-- (they watch until the next match).
Config.SeatReclaim = {
	Enabled = true,
}

Config.Board = {
	Origin = Vector3.new(0, 0, -300), -- far from the lobby (0,0,0) and the arenas
	SpaceSpacing = 12, -- studs between grid cells in board layouts
	DieSides = 6,
	RollTimeout = 12, -- a player who doesn't roll in time rolls automatically
	ChoiceTimeout = 10, -- unanswered prompts take their default option
	HopTime = 0.35, -- seconds per space moved
	BotRollDelay = { 0.8, 1.6 },
	BotChoiceDelay = { 0.6, 1.4 },
	LandPause = 1.5, -- beat after landing so everyone can read what happened
}

-- The primary collectible (wins the match; coins only break ties). Placeholder name.
Config.Collectible = {
	Name = "Crown",
	Plural = "Crowns",
	Price = 20, -- coins
}

-- All coin amounts the board hands out or takes, in one place.
Config.Economy = {
	StartingCoins = 10,
	GainSpaceCoins = 3,
	LoseSpaceCoins = 3,
	-- Reward spaces roll one of these (Weight is relative).
	Rewards = {
		{ Kind = "Coins", Amount = 5, Weight = 6 },
		{ Kind = "Coins", Amount = 10, Weight = 3 },
		{ Kind = "Cosmetic", Weight = 2 }, -- a random cosmetic the owner doesn't have yet
		{ Kind = "Collectible", Amount = 1, Weight = 0.5 },
		{ Kind = "Item", Weight = 3 }, -- a random board item (Board/Items), if there's room
	},
	ShopOffers = 2, -- cosmetics offered per shop visit
	ShopItemOffers = 1, -- board items offered per shop visit (on top of the cosmetics)
	ItemSpaceFallbackCoins = 3, -- Item space with a full bag
	ChaosLossCap = 15, -- most coins a single Chaos space can take
	PriceSurgeCap = 10, -- Price Surge can raise the Crown price by at most this much
	DuelStakes = { 5, 10, 20 }, -- Duel space wagers (only ones both duellists can pay are offered)
	CrownMovePrice = 8, -- Switch space: pay this to send the Crown somewhere else
}

-- Comeback help for trailing players. Kept small and late so early play still matters.
--   StartRound            no help before this round
--   LastPlaceCoins        coins for the last-place seat(s) at the start of each round
--   UnderdogGap           a seat this many Crowns behind the leader is an "underdog" ...
--   UnderdogDiscount      ... and pays this much less for a Crown (never below MinCrownPrice)
--   UnderdogGiftBoost     ... and its Gift-space Item/Crown chances are multiplied by this
--   FinalFrenzy           in the last round Gain/Lose spaces are worth FrenzyMultiplier times more
Config.Comeback = {
	Enabled = true,
	StartRound = 2,
	LastPlaceCoins = 5,
	UnderdogGap = 2,
	UnderdogDiscount = 5,
	MinCrownPrice = 10,
	UnderdogGiftBoost = 2,
	FinalFrenzy = true,
	FrenzyMultiplier = 2,
}

-- Board items (Board/Items has the list). One item may be used per turn, before rolling.
Config.Items = {
	MaxHeld = 3,
	StartingItems = {}, -- item ids every seat starts a match with, e.g. { "DoubleDice" }
}

-- End-of-match bonus awards, given after the last round and before the final standings.
--   Stat       a per-seat statistic tracked by Match (MinigamePoints, CoinsEarned, SpacesMoved)
--   AwardTies  true: every tied leader gets it; false: a tie means nobody does
-- Nobody wins a bonus whose best value is 0.
Config.Bonuses = {
	{ Id = "MinigameMaster", Name = "Minigame Master", Description = "Best minigame results", Stat = "MinigamePoints", Crowns = 1, AwardTies = true },
	{ Id = "CoinCollector", Name = "Coin Collector", Description = "Most coins earned this match", Stat = "CoinsEarned", Crowns = 1, AwardTies = true },
	{ Id = "Explorer", Name = "Explorer", Description = "Most board spaces travelled", Stat = "SpacesMoved", Crowns = 1, AwardTies = true },
}
-- Minigame Master points per minigame placement (ties share a placement).
Config.MinigamePointsByPlacement = { 3, 2, 1, 0 }

-- Permanent profile (see PartyServer/Profiles). Match coins and Crowns never go in here.
Config.Profile = {
	-- "Auto": DataStore in live servers, Memory in Studio (so testing never touches real saves).
	-- "Memory" | "DataStore" force one (DataStore in Studio needs API access turned on).
	Backend = "Auto",
	AutosaveInterval = 120, -- seconds between saves of every loaded profile
	BankCoinsByPlacement = { 30, 20, 12, 8 }, -- permanent coins for real players by final placement
}

-- Guided first actions (client pointer + YOU marker). Each flag is set once, in the player's
-- profile, after they really do that thing; until then the pointer shows them where to tap.
Config.Tutorial = {
	Flags = {
		"StartedMatch", -- host pressed START in the waiting room
		"RolledForOrder", -- rolled for turn order
		"RolledBoardTurn", -- rolled on a normal board turn
		"SawItem", -- used an item, or rolled while holding one
		"ChoseFork", -- picked a route at a fork
		"UsedMinigameAction", -- pressed a minigame action button
		"SawCrownPurchase", -- answered a Crown purchase offer
	},
	-- Development only: in Studio, wipe a player's flags when they join (fresh tutorial
	-- every playtest even with a saved profile). Never applies on live servers.
	ResetInStudio = false,
}

-- World layout -----------------------------------------------------------------

-- Arenas are built here, far away from the lobby so they never overlap it.
Config.ArenaOrigin = Vector3.new(0, 80, 600)
-- Eliminated participants watch from a glass box this far above the arena origin.
Config.SpectatorOffset = Vector3.new(0, 45, 0)
-- Anyone this many studs below the arena origin counts as having fallen out.
Config.FallOutDepth = 25

-- Movement defaults restored after every round.
Config.DefaultWalkSpeed = 16
Config.DefaultJumpPower = 50
Config.DefaultJumpHeight = 7.2

-- Camera ---------------------------------------------------------------------------

-- Camera modes a minigame can pick in Info.Camera.Mode. Each minigame can override any
-- of these numbers in its own Info.Camera table.
Config.CameraModes = {
	AngledOverhead = { Height = 55, Distance = 42, Follow = 0.3, Smooth = 6 }, -- whole arena, nudged toward you
	FollowBehind = { Height = 9, Distance = 16, Smooth = 10 }, -- over-the-shoulder chase cam
	SideView = { Height = 6, Distance = 48, Smooth = 8 }, -- 2D side-scroller, looks along the arena's LookVector
}
Config.DefaultCameraMode = "AngledOverhead"
-- Touch devices only (desktop and console are not affected). Zoom multiplies the mode's
-- Height and Distance so characters are bigger on a small screen; LookAhead aims the camera
-- that many studs past the arena centre, which slides the arena down out from under the HUD.
Config.TouchCamera = { AngledOverhead = { Zoom = 0.8, LookAhead = 6 } }
Config.Spectator = { Height = 28, Distance = 30, OrbitSpeed = 0.25 }

-- Player chips: how often progress updates are pushed to clients (seconds).
Config.ChipFlushInterval = 0.15

-- Bots ---------------------------------------------------------------------------

Config.BotThinkInterval = 0.2 -- how often each bot's brain runs
Config.BotVoteDelay = { 1.5, 5 } -- bots "think" about their vote for this long (min, max)
Config.BotNames = {
	"Pip",
	"Mochi",
	"Ziggy",
	"Nova",
	"Biscuit",
	"Pebble",
	"Juniper",
	"Comet",
	"Waffles",
	"Maple",
}

-- Networking -------------------------------------------------------------------

Config.InputRateLimit = 20 -- max inputs per second per player before they are dropped
Config.MinigameMessageRateLimit = 40 -- same, for messages a minigame's own client code sends

-- The extra vote card shown when there are fewer minigames than Config.VoteChoices.
Config.RandomChoice = {
	Id = "__random",
	Name = "🎲 Surprise Me",
	Description = "Can't decide? Let the game pick one at random.",
	Layout = "???",
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Cosmetics</string>
          <string name="Source"><![CDATA[--[[
	Cosmetics
	The catalog of cosmetic items. Pure data, readable by server and client.

	Each item:
	  Id      unique, never reuse or rename once players own it
	  Name    shown to players
	  Slot    one equipped item per slot (Cosmetics.Slots)
	  Price   match coins at a board Shop space
	  BankPrice  permanent bank coins in the lobby Cosmetics Shop (Cosmetics.bankPrice)
	  Rarity  "Common" | "Rare" | "Epic" (for the later visual pass)
	  Visual  placeholder look, drawn by PartyServer.CosmeticService:
	            { Kind = "Hat", Shape = "Block"|"Ball"|"Cylinder", Size = {x, y, z}, Color = {r, g, b} }
	            { Kind = "Trail", Colors = { {r, g, b}, {r, g, b} } }
	            { Kind = "Sparkles", Color = {r, g, b} }   (emotes: an aura until real emotes exist)

	To add one, append an entry; shops and reward spaces pick it up automatically.
]]

local Cosmetics = {}

Cosmetics.Slots = { "Hat", "Trail", "Emote" }

Cosmetics.Items = {
	{
		Id = "hat_party", Name = "Party Hat", Slot = "Hat", Price = 6, Rarity = "Common",
		Visual = { Kind = "Hat", Shape = "Cylinder", Size = { 1.4, 1.1, 1.1 }, Color = { 255, 90, 160 } },
	},
	{
		Id = "hat_crown_paper", Name = "Paper Crown", Slot = "Hat", Price = 10, Rarity = "Rare",
		Visual = { Kind = "Hat", Shape = "Block", Size = { 1.5, 0.5, 1.5 }, Color = { 255, 210, 60 } },
	},
	{
		Id = "hat_propeller", Name = "Propeller Cap", Slot = "Hat", Price = 14, Rarity = "Epic",
		Visual = { Kind = "Hat", Shape = "Ball", Size = { 1.5, 1.5, 1.5 }, Color = { 80, 160, 255 } },
	},
	{
		Id = "trail_confetti", Name = "Confetti Trail", Slot = "Trail", Price = 8, Rarity = "Common",
		Visual = { Kind = "Trail", Colors = { { 255, 220, 60 }, { 255, 90, 160 } } },
	},
	{
		Id = "trail_rainbow", Name = "Rainbow Trail", Slot = "Trail", Price = 14, Rarity = "Epic",
		Visual = { Kind = "Trail", Colors = { { 255, 80, 80 }, { 80, 140, 255 } } },
	},
	{
		Id = "emote_wave", Name = "Big Wave", Slot = "Emote", Price = 5, Rarity = "Common",
		Visual = { Kind = "Sparkles", Color = { 120, 255, 140 } },
	},
	{
		Id = "emote_spin", Name = "Victory Spin", Slot = "Emote", Price = 9, Rarity = "Rare",
		Visual = { Kind = "Sparkles", Color = { 255, 215, 0 } },
	},
}

-- Lobby shop prices in permanent bank coins, by rarity (an item can override with BankPrice).
Cosmetics.BankPriceByRarity = { Common = 40, Rare = 80, Epic = 150 }

local byId = {}
for _, item in Cosmetics.Items do
	assert(not byId[item.Id], "duplicate cosmetic id " .. item.Id)
	assert(table.find(Cosmetics.Slots, item.Slot), "unknown slot for " .. item.Id)
	byId[item.Id] = item
end

-- What an item costs in the lobby shop (bank coins). Server-side truth; never from a client.
function Cosmetics.bankPrice(item): number
	return item.BankPrice or Cosmetics.BankPriceByRarity[item.Rarity] or 100
end

function Cosmetics.get(id: string)
	return byId[id]
end

return Cosmetics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">IceDashSim</string>
          <string name="Source"><![CDATA[--[[
	IceDashSim
	The Ice Dash track layout and sliding physics, shared by server and client so both run
	exactly the same rules:

	  * the server uses it to move bots and to know what a legal move looks like
	  * each client uses it to move its own racer instantly (no waiting on the network)

	Nothing in here touches Instances; it is plain numbers.

	Track space: X = sideways (+ is the racer's right), S = distance from the start line.
]]

local Sim = {}

-- Tuning ----------------------------------------------------------------------------------

-- Ice physics
Sim.MAX_SPEED = 34 -- forward speed cap (studs/s)
Sim.FORWARD_ACCEL = 16 -- how quickly you get back up to speed
Sim.STEER_ACCEL = 42 -- sideways push while a steer button is held (studs/s^2)
Sim.ICE_FRICTION = 1.3 -- sideways speed lost per second (fraction); lower = more drift
Sim.MAX_SIDE_SPEED = 18
Sim.SLOW_DRAG = 4 -- how hard a snow drift / puddle pulls you down to its speed cap

-- Obstacles
Sim.SNOW_SLOW = 0.45 -- speed cap multiplier inside a snow drift
Sim.PUDDLE_SLOW = 0.65 -- speed cap multiplier inside a puddle
Sim.PUDDLE_STEER = 0.3 -- steering multiplier inside a puddle (you aquaplane)
Sim.BUMPER_BOUNCE = 0.9 -- bounciness of a bumper hit (0 = dead stop, 1 = perfect bounce)
Sim.BUMPER_KICK = 14 -- extra speed a bumper adds along the bounce direction
Sim.WALL_BOUNCE = 0.6 -- bounciness of side walls and barrier blocks
Sim.RACER_BOUNCE = 0.7 -- bounciness when two racers slide into each other

-- Track layout
Sim.TRACK_LENGTH = 800
Sim.TRACK_WIDTH = 36
Sim.OBSTACLE_SPACING = 30 -- studs between obstacle rows
Sim.FIRST_OBSTACLE = 55 -- clear run-up after the start line
Sim.CHECKPOINT_SPACING = 160
Sim.RESPAWN_DELAY = 1.1 -- seconds between sliding off and reappearing at the checkpoint

Sim.RACER_RADIUS = 1.6
Sim.BUMPER_RADIUS = 2.6
Sim.SNOW_SIZE = Vector2.new(13, 11) -- width, length
Sim.PUDDLE_RADIUS = 5.5
Sim.START_LANES = { -9, -3, 3, 9 }
Sim.START_S = 3

Sim.HALF_WIDTH = Sim.TRACK_WIDTH / 2

-- Layout ------------------------------------------------------------------------------------

-- Random obstacle course. Plain tables only, so it can be sent to clients as-is.
function Sim.generateLayout(rng)
	local half = Sim.HALF_WIDTH
	local layout = {
		Snow = {}, -- { X, S } centres of slow rectangles
		Puddles = {}, -- { X, S }
		Bumpers = {}, -- { X, S }
		Barriers = {}, -- { X0, X1, S0, S1 }
		Open = {}, -- { S0, S1 } stretches with no side walls
		Checkpoints = {}, -- S of each checkpoint gate
	}
	local lanes = { -13, -8, -3, 3, 8, 13 }
	local s = Sim.FIRST_OBSTACLE
	while s < Sim.TRACK_LENGTH - 30 do
		local roll = rng:NextNumber()
		if roll < 0.24 then
			table.insert(layout.Snow, { X = rng:NextNumber(-half + 7, half - 7), S = s })
		elseif roll < 0.42 then
			table.insert(layout.Puddles, { X = rng:NextNumber(-half + 6, half - 6), S = s })
		elseif roll < 0.68 then
			-- Two bumpers in different lanes.
			local first = rng:NextInteger(1, #lanes)
			local second = (first + rng:NextInteger(2, 4) - 1) % #lanes + 1
			table.insert(layout.Bumpers, { X = lanes[first], S = s })
			table.insert(layout.Bumpers, { X = lanes[second], S = s })
		elseif roll < 0.84 then
			-- A wall block sticking out from one side, or sitting in the middle.
			local width = Sim.TRACK_WIDTH * rng:NextNumber(0.3, 0.42)
			local kind = rng:NextInteger(1, 3)
			local x0 = if kind == 1 then -half elseif kind == 2 then half - width else -width / 2
			table.insert(layout.Barriers, { X0 = x0, X1 = x0 + width, S0 = s - 1.5, S1 = s + 1.5 })
		else
			-- No side walls here, and a bumper in the middle to make it interesting.
			table.insert(layout.Open, { S0 = s - Sim.OBSTACLE_SPACING / 2, S1 = s + Sim.OBSTACLE_SPACING / 2 })
			table.insert(layout.Bumpers, { X = 0, S = s })
		end
		s += Sim.OBSTACLE_SPACING
	end
	local checkpoint = Sim.CHECKPOINT_SPACING
	while checkpoint < Sim.TRACK_LENGTH - 40 do
		table.insert(layout.Checkpoints, checkpoint)
		checkpoint += Sim.CHECKPOINT_SPACING
	end
	return layout
end

function Sim.hasWall(layout, s: number): boolean
	for _, open in layout.Open do
		if s >= open.S0 and s <= open.S1 then
			return false
		end
	end
	return true
end

-- Speed-cap and steering multipliers for whatever is under (x, s).
function Sim.surface(layout, x: number, s: number): (number, number)
	local slow, steer = 1, 1
	for _, snow in layout.Snow do
		if math.abs(x - snow.X) <= Sim.SNOW_SIZE.X / 2 and math.abs(s - snow.S) <= Sim.SNOW_SIZE.Y / 2 then
			slow = math.min(slow, Sim.SNOW_SLOW)
		end
	end
	for _, puddle in layout.Puddles do
		local dx, ds = x - puddle.X, s - puddle.S
		if dx * dx + ds * ds <= Sim.PUDDLE_RADIUS * Sim.PUDDLE_RADIUS then
			slow = math.min(slow, Sim.PUDDLE_SLOW)
			steer = math.min(steer, Sim.PUDDLE_STEER)
		end
	end
	return slow, steer
end

-- The furthest checkpoint at or before s (the start line counts).
function Sim.checkpointFor(layout, s: number): number
	local best = Sim.START_S
	for _, checkpoint in layout.Checkpoints do
		if s >= checkpoint then
			best = checkpoint
		end
	end
	return best
end

-- Racers -------------------------------------------------------------------------------------

function Sim.newRacer(lane: number)
	return {
		X = lane,
		S = Sim.START_S,
		VX = 0,
		VS = 0,
		Lane = lane,
		Checkpoint = Sim.START_S,
		State = "Racing", -- "Racing" | "Falling" | "Finished"
		FallTime = 0,
	}
end

function Sim.respawn(racer)
	racer.State = "Racing"
	racer.X = racer.Lane
	racer.S = racer.Checkpoint
	racer.VX = 0
	racer.VS = 0
	racer.FallTime = 0
end

-- How far a falling racer has dropped below the ice.
function Sim.fallDrop(racer): number
	return if racer.State == "Falling" then math.min(18, 40 * racer.FallTime * racer.FallTime) else 0
end

-- Bounces the racer's velocity off a surface with normal (nx, ns).
local function bounce(racer, nx: number, ns: number, bounciness: number, kick: number)
	local into = racer.VX * nx + racer.VS * ns
	if into < 0 then
		racer.VX -= (1 + bounciness) * into * nx
		racer.VS -= (1 + bounciness) * into * ns
	end
	racer.VX += nx * kick
	racer.VS += ns * kick
end

--[[
	Advances one racer by dt seconds. `steer` is -1 (left), 0 or 1 (right).
	Returns "fell", "respawned" or "finished" when that happened this step, otherwise nil.
]]
function Sim.step(layout, racer, steer: number, dt: number): string?
	local half = Sim.HALF_WIDTH
	if racer.State == "Falling" then
		racer.FallTime += dt
		racer.X += racer.VX * dt
		racer.S += racer.VS * dt * 0.5
		if racer.FallTime >= Sim.RESPAWN_DELAY then
			Sim.respawn(racer)
			return "respawned"
		end
		return nil
	end
	if racer.State == "Finished" then
		-- Glide to a stop in the run-off area.
		racer.VS *= math.exp(-2.5 * dt)
		racer.VX *= math.exp(-3 * dt)
		racer.X = math.clamp(racer.X + racer.VX * dt, -half + Sim.RACER_RADIUS, half - Sim.RACER_RADIUS)
		racer.S = math.min(racer.S + racer.VS * dt, Sim.TRACK_LENGTH + 40)
		return nil
	end

	local slow, steerGrip = Sim.surface(layout, racer.X, racer.S)

	-- Sideways: push from steering, a little friction, lots of drift.
	racer.VX += steer * Sim.STEER_ACCEL * steerGrip * dt
	racer.VX *= math.exp(-Sim.ICE_FRICTION * dt)
	racer.VX = math.clamp(racer.VX, -Sim.MAX_SIDE_SPEED, Sim.MAX_SIDE_SPEED)

	-- Forward: always accelerating up to the cap of the surface you're on.
	local cap = Sim.MAX_SPEED * slow
	if racer.VS < cap then
		racer.VS = math.min(cap, racer.VS + Sim.FORWARD_ACCEL * dt)
	else
		racer.VS = cap + (racer.VS - cap) * math.exp(-Sim.SLOW_DRAG * dt)
	end

	racer.X += racer.VX * dt
	racer.S += racer.VS * dt

	-- Bumpers: round, bouncy, and they kick.
	for _, bumper in layout.Bumpers do
		local dx, ds = racer.X - bumper.X, racer.S - bumper.S
		local reach = Sim.BUMPER_RADIUS + Sim.RACER_RADIUS
		local distanceSquared = dx * dx + ds * ds
		if distanceSquared < reach * reach then
			local distance = math.sqrt(distanceSquared)
			local nx, ns = 0, -1
			if distance > 0.01 then
				nx, ns = dx / distance, ds / distance
			end
			racer.X = bumper.X + nx * reach
			racer.S = bumper.S + ns * reach
			bounce(racer, nx, ns, Sim.BUMPER_BOUNCE, Sim.BUMPER_KICK)
		end
	end

	-- Barrier blocks: bounce off whichever face you hit.
	for _, barrier in layout.Barriers do
		local nearestX = math.clamp(racer.X, barrier.X0, barrier.X1)
		local nearestS = math.clamp(racer.S, barrier.S0, barrier.S1)
		local dx, ds = racer.X - nearestX, racer.S - nearestS
		local distanceSquared = dx * dx + ds * ds
		if distanceSquared < Sim.RACER_RADIUS * Sim.RACER_RADIUS then
			local distance = math.sqrt(distanceSquared)
			local nx, ns
			if distance > 0.01 then
				nx, ns = dx / distance, ds / distance
			else
				nx, ns = 0, -1 -- somehow inside: shove back the way you came
			end
			racer.X = nearestX + nx * Sim.RACER_RADIUS
			racer.S = nearestS + ns * Sim.RACER_RADIUS
			bounce(racer, nx, ns, Sim.WALL_BOUNCE, 0)
		end
	end
	racer.VS = math.max(racer.VS, -Sim.MAX_SPEED * 0.6)
	racer.S = math.max(racer.S, 1)

	-- Edges: a wall bounces you back; no wall means a long drop.
	local limit = half - Sim.RACER_RADIUS
	if math.abs(racer.X) > limit then
		if Sim.hasWall(layout, racer.S) then
			local side = math.sign(racer.X)
			racer.X = side * limit
			if racer.VX * side > 0 then
				racer.VX = -racer.VX * Sim.WALL_BOUNCE
			end
		elseif math.abs(racer.X) > half + 0.5 then
			racer.State = "Falling"
			racer.FallTime = 0
			return "fell"
		end
	end

	racer.Checkpoint = math.max(racer.Checkpoint, Sim.checkpointFor(layout, racer.S))

	if racer.S >= Sim.TRACK_LENGTH then
		racer.State = "Finished"
		return "finished"
	end
	return nil
end

--[[
	Racers are solid to each other. Pushes an overlapping pair apart and trades momentum.
	moveA / moveB say which of the two this machine is allowed to change (a client only moves
	its own racer; the server only moves bots).
]]
function Sim.collide(a, b, moveA: boolean, moveB: boolean)
	if a.State ~= "Racing" or b.State ~= "Racing" then
		return
	end
	local reach = Sim.RACER_RADIUS * 2
	local dx, ds = b.X - a.X, b.S - a.S
	local distanceSquared = dx * dx + ds * ds
	if distanceSquared >= reach * reach then
		return
	end
	local distance = math.sqrt(distanceSquared)
	local nx, ns = 1, 0
	if distance > 0.01 then
		nx, ns = dx / distance, ds / distance
	end
	local overlap = (reach - distance) / 2
	-- Equal masses: swap (most of) the speed along the line between them.
	local closing = (a.VX - (b.VX or 0)) * nx + (a.VS - (b.VS or 0)) * ns
	local impulse = if closing > 0 then closing * (1 + Sim.RACER_BOUNCE) / 2 else 0
	if moveA then
		a.X -= nx * overlap
		a.S -= ns * overlap
		a.VX -= impulse * nx
		a.VS -= impulse * ns
	end
	if moveB then
		b.X += nx * overlap
		b.S += ns * overlap
		b.VX += impulse * nx
		b.VS += impulse * ns
	end
end

return Sim
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--[[
	Net
	The two RemoteEvents the whole framework uses, plus the message vocabulary.

	  PartyState  (server -> client): authoritative state. The client only ever renders this.
	  PartyInput  (client -> server): inputs only (ready / vote / minigame action).
	                                  The server validates every one of them.

	Two more remotes exist for minigames that run their own client code (Info.ClientModule):

	  PartyMinigame      reliable, both ways: setup data, corrections
	  PartyMinigameFast  unreliable, both ways: high-rate state (positions) where a lost
	                     packet doesn't matter because a newer one is right behind it

	Whatever a client sends on these goes to the active minigame's OnClientMessage, which
	must treat it as untrusted.

	The server creates the remotes; clients wait for them.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "PartyRemotes"

local Net = {}

-- Phases the server walks through each round. The client shows a screen per phase.
Net.Phase = {
	Lobby = "Lobby",
	Vote = "Vote",
	Instructions = "Instructions",
	Countdown = "Countdown",
	Playing = "Playing",
	Finished = "Finished",
	Results = "Results",
	-- Board game (around the minigame rounds above)
	Board = "Board", -- turns on the board; details arrive as BoardState messages
	Standings = "Standings", -- final match standings
}

-- Server -> client message types (message.Type).
Net.Message = {
	Phase = "Phase", -- full phase change; carries everything needed to draw that screen
	VoteUpdate = "VoteUpdate", -- live vote counts during the Vote phase
	Status = "Status", -- persistent HUD line set by the minigame ("Pip has the potato!")
	Toast = "Toast", -- short-lived feed message ("BOOM!")
	Chips = "Chips", -- player-chip strip: every participant's live value + eliminated flag
	BoardLayout = "BoardLayout", -- the board's spaces (sent once per match and to late joiners)
	BoardState = "BoardState", -- seats, coins, collectibles, whose turn, dice, moves left
	Prompt = "Prompt", -- to one player: pick an option (fork, buy, shop); Prompt = nil closes it
	Inventory = "Inventory", -- to one player: owned cosmetics, what's equipped, bank coins
	ShopResult = "ShopResult", -- to one player: { Ok, ItemId, Text } after a lobby shop purchase
	Tutorial = "Tutorial", -- to one player: { Flags = { [flag] = true } } guided first actions done
}

-- Client -> server input kinds (payload.Kind).
Net.Input = {
	Ready = "Ready", -- client finished loading; server replies with a state snapshot
	Vote = "Vote", -- payload.Choice = index of the vote card
	Action = "Action", -- payload.Action = action name declared in the minigame's Info.Controls
	Roll = "Roll", -- roll the die on your turn
	Choice = "Choice", -- payload.PromptId, payload.Index: answer to a Prompt
	UseItem = "UseItem", -- your turn, before rolling: payload.Slot = index into your items
	Equip = "Equip", -- payload.ItemId: wear a cosmetic you own
	Unequip = "Unequip", -- payload.Slot: take off whatever is in that slot
	BuyCosmetic = "BuyCosmetic", -- payload.ItemId: buy a cosmetic with bank coins (price is server-side)
	Setting = "Setting", -- waiting room, host only: payload.Key ("Rounds" | "Difficulty"), payload.Value
	StartMatch = "StartMatch", -- waiting room, host only: skip the countdown
	ActionUsed = "ActionUsed", -- a minigame action that the minigame's client code sent itself
	-- (tutorial only; the server checks you're playing). Studio-only: "ResetTutorial".
	ResetTutorial = "ResetTutorial",
}

local function getFolder(): Instance
	if RunService:IsServer() then
		local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = FOLDER_NAME
			folder.Parent = ReplicatedStorage
		end
		return folder
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME)
end

local function getRemote(name: string, className: string?): RemoteEvent
	local folder = getFolder()
	if RunService:IsServer() then
		local remote = folder:FindFirstChild(name)
		if not remote then
			remote = Instance.new(className or "RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
		return remote :: RemoteEvent
	end
	return folder:WaitForChild(name) :: RemoteEvent
end

function Net.stateRemote(): RemoteEvent
	return getRemote("PartyState")
end

function Net.inputRemote(): RemoteEvent
	return getRemote("PartyInput")
end

function Net.minigameRemote(): RemoteEvent
	return getRemote("PartyMinigame")
end

function Net.minigameFastRemote(): UnreliableRemoteEvent
	return getRemote("PartyMinigameFast", "UnreliableRemoteEvent") :: any
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">PoleShimmySim</string>
          <string name="Source"><![CDATA[--[[
	PoleShimmySim
	The climbing rules for Pole Shimmy, shared by server and client so both get exactly the
	same answer from the same presses:

	  * the server runs every climber with it (players from their timestamped presses, bots
	    from their own) and its result is the one that counts
	  * your client runs your climber with it too, so a press moves you on the very next frame

	A climber is plain data. Time is "race time" in seconds since that climber's GO.
]]

local Sim = {}

-- Tuning ----------------------------------------------------------------------------------

Sim.POLE_HEIGHT = 60 -- studs from the bottom to the bell
Sim.CLIMB_PER_PRESS = 0.9 -- studs a correctly alternated press is worth, before the rhythm bonus
Sim.RHYTHM_WINDOW = { 0.1, 0.5 } -- seconds between presses that count as climbing in rhythm
Sim.RHYTHM_TOLERANCE = 0.35 -- a beat is "steady" if within 35% of the previous gap
Sim.STREAK_BONUS = 0.08 -- extra multiplier per steady beat in a row ...
Sim.STREAK_MAX = 10 -- ... up to this many beats
Sim.BASE_MULTIPLIER = 0.7 -- multiplier with no streak (first press, or after a pause)
Sim.SPEED_CAP = 5 -- studs/s: nobody climbs faster than this, however fast they tap
Sim.POOL_MAX = 2.5 -- studs of climb that can be banked ahead of the cap
Sim.PAUSE_GRACE = 0.5 -- seconds without a press before the banked climb starts to fade ...
Sim.DECAY = 4 -- ... at this rate (per second, exponential)
-- Presses closer together than the window's lower edge are ignored (anti-autoclicker).
Sim.MIN_PRESS_INTERVAL = Sim.RHYTHM_WINDOW[1]

local STEP = 1 / 60 -- integration step; fixed so server and client agree

-- Climbers -------------------------------------------------------------------------------------

function Sim.newClimber()
	return {
		Time = 0, -- race time this state is at
		Height = 0,
		Pool = 0, -- climb earned but not yet climbed (drained at SPEED_CAP)
		Streak = 0,
		LastKey = nil, -- "Left" | "Right"
		LastPressAt = -math.huge,
		LastInterval = nil,
		Speed = 0, -- studs/s over the last step (for animation)
		FinishedAt = nil, -- race time the bell was reached
	}
end

-- Moves a climber forward in time to `toTime` (never backwards).
function Sim.advance(climber, toTime: number)
	while climber.Time < toTime - 1e-6 do
		local dt = math.min(STEP, toTime - climber.Time)
		if climber.FinishedAt then
			climber.Time += dt
			climber.Speed = 0
			continue
		end
		if climber.Time - climber.LastPressAt > Sim.PAUSE_GRACE then
			climber.Pool *= math.exp(-Sim.DECAY * dt)
		end
		local climb = math.min(climber.Pool, Sim.SPEED_CAP * dt)
		climber.Pool -= climb
		climber.Speed = climb / dt
		if climber.Height + climb >= Sim.POLE_HEIGHT then
			-- Reached the bell part-way through this step.
			local needed = Sim.POLE_HEIGHT - climber.Height
			climber.FinishedAt = climber.Time + (if climb > 0 then dt * needed / climb else 0)
			climber.Height = Sim.POLE_HEIGHT
			climber.Pool = 0
		else
			climber.Height += climb
		end
		climber.Time += dt
	end
end

--[[
	A press of `key` ("Left" or "Right") at race time `t`. Advances the climber to `t` first.
	Returns what happened: "climb", "same" (same hand twice), "fast" (too soon after the last
	press), or "done" (already at the top).
]]
function Sim.press(climber, key: string, t: number): string
	Sim.advance(climber, t)
	if climber.FinishedAt then
		return "done"
	end
	if key == climber.LastKey then
		return "same"
	end
	local interval = t - climber.LastPressAt
	if interval < Sim.MIN_PRESS_INTERVAL then
		return "fast"
	end

	if interval > Sim.RHYTHM_WINDOW[2] then
		climber.Streak = 0 -- lost the rhythm: start over
	elseif
		climber.LastInterval and math.abs(interval - climber.LastInterval) <= Sim.RHYTHM_TOLERANCE * climber.LastInterval
	then
		climber.Streak = math.min(climber.Streak + 1, Sim.STREAK_MAX)
	else
		climber.Streak = math.max(climber.Streak - 1, 0) -- uneven beat
	end
	local multiplier = Sim.BASE_MULTIPLIER + climber.Streak * Sim.STREAK_BONUS
	climber.Pool = math.min(Sim.POOL_MAX, climber.Pool + Sim.CLIMB_PER_PRESS * multiplier)

	climber.LastKey = key
	climber.LastPressAt = t
	climber.LastInterval = if interval <= Sim.RHYTHM_WINDOW[2] then interval else nil
	return "climb"
end

return Sim
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="7">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="8">
      <Properties>
        <string name="Name">PartyServer</string>
      </Properties>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Arena</string>
          <string name="Source"><![CDATA[--[[
	Arena
	World helpers owned by the framework (minigames build their own map *inside* the arena):
	  * the lobby (built automatically if the place has no SpawnLocation)
	  * a fresh arena Folder per round, positioned at Config.ArenaOrigin
	  * the glass spectator box eliminated participants are sent to
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.PartyShared.Config)

local Arena = {}

local function makePart(props): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(part :: any)[key] = value
	end
	return part
end

-- Returns the lobby spawn, building a simple lobby first if the place has none.
function Arena.ensureLobby(): SpawnLocation
	local existing = Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
	if existing then
		return existing
	end

	local lobby = Instance.new("Model")
	lobby.Name = "PartyLobby"

	makePart({
		Name = "Floor",
		Size = Vector3.new(80, 2, 80),
		Position = Vector3.new(0, -1, 0),
		Color = Color3.fromRGB(255, 170, 230),
		Material = Enum.Material.SmoothPlastic,
		Parent = lobby,
	})

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = Vector3.new(0, 0.5, 0)
	spawn.Color = Color3.fromRGB(255, 220, 90)
	spawn.Neutral = true
	spawn.Duration = 0 -- no forcefield; it would block hot potato passes
	spawn.Parent = lobby

	lobby.Parent = Workspace
	return spawn
end

-- A spot in a ring around the lobby spawn so returning players don't stack up.
function Arena.lobbySpot(index: number): CFrame
	local spawn = Arena.ensureLobby()
	local angle = (index - 1) * (math.pi * 2 / Config.PlayersPerMatch)
	local offset = Vector3.new(math.cos(angle) * 10, 4, math.sin(angle) * 10)
	local position = spawn.Position + offset
	return CFrame.lookAt(position, Vector3.new(spawn.Position.X, position.Y, spawn.Position.Z))
end

local function buildSpectatorBox(parent: Instance, origin: CFrame): CFrame
	local box = Instance.new("Model")
	box.Name = "SpectatorBox"

	local center = origin.Position + Config.SpectatorOffset
	local size = 28
	makePart({
		Name = "Glass",
		Size = Vector3.new(size, 1, size),
		Position = center,
		Transparency = 0.7,
		Material = Enum.Material.Glass,
		Color = Color3.fromRGB(170, 230, 255),
		Parent = box,
	})
	-- Low invisible walls so spectators can't wander off the glass.
	for i = 0, 3 do
		local angle = i * math.pi / 2
		local wallCenter = center + Vector3.new(math.cos(angle) * size / 2, 4, math.sin(angle) * size / 2)
		makePart({
			Name = "Wall",
			Size = Vector3.new(1, 8, size),
			CFrame = CFrame.new(wallCenter) * CFrame.Angles(0, -angle, 0),
			Transparency = 1,
			Parent = box,
		})
	end
	box.Parent = parent
	return CFrame.new(center + Vector3.new(0, 4, 0))
end

--[[
	Creates the arena object handed to Minigame:Setup(arena, ...):
	  arena.Folder          parent everything you build here; it is destroyed after the round
	  arena.Origin          CFrame at the centre of the play space
	  arena.SpectatorCFrame where eliminated participants are sent
]]
function Arena.create(minigameName: string)
	local folder = Instance.new("Folder")
	folder.Name = "Arena_" .. minigameName
	folder.Parent = Workspace

	local origin = CFrame.new(Config.ArenaOrigin)
	return {
		Folder = folder,
		Origin = origin,
		SpectatorCFrame = buildSpectatorBox(folder, origin),
	}
end

function Arena.destroy(arena)
	if arena and arena.Folder then
		arena.Folder:Destroy()
	end
end

return Arena
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="10">
        <Properties>
          <string name="Name">Board</string>
        </Properties>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">BoardGame</string>
            <string name="Source"><![CDATA[--[[
	BoardGame
	Runs one board-game match in the world: builds the board, takes turns (roll -> move ->
	space), runs a minigame after every full turn cycle, then shows the final standings.
	The rules themselves live in Match; this module adds timing, networking, bodies and bots.

	  BoardGame.play(participants, settings)   -> final standings rows (yields for the whole match)
	  BoardGame.cleanup()                      safe teardown, also after a crash
	  BoardGame.handleInput(player, payload)   -> true if it was a board input (Roll / Choice)
	  BoardGame.onPlayerLeft(player) / BoardGame.requestReclaim(player)
	                                           leave / rejoin entry points (PlayerRemoving and
	                                           PlayerAdded call them; the reclaim harness too)

	Players who leave are replaced by a bot that keeps their seat, coins and collectibles. The
	seat stays reserved for their UserId; if they rejoin they get it back at a safe moment
	(between turns, after a minigame; see SeatClaims). Players who join mid-match without a
	reserved seat watch until the next match.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.PartyShared.Config)
local Net = require(ReplicatedStorage.PartyShared.Net)
local Arena = require(script.Parent.Parent.Arena)
local BotService = require(script.Parent.Parent.BotService)
local CoinService = require(script.Parent.Parent.CoinService)
local CosmeticService = require(script.Parent.Parent.CosmeticService)
local Inventory = require(script.Parent.Parent.Inventory)
local MinigameManager = require(script.Parent.Parent.MinigameManager)
local Participant = require(script.Parent.Parent.Participant)
local Profiles = require(script.Parent.Parent.Profiles)
local SeatClaims = require(script.Parent.Parent.SeatClaims)
local Tutorial = require(script.Parent.Parent.Tutorial)
local BoardLayout = require(script.Parent.BoardLayout)
local BoardWorld = require(script.Parent.BoardWorld)
local Match = require(script.Parent.Match)
local SpaceTypes = require(script.Parent.SpaceTypes)

local BoardGame = {}

local rng = Random.new()
local current = nil -- the running match, see BoardGame.play
local nextPromptId = 0

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function waitRandom(range: { number })
	task.wait(rng:NextNumber(range[1], range[2]))
end

local function isAway(participant): boolean
	return participant.Left or (not participant.IsBot and (not participant.Player or participant.Player.Parent == nil))
end

-- Messages -------------------------------------------------------------------------------------

local function layoutMessage(board)
	local spaces = {}
	for _, id in board.Order do
		local space = board.Spaces[id]
		local spaceType = SpaceTypes[space.Type]
		table.insert(spaces, {
			Id = id,
			Type = space.Type,
			Name = spaceType.Name,
			Color = spaceType.Color,
			Position = current.World.Tops[id],
		})
	end
	local legend = {}
	for key, spaceType in SpaceTypes do
		table.insert(legend, { Type = key, Name = spaceType.Name, Short = spaceType.Short, Color = spaceType.Color })
	end
	return { Type = Net.Message.BoardLayout, Name = board.DisplayName, Spaces = spaces, Legend = legend, Festival = board.Bridge ~= nil }
end

local function describeItems(seat)
	local list = {}
	for _, id in seat.Items do
		local item = Match.getItem(id)
		table.insert(list, { Id = id, Name = item.Name, Description = item.Description })
	end
	return list
end

local function stateMessage()
	local match = current.Match
	local seats = {}
	for orderIndex, seat in match.Order do
		local participant = seat.Participant
		table.insert(seats, {
			Items = describeItems(seat),
			Shield = seat.Shield,
			Underdog = match:isUnderdog(seat),
			OrderRolls = current.OrderRolls and current.OrderRolls[seat],
			Id = participant.Id,
			Name = participant.Name,
			IsBot = participant.IsBot,
			Order = orderIndex,
			Coins = match:coinsOf(seat),
			Collectibles = match:collectiblesOf(seat),
			SpaceId = seat.SpaceId,
			Zone = match.Board:get(seat.SpaceId).Zone,
			Stats = table.clone(seat.Stats),
			-- A bot holding a seat for a player who left: whose seat it is.
			ReservedFor = (function()
				local userId = current.Claims:reservedFor(seat)
				return if userId and participant.IsBot then "player_" .. userId else nil
			end)(),
			Character = participant:GetCharacter(),
		})
	end
	local turn = current.Turn
	local pending = {}
	for player, pressed in current.OrderWaiting or {} do
		if not pressed then
			pending["player_" .. player.UserId] = true
		end
	end
	return {
		Bridge = match:bridgeState(),
		OrderPending = pending,
		Dice = match.Turn and match.Turn.Dice,
		ItemUsed = match.Turn and match.Turn.ItemUsed,
		MaxItems = Config.Items.MaxHeld,
		Type = Net.Message.BoardState,
		Round = match.Round,
		Rounds = match.Rounds,
		TurnId = turn and turn.Participant.Id,
		TurnName = turn and turn.Participant.Name,
		Stage = current.Stage,
		Roll = current.Roll,
		Remaining = current.Remaining,
		RollEndsAt = current.RollEndsAt,
		Text = current.Text,
		CollectibleSpace = match.CollectibleSpace,
		CollectibleName = Config.Collectible.Name,
		CollectiblePlural = Config.Collectible.Plural,
		CollectiblePrice = match.CollectiblePrice,
		Frenzy = match:isFrenzy(),
		Gates = (function()
			local gates = {}
			for _, gate in match.Board.Gates or {} do
				table.insert(gates, { Id = gate.Id, Open = match.GateOpen[gate.Id], Toll = gate.Toll or 0, From = gate.From, To = gate.To })
			end
			return gates
		end)(),
		Traps = (function()
			local traps = {}
			for id, trap in match.Traps do
				table.insert(traps, { SpaceId = id, Owner = trap.Owner.Participant.Name })
			end
			return traps
		end)(),
		Seats = seats,
	}
end

local function publish()
	if not current then
		return
	end
	local match = current.Match
	current.World:setCollectible(
		match.CollectibleSpace,
		("%s · %d coins"):format(Config.Collectible.Name, match.CollectiblePrice)
	)
	current.World:setFestivalLighting(current.Stage ~= "Minigame")
	current.World:setBridgeState(match:bridgeState())
	current.World:setTraps(match.Traps)
	current.World:setGates(match.Board.Gates, match.GateOpen)
	current.StateMessage = stateMessage()
	MinigameManager.broadcast(current.StateMessage)
end

local function feed(text: string?)
	if text and current then
		current.Text = text
		MinigameManager.broadcast({ Type = Net.Message.Toast, Text = text })
	end
end

-- Pieces on the board ---------------------------------------------------------------------------

local function slotOf(seat): number
	local slot = 0
	for _, other in current.Match.Seats do
		if other.SpaceId == seat.SpaceId then
			slot += 1
		end
		if other == seat then
			return slot
		end
	end
	return 1
end

local function placeSeat(seat)
	local participant = seat.Participant
	if not participant:IsAlive() then
		return
	end
	local facing = current.Match:nextOptions(seat.SpaceId)[1]
	participant:Teleport(current.World:spaceCFrame(seat.SpaceId, slotOf(seat), facing))
	participant:Freeze()
	if current.Match.Board.Bridge then
		local root = participant:GetRoot()
		if root then root.Anchored = true end
	end
	-- Pieces bumping on a shared tile can tip over; stand bots back up (players' own
	-- clients do the same in BoardView).
	local humanoid = participant:GetHumanoid()
	if participant.IsBot and humanoid then
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
end

local function placeAll()
	for _, seat in current.Match.Seats do
		placeSeat(seat)
	end
end

-- Board pieces are anchored on this board: clients cannot jump/walk across a gap.
-- Release before any minigame/duel or lobby transition.
local function releasePieces()
 if not current or not current.Match or not current.Match.Board.Bridge then return end
 for _,seat in current.Match.Seats do
  local root=seat.Participant:GetRoot()
  if root then root.Anchored=false end
 end
end

local function warnRotation()
 local state=current.Match:bridgeState()
 current.Stage="RotationWarning"
 feed("Moon bridge: " .. state.Alignment .. " → " .. state.NextAlignment .. ". Stay on your space!")
 publish()
 task.wait(current.Match.Board.Bridge.WarningSeconds)
end

local function animateRotation()
 local match=current.Match
 current.Stage="Rotating"
 -- State and connectivity have already committed together; no turns or seam hops
 -- can run until this synchronous presentation finishes.
 publish()
 local startAngle=current.BridgeAngle or 0
 local duration=match.Board.Bridge.RotationSeconds
 local started=now()
 repeat
  local alpha=math.clamp((now()-started)/duration,0,1)
  current.World:setBridgeAngle(startAngle+((if match.Orientation==0 then 0 else -math.pi/2)-startAngle)*(alpha*alpha*(3-2*alpha)))
  for _,seat in match.Seats do
   if seat.SpaceId>=33 then placeSeat(seat) end
  end
  task.wait()
 until now()-started>=duration
 current.BridgeAngle=if match.Orientation==0 then 0 else -math.pi/2
 current.World:setBridgeAngle(current.BridgeAngle)
 placeAll()
 current.LayoutMessage=layoutMessage(match.Board)
 MinigameManager.broadcast(current.LayoutMessage)
 feed("Moon bridge now " .. match:bridgeState().Alignment .. ". Closed zones keep looping.")
end

--[[
	Safe recovery: while the board is up, any piece that has been knocked off its space,
	fallen off the board or lost its body is put back (bots get a new body first). Runs once
	a second; Match positions are the truth, the world just follows them.
]]
local function recoverPieces()
	if not current or current.Stage == "Minigame" or current.Stage == "Finished" or current.Stage == "Rotating" then
		return 0
	end
	local fixed = 0
	for _, seat in current.Match.Seats do
		local participant = seat.Participant
		if participant.IsBot and not participant:IsAlive() then
			BotService.reviveAll(Arena.lobbySpot)
		end
		local root = participant:GetRoot()
		if participant:IsAlive() and root and current.World:isMisplaced(root.Position, seat.SpaceId) then
			placeSeat(seat)
			fixed += 1
		end
	end
	return fixed
end
BoardGame.recoverPieces = recoverPieces

local function ensureBodies()
	BotService.reviveAll(Arena.lobbySpot)
	for _, seat in current.Match.Seats do
		local participant = seat.Participant
		if not participant.IsBot and not isAway(participant) and not participant:IsAlive() then
			pcall(function()
				participant.Player:LoadCharacter()
			end)
		end
	end
end

-- Seats whose player left get a bot that keeps the seat (coins, collectibles, position).
local function refreshSeats()
	local match = current.Match
	for _, seat in match.Seats do
		local leaver = seat.Participant
		if not isAway(leaver) then
			continue
		end
		leaver.Left = true
		if leaver.UserId and Config.SeatReclaim.Enabled then
			current.Claims:reserve(seat, leaver.UserId)
		end
		local seatedBots = {}
		for _, other in match.Seats do
			if other.Participant.IsBot then
				seatedBots[other.Participant.Bot] = other.Participant
			end
		end
		local count = 0
		for _ in seatedBots do
			count += 1
		end
		-- getBots clears every bot's Participant link, so restore the seated ones after.
		local bots = BotService.getBots(count + 1, Arena.lobbySpot)
		local newcomer
		for _, bot in bots do
			if seatedBots[bot] then
				bot.Participant = seatedBots[bot]
			else
				newcomer = bot
			end
		end
		if newcomer then
			local replacement = Participant.fromBot(newcomer)
			match:replaceParticipant(seat, replacement)
			feed(("%s left, %s takes over their seat"):format(leaver.Name, replacement.Name))
			placeSeat(seat)
		end
	end
end

-- Rejoining -----------------------------------------------------------------------------------

local function tellPlayer(player: Player, text: string)
	if player.Parent then
		MinigameManager.sendTo(player, { Type = Net.Message.Toast, Text = text })
	end
end

-- Hands a reserved seat back to its returning player. Callers make sure it's a safe moment.
local function completeReclaim(seat): boolean
	local claims = current.Claims
	local player = claims:pendingFor(seat)
	if not player then
		return false
	end
	claims:consume(seat)
	local previous = seat.Participant
	local returning = Participant.fromPlayer(player)
	local ok = current.Match:reclaimSeat(seat, returning)
	if not ok then
		return false
	end
	if previous.IsBot and previous.Bot then
		BotService.release(previous.Bot) -- the takeover bot is done; lobby-fill bots stay
	elseif previous.Player and previous.Player ~= player then
		-- The earlier session's body, if Roblox hasn't removed it yet.
		local old = previous.Player.Character
		if old and old.Parent then
			old:Destroy()
		end
	end
	if returning:IsAlive() then
		placeSeat(seat)
	end -- otherwise watchCharacter seats the body when it spawns
	feed(("%s is back and takes their seat again"):format(returning.Name))
	tellPlayer(player, SeatClaims.Messages.now)
	publish()
	return true
end

-- Safe boundary (turn finished, minigame over, round start, standings): seat everyone waiting.
-- Runs before refreshSeats, so someone who left and came back within one minigame gets their
-- seat straight back instead of a bot taking it for a moment.
local function settleReclaims()
	if not current then
		return
	end
	for _, seat in current.Match.Seats do
		completeReclaim(seat)
	end
end

-- A player joined: if a seat is reserved for their UserId, queue the claim and take it now
-- if nothing is in progress for that seat.
local function requestReclaim(player: Player)
	if not current or not current.Claims or not Config.SeatReclaim.Enabled then
		return
	end
	local seat = current.Claims:request(player)
	if not seat then
		return
	end
	local timing = SeatClaims.timing(current.Stage, current.Turn == seat)
	if timing == "now" and completeReclaim(seat) then
		return
	end
	tellPlayer(player, SeatClaims.Messages[timing] or SeatClaims.Messages.later)
end
BoardGame.requestReclaim = requestReclaim

-- Choices -----------------------------------------------------------------------------------------

-- What a fork's buttons lead to, for the client's first-fork guidance: the first space of
-- each route and its distance to the Crown (nil when it can't be reached).
local function describeRoutes(request)
	local data = request.Kind == "Path" and request.Data
	if not data or not data.Spaces then
		return nil
	end
	local routes = {}
	for i, spaceId in data.Spaces do
		local info = data.Info and data.Info[i]
		local distance = info and info.CrownDistance
		table.insert(routes, {
			SpaceId = spaceId,
			CrownDistance = if distance and distance ~= math.huge then distance else nil,
			Toll = info and info.Toll or 0,
		})
	end
	return routes
end

-- Match's Ask: players get a prompt on screen, bots decide on their own.
local function ask(seat, request)
	local participant = seat.Participant
	local previousStage = current.Stage
	current.Stage = "Deciding"
	current.Text = ("%s is deciding: %s"):format(participant.Name, request.Prompt)
	publish()

	local answer
	if participant.IsBot or isAway(participant) then
		waitRandom(Config.Board.BotChoiceDelay)
		local skill = if participant.Bot then participant.Bot.Skill else 0.5
		answer = current.Match:botDecision(seat, request, skill)
	else
		nextPromptId += 1
		local prompt = {
			Id = nextPromptId,
			Player = participant.Player,
			Count = #request.Options,
			Kind = request.Kind,
			Answer = nil,
		}
		current.Prompt = prompt
		local endsAt = now() + Config.Board.ChoiceTimeout
		MinigameManager.sendTo(participant.Player, {
			Type = Net.Message.Prompt,
			PromptId = prompt.Id,
			Prompt = request.Prompt,
			Options = request.Options,
			Default = request.Default,
			EndsAt = endsAt,
			Kind = request.Kind, -- "Path" | "Collectible" | "Shop" | ... (guidance only)
			Routes = describeRoutes(request),
			Price = request.Price,
		})
		while prompt.Answer == nil and now() < endsAt and not isAway(participant) do
			task.wait(0.1)
		end
		current.Prompt = nil
		if participant.Player.Parent then
			MinigameManager.sendTo(participant.Player, { Type = Net.Message.Prompt, PromptId = nil })
		end
		answer = prompt.Answer or request.Default
	end

	current.Stage = previousStage
	publish()
	return answer
end

-- Duel space: play a Duel minigame between the two seats, then bring everyone back to the board.
-- Returns winner seat (nil = draw) and whether a duel was played at all.
local function playDuel(seatA, seatB)
	if #MinigameManager.duelMinigames() == 0 then
		return nil, false
	end
	local match = current.Match
	local previousStage = current.Stage
	current.Stage = "Minigame"
	publish()
	task.wait(1)
	releasePieces()
	local ok, winner = xpcall(MinigameManager.runDuel, debug.traceback, seatA.Participant, seatB.Participant)
	if not ok then
		warn("[BoardGame] Duel crashed, using dice instead:\n" .. tostring(winner))
		MinigameManager.abort("Duel crashed, rolling dice instead")
	end
	MinigameManager.setPhase(Net.Phase.Board, { Round = match.Round, Rounds = match.Rounds })
	current.Stage = previousStage
	ensureBodies()
	placeAll()
	publish()
	if not ok then
		return nil, false
	end
	return if winner then match:seatOf(winner) else nil, true
end

-- Turns -------------------------------------------------------------------------------------------

-- Turn order: everyone rolls once before round 1; ties roll again among themselves.
local function rollForTurnOrder()
	local match = current.Match
	current.Stage = "OrderRoll"
	current.OrderRolls = {}
	current.Text = "Everyone rolls for turn order!"

	local function rollFor(seats, attempt)
		current.OrderWaiting = {}
		for _, seat in seats do
			local participant = seat.Participant
			if not participant.IsBot and not isAway(participant) then
				current.OrderWaiting[participant.Player] = false
			end
		end
		current.RollEndsAt = now() + Config.Match.OrderRollTimeout
		if attempt > 1 then
			current.Text = "Tie! Tied players roll again"
		end
		publish()
		task.wait(1) -- bots "roll" after a beat
		while now() < current.RollEndsAt do
			local waiting = false
			for player, pressed in current.OrderWaiting do
				if not pressed and player.Parent then
					waiting = true
				end
			end
			if not waiting then
				break
			end
			task.wait(0.05)
		end
		current.OrderWaiting = nil
		current.RollEndsAt = nil
		local rolls = {}
		for _, seat in seats do
			rolls[seat] = match:roll()
			current.OrderRolls[seat] = current.OrderRolls[seat] or {}
			table.insert(current.OrderRolls[seat], rolls[seat])
		end
		publish()
		task.wait(1.5)
		return rolls
	end

	local order = match:decideTurnOrder(rollFor)
	local names = {}
	for index, seat in order do
		table.insert(names, ("%d. %s"):format(index, seat.Participant.Name))
	end
	current.Stage = "OrderDone"
	feed("Turn order: " .. table.concat(names, "   "))
	publish()
	task.wait(2.5)
	current.OrderRolls = nil
end

-- Uses an item for the seat whose turn it is. Players pick a target / number here; bots pass
-- theirs in. Match:useItem does all the validation for both.
local function useItem(seat, slot, target, choice)
	local match = current.Match
	local id = type(slot) == "number" and seat.Items[slot]
	local item = id and Match.getItem(id)
	if item and item.Target == "Opponent" and target == nil then
		local opponents = match:opponentsOf(seat)
		local labels = {}
		for i, other in opponents do
			labels[i] = other.Participant.Name
		end
		table.insert(labels, "Cancel")
		local pick = ask(seat, {
			Kind = "Target",
			Prompt = ("%s: pick an opponent"):format(item.Name),
			Options = labels,
			Default = #labels,
			Data = { Seats = opponents },
		})
		target = opponents[pick]
		if not target then
			return false
		end
	end
	if item and item.Choice == "DieFace" and choice == nil then
		local labels = {}
		for face = 1, Config.Board.DieSides do
			labels[face] = tostring(face)
		end
		table.insert(labels, "Cancel")
		choice = ask(seat, {
			Kind = "DieFace",
			Prompt = ("%s: pick your roll"):format(item.Name),
			Options = labels,
			Default = #labels,
		})
		if choice > Config.Board.DieSides then
			return false
		end
	end
	local previousStage=current.Stage
 local revision=match.BridgeRevision
 if id=="MoonDial" and match:canUseMoonDial() and match.Turn and match.Turn.Seat==seat
  and match.Turn.Stage=="PreRoll" and not match.Turn.ItemUsed then warnRotation() end
 local used, text = match:useItem(seat, slot, target, choice)
 if match.BridgeRevision~=revision then animateRotation() end
 current.Stage=previousStage
	if used then
		Tutorial.complete(seat.Participant, "SawItem")
		feed(text)
		placeAll() -- swaps and warps move pieces
	elseif seat.Participant.Player and seat.Participant.Player.Parent then
		MinigameManager.sendTo(seat.Participant.Player, { Type = Net.Message.Toast, Text = "Can't use that: " .. text })
	end
	publish()
	return used
end

local function takeTurn(seat)
	settleReclaims() -- the previous turn is over
	refreshSeats()
	local match = current.Match
	local participant = seat.Participant
	match:beginTurn(seat)
	current.Turn = seat
	current.Stage = "Roll"
	current.Roll = nil
	current.Remaining = nil
	current.RollEndsAt = now() + Config.Board.RollTimeout
	current.Text = ("%s's turn"):format(participant.Name)
	current.RollRequested = false
	current.ItemRequest = nil
	publish()

	if participant.IsBot or isAway(participant) then
		waitRandom(Config.Board.BotRollDelay)
		local slot, target, choice = match:botItemChoice(seat)
		if slot and useItem(seat, slot, target, choice) then
			task.wait(1)
		end
	else
		current.RollWaiting = participant.Player
		while not current.RollRequested and now() < current.RollEndsAt and not isAway(participant) do
			local request = current.ItemRequest
			if request then
				current.ItemRequest = nil
				if useItem(seat, request.Slot) then
					current.RollEndsAt = math.max(current.RollEndsAt, now() + 5)
					publish()
				end
			end
			task.wait(0.05)
		end
		current.RollWaiting = nil
	end

	local roll, dice = match:rollTurn(seat)
	current.Stage = "Moving"
	current.Roll = roll
	current.Remaining = roll
	current.RollEndsAt = nil
	current.Text = if #dice > 1
		then ("%s rolled %s = %d"):format(seat.Participant.Name, table.concat(dice, " + "), roll)
		else ("%s rolled a %d"):format(seat.Participant.Name, roll)
	publish()
	task.wait(0.8)

	local landing = match:move(seat, roll, function(movedSeat, _, remaining)
		current.Remaining = remaining
		placeSeat(movedSeat)
		publish()
		task.wait(Config.Board.HopTime)
	end, function(note)
		feed(note)
		publish()
	end)

	placeAll() -- events can move other pieces too
	current.Stage = "Landed"
	local space = match.Board:get(seat.SpaceId)
	feed(landing or ("%s landed on a %s"):format(seat.Participant.Name, SpaceTypes[space.Type].Name))
	match:endTurn()
	publish()
	task.wait(Config.Board.LandPause)
end

-- Match -------------------------------------------------------------------------------------------

local function describeBonuses(awarded)
	local list = {}
	for _, entry in awarded do
		local winners = {}
		for _, seat in entry.Winners do
			table.insert(winners, { Id = seat.Participant.Id, Name = seat.Participant.Name })
		end
		table.insert(list, {
			Name = entry.Bonus.Name,
			Description = entry.Bonus.Description,
			Crowns = entry.Bonus.Crowns or 1,
			Value = entry.Value,
			Winners = winners,
		})
	end
	return list
end

local function describeRows(rows)
	local list = {}
	for _, row in rows do
		local entry = row.Participant:Describe()
		entry.Placement = row.Placement
		entry.Collectibles = row.Collectibles
		entry.Coins = row.Coins
		table.insert(list, entry)
	end
	return list
end

function BoardGame.play(participants, settings)
	BoardGame.cleanup()
	CoinService.resetAll()
	Inventory.resetBots()

	local data = require(script.Parent.Boards:FindFirstChild(settings.Board or Config.Match.Board))
	local board = BoardLayout.load(data, SpaceTypes)
	current = {
		World = BoardWorld.build(board, SpaceTypes, Config.Board.Origin),
		Stage = "Start",
		Claims = SeatClaims.new(),
	}
	current.Match = Match.new(board, participants, { Rounds = settings.Rounds, Difficulty = settings.Difficulty }, {
		Wallet = CoinService,
		Inventory = Inventory,
		Rng = rng,
		Ask = ask,
		Duel = playDuel,
	})
	local match = current.Match
	for _, seat in match.Seats do
		CoinService.add(seat.Participant, Config.Economy.StartingCoins)
		for _, itemId in Config.Items.StartingItems do
			match:giveItem(seat, itemId)
		end
	end
	current.LayoutMessage = layoutMessage(board)
	local watched = current
	task.spawn(function()
		while current == watched do
			pcall(recoverPieces)
			task.wait(1)
		end
	end)
	MinigameManager.broadcast(current.LayoutMessage)

	for round = 1, match.Rounds do
		local catchUp = match:startRound(round)
		current.Turn = nil
		current.Stage = "Start"
		current.Text = ("Round %d of %d"):format(round, match.Rounds)
			.. (if match:isFrenzy() then "  ·  FINAL FRENZY: coin spaces x2" else "")
		MinigameManager.setPhase(Net.Phase.Board, { Round = round, Rounds = match.Rounds })
		settleReclaims()
		refreshSeats()
		ensureBodies()
		placeAll()
		publish()
		task.wait(1.5)
		if catchUp then
			feed(catchUp)
			publish()
			task.wait(1.5)
		end
		if round == 1 then
			rollForTurnOrder()
		end

		for _, seat in match.Order do
			takeTurn(seat)
		end

		current.Turn = nil
		settleReclaims() -- the last turn of the round is over
		refreshSeats()
  if match:rotationDue() then
   warnRotation()
   if match:finishBoardRound() then animateRotation() end
  end
		current.Stage = "Minigame"
		current.Text = "Minigame time!"
		publish()
		task.wait(1)
		refreshSeats()
		releasePieces()
		local ok, results, rows = xpcall(MinigameManager.runRound, debug.traceback, match:participants())
		if ok then
			match:recordMinigame(results, rows)
		else
			warn("[BoardGame] Minigame crashed, carrying on with the board:\n" .. tostring(results))
			MinigameManager.abort("Minigame crashed, back to the board!")
		end
		-- Results are in: players who came back during the minigame get their seats now,
		-- before the next board turn.
		current.Stage = "Start"
		settleReclaims()
		refreshSeats()
	end

	-- Standings before bonuses -> bonus awards -> final standings.
	current.Stage = "Standings"
	settleReclaims()
	refreshSeats()
	MinigameManager.setPhase(Net.Phase.Standings, {
		Stage = "Before",
		Rows = describeRows(match:standings()),
		CollectiblePlural = Config.Collectible.Plural,
		EndsAt = now() + Config.Match.PreBonusDuration,
	})
	ensureBodies()
	placeAll()
	task.wait(Config.Match.PreBonusDuration)

	local awarded = match:awardBonuses()
	MinigameManager.setPhase(Net.Phase.Standings, {
		Stage = "Bonus",
		Bonuses = describeBonuses(awarded),
		CollectiblePlural = Config.Collectible.Plural,
		EndsAt = now() + Config.Match.BonusDuration,
	})
	task.wait(Config.Match.BonusDuration)

	-- Last chance for anyone who came back during the standings; then the seats are final.
	settleReclaims()
	refreshSeats()
	local claims = current.Claims
	current.Claims = SeatClaims.new() -- reservations end with the match
	for _, player in claims:clear() do
		tellPlayer(player, SeatClaims.Messages.ended)
	end
	-- Permanent bank coins for real players (the only thing a match writes to a profile).
	-- One row per seat, paid once, so a rejoin can't be paid twice.
	local rows = match:standings()
	local described = describeRows(rows)
	for index, row in rows do
		local player = row.Participant.Player
		local amount = Config.Profile.BankCoinsByPlacement[row.Placement] or 0
		if player and player.Parent and not row.Participant.Left and amount > 0 then
			Profiles.addBankCoins(player, amount)
			described[index].BankCoins = amount
			CosmeticService.sendInventory(player)
		end
	end
	MinigameManager.setPhase(Net.Phase.Standings, {
		Stage = "Final",
		Rows = described,
		CollectiblePlural = Config.Collectible.Plural,
		EndsAt = now() + Config.Match.StandingsDuration,
	})
	task.wait(Config.Match.StandingsDuration)
	BoardGame.cleanup()
	return rows
end

-- Tears the match down and sends everyone back to the lobby. Safe to call any time.
function BoardGame.cleanup()
	local match = current and current.Match
	releasePieces()
	if current then
		current.World:destroy()
		for _, player in current.Claims:clear() do
			tellPlayer(player, SeatClaims.Messages.ended)
		end
	end
	current = nil
	CoinService.resetAll()
	Inventory.resetBots()
	BotService.setBrain(nil)
	BotService.reviveAll(Arena.lobbySpot)
	if match then
		for index, seat in match.Seats do
			local participant = seat.Participant
			if participant:IsAlive() then
				participant:Teleport(Arena.lobbySpot(index))
				participant:ResetMovement()
			end
		end
	end
end

function BoardGame.isRunning(): boolean
	return current ~= nil
end

function BoardGame.handleInput(player: Player, payload): boolean
	local kind = payload.Kind
	if kind == Net.Input.Roll then
		if current and current.RollWaiting == player then
			current.RollRequested = true
			Tutorial.complete(player, "RolledBoardTurn")
			-- Rolled while holding an item they could have used: they've seen the item choice.
			local turn = current.Match.Turn
			if current.Turn and #current.Turn.Items > 0 and turn and not turn.ItemUsed then
				Tutorial.complete(player, "SawItem")
			end
		elseif current and current.OrderWaiting and current.OrderWaiting[player] == false then
			current.OrderWaiting[player] = true
			Tutorial.complete(player, "RolledForOrder")
		end
		return true
	elseif kind == Net.Input.UseItem then
		-- Only queued here; takeTurn hands it to Match:useItem, which checks everything.
		if current and current.RollWaiting == player and not current.ItemRequest then
			current.ItemRequest = { Slot = payload.Slot }
		end
		return true
	elseif kind == Net.Input.Choice then
		local prompt = current and current.Prompt
		local index = payload.Index
		if
			prompt
			and prompt.Player == player
			and payload.PromptId == prompt.Id
			and type(index) == "number"
			and index % 1 == 0
			and index >= 1
			and index <= prompt.Count
		then
			prompt.Answer = index
			if prompt.Kind == "Path" then
				Tutorial.complete(player, "ChoseFork")
			elseif prompt.Kind == "Collectible" then
				Tutorial.complete(player, "SawCrownPurchase")
			end
		end
		return true
	end
	return false
end

-- Late joiners / reloads: send the board and where everyone is.
MinigameManager.onReady(function(player)
	if current and current.LayoutMessage then
		MinigameManager.sendTo(player, current.LayoutMessage)
		if current.StateMessage then
			MinigameManager.sendTo(player, stateMessage())
		end
		-- Still waiting for their seat (the queued message may have arrived before the
		-- client was listening): say so again.
		local seat = current.Claims:keyFor(player.UserId)
		if seat and current.Claims:pendingFor(seat) == player then
			local timing = SeatClaims.timing(current.Stage, current.Turn == seat)
			tellPlayer(player, SeatClaims.Messages[if timing == "now" then "later" else timing])
		end
	end
end)

-- A seated player who resets on the board goes straight back to their space.
local function watchCharacter(player: Player)
	player.CharacterAdded:Connect(function()
		task.wait(0.2)
		if not current or current.Stage == "Minigame" then
			return
		end
		for _, seat in current.Match.Seats do
			if seat.Participant.Player == player then
				placeSeat(seat)
				publish()
			end
		end
	end)
end
Players.PlayerAdded:Connect(function(player)
	watchCharacter(player)
	requestReclaim(player)
end)
for _, player in Players:GetPlayers() do
	watchCharacter(player)
end

-- A player left: their seat goes to a bot at the next turn and stays reserved for them.
-- PlayerRemoving calls this; the multi-client harness calls it to simulate a leave.
function BoardGame.onPlayerLeft(player: Player)
	if not current then
		return
	end
	current.Claims:cancel(player) -- left again while waiting for their seat
	for _, seat in current.Match.Seats do
		if seat.Participant.Player == player then
			seat.Participant.Left = true -- the turn loop hands the seat to a bot
			if Config.SeatReclaim.Enabled then
				current.Claims:reserve(seat, player.UserId)
			end
		end
	end
end
Players.PlayerRemoving:Connect(BoardGame.onPlayerLeft)

return BoardGame
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">BoardLayout</string>
            <string name="Source"><![CDATA[--[[
	BoardLayout
	Turns a board data module (Board/Boards/*) into a checked, indexed board.

	  BoardLayout.load(data, spaceTypes)  -> board (errors with a clear message if the data is bad)
	  BoardLayout.validate(data, spaceTypes) -> problem string or nil

	A board:
	  board.Name, board.Start, board.CrownSpaces
	  board.Spaces[id] = { Id, Type, At = {x, z}, Next = {ids}, Paths = {labels}? }
	  board.Order      every space id, in data order
	  board:nextOptions(id) -> { ids }   (ignores gates; Match:nextOptions applies them)
	  board.Gates      { { Id, From, To, Open, Toll } }: a fork edge that can be shut
	                   (Switch spaces flip them) and/or costs Toll coins to take
]]

local RotatingBridge = require(script.Parent.RotatingBridge)
local BoardLayout = {}

local Board = {}
Board.__index = Board

function Board:nextOptions(id: number): { number }
	local space = self.Spaces[id]
	return if space then space.Next else {}
end

function Board:get(id: number)
	return self.Spaces[id]
end

-- Fewest moves from `from` to `to` following Next (math.huge if unreachable). Cached.
function Board:distance(from: number, to: number): number
	self.DistanceCache = self.DistanceCache or {}
	local row = self.DistanceCache[from]
	if not row then
		row = { [from] = 0 }
		local queue, head = { from }, 1
		while queue[head] do
			local id = queue[head]
			head += 1
			for _, nextId in self.Spaces[id].Next do
				if row[nextId] == nil then
					row[nextId] = row[id] + 1
					table.insert(queue, nextId)
				end
			end
		end
		self.DistanceCache[from] = row
	end
	return row[to] or math.huge
end

function BoardLayout.validate(data, spaceTypes): string?
	if type(data) ~= "table" or type(data.Spaces) ~= "table" or #data.Spaces == 0 then
		return "board has no Spaces"
	end
	local byId = {}
	for index, space in data.Spaces do
		if type(space.Id) ~= "number" then
			return ("space #%d has no numeric Id"):format(index)
		end
		if byId[space.Id] then
			return ("duplicate space Id %d"):format(space.Id)
		end
		if not spaceTypes[space.Type] then
			return ("space %d has unknown Type %s"):format(space.Id, tostring(space.Type))
		end
		if type(space.At) ~= "table" or type(space.At[1]) ~= "number" or type(space.At[2]) ~= "number" then
			return ("space %d needs At = { x, z }"):format(space.Id)
		end
		if type(space.Next) ~= "table" or #space.Next == 0 then
			return ("space %d is a dead end (no Next)"):format(space.Id)
		end
		if space.Paths and #space.Paths ~= #space.Next then
			return ("space %d has %d Paths for %d Next"):format(space.Id, #space.Paths, #space.Next)
		end
		byId[space.Id] = space
	end
	for _, space in data.Spaces do
		for _, nextId in space.Next do
			if not byId[nextId] then
				return ("space %d points to missing space %s"):format(space.Id, tostring(nextId))
			end
		end
	end
	if not byId[data.Start] then
		return "Start is not a space"
	end
	for _, gate in data.Gates or {} do
		local from = byId[gate.From]
		if not from or not table.find(from.Next, gate.To) then
			return ("gate %s is not an edge of the board"):format(tostring(gate.Id))
		end
		if #from.Next < 2 then
			return ("gate %s must be on a fork, so there's always another way"):format(tostring(gate.Id))
		end
	end
	if type(data.CrownSpaces) ~= "table" or #data.CrownSpaces < 2 then
		return "need at least 2 CrownSpaces (the collectible moves after each purchase)"
	end
	for _, id in data.CrownSpaces do
		if not byId[id] then
			return ("CrownSpaces lists missing space %s"):format(tostring(id))
		end
	end

	local bridgeProblem = RotatingBridge.validate(data)
	if bridgeProblem then return bridgeProblem end

	-- Every space must be reachable from Start, and Start reachable again from every space
	-- (otherwise someone could get stuck on a branch forever).
	local function reach(from, edges)
		local seen, queue = { [from] = true }, { from }
		while #queue > 0 do
			local id = table.remove(queue)
			for _, nextId in edges[id] or {} do
				if not seen[nextId] then
					seen[nextId] = true
					table.insert(queue, nextId)
				end
			end
		end
		return seen
	end
	local forward, backward = {}, {}
	for _, space in data.Spaces do
		forward[space.Id] = space.Next
		for _, nextId in space.Next do
			backward[nextId] = backward[nextId] or {}
			table.insert(backward[nextId], space.Id)
		end
	end
	local fromStart, toStart = reach(data.Start, forward), reach(data.Start, backward)
	for _, space in data.Spaces do
		if not fromStart[space.Id] then
			return ("space %d can't be reached from Start"):format(space.Id)
		end
		if not toStart[space.Id] then
			return ("space %d never leads back to Start"):format(space.Id)
		end
	end
	return nil
end

function BoardLayout.load(data, spaceTypes)
	local problem = BoardLayout.validate(data, spaceTypes)
	if problem then
		error(("[BoardLayout] board %s: %s"):format(tostring(data and data.Name), problem), 2)
	end
	local board = setmetatable({
		Name = data.Name,
		DisplayName = data.DisplayName or data.Name,
		Start = data.Start,
		CrownSpaces = table.clone(data.CrownSpaces),
		Gates = data.Gates or {},
		Bridge = data.Bridge,
		Zones = data.Zones,
		Spaces = {},
		Order = {},
	}, Board)
	for _, space in data.Spaces do
		board.Spaces[space.Id] = table.clone(space)
		table.insert(board.Order, space.Id)
	end
	return board
end

return BoardLayout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">BoardWorld</string>
            <string name="Source"><![CDATA[--[[
	BoardWorld
	Builds a board in the Workspace from a loaded board (BoardLayout) and tells BoardGame
	where pieces stand. Placeholder look: coloured tiles, paths and a gold collectible marker.

	  local world = BoardWorld.build(board, spaceTypes, origin)
	  world:spaceCFrame(id, slot, facingId?)  where a piece stands (slot 1..4 share a tile)
	  world:setCollectible(id, label)        move the collectible marker
	  world:destroy()
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.PartyShared.Config)

local FestivalScene = require(script.Parent.FestivalScene)

local BoardWorld = {}
BoardWorld.__index = BoardWorld

local TILE_SIZE = 9
local TILE_HEIGHT = 1
local ROOT_HEIGHT = 3.2 -- HumanoidRootPart height above the tile top
local SLOT_OFFSETS = {
	Vector3.new(-2.5, 0, -2.5),
	Vector3.new(2.5, 0, -2.5),
	Vector3.new(-2.5, 0, 2.5),
	Vector3.new(2.5, 0, 2.5),
}

local function part(props): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		(p :: any)[key] = value
	end
	return p
end

function BoardWorld.build(board, spaceTypes, origin: Vector3)
	local self = setmetatable({ Board = board, Origin = origin, Tops = {}, Tiles = {} }, BoardWorld)
	local spacing = Config.Board.SpaceSpacing
	local folder = Instance.new("Folder")
	folder.Name = "PartyBoard"
	self.Folder = folder

	local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
	for _, id in board.Order do
		local at = board.Spaces[id].At
		minX, maxX = math.min(minX, at[1]), math.max(maxX, at[1])
		minZ, maxZ = math.min(minZ, at[2]), math.max(maxZ, at[2])
	end
	-- Centre the layout on the origin. Grid z goes "up the board" = -Z in the world.
	local centre = Vector3.new((minX + maxX) / 2 * spacing, 0, -(minZ + maxZ) / 2 * spacing)
	local function worldAt(at): Vector3
		return origin + Vector3.new(at[1] * spacing, 0, -at[2] * spacing) - centre
	end

	if not board.Bridge then
	part({
		Name = "Base",
		Size = Vector3.new((maxX - minX) * spacing + 30, 2, (maxZ - minZ) * spacing + 30),
		Position = origin + Vector3.new(0, -1, 0),
		Color = Color3.fromRGB(120, 200, 120),
		Material = Enum.Material.Grass,
		Parent = folder,
	})

	end
	for _, id in board.Order do
		local space = board.Spaces[id]
		local spaceType = spaceTypes[space.Type]
		local position = worldAt(space.At)
		self.Tops[id] = position + Vector3.new(0, TILE_HEIGHT, 0)

		local tile = part({
			Name = "Space" .. id,
			Size = Vector3.new(TILE_SIZE, TILE_HEIGHT, TILE_SIZE),
			Position = position + Vector3.new(0, TILE_HEIGHT / 2, 0),
			Color = spaceType.Color,
			Parent = folder,
		})
		self.Tiles[id] = tile
		tile:SetAttribute("SpaceId", id)
		tile:SetAttribute("SpaceType", space.Type)
		if spaceType.Short ~= "" then
			local gui = Instance.new("SurfaceGui")
			gui.Face = Enum.NormalId.Top
			gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			gui.PixelsPerStud = 25
			gui.Parent = tile
			local label = Instance.new("TextLabel")
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.Font = Enum.Font.FredokaOne
			label.TextScaled = true
			label.TextColor3 = Color3.new(1, 1, 1)
			label.TextStrokeTransparency = 0.4
			label.Text = spaceType.Short
			label.Parent = gui
		end

		-- Paths to the next spaces
		for _, nextId in space.Next do
			if board.Bridge and (id >= 33 or nextId >= 33) then continue end
			local target = worldAt(board.Spaces[nextId].At)
			local length = (target - position).Magnitude - TILE_SIZE
			if length > 0 then
				local middle = (position + target) / 2 + Vector3.new(0, 0.2, 0)
				part({
					Name = ("Path%d_%d"):format(id, nextId),
					Size = Vector3.new(2, 0.4, length),
					CFrame = CFrame.lookAt(middle, target + Vector3.new(0, 0.2, 0)),
					Color = Color3.fromRGB(245, 235, 210),
					Parent = folder,
				})
			end
		end
	end

	if board.Bridge then FestivalScene.build(self) end
	-- The collectible marker: a floating gold gem with a price tag.
	local marker = part({
		Name = "Collectible",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(3.5, 3.5, 3.5),
		Color = Color3.fromRGB(255, 205, 40),
		Material = Enum.Material.Neon,
		CanCollide = false,
		CanQuery = false,
		Parent = folder,
	})
	local tag = Instance.new("BillboardGui")
	tag.Size = UDim2.fromOffset(160, 40)
	tag.StudsOffset = Vector3.new(0, 3.5, 0)
	tag.AlwaysOnTop = true
	tag.Parent = marker
	local tagLabel = Instance.new("TextLabel")
	tagLabel.Size = UDim2.fromScale(1, 1)
	tagLabel.BackgroundTransparency = 1
	tagLabel.Font = Enum.Font.FredokaOne
	tagLabel.TextScaled = true
	tagLabel.TextColor3 = Color3.fromRGB(255, 225, 90)
	tagLabel.TextStrokeTransparency = 0
	tagLabel.Parent = tag
	self.Marker = marker
	self.MarkerLabel = tagLabel

	folder.Parent = Workspace
	return self
end

-- Where a piece stands on space `id`. Up to four share a tile, one per corner slot.
function BoardWorld:spaceCFrame(id: number, slot: number?, facingId: number?): CFrame
	local top = self.Tops[id] or self.Origin
	local position = top + SLOT_OFFSETS[((slot or 1) - 1) % #SLOT_OFFSETS + 1] + Vector3.new(0, ROOT_HEIGHT, 0)
	local facing = facingId and self.Tops[facingId]
	if facing and (facing - top).Magnitude > 0.1 then
		local look = Vector3.new(facing.X, position.Y, facing.Z) + (position - top - Vector3.new(0, ROOT_HEIGHT, 0))
		return CFrame.lookAt(position, look)
	end
	return CFrame.new(position)
end

-- True if a piece at `position` is clearly not standing on space `id` (knocked off, fell
-- through, flung away). Small wobbles inside the tile don't count.
function BoardWorld:isMisplaced(position: Vector3, id: number): boolean
	local top = self.Tops[id]
	if not top then
		return false
	end
	local flat = Vector3.new(position.X - top.X, 0, position.Z - top.Z)
	return flat.Magnitude > TILE_SIZE or position.Y < top.Y - 2 or position.Y > top.Y + 20
end

function BoardWorld:setCollectible(id: number?, label: string)
	self.MarkerId = id
	local top = id and self.Tops[id]
	self.Marker.Transparency = if top then 0 else 1
	self.MarkerLabel.Text = label
	if top then
		self.Marker.Position = top + Vector3.new(0, 7, 0)
	end
end

-- Shows each gate on its path: a red barrier when closed, a yellow toll post when open.
function BoardWorld:setGates(gates, openState)
	self.GateMarkers = self.GateMarkers or {}
	for _, gate in gates or {} do
		local path = self.Folder:FindFirstChild(("Path%d_%d"):format(gate.From, gate.To))
		if not path then
			continue
		end
		local marker = self.GateMarkers[gate.Id]
		if not marker then
			marker = part({
				Name = "Gate_" .. gate.Id,
				Size = Vector3.new(4, 3, 0.6),
				CFrame = path.CFrame * CFrame.new(0, 1.5, 0),
				CanCollide = false,
				CanQuery = false,
				Parent = self.Folder,
			})
			local gui = Instance.new("BillboardGui")
			gui.Size = UDim2.fromScale(6, 1.5) -- studs, so it shrinks with distance like the board
			gui.StudsOffset = Vector3.new(0, 3, 0)
			gui.Parent = marker
			local label = Instance.new("TextLabel")
			label.Name = "Label"
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.Font = Enum.Font.FredokaOne
			label.TextScaled = true
			label.TextColor3 = Color3.new(1, 1, 1)
			label.TextStrokeTransparency = 0
			label.Parent = gui
			self.GateMarkers[gate.Id] = marker
		end
		local open = openState[gate.Id]
		marker.Color = if open then Color3.fromRGB(255, 210, 60) else Color3.fromRGB(220, 50, 50)
		marker.Transparency = if open then 0.5 else 0
		marker:FindFirstChildWhichIsA("BillboardGui").Label.Text = if not open
			then "CLOSED"
			elseif (gate.Toll or 0) > 0 then ("TOLL %d"):format(gate.Toll)
			else "OPEN"
	end
end

-- Draws a small marker on every trapped space ({ [spaceId] = trap }).
function BoardWorld:setTraps(traps)
	self.TrapMarkers = self.TrapMarkers or {}
	for id, marker in self.TrapMarkers do
		if not traps[id] then
			marker:Destroy()
			self.TrapMarkers[id] = nil
		end
	end
	for id in traps do
		local top = self.Tops[id]
		if top and not self.TrapMarkers[id] then
			self.TrapMarkers[id] = part({
				Name = "Trap" .. id,
				Size = Vector3.new(3, 0.4, 3),
				Position = top + Vector3.new(0, 0.2, 0),
				Color = Color3.fromRGB(120, 40, 40),
				Material = Enum.Material.DiamondPlate,
				CanCollide = false,
				CanQuery = false,
				Parent = self.Folder,
			})
		end
	end
end

function BoardWorld:setBridgeAngle(angle)
 FestivalScene.align(self,angle)
 if self.MarkerId and self.MarkerId>=33 then self.Marker.Position=self.Tops[self.MarkerId]+Vector3.new(0,7,0) end
 for id,marker in self.TrapMarkers or {} do
  if id>=33 then marker.Position=self.Tops[id]+Vector3.new(0,0.2,0) end
 end
end
function BoardWorld:setBridgeState(state)
 if state then FestivalScene.status(self,state) end
end

function BoardWorld:setFestivalLighting(active)
 if not self.Board.Bridge then return end
 local lighting=game:GetService("Lighting")
 if active and not self.SavedLighting then
  self.SavedLighting={ClockTime=lighting.ClockTime,Ambient=lighting.Ambient,OutdoorAmbient=lighting.OutdoorAmbient,Brightness=lighting.Brightness}
  lighting.ClockTime=17.8;lighting.Ambient=Color3.fromRGB(145,130,180)
  lighting.OutdoorAmbient=Color3.fromRGB(155,150,190);lighting.Brightness=2
 elseif not active and self.SavedLighting then
  for key,value in self.SavedLighting do lighting[key]=value end
  self.SavedLighting=nil
 end
end

function BoardWorld:destroy()
 self:setFestivalLighting(false)
	self.Folder:Destroy()
end

return BoardWorld
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="14">
          <Properties>
            <string name="Name">Boards</string>
          </Properties>
          <Item class="ModuleScript" referent="15">
            <Properties>
              <string name="Name">Classic</string>
              <string name="Source"><![CDATA[--[[
	Classic board: a 26-space loop with one shortcut up the middle.

	Each space:
	  Id      unique number
	  Type    a key of Board/SpaceTypes
	  At      { x, z } grid cell; multiplied by Config.Board.SpaceSpacing
	  Next    ids you can move to from here (2+ = a fork, the mover picks)
	  Paths   optional labels for a fork's choices, same order as Next

	Start          where everyone begins
	CrownSpaces    where the collectible can appear (it moves after every purchase)
	Gates          fork edges that Switch spaces can shut, and/or that cost a toll

	Layout (x across, z up), clockwise from Start at the bottom-left:

	  22 21 20 19 18 17 16 15 14     top row (z = 5); the shortcut rejoins at 18
	  23          30          13
	  24          29          12
	  25          28          11
	  26          27          10
	   1  2  3  4  5  6  7  8  9     5 is a fork: main road (6) or shortcut (27)

	Signature mechanic: the Shortcut toll gate. It saves 8 spaces for 3 coins, but a Switch
	space (17) can close it for everyone, or open it again. Board item: the Gate Key flips
	the gate from anywhere.
]]

return {
	Name = "Classic", -- id: used by Config.Match.Boards and items' Boards lists
	DisplayName = "Sunny Loop", -- shown to players
	-- Beginner board: one loop, one toll shortcut, a single Switch, few Chaos spaces.
	Start = 1,
	CrownSpaces = { 7, 10, 13, 15, 20, 23, 26 },
	Gates = {
		{ Id = "Shortcut", From = 5, To = 27, Open = true, Toll = 3 },
	},
	Spaces = {
		-- bottom row, left to right
		{ Id = 1, Type = "Neutral", At = { 0, 0 }, Next = { 2 } },
		{ Id = 2, Type = "Gain", At = { 1, 0 }, Next = { 3 } },
		{ Id = 3, Type = "Gain", At = { 2, 0 }, Next = { 4 } },
		{ Id = 4, Type = "Item", At = { 3, 0 }, Next = { 5 } },
		{ Id = 5, Type = "Neutral", At = { 4, 0 }, Next = { 6, 27 }, Paths = { "Main road", "Shortcut (toll)" } },
		{ Id = 6, Type = "Lose", At = { 5, 0 }, Next = { 7 } },
		{ Id = 7, Type = "Gain", At = { 6, 0 }, Next = { 8 } },
		{ Id = 8, Type = "Reward", At = { 7, 0 }, Next = { 9 } },
		{ Id = 9, Type = "Gain", At = { 8, 0 }, Next = { 10 } },
		-- right column, upwards
		{ Id = 10, Type = "Gain", At = { 8, 1 }, Next = { 11 } },
		{ Id = 11, Type = "Event", At = { 8, 2 }, Next = { 12 } },
		{ Id = 12, Type = "Shop", At = { 8, 3 }, Next = { 13 } },
		{ Id = 13, Type = "Gain", At = { 8, 4 }, Next = { 14 } },
		-- top row, right to left
		{ Id = 14, Type = "Duel", At = { 8, 5 }, Next = { 15 } },
		{ Id = 15, Type = "Gain", At = { 7, 5 }, Next = { 16 } },
		{ Id = 16, Type = "Lose", At = { 6, 5 }, Next = { 17 } },
		{ Id = 17, Type = "Switch", At = { 5, 5 }, Next = { 18 } },
		{ Id = 18, Type = "Neutral", At = { 4, 5 }, Next = { 19 } },
		{ Id = 19, Type = "Reward", At = { 3, 5 }, Next = { 20 } },
		{ Id = 20, Type = "Gain", At = { 2, 5 }, Next = { 21 } },
		{ Id = 21, Type = "Lose", At = { 1, 5 }, Next = { 22 } },
		{ Id = 22, Type = "Chaos", At = { 0, 5 }, Next = { 23 } },
		-- left column, downwards
		{ Id = 23, Type = "Gain", At = { 0, 4 }, Next = { 24 } },
		{ Id = 24, Type = "Shop", At = { 0, 3 }, Next = { 25 } },
		{ Id = 25, Type = "Lose", At = { 0, 2 }, Next = { 26 } },
		{ Id = 26, Type = "Gain", At = { 0, 1 }, Next = { 1 } },
		-- shortcut up the middle: quicker, but riskier
		{ Id = 27, Type = "Lose", At = { 4, 1 }, Next = { 28 } },
		{ Id = 28, Type = "Event", At = { 4, 2 }, Next = { 29 } },
		{ Id = 29, Type = "Chaos", At = { 4, 3 }, Next = { 30 } },
		{ Id = 30, Type = "Reward", At = { 4, 4 }, Next = { 18 } },
	},
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="16">
            <Properties>
              <string name="Name">MagicalFestival</string>
              <string name="Source"><![CDATA[-- Four eight-space loops and four spaces on ONE straight rotating bridge.
local spaces = {}
local zones = { "Moonflower Plaza", "Crystal-Flower Garden", "Moon-Tree Grove", "Lantern Fair" }
local points = { {0,2.8}, {1.25,3.25}, {1.7,4.5}, {1.25,5.75}, {0,6.2}, {-1.25,5.75}, {-1.7,4.5}, {-1.25,3.25} }
local kinds = {
 {"Neutral","Gain","Item","Gain","Switch","Reward","Lose","Shop"},
 {"Neutral","Gain","Reward","Gain","Event","Item","Lose","Shop"},
 {"Neutral","Gain","Chaos","Gain","Event","Reward","Item","Shop"},
 {"Neutral","Gain","Duel","Gain","Lose","Reward","Item","Shop"},
}
for zone = 1, 4 do
 for i, at in points do
  local x,z = at[1],at[2]
  for _ = 2, zone do x,z = z,-x end
  local id = (zone-1)*8+i
  local nextIds = { (zone-1)*8+i%8+1 }
  local paths = nil
  if i == 1 then
   table.insert(nextIds, if zone <= 2 then 33 else 36)
   paths = { "Local loop", "Moon bridge" }
  end
  table.insert(spaces, { Id=id, Type=kinds[zone][i], At={x,z}, Next=nextIds, Paths=paths, Zone=zone })
 end
end
for i = 1,4 do
 local nextIds = {}
 if i > 1 then table.insert(nextIds,32+i-1) end
 if i < 4 then table.insert(nextIds,32+i+1) end
 if i == 1 then table.insert(nextIds,1); table.insert(nextIds,9) end
 if i == 4 then table.insert(nextIds,17); table.insert(nextIds,25) end
 table.insert(spaces,{Id=32+i,Type=if i==2 then "Reward" elseif i==3 then "Gain" else "Neutral",At={0,2.25-(i-1)*1.5},Next=nextIds,Zone=0})
end
return {
 Name="MagicalFestival", DisplayName="Magical Festival Island", Start=17,
 CrownSpaces={4,12,20,28,34,35}, Spaces=spaces, Zones=zones,
 Bridge={ EveryRounds=1, WarningSeconds=2, RotationSeconds=1.5, DialCooldownRounds=2,
  -- Crown relocation when a rotation strands it (Match:chooseCrownSpace).
  CrownMemory=2, CrownLeaderBuffer=4 },
}
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">BotBrain</string>
            <string name="Source"><![CDATA[--[[
	BotBrain
	How bots play the board. Pure functions of what any player could see on screen (board,
	coins, Crown position, standings, round): bots never peek at upcoming dice or rewards.

	Difficulty profiles live in Config.Match.BotBehavior:
	  RandomChoice   chance a decision is made at random (Easy bots blunder a lot)
	  ItemUseChance  chance a bot actually uses an item it has a good reason to use
	  SaveFactor     share of the Crown price kept back before shopping
	  LookAhead      spaces scored down each fork branch (0 = pick at random)
	  CosmeticSpend  coins to spare before buying a cosmetic (they don't help win)

	Space and item values below are the tuning knobs for the "thinking" part.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.PartyShared.Config)
local Bridge = require(script.Parent.RotatingBridge)

local BotBrain = {}

-- How much a bot likes landing on / passing each space type (scaled down with distance).
BotBrain.SpaceValue = {
	Gain = 3,
	Lose = -3,
	Event = 0.5,
	Reward = 3,
	Shop = 1,
	Neutral = 0,
	Item = 2,
	Duel = 0.5,
	Chaos = -2,
	Switch = 0.5,
}
-- How much a bot wants each item in a shop.
BotBrain.ItemValue = {
	DoubleDice = 3,
	TripleDice = 4,
	CoinShield = 2,
	SwapTicket = 3,
	WarpToken = 2,
	LuckyDie = 3,
	Pickpocket = 2,
	CrownHeist = 4,
	Snare = 1,
	GateKey = 2,
	MoonDial = 4,
}
-- Items an opponent could hurt you with; a bot that sees one in an opponent's (public)
-- inventory values its own Coin Shield more.
BotBrain.Threats = { Pickpocket = true, CrownHeist = true }
local AVERAGE_ROLL = (Config.Board.DieSides + 1) / 2

function BotBrain.profile(difficulty: string?)
	return Config.Match.BotBehavior[difficulty or ""] or Config.Match.BotBehavior.Normal
end

local function isLastRound(match): boolean
	return match.Round >= match.Rounds
end

local function crownDistance(match, spaceId: number): number
	return match:distance(spaceId, match.CollectibleSpace)
end

-- True if this seat has fewer collectibles than the leader.
local function isBehind(match, seat): boolean
	local mine = match:collectiblesOf(seat)
	for _, other in match.Seats do
		if match:collectiblesOf(other) > mine then
			return true
		end
	end
	return false
end

-- Paths -----------------------------------------------------------------------------------------

-- Score of heading down the branch that starts at `startId`.
function BotBrain.branchScore(match, seat, startId: number, profile): number
	local score = 0
	local id = startId
	for step = 0, profile.LookAhead - 1 do
		local space = match.Board:get(id)
		score += (BotBrain.SpaceValue[space.Type] or 0) * 0.85 ^ step
		id = match:nextOptions(id)[1]
	end
	-- The Crown matters most when you can (nearly) pay for it.
	local coins, price = match:coinsOf(seat), match:collectiblePriceFor(seat)
	local weight = if coins >= price then 4 elseif coins >= price - 6 then 1.5 else 0.3
	local distance = math.min(crownDistance(match, startId), 20)
	return score + weight * (20 - distance) * 0.5
end

function BotBrain.choosePath(match, seat, spaces, profile, info): number
	if profile.LookAhead <= 0 then
		return match.Rng:NextInteger(1, #spaces)
	end
	local best, bestScore = 1, -math.huge
	for i, id in spaces do
		local toll = info and info[i] and info[i].Toll or 0
		local score = BotBrain.branchScore(match, seat, id, profile) - toll * 0.5
		if score > bestScore then
			best, bestScore = i, score
		end
	end
	return best
end

-- Shop ------------------------------------------------------------------------------------------

-- Coins a bot keeps back for the Crown before buying anything.
function BotBrain.reserve(match, seat, profile): number
	local reserve = match:collectiblePriceFor(seat) * profile.SaveFactor
	if isLastRound(match) and crownDistance(match, seat.SpaceId) > 2 * AVERAGE_ROLL + 2 then
		reserve = 0 -- can't reach the Crown again anyway: spend
	end
	return reserve
end

function BotBrain.chooseShop(match, seat, offers, default: number, profile): number
	local coins = match:coinsOf(seat)
	local reserve = BotBrain.reserve(match, seat, profile)
	local best, bestValue = default, 0
	for i, offer in offers do
		local left = coins - offer.Price
		local value
		if offer.Kind == "Item" then
			value = if left >= reserve and #seat.Items < Config.Items.MaxHeld then BotBrain.ItemValue[offer.Id] or 1 else 0
		else
			value = if left >= reserve + profile.CosmeticSpend then 0.5 else 0
		end
		if value > bestValue then
			best, bestValue = i, value
		end
	end
	return best
end

-- Items -----------------------------------------------------------------------------------------

-- The opponent nearest the Crown (the best seat to swap into), and how many moves closer it is.
function BotBrain.bestSwap(match, seat)
	local own = crownDistance(match, seat.SpaceId)
	local target, targetDistance = nil, math.huge
	for _, other in match:opponentsOf(seat) do
		local distance = crownDistance(match, other.SpaceId)
		if distance < targetDistance then
			target, targetDistance = other, distance
		end
	end
	return target, own - targetDistance
end

-- Is any opponent holding an item that could steal from this seat?
function BotBrain.threatened(match, seat): boolean
	for _, other in match:opponentsOf(seat) do
		for _, id in other.Items do
			if BotBrain.Threats[id] then
				return true
			end
		end
	end
	return false
end

-- The opponent worth robbing: most of `stat` ("Coins" or "Collectibles"), not shielded.
function BotBrain.bestVictim(match, seat, stat: string)
	local best, bestValue = nil, 0
	for _, other in match:opponentsOf(seat) do
		local value = if stat == "Coins" then match:coinsOf(other) else match:collectiblesOf(other)
		if not other.Shield and value > bestValue then
			best, bestValue = other, value
		end
	end
	return best, bestValue
end

-- The die face that lands on the most useful space straight ahead (ignores forks).
function BotBrain.bestFace(match, seat): (number, number)
	local bestFace, bestValue = 1, -math.huge
	local id = seat.SpaceId
	for face = 1, Config.Board.DieSides do
		id = match:nextOptions(id)[1]
		local value = BotBrain.SpaceValue[match.Board:get(id).Type] or 0
		if value > bestValue then
			bestFace, bestValue = face, value
		end
	end
	return bestFace, bestValue
end

--[[
	How much a bot wants to use item `id` right now (> 0 = worth using), plus the target seat
	and die-face choice where the item needs them. To teach bots a new item, add a branch here.
]]
function BotBrain.itemScore(match, seat, id: string)
	local coins, price = match:coinsOf(seat), match:collectiblePriceFor(seat)
	local canBuy = coins >= price
	local distance = crownDistance(match, seat.SpaceId)
	local late = isLastRound(match)
	local urgency = if isBehind(match, seat) then 1.3 else 1

	if id == "MoonDial" then
  if not match:canUseMoonDial() then return 0 end
  local nextOrientation=1-match.Orientation
  local crown=match.CollectibleSpace
  local zone=match.Board:get(crown).Zone
  local after
  if zone~=0 and not Bridge.connected(zone,nextOrientation) then
   -- The Crown would move to one of the newly reachable zone spaces; a bot can't know which,
   -- so it plans on the average distance to them (or the bridge fallback).
   local candidates=match:crownCandidates(nextOrientation)
   if #candidates==0 then candidates={34} end
   local total=0
   for _,id in candidates do total+=math.min(match:distanceAt(seat.SpaceId,id,nextOrientation),40) end
   after=total/#candidates
  else
   after=match:distanceAt(seat.SpaceId,crown,nextOrientation)
  end
  local before=math.min(distance,40)
  local score=if canBuy and after+3<before then (before-after)*0.3 else 0
  for _,other in match:opponentsOf(seat) do
   if match:collectiblesOf(other)>match:collectiblesOf(seat) and match:coinsOf(other)>=price
    and crownDistance(match,other.SpaceId)<=6 and match:distanceAt(other.SpaceId,crown,nextOrientation)>12 then score+=2 end
  end
  -- Saving the item is preferable when the next automatic rotation already opens
  -- our zone and we cannot reach its dock on this roll.
  local dock=(math.max(1,match.Board:get(seat.SpaceId).Zone)-1)*8+1
  if distance==math.huge and match:distance(seat.SpaceId,dock)>Config.Board.DieSides then score=0 end
  return score
 elseif id == "DoubleDice" or id == "TripleDice" then
		local dice = if id == "TripleDice" then 3 else 2
		if canBuy and distance > Config.Board.DieSides and distance <= Config.Board.DieSides * dice then
			return (3 + dice) * urgency
		end
		return if late then 1 else 0 -- use it up before the match ends
	elseif id == "CoinShield" then
		if seat.Shield then
			return 0
		end
		if BotBrain.threatened(match, seat) and (coins >= 6 or match:collectiblesOf(seat) > 0) then
			return 5 -- someone is holding a steal: block it first
		end
		return if coins >= 6 then 2 elseif late and coins > 0 then 1 else 0
	elseif id == "LuckyDie" then
		if canBuy and distance >= 1 and distance <= Config.Board.DieSides then
			return 7, nil, distance -- land exactly on the Crown
		end
		local face, value = BotBrain.bestFace(match, seat)
		return (if value >= 3 then 1 elseif late then 0.5 else 0), nil, face
	elseif id == "Pickpocket" then
		local victim, theirCoins = BotBrain.bestVictim(match, seat, "Coins")
		if victim and theirCoins >= 3 then
			return math.min(theirCoins, 6) / 2 * urgency, victim
		end
		return 0
	elseif id == "CrownHeist" then
		local victim, crowns = BotBrain.bestVictim(match, seat, "Collectibles")
		if victim and crowns >= 1 and coins >= 15 then
			return 8 * urgency, victim
		end
		return 0
	elseif id == "Snare" then
		return if match.Traps[seat.SpaceId] then 0 else 1
	elseif id == "GateKey" then
		-- Same reasoning as a Switch space: flip only if it brings the Crown closer.
		local now = distance
		match:toggleGates()
		local flipped = crownDistance(match, seat.SpaceId)
		match:toggleGates()
		return if flipped + 3 <= now then 3 * urgency else 0
	elseif id == "SwapTicket" then
		local target, gain = BotBrain.bestSwap(match, seat)
		if target and gain >= 6 and coins >= price - 5 then
			return 4 * urgency, target
		end
		return (if late and target and gain > 0 then 0.5 else 0), target
	elseif id == "WarpToken" then
		if distance >= 14 then
			return 2 * urgency
		end
		return if late then 0.5 else 0
	end
	return 0
end

-- Returns slot, target (seat or nil) and choice (die face or nil) of the item to use, or nil.
function BotBrain.chooseItem(match, seat, profile)
	if #seat.Items == 0 then
		return nil
	end
	local rng = match.Rng
	if rng:NextNumber() < profile.RandomChoice then
		if rng:NextNumber() < 0.5 then
			return nil
		end
		local slot = rng:NextInteger(1, #seat.Items)
		local opponents = match:opponentsOf(seat)
		return slot, opponents[rng:NextInteger(1, #opponents)], rng:NextInteger(1, Config.Board.DieSides)
	end
	local bestSlot, bestScore, bestTarget, bestChoice = nil, 0, nil, nil
	for slot, id in seat.Items do
		local score, target, choice = BotBrain.itemScore(match, seat, id)
		if score > bestScore then
			bestSlot, bestScore, bestTarget, bestChoice = slot, score, target, choice
		end
	end
	if bestSlot and rng:NextNumber() < profile.ItemUseChance then
		return bestSlot, bestTarget, bestChoice
	end
	return nil
end

-- Switch space ------------------------------------------------------------------------------------

-- Flip the gates if that brings the Crown closer; pay to move the Crown if an opponent is about
-- to reach it and this bot can't; otherwise leave the board alone.
function BotBrain.chooseSwitch(match, seat, actions, _profile): number
	local leave = table.find(actions, "None") or #actions
	local gatesIndex = table.find(actions, "Gates")
	if gatesIndex then
		local now = crownDistance(match, seat.SpaceId)
		match:toggleGates()
		local flipped = crownDistance(match, seat.SpaceId)
		match:toggleGates() -- put them back: this was only a look
		if flipped + 3 <= now then
			return gatesIndex
		end
	end
	local crownIndex = table.find(actions, "Crown")
	if crownIndex then
		local mine = crownDistance(match, seat.SpaceId)
		for _, other in match:opponentsOf(seat) do
			if crownDistance(match, other.SpaceId) <= 4 and match:coinsOf(other) >= match.CollectiblePrice and mine > 6 then
				return crownIndex
			end
		end
	end
	return leave
end

-- Ask requests ----------------------------------------------------------------------------------

function BotBrain.decide(match, seat, request, profile, _skill: number): number
	local count = #request.Options
	if count > 1 and match.Rng:NextNumber() < profile.RandomChoice then
		return match.Rng:NextInteger(1, count)
	end
	if request.Kind == "Collectible" then
		return 1 -- always buy: it's what wins
	elseif request.Kind == "Path" and request.Data and request.Data.Spaces then
		return BotBrain.choosePath(match, seat, request.Data.Spaces, profile, request.Data.Info)
	elseif request.Kind == "Shop" and request.Data and request.Data.Items then
		return BotBrain.chooseShop(match, seat, request.Data.Items, request.Default, profile)
	elseif request.Kind == "Target" and request.Data and request.Data.Seats then
		local target = BotBrain.bestSwap(match, seat)
		return table.find(request.Data.Seats, target) or 1
	elseif request.Kind == "DieFace" then
		return (BotBrain.bestFace(match, seat))
	elseif request.Kind == "DuelTarget" and request.Data and request.Data.Seats then
		-- Challenge whoever is ahead (or richest): a win there helps the most.
		local best, bestScore = 1, -math.huge
		for i, other in request.Data.Seats do
			local score = match:collectiblesOf(other) * 100 + match:coinsOf(other)
			if score > bestScore then
				best, bestScore = i, score
			end
		end
		return best
	elseif request.Kind == "DuelStake" and request.Data and request.Data.Stakes then
		-- A die duel is a coin flip: bots that are behind gamble big, leaders play it safe.
		return if isBehind(match, seat) then #request.Data.Stakes else 1
	elseif request.Kind == "Switch" and request.Data and request.Data.Actions then
		return BotBrain.chooseSwitch(match, seat, request.Data.Actions, profile)
	end
	return request.Default or 1
end

return BotBrain
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">ChaosEvents</string>
            <string name="Source"><![CDATA[--[[
	ChaosEvents
	What can happen on a Chaos space: mostly harmful or disruptive, occasionally lucky.
	Same shape as Events: { Id, Name, Weight, Apply(match, seat, rng) -> feed text }.

	Losses are capped (Config.Economy.ChaosLossCap) and a Coin Shield blocks a coin loss, so
	one bad landing can hurt but can't wipe anyone out.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.PartyShared.Config)

return {
	{
		Id = "Thunderclap",
		Name = "Thunderclap",
		Weight = 3,
		Apply = function(match, seat)
			local loss = math.min(math.ceil(match:coinsOf(seat) / 2), Config.Economy.ChaosLossCap)
			local delta, shielded = match:changeCoins(seat, -loss)
			if shielded then
				return ("%s's Coin Shield took the hit and broke"):format(seat.Participant.Name)
			end
			return ("%s lost %d coins"):format(seat.Participant.Name, -delta)
		end,
	},
	{
		Id = "TaxDay",
		Name = "Tax Day",
		Weight = 2,
		Apply = function(match)
			for _, each in match.Seats do
				match:changeCoins(each, -3)
			end
			return "Everyone pays 3 coins (shields block it)"
		end,
	},
	{
		Id = "Shuffle",
		Name = "Shuffle",
		Weight = 2,
		Apply = function(match, _seat, rng)
			local spaces = {}
			for _, each in match.Seats do
				table.insert(spaces, each.SpaceId)
			end
			for i = #spaces, 2, -1 do
				local j = rng:NextInteger(1, i)
				spaces[i], spaces[j] = spaces[j], spaces[i]
			end
			for i, each in match.Seats do
				each.SpaceId = spaces[i]
			end
			return "Everyone's pieces were shuffled around the board"
		end,
	},
	{
		Id = "BagSwap",
		Name = "Bag Swap",
		Weight = 1,
		Apply = function(match, seat, rng)
			local others = match:opponentsOf(seat)
			local other = others[rng:NextInteger(1, #others)]
			seat.Items, other.Items = other.Items, seat.Items
			return ("%s and %s swapped item bags"):format(seat.Participant.Name, other.Participant.Name)
		end,
	},
	{
		Id = "PriceSurge",
		Name = "Price Surge",
		Weight = 1,
		Apply = function(match)
			local cap = Config.Collectible.Price + Config.Economy.PriceSurgeCap
			match.CollectiblePrice = math.min(match.CollectiblePrice + 5, cap)
			return ("The %s now costs %d coins (until someone buys it)"):format(match.CollectibleName, match.CollectiblePrice)
		end,
	},
	{
		Id = "LuckyBreak",
		Name = "Lucky Break",
		Weight = 1,
		Apply = function(match, seat)
			local delta = match:changeCoins(seat, 8)
			return ("Chaos smiles on %s: +%d coins"):format(seat.Participant.Name, delta)
		end,
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Events</string>
            <string name="Source"><![CDATA[--[[
	Events
	What can happen on an Event space. One is picked at random by Weight.

	Each event:
	  Id       unique
	  Name     headline shown to everyone
	  Weight   relative chance
	  Apply    function(match, seat, rng) -> string   does the thing, returns the feed line

	Board pieces that change space here are moved in the world by BoardGame afterwards.
	To add an event: append an entry. Keep the numbers here so they're easy to tune.
]]

local function others(match, seat)
	local list = {}
	for _, other in match.Seats do
		if other ~= seat then
			table.insert(list, other)
		end
	end
	return list
end

return {
	{
		Id = "LuckyFind",
		Name = "Lucky Find",
		Weight = 3,
		Apply = function(match, seat)
			local delta = match:changeCoins(seat, 5)
			return ("%s found %d coins on the ground"):format(seat.Participant.Name, delta)
		end,
	},
	{
		Id = "PartyBus",
		Name = "Party Bus",
		Weight = 2,
		Apply = function(match)
			for _, each in match.Seats do
				match:changeCoins(each, 2)
			end
			return "Everyone gets 2 coins"
		end,
	},
	{
		Id = "LeakyPocket",
		Name = "Leaky Pocket",
		Weight = 2,
		Apply = function(match, seat)
			local delta, shielded = match:changeCoins(seat, -5)
			if shielded then
				return ("%s's Coin Shield saved their coins and broke"):format(seat.Participant.Name)
			end
			return ("%s dropped %d coins"):format(seat.Participant.Name, -delta)
		end,
	},
	{
		Id = "SwapSpots",
		Name = "Swap Spots",
		Weight = 2,
		Apply = function(match, seat, rng)
			local candidates = others(match, seat)
			local other = candidates[rng:NextInteger(1, #candidates)]
			seat.SpaceId, other.SpaceId = other.SpaceId, seat.SpaceId
			return ("%s swapped places with %s"):format(seat.Participant.Name, other.Participant.Name)
		end,
	},
	{
		Id = "HelpingHand",
		Name = "Helping Hand",
		Weight = 1,
		Apply = function(match)
			local richest, poorest = match.Seats[1], match.Seats[1]
			for _, each in match.Seats do
				if match:coinsOf(each) > match:coinsOf(richest) then
					richest = each
				end
				if match:coinsOf(each) < match:coinsOf(poorest) then
					poorest = each
				end
			end
			if richest == poorest or match:coinsOf(richest) == match:coinsOf(poorest) then
				return "Everyone has the same coins, so nothing happens"
			end
			local taken, shielded = match:changeCoins(richest, -5)
			if shielded then
				return ("%s's Coin Shield kept their coins and broke"):format(richest.Participant.Name)
			end
			local given = -taken
			match:changeCoins(poorest, given)
			return ("%s gives %d coins to %s"):format(richest.Participant.Name, given, poorest.Participant.Name)
		end,
	},
	{
		Id = "CollectibleMoves",
		Name = "On the Move",
		Weight = 1,
		Apply = function(match)
			match:relocateCollectible()
			return ("The %s moved to a new space!"):format(match.CollectibleName)
		end,
	},
	{
		Id = "ItemDrop",
		Name = "Item Drop",
		Weight = 2,
		Apply = function(match, seat)
			local item = match:giveRandomItem(seat)
			if not item then
				return ("%s's bag is full, so the item rolls away"):format(seat.Participant.Name)
			end
			return ("%s picked up a %s"):format(seat.Participant.Name, item.Name)
		end,
	},
	{
		Id = "Warp",
		Name = "Warp",
		Weight = 1,
		Apply = function(match, seat, rng)
			local order = match.Board.Order
			seat.SpaceId = order[rng:NextInteger(1, #order)]
			return ("%s warped across the board"):format(seat.Participant.Name)
		end,
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">FestivalScene</string>
            <string name="Source"><![CDATA[-- Editable procedural blockout: shared lamps, rocks, crystals and seven landmark groups.
-- No external assets, unions, textures, or per-frame effects. All decoration is noncolliding.
local Scene={}
local gold=Color3.fromRGB(241,180,67)
local stone=Color3.fromRGB(156,133,185)
local cyan=Color3.fromRGB(95,221,255)
local pink=Color3.fromRGB(220,120,255)
local function part(parent,name,size,cf,color,material,collide,shape)
 local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=cf;p.Color=color
 p.Material=material or Enum.Material.SmoothPlastic;p.Anchored=true;p.CanCollide=collide==true
 p.CanTouch=false;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth
 if shape then p.Shape=shape end
 p.Parent=parent;return p
end
local function cylinder(parent,name,radius,height,cf,color,collide)
 return part(parent,name,Vector3.new(height,radius*2,radius*2),cf*CFrame.Angles(0,0,math.pi/2),color,nil,collide,Enum.PartType.Cylinder)
end
local function group(parent,name) local m=Instance.new("Model");m.Name=name;m.Parent=parent;return m end
local function lamp(parent,at)
 part(parent,"LanternPost",Vector3.new(0.7,6,0.7),CFrame.new(at+Vector3.new(0,3,0)),gold)
 part(parent,"Lantern",Vector3.new(2,2.8,2),CFrame.new(at+Vector3.new(0,6.5,0)),Color3.fromRGB(255,204,85),Enum.Material.Neon)
end
local function crystal(parent,at,color,scale)
 local p=part(parent,"Crystal",Vector3.new(2,6,2)*scale,CFrame.new(at+Vector3.new(0,3*scale,0))*CFrame.Angles(0,0,0.2),color,Enum.Material.Neon)
 return p
end
function Scene.build(world)
 local origin=world.Origin
 local folder=world.Folder
 local centers={Vector3.new(0,0,-54),Vector3.new(54,0,0),Vector3.new(0,0,54),Vector3.new(-54,0,0)}
 for zone,offset in centers do
  local island=group(folder,world.Board.Zones[zone])
  local c=origin+offset
  cylinder(island,"Island",25,4,CFrame.new(c-Vector3.new(0,2,0)),stone,true)
  cylinder(island,"Garden",23,0.5,CFrame.new(c+Vector3.new(0,0.1,0)),Color3.fromRGB(97,151,147),false)
  for i=1,8 do
   local a=i*math.pi/4
   local rim=c+Vector3.new(math.cos(a)*22,-5,math.sin(a)*22)
   part(island,"FloatingRock",Vector3.new(9,12+(i%3)*3,9),CFrame.new(rim)*CFrame.Angles(0,a,0.15),stone)
   if i%2==0 then lamp(island,rim+Vector3.new(0,6,0)) end
   crystal(island,rim+Vector3.new(0,7,0),if i%2==0 then cyan else pink,0.4)
  end
 end
 local plaza=group(folder,"MoonflowerFountain")
 local c=origin+centers[1]
 cylinder(plaza,"Basin",8,2,CFrame.new(c+Vector3.new(0,2,0)),gold)
 cylinder(plaza,"Water",7,0.3,CFrame.new(c+Vector3.new(0,3.2,0)),cyan)
 for i=1,6 do
  local angle=i*math.pi/3
  part(plaza,"Petal",Vector3.new(4,2,7),CFrame.new(c+Vector3.new(math.cos(angle)*3,6,math.sin(angle)*3))*CFrame.Angles(0,-angle,0.5),pink,Enum.Material.Neon,false,Enum.PartType.Ball)
 end
 crystal(plaza,c+Vector3.new(0,5,0),gold,0.8)
 local pavilion=group(folder,"CrystalPavilion");c=origin+centers[2]
 for _,x in {-5,5} do for _,z in {-5,5} do part(pavilion,"Pillar",Vector3.new(1.3,10,1.3),CFrame.new(c+Vector3.new(x,5,z)),gold) end end
 part(pavilion,"Canopy",Vector3.new(14,3,14),CFrame.new(c+Vector3.new(0,11,0)),stone)
 crystal(pavilion,c+Vector3.new(0,12,0),cyan,0.8)
 for _,x in {-7,0,7} do crystal(pavilion,c+Vector3.new(x,1,0),if x==0 then pink else cyan,0.7) end
 local tree=group(folder,"MoonTree");c=origin+centers[3]
 part(tree,"Trunk",Vector3.new(5,11,5),CFrame.new(c+Vector3.new(0,5,0)),Color3.fromRGB(115,80,120))
 for _,x in {-5,0,5} do
  part(tree,"Canopy",Vector3.new(13,7,12),CFrame.new(c+Vector3.new(x,12-math.abs(x)*0.3,0)),Color3.fromRGB(89,129,235),nil,false,Enum.PartType.Ball)
  lamp(tree,c+Vector3.new(x,4,1))
 end
 for _,x in {-10,10} do
  local gate=group(folder,"ShrineGate")
  for _,z in {-3,3} do part(gate,"Post",Vector3.new(1.2,7,1.2),CFrame.new(c+Vector3.new(x,3.5,z)),gold) end
  part(gate,"Lintel",Vector3.new(2,1.5,10),CFrame.new(c+Vector3.new(x,7,0)),Color3.fromRGB(175,78,131))
 end
 local wheel=group(folder,"LanternWheel");c=origin+centers[4]+Vector3.new(0,10,-3)
 for i=1,8 do
  local a=i*math.pi/4
  local p=c+Vector3.new(math.cos(a)*8,math.sin(a)*8,0)
  part(wheel,"Spoke",Vector3.new(0.5,8,0.5),CFrame.new((p+c)/2)*CFrame.Angles(0,0,a-math.pi/2),gold)
  part(wheel,"WheelLantern",Vector3.new(2,2,2),CFrame.new(p),gold,Enum.Material.Neon)
 end
 part(wheel,"Support",Vector3.new(2,11,2),CFrame.new(c-Vector3.new(0,5,0)),stone)
 for _,x in {-9,9} do
  local tent=group(folder,"FestivalTent")
  local t=origin+centers[4]+Vector3.new(x,0,6)
  part(tent,"Counter",Vector3.new(6,3,4),CFrame.new(t+Vector3.new(0,1.5,0)),gold)
  part(tent,"Roof",Vector3.new(8,2,7),CFrame.new(t+Vector3.new(0,6,0)),pink)
  for _,dx in {-3,3} do part(tent,"Pole",Vector3.new(0.5,6,0.5),CFrame.new(t+Vector3.new(dx,3,0)),gold) end
 end
 -- Decorative circular mechanism has NO walkable surface outside the straight deck.
 cylinder(folder,"MoonMechanism",27,2,CFrame.new(origin-Vector3.new(0,2,0)),stone,false)
 local moving=group(folder,"RotatingMoonBridge")
 moving.WorldPivot=CFrame.new(origin)
 part(moving,"SingleStraightDeck",Vector3.new(10,1,63),CFrame.new(origin),Color3.fromRGB(233,215,198),nil,true)
 for _,x in {-5.5,5.5} do
  part(moving,"Rail",Vector3.new(0.6,2,61),CFrame.new(origin+Vector3.new(x,1,0)),gold)
 end
 world.Moving=moving
 world.MovingLocal={}
 for id=33,36 do
  world.Tiles[id].Parent=moving
  world.MovingLocal[id]=world.Tops[id]-origin
 end
 world.DockLabels={}
 world.DockBarriers={}
 for zone,id in {1,9,17,25} do
  local at=world.Tops[id]
  local sign=part(folder,"DockStatus"..zone,Vector3.new(1,1,1),CFrame.new(at+Vector3.new(0,5,0)),gold)
  sign.Transparency=1
  local gui=Instance.new("BillboardGui");gui.Size=UDim2.fromOffset(135,30);gui.AlwaysOnTop=true;gui.Parent=sign
  local label=Instance.new("TextLabel");label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=0.3
  label.BackgroundColor3=stone;label.TextColor3=Color3.new(1,1,1);label.TextScaled=true;label.Font=Enum.Font.FredokaOne;label.Parent=gui
  world.DockLabels[zone]=label
  local inward=(origin-at)*Vector3.new(1,0,1)
  inward=inward.Unit
  local position=at+inward*4.7+Vector3.new(0,1,0)
  world.DockBarriers[zone]=part(folder,"ClosedDockBarrier"..zone,Vector3.new(9,2,0.7),CFrame.lookAt(position,position+inward),Color3.fromRGB(255,105,120),Enum.Material.Neon,true)
  local surface=Instance.new("SurfaceGui");surface.Face=Enum.NormalId.Top;surface.Parent=world.Tiles[id]
  local status=Instance.new("TextLabel");status.Name="ExitStatus";status.Size=UDim2.fromScale(1,1);status.BackgroundTransparency=1
  status.TextScaled=true;status.Font=Enum.Font.FredokaOne;status.TextColor3=Color3.new(1,1,1);status.Parent=surface
 end
 Scene.align(world,0)
end
function Scene.align(world,angle)
 world.Moving:PivotTo(CFrame.new(world.Origin)*CFrame.Angles(0,angle,0))
 for id,offset in world.MovingLocal do world.Tops[id]=(CFrame.new(world.Origin)*CFrame.Angles(0,angle,0)):PointToWorldSpace(offset) end
end
function Scene.status(world,state)
 for zone,label in world.DockLabels do
  local open=state.Docks[zone].Open
  label.Text=if open then "BRIDGE OPEN" else "CLOSED · LOOP"
  local barrier=world.DockBarriers[zone]
  barrier.Transparency=if open then 1 else 0
  barrier.CanCollide=not open
  world.Tiles[({1,9,17,25})[zone]].SurfaceGui.ExitStatus.Text=if open then "OPEN" else "CLOSED"
  label.TextColor3=if open then Color3.fromRGB(110,255,180) else Color3.fromRGB(255,170,130)
 end
end
return Scene
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Items</string>
            <string name="Source"><![CDATA[--[[
	Items
	Board items. A seat holds up to Config.Items.MaxHeld and may use one per turn, before
	rolling. Match:useItem checks ownership, timing and the target, then calls Use.

	Each item:
	  Id           unique, never rename
	  Name         shown to players
	  Description  one line for the item buttons / shop
	  Price        coins at a shop
	  Weight       relative chance in gifts, events and shop offers
	  Dice         optional: roll this many dice this turn instead of one
	  Target       optional: "Opponent" = the user picks another seat
	  Choice       optional: "DieFace" = the user picks a number 1..DieSides
	  Boards       optional: list of board names this item appears on (board-specific items)
	  Use          function(match, seat, target, choice) -> feed text, or nil + reason to refuse
	               (a refusal keeps the item in the user's inventory)

	Counterplay: a Coin Shield blocks the next coin loss, coin steal, trap or Crown Heist.

	To add an item: append an entry here. Teach bots when to use it in BotBrain.itemScore.
]]

return {
 { Id="MoonDial", Name="Moon Dial", Description="Rotate the bridge before rolling. Shared cooldown: 2 rounds; automatic rotation still happens.",
 Price=7, Weight=2, Boards={"MagicalFestival"},
 Use=function(match) return match:useMoonDial() end },
	{
		Id = "DoubleDice",
		Name = "Double Dice",
		Description = "Roll two dice and move the total",
		Price = 6,
		Weight = 3,
		Dice = 2,
		Use = function(_match, seat)
			return ("%s will roll two dice!"):format(seat.Participant.Name)
		end,
	},
	{
		Id = "TripleDice",
		Name = "Triple Dice",
		Description = "Roll three dice and move the total",
		Price = 10,
		Weight = 1,
		Dice = 3,
		Use = function(_match, seat)
			return ("%s will roll three dice!"):format(seat.Participant.Name)
		end,
	},
	{
		Id = "CoinShield",
		Name = "Coin Shield",
		Description = "Blocks the next coin loss, then breaks",
		Price = 5,
		Weight = 2,
		Use = function(_match, seat)
			if seat.Shield then
				return nil, "already shielded"
			end
			seat.Shield = true
			return ("%s raised a Coin Shield"):format(seat.Participant.Name)
		end,
	},
	{
		Id = "SwapTicket",
		Name = "Swap Ticket",
		Description = "Swap places with an opponent you pick",
		Price = 8,
		Weight = 2,
		Target = "Opponent",
		Use = function(_match, seat, target)
			seat.SpaceId, target.SpaceId = target.SpaceId, seat.SpaceId
			return ("%s swapped places with %s"):format(seat.Participant.Name, target.Participant.Name)
		end,
	},
	{
		Id = "WarpToken",
		Name = "Warp Token",
		Description = "Jump to a random space",
		Price = 6,
		Weight = 2,
		Use = function(match, seat)
			local options = {}
			for _, id in match.Board.Order do
				if id ~= seat.SpaceId then
					table.insert(options, id)
				end
			end
			seat.SpaceId = options[match.Rng:NextInteger(1, #options)]
			return ("%s warped to a random space"):format(seat.Participant.Name)
		end,
	},
	{
		Id = "LuckyDie",
		Name = "Lucky Die",
		Description = "Pick your roll",
		Price = 9,
		Weight = 2,
		Choice = "DieFace",
		Use = function(match, seat, _target, face)
			match.Turn.Fixed = face
			return ("%s will move exactly %d"):format(seat.Participant.Name, face)
		end,
	},
	{
		Id = "Pickpocket",
		Name = "Pickpocket",
		Description = "Take up to 6 coins from an opponent",
		Price = 7,
		Weight = 2,
		Target = "Opponent",
		Use = function(match, seat, target)
			if match:coinsOf(target) == 0 then
				return nil, "they have no coins"
			end
			local taken, blocked = match:stealCoins(seat, target, 6)
			if blocked then
				return ("%s's Coin Shield stopped %s's pickpocket"):format(target.Participant.Name, seat.Participant.Name)
			end
			return ("%s pickpocketed %d coins from %s"):format(seat.Participant.Name, taken, target.Participant.Name)
		end,
	},
	{
		Id = "CrownHeist",
		Name = "Crown Heist",
		Description = "Pay 15 coins to take a Crown from an opponent (a Coin Shield stops it)",
		Price = 25,
		Weight = 0.4,
		Target = "Opponent",
		Fee = 15,
		Use = function(match, seat, target)
			local result, reason = match:stealCollectible(seat, target, 15)
			if not result then
				return nil, reason
			elseif result == "blocked" then
				return ("%s's Coin Shield stopped %s's Crown Heist"):format(target.Participant.Name, seat.Participant.Name)
			end
			return ("%s stole a %s from %s!"):format(seat.Participant.Name, match.CollectibleName, target.Participant.Name)
		end,
	},
	{
		Id = "GateKey",
		Name = "Gate Key",
		Description = "Open or close the Sunny Loop shortcut from anywhere",
		Price = 4,
		Weight = 2,
		Boards = { "Classic" },
		Use = function(match, seat)
			if #(match.Board.Gates or {}) == 0 then
				return nil, "this board has no gates"
			end
			local open = match:toggleGates()
			return ("%s used a Gate Key: the shortcut is %s"):format(seat.Participant.Name, if open > 0 then "open" else "closed")
		end,
	},
	{
		Id = "Snare",
		Name = "Snare Trap",
		Description = "Trap your space: the next opponent to land there pays you 5 coins",
		Price = 5,
		Weight = 2,
		Use = function(match, seat)
			if not match:setTrap(seat, 5) then
				return nil, "there's already a trap here"
			end
			return ("%s set a trap"):format(seat.Participant.Name)
		end,
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Match</string>
            <string name="Source"><![CDATA[--[[
	Match
	The rules of one board-game match, with no networking, timing or world in it, so it can
	be tested on its own. BoardGame drives it and draws the results.

	  Match.new(board, participants, settings, deps)
	    settings  { Rounds, Difficulty }
	    deps      {
	      Wallet     CoinService-like: get, add, spend, getCollectibles, addCollectibles, transfer
	      Inventory  Inventory-like: grant, equip, getEquipped, unowned
	      Rng        Random
	      Duel       optional function(seatA, seatB) -> winner seat or nil, played: plays a duel
	                 minigame (BoardGame); without it, or if none was played, duels use dice
	      Ask        function(seat, request) -> option index; may yield. request =
	                 { Kind = "Path"|"Collectible"|"Shop"|"Target", Prompt, Options = {labels}, Default, Data }
	    }

	A seat: { Index, Participant, SpaceId, Items = {item ids}, Shield, Stats }. Seats keep
	their place in the turn order, inventory and stats when a bot takes over from a player
	who left (replaceParticipant), and when that player comes back (reclaimSeat).

	A turn: beginTurn(seat) -> [useItem(seat, slot, target)] -> rollTurn(seat) -> move(...) -> endTurn().
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.PartyShared.Config)
local Cosmetics = require(ReplicatedStorage.PartyShared.Cosmetics)
local BotBrain = require(script.Parent.BotBrain)
local ChaosEvents = require(script.Parent.ChaosEvents)
local Events = require(script.Parent.Events)
local Items = require(script.Parent.Items)
local SpaceTypes = require(script.Parent.SpaceTypes)

local Bridge = require(script.Parent.RotatingBridge)

local Match = {}
Match.__index = Match

local itemsById = {}
for _, item in Items do
	itemsById[item.Id] = item
end

local function weightedPick(rng: Random, list)
	local total = 0
	for _, entry in list do
		total += entry.Weight
	end
	local roll = rng:NextNumber() * total
	for _, entry in list do
		roll -= entry.Weight
		if roll <= 0 then
			return entry
		end
	end
	return list[#list]
end

local function isDieValue(value): boolean
	return type(value) == "number" and value % 1 == 0 and value >= 1 and value <= Config.Board.DieSides
end

function Match.getItem(id: string)
	return itemsById[id]
end

function Match.new(board, participants, settings, deps)
	local self = setmetatable({
		Board = board,
		Deps = deps,
		Rng = deps.Rng or Random.new(),
		Rounds = settings.Rounds or Config.Match.BoardRounds,
		Difficulty = settings.Difficulty or Config.Match.BotDifficulty,
		Round = 0,
		Orientation = 0,
		BridgeRevision = 0,
		LastRotationRound = 0,
		DialReadyRound = 1,
		Seats = {},
		Order = {}, -- seat order until decideTurnOrder runs
		CollectibleSpace = nil,
		CollectibleName = Config.Collectible.Name,
		CollectiblePrice = Config.Collectible.Price,
		Turn = nil, -- { Seat, Stage = "PreRoll"|"Moving", ItemUsed, Dice, Fixed }
		Traps = {}, -- [spaceId] = { Owner = seat, Coins = n }
		GateOpen = {}, -- [gateId] = true/false (Switch spaces flip them)
	}, Match)

	for index, participant in participants do
		local seat = {
			Index = index,
			Participant = participant,
			SpaceId = board.Start,
			Items = {},
			Shield = false,
			Stats = { MinigamePoints = 0, CoinsEarned = 0, SpacesMoved = 0 },
		}
		table.insert(self.Seats, seat)
		table.insert(self.Order, seat)
	end
	for _, gate in board.Gates or {} do
		self.GateOpen[gate.Id] = gate.Open ~= false
	end
	self:relocateCollectible()
	return self
end

function Match:participants()
	local list = {}
	for _, seat in self.Seats do
		table.insert(list, seat.Participant)
	end
	return list
end

function Match:seatOf(participant)
	for _, seat in self.Seats do
		if seat.Participant == participant then
			return seat
		end
	end
	return nil
end

function Match:seatById(id: string?)
	for _, seat in self.Seats do
		if seat.Participant.Id == id then
			return seat
		end
	end
	return nil
end

function Match:coinsOf(seat): number
	return self.Deps.Wallet.get(seat.Participant)
end

function Match:collectiblesOf(seat): number
	return self.Deps.Wallet.getCollectibles(seat.Participant)
end

--[[
	Adds/removes coins (never below 0) as a board effect. A Coin Shield blocks the next loss.
	Returns the change that actually happened and whether a shield blocked it.
	Gains count towards the Coin Collector bonus. (Purchases use Wallet.spend instead.)
]]
function Match:changeCoins(seat, amount: number): (number, boolean)
	if amount < 0 and seat.Shield and self:coinsOf(seat) > 0 then
		seat.Shield = false
		return 0, true
	end
	local _, delta = self.Deps.Wallet.add(seat.Participant, amount)
	if delta > 0 then
		seat.Stats.CoinsEarned += delta
	end
	return delta, false
end

-- Turn order -----------------------------------------------------------------------------------

--[[
	Everyone rolls once; highest goes first. Tied seats roll again among themselves (and again,
	until nobody is tied). rollFor(seats, attempt) -> { [seat] = roll } lets BoardGame wait for
	players to press ROLL; by default the match's Rng rolls. Invalid rolls are re-rolled here.
	Sets self.Order and returns it with a log: { { Seat, Roll, Attempt } }.
]]
function Match:decideTurnOrder(rollFor)
	local log = {}
	rollFor = rollFor or function(seats)
		local rolls = {}
		for _, seat in seats do
			rolls[seat] = self:roll()
		end
		return rolls
	end

	local function resolve(group, attempt)
		local rolls = rollFor(group, attempt) or {}
		for _, seat in group do
			if not isDieValue(rolls[seat]) then
				rolls[seat] = self:roll()
			end
			table.insert(log, { Seat = seat, Roll = rolls[seat], Attempt = attempt })
		end
		local sorted = table.clone(group)
		table.sort(sorted, function(a, b)
			if rolls[a] ~= rolls[b] then
				return rolls[a] > rolls[b]
			end
			return a.Index < b.Index
		end)
		local result = {}
		local i = 1
		while i <= #sorted do
			local j = i
			while sorted[j + 1] and rolls[sorted[j + 1]] == rolls[sorted[i]] do
				j += 1
			end
			if j > i then
				for _, seat in resolve(table.move(sorted, i, j, 1, {}), attempt + 1) do
					table.insert(result, seat)
				end
			else
				table.insert(result, sorted[i])
			end
			i = j + 1
		end
		return result
	end

	self.Order = resolve(table.clone(self.Seats), 1)
	return self.Order, log
end

-- Dice -----------------------------------------------------------------------------------------

function Match:roll(): number
	return self.Rng:NextInteger(1, Config.Board.DieSides)
end

-- Turns + items --------------------------------------------------------------------------------

function Match:beginTurn(seat)
	self.Turn = { Seat = seat, Stage = "PreRoll", ItemUsed = false, Dice = 1 }
end

function Match:endTurn()
	self.Turn = nil
end

-- Adds an item to a seat's inventory. False if unknown or the inventory is full.
function Match:giveItem(seat, itemId: string): boolean
	if not itemsById[itemId] or #seat.Items >= Config.Items.MaxHeld then
		return false
	end
	table.insert(seat.Items, itemId)
	return true
end

--[[
	Uses the item in `slot` of the seat's inventory. Every rule is checked here, so players
	(via the remote) and bots go through exactly the same validation:
	  it must be this seat's turn, before the roll, no item used yet this turn,
	  the slot must hold a real item, an Opponent item needs another seat as target, and a
	  DieFace item needs a whole number 1..DieSides as `choice`.
	Returns true + feed text, or false + reason. A refused item stays in the inventory.
]]
function Match:useItem(seat, slot, target, choice): (boolean, string)
	local turn = self.Turn
	if not turn or turn.Seat ~= seat then
		return false, "not your turn"
	end
	if turn.Stage ~= "PreRoll" then
		return false, "items are used before rolling"
	end
	if turn.ItemUsed then
		return false, "one item per turn"
	end
	if type(slot) ~= "number" or slot % 1 ~= 0 or not seat.Items[slot] then
		return false, "you don't have that item"
	end
	local item = itemsById[seat.Items[slot]]
	if not item then
		return false, "unknown item"
	end
	if item.Boards and not table.find(item.Boards, self.Board.Name) then
		return false, "item belongs to another board"
	end
	if item.Target == "Opponent" then
		if type(target) ~= "table" or target == seat or not table.find(self.Seats, target) then
			return false, "pick an opponent"
		end
	else
		target = nil
	end
	if item.Choice == "DieFace" then
		if type(choice) ~= "number" or choice % 1 ~= 0 or choice < 1 or choice > Config.Board.DieSides then
			return false, "pick a number"
		end
	else
		choice = nil
	end
	local text, reason = item.Use(self, seat, target, choice)
	if not text then
		return false, reason or "can't use that now"
	end
	table.remove(seat.Items, slot)
	turn.ItemUsed = true
	if item.Dice then
		turn.Dice = item.Dice
	end
	return true, text
end

-- Rolls this turn's dice (1, more from a dice item, or a chosen number from a Lucky Die).
-- Returns the total and each die.
function Match:rollTurn(seat): (number, { number })
	local turn = self.Turn
	if turn and turn.Seat == seat and turn.Fixed then
		turn.Stage = "Moving"
		return turn.Fixed, { turn.Fixed }
	end
	local count = if turn and turn.Seat == seat then turn.Dice else 1
	local dice, total = {}, 0
	for i = 1, count do
		dice[i] = self:roll()
		total += dice[i]
	end
	if turn then
		turn.Stage = "Moving"
	end
	return total, dice
end

-- Stealing + traps ---------------------------------------------------------------------------

--[[
	Takes up to `amount` coins from victim to thief. A Coin Shield on the victim blocks it
	(and breaks). Returns coins taken, and whether a shield blocked it.
]]
function Match:stealCoins(thief, victim, amount: number): (number, boolean)
	if victim.Shield and self:coinsOf(victim) > 0 then
		victim.Shield = false
		return 0, true
	end
	local _, delta = self.Deps.Wallet.add(victim.Participant, -amount)
	local taken = -delta
	if taken > 0 then
		self:changeCoins(thief, taken)
	end
	return taken, false
end

--[[
	The Crown steal: the thief pays `fee` coins, then takes one collectible from the victim.
	A Coin Shield on the victim blocks it (the shield breaks; the fee is still paid).
	Returns "stolen" | "blocked", or nil + reason (nothing happened).
]]
function Match:stealCollectible(thief, victim, fee: number): (string?, string?)
	if self:collectiblesOf(victim) < 1 then
		return nil, ("they have no %s"):format(Config.Collectible.Plural)
	end
	if not self.Deps.Wallet.spend(thief.Participant, fee) then
		return nil, ("you need %d coins to pay for it"):format(fee)
	end
	if victim.Shield then
		victim.Shield = false
		return "blocked"
	end
	self.Deps.Wallet.addCollectibles(victim.Participant, -1)
	self.Deps.Wallet.addCollectibles(thief.Participant, 1)
	return "stolen"
end

-- Sets a trap on the seat's current space. False if one is already there.
function Match:setTrap(seat, coins: number): boolean
	if self.Traps[seat.SpaceId] then
		return false
	end
	self.Traps[seat.SpaceId] = { Owner = seat, Coins = coins }
	return true
end

-- An opponent landing on a trap pays its owner (a shield blocks it). Returns feed text.
function Match:springTrap(seat): string?
	local trap = self.Traps[seat.SpaceId]
	if not trap or trap.Owner == seat then
		return nil
	end
	self.Traps[seat.SpaceId] = nil
	local taken, blocked = self:stealCoins(trap.Owner, seat, trap.Coins)
	if blocked then
		return ("%s's Coin Shield broke %s's trap"):format(seat.Participant.Name, trap.Owner.Participant.Name)
	end
	return ("%s stepped in %s's trap and paid %d coins"):format(seat.Participant.Name, trap.Owner.Participant.Name, taken)
end

-- Items that can appear on this board (Items with a Boards list only show up on those boards).
function Match:itemPool()
	local pool = {}
	for _, item in Items do
		if not item.Boards or table.find(item.Boards, self.Board.Name) then
			table.insert(pool, item)
		end
	end
	return pool
end

-- Opponents a Target item could be used on.
function Match:opponentsOf(seat)
	local list = {}
	for _, other in self.Seats do
		if other ~= seat then
			table.insert(list, other)
		end
	end
	return list
end

-- Collectible --------------------------------------------------------------------------------

-- Moves the collectible to a different allowed space, avoiding occupied ones when possible.
function Match:relocateCollectible()
	local candidates, free = {}, {}
	local occupied = {}
	for _, seat in self.Seats do
		occupied[seat.SpaceId] = true
	end
	for _, id in self.Board.CrownSpaces do
		if id ~= self.CollectibleSpace and (not self.Board.Bridge or Bridge.connected(self.Board:get(id).Zone,self.Orientation)) then
			table.insert(candidates, id)
			if not occupied[id] then
				table.insert(free, id)
			end
		end
	end
	local pool = if #free > 0 then free else candidates
	self.CollectibleSpace = pool[self.Rng:NextInteger(1, #pool)]
	return self.CollectibleSpace
end

-- Comeback ------------------------------------------------------------------------------------

local function comebackOn(match): boolean
	return Config.Comeback.Enabled and match.Round >= Config.Comeback.StartRound
end

-- An underdog is far enough behind the Crown leader to get help (discount, better gifts).
function Match:isUnderdog(seat): boolean
	if not comebackOn(self) then
		return false
	end
	local leader = 0
	for _, other in self.Seats do
		leader = math.max(leader, self:collectiblesOf(other))
	end
	return leader - self:collectiblesOf(seat) >= Config.Comeback.UnderdogGap
end

-- What this seat pays for the collectible right now (underdogs get a discount).
function Match:collectiblePriceFor(seat): number
	if self:isUnderdog(seat) then
		return math.max(Config.Comeback.MinCrownPrice, self.CollectiblePrice - Config.Comeback.UnderdogDiscount)
	end
	return self.CollectiblePrice
end

-- True in the last round when Final Frenzy is on.
function Match:isFrenzy(): boolean
	return Config.Comeback.Enabled and Config.Comeback.FinalFrenzy and self.Round >= self.Rounds
end

-- Coins a Gain / Lose space is worth this round.
function Match:spaceCoins(base: number): number
	return if self:isFrenzy() then base * Config.Comeback.FrenzyMultiplier else base
end

--[[
	Start of a round: the last-place seat(s) get a few coins (from Comeback.StartRound on).
	Returns feed text or nil.
]]
function Match:startRound(round: number): string?
	self.Round = round
	if not comebackOn(self) then
		return nil
	end
	local rows = self:standings()
	local last = rows[#rows].Placement
	if last == 1 then
		return nil -- everyone tied
	end
	local names = {}
	for _, row in rows do
		if row.Placement == last then
			local seat = self:seatOf(row.Participant)
			self:changeCoins(seat, Config.Comeback.LastPlaceCoins)
			table.insert(names, row.Participant.Name)
		end
	end
	return ("Catch-up: %s +%d coins"):format(table.concat(names, ", "), Config.Comeback.LastPlaceCoins)
end

-- Gift-space reward table for this seat (underdogs get better odds on items and Crowns).
function Match:rewardsFor(seat)
	if not self:isUnderdog(seat) then
		return Config.Economy.Rewards
	end
	local boosted = {}
	for _, reward in Config.Economy.Rewards do
		local copy = table.clone(reward)
		if copy.Kind == "Collectible" or copy.Kind == "Item" then
			copy.Weight *= Config.Comeback.UnderdogGiftBoost
		end
		table.insert(boosted, copy)
	end
	return boosted
end

-- Collectible purchase ---------------------------------------------------------------------------

-- Pays for the collectible. Returns true if bought (and moves it).
function Match:buyCollectible(seat): boolean
	if not self.Deps.Wallet.spend(seat.Participant, self:collectiblePriceFor(seat)) then
		return false
	end
	self.Deps.Wallet.addCollectibles(seat.Participant, 1)
	self.CollectiblePrice = Config.Collectible.Price -- a Price Surge ends with the purchase
	self:relocateCollectible()
	return true
end

-- Reached the collectible's space (passing or landing): offer it if affordable.
function Match:offerCollectible(seat): string
	local name = seat.Participant.Name
	local price = self:collectiblePriceFor(seat)
	if self:coinsOf(seat) < price then
		return ("%s needs %d coins for a %s"):format(name, price, self.CollectibleName)
	end
	local pick = self:ask(seat, {
		Kind = "Collectible",
		Prompt = ("Buy a %s for %d coins?%s"):format(
			self.CollectibleName,
			price,
			if price < self.CollectiblePrice then " (underdog discount)" else ""
		),
		Options = { "Buy", "Not now" },
		Default = 1,
		Price = price,
	})
	if pick == 1 and self:buyCollectible(seat) then
		return ("%s bought a %s!"):format(name, self.CollectibleName)
	end
	return ("%s passed on the %s"):format(name, self.CollectibleName)
end

function Match:ask(seat, request): number
	local pick = self.Deps.Ask(seat, request)
	if type(pick) ~= "number" or pick % 1 ~= 0 or pick < 1 or pick > #request.Options then
		return request.Default or 1
	end
	return pick
end

-- Movement ------------------------------------------------------------------------------------

-- Gates ----------------------------------------------------------------------------------------

-- The gate on the edge from -> to, if any.
function Match:gateOn(from: number, to: number)
	for _, gate in self.Board.Gates or {} do
		if gate.From == from and gate.To == to then
			return gate
		end
	end
	return nil
end

-- Where a piece can go from `id` right now: closed gates are left out (never all of them).
function Match:nextOptions(id: number): { number }
	if self.Board.Bridge then
		return Bridge.options(self.Board, id, self.Orientation)
	end
	local all = self.Board:nextOptions(id)
	local open = {}
	for _, nextId in all do
		local gate = self:gateOn(id, nextId)
		if not gate or self.GateOpen[gate.Id] then
			table.insert(open, nextId)
		end
	end
	return if #open > 0 then open else all
end

-- Flips every gate on the board (Switch space). Returns how many are now open.
function Match:toggleGates(): number
	local open = 0
	for _, gate in self.Board.Gates or {} do
		self.GateOpen[gate.Id] = not self.GateOpen[gate.Id]
		open += if self.GateOpen[gate.Id] then 1 else 0
	end
	self.DistanceCache = nil
	return open
end

-- Fewest moves from -> to with the gates as they are now (math.huge if unreachable).
function Match:bridgeState()
 return Bridge.snapshot(self)
end

function Match:canUseMoonDial()
 return self.Board.Bridge ~= nil and self.Round >= self.DialReadyRound
end

-- Configured Crown spaces inside zones that are open under `orientation` (never the bridge),
-- excluding the Crown's current space. Pure: bots use it to predict a relocation.
function Match:crownCandidates(orientation: number): { number }
 local list = {}
 for _, id in self.Board.CrownSpaces do
  local zone = self.Board:get(id).Zone
  if zone ~= 0 and id ~= self.CollectibleSpace and Bridge.connected(zone, orientation) then
   table.insert(list, id)
  end
 end
 return list
end

-- The seat leading the standings, or nil when the top is tied.
local function leaderOf(match)
 local rows = match:standings()
 if rows[2] and rows[2].Placement == rows[1].Placement then return nil end
 return match:seatOf(rows[1].Participant)
end

--[[
	Where the Crown goes when a rotation to `orientation` would strand it. Each filter only
	applies if it leaves at least one option:
	  1. configured Crown spaces in zones open after the rotation
	  2. prefer zones that this rotation newly opens
	  3. skip spaces / zones used by the last few relocations (Bridge.CrownMemory)
	  4. skip spaces within Bridge.CrownLeaderBuffer moves of the leading player
	then pick one with the match's Rng. Bridge spaces 34 / 35 only as the fallback when no
	zone space qualifies. Records the choice for the repeat check.
]]
function Match:chooseCrownSpace(orientation: number): number
 local rule = self.Board.Bridge
 local memory = rule.CrownMemory or 2
 local buffer = rule.CrownLeaderBuffer or 4
 local pool = self:crownCandidates(orientation)
 if #pool == 0 then
  return if self.CollectibleSpace == 34 then 35 else 34
 end
 local function narrow(keep)
  local kept = {}
  for _, id in pool do if keep(id) then table.insert(kept, id) end end
  if #kept > 0 then pool = kept end
 end
 narrow(function(id) return not Bridge.connected(self.Board:get(id).Zone, self.Orientation) end)
 self.CrownHistory = self.CrownHistory or {}
 local function avoidRecent()
  narrow(function(id)
   for i = math.max(1, #self.CrownHistory - memory + 1), #self.CrownHistory do
    local past = self.CrownHistory[i]
    if past == id or self.Board:get(past).Zone == self.Board:get(id).Zone then return false end
   end
   return true
  end)
 end
 local leader = leaderOf(self)
 local function nearLeader(id)
  return leader ~= nil and Bridge.distance(self.Board, leader.SpaceId, id, orientation) <= buffer
 end
 local function avoidLeader()
  narrow(function(id) return not nearLeader(id) end)
 end
 -- If the last relocation already landed near this same leader, keeping it away from them
 -- now matters more than variety; otherwise variety first.
 if leader and self.CrownNearLeader == leader then
  avoidLeader()
  avoidRecent()
 else
  avoidRecent()
  avoidLeader()
 end
 local pick = pool[self.Rng:NextInteger(1, #pool)]
 table.insert(self.CrownHistory, pick)
 self.CrownNearLeader = if nearLeader(pick) then leader else nil
 return pick
end

-- Commit orientation, route cache and Crown together without yielding. Only the turn
-- driver invokes automatic rotation, after all four turns have ended (no seam crossing).
function Match:rotateBridge()
 if not self.Board.Bridge or (self.Turn and self.Turn.Stage ~= "PreRoll") then return false end
 local nextOrientation = 1-self.Orientation
 local crown = self.CollectibleSpace
 if not crown or not Bridge.connected(self.Board:get(crown).Zone,nextOrientation) then
  crown = self:chooseCrownSpace(nextOrientation)
 end
 self.Orientation = nextOrientation
 self.CollectibleSpace = crown
 self.DistanceCache = nil
 self.BridgeRevision += 1
 return true
end

function Match:rotationDue()
 return self.Board.Bridge ~= nil and self.Turn == nil
  and self.Round >= self.LastRotationRound+self.Board.Bridge.EveryRounds
end

function Match:finishBoardRound()
 if not self:rotationDue() then return false end
 if not self:rotateBridge() then return false end
 self.LastRotationRound = self.Round
 return true
end

function Match:useMoonDial()
 if not self:canUseMoonDial() then return nil,"Moon Dial is cooling down until round " .. self.DialReadyRound end
 if not self:rotateBridge() then return nil,"bridge is busy" end
 self.DialReadyRound = self.Round+self.Board.Bridge.DialCooldownRounds*self.Board.Bridge.EveryRounds
 return "Moon Dial: bridge rotated to " .. self:bridgeState().Alignment .. "; automatic rotation still happens this round"
end

function Match:distanceAt(from, to, orientation)
 return Bridge.distance(self.Board,from,to,orientation)
end

function Match:distance(from: number, to: number): number
	self.DistanceCache = self.DistanceCache or {}
	local row = self.DistanceCache[from]
	if not row then
		row = { [from] = 0 }
		local queue, head = { from }, 1
		while queue[head] do
			local id = queue[head]
			head += 1
			for _, nextId in self:nextOptions(id) do
				if row[nextId] == nil then
					row[nextId] = row[id] + 1
					table.insert(queue, nextId)
				end
			end
		end
		self.DistanceCache[from] = row
	end
	return row[to] or math.huge
end

--[[
	What a fork choice leads to, shown with the choice so players can decide:
	  CrownDistance  moves to the collectible going this way (math.huge if it can't be reached)
	  Preview        tile text of the next 3 spaces down this way, e.g. "+3 ? SHOP"
	  Toll           coins the route costs
]]
function Match:routeInfo(_seat, firstId: number, toll: number)
	local shorts = {}
	local id = firstId
	for _ = 1, 3 do
		local space = self.Board:get(id)
		local short = SpaceTypes[space.Type].Short
		table.insert(shorts, if short == "" then "·" else short)
		id = self:nextOptions(id)[1]
	end
	return {
		CrownDistance = 1 + self:distance(firstId, self.CollectibleSpace),
		Preview = table.concat(shorts, " ") .. (if self.Board.Bridge and not Bridge.connected(self.Board:get(firstId).Zone, self.Orientation) then " · bridge CLOSED; local loop" else ""),
		Toll = toll,
	}
end

-- One space forward. At a fork the mover chooses; a tolled route is only offered to (and
-- charged to) someone who can pay.
function Match:step(seat): number
	local here = seat.SpaceId
	local options = {}
	for _, id in self:nextOptions(here) do
		local gate = self:gateOn(here, id)
		if not gate or not gate.Toll or self:coinsOf(seat) >= gate.Toll then
			table.insert(options, id)
		end
	end
	if #options == 0 then
		options = self:nextOptions(here)
	end
	-- No turning around mid-move: on two-way stretches (the festival bridge) the space you
	-- just came from isn't offered, unless it's the only way on.
	if seat.MoveFrom and #options > 1 then
		local back = table.find(options, seat.MoveFrom)
		if back then
			options = table.clone(options)
			table.remove(options, back)
		end
	end
	local nextId = options[1]
	if #options > 1 then
		local space = self.Board:get(here)
		local all = self.Board:nextOptions(here)
		local labels, info = {}, {}
		for i, id in options do
			local index = table.find(all, id)
			local gate = self:gateOn(here, id)
			info[i] = self:routeInfo(seat, id, if gate then gate.Toll or 0 else 0)
			local name = if space.Paths and index then space.Paths[index] else ("Space %d"):format(id)
			labels[i] = ("%s\n%s %s · %s"):format(
				name,
				self.CollectibleName,
				if info[i].CrownDistance == math.huge then "far" else ("in %d"):format(info[i].CrownDistance),
				info[i].Preview
			)
		end
		nextId = options[self:ask(seat, {
			Kind = "Path",
			Prompt = "Which way?",
			Options = labels,
			Default = 1,
			Data = { Spaces = options, Info = info },
		})]
	end
	local gate = self:gateOn(here, nextId)
	if gate and gate.Toll and gate.Toll > 0 then
		self.Deps.Wallet.spend(seat.Participant, gate.Toll)
	end
	seat.MoveFrom = here
	seat.SpaceId = nextId
	seat.Stats.SpacesMoved += 1
	return nextId
end

--[[
	Moves `steps` spaces, then resolves the landing space.
	onHop(seat, spaceId, remaining) runs after every hop (BoardGame animates there).
	onNotice(text) receives anything worth telling everyone on the way (collectible offers).
	Returns the feed line for the landing (may be nil).
]]
function Match:move(seat, steps: number, onHop, onNotice)
	seat.MoveFrom = nil -- a new move may set off in either direction
	for remaining = steps - 1, 0, -1 do
		local id = self:step(seat)
		if onHop then
			onHop(seat, id, remaining)
		end
		if id == self.CollectibleSpace then
			local text = self:offerCollectible(seat)
			if onNotice then
				onNotice(text)
			end
		end
	end
	return self:land(seat)
end

function Match:land(seat): string?
	local trap = self:springTrap(seat)
	local space = self.Board:get(seat.SpaceId)
	local spaceType = SpaceTypes[space.Type]
	local text = spaceType.Resolve(self, seat, space)
	if trap then
		return if text then trap .. ". " .. text else trap
	end
	return text
end

-- Space helpers (used by SpaceTypes / Events) ---------------------------------------------------

function Match:runChaos(seat): string
	local event = weightedPick(self.Rng, ChaosEvents)
	return ("%s: %s"):format(event.Name, event.Apply(self, seat, self.Rng))
end

-- Item space: a random item, or a few coins if the bag is full.
function Match:itemSpace(seat): string
	local item = self:giveRandomItem(seat)
	if item then
		return ("%s found a %s"):format(seat.Participant.Name, item.Name)
	end
	local delta = self:changeCoins(seat, Config.Economy.ItemSpaceFallbackCoins)
	return ("%s's bag is full: +%d coins instead"):format(seat.Participant.Name, delta)
end

--[[
	Duel space: the lander picks an opponent and a stake both can pay; both roll a die and the
	higher roll takes the stake (a tie is a draw). A duel is a wager, so shields don't apply.
]]
function Match:runDuel(seat): string
	local name = seat.Participant.Name
	local opponents = {}
	for _, other in self:opponentsOf(seat) do
		if self:coinsOf(other) >= Config.Economy.DuelStakes[1] then
			table.insert(opponents, other)
		end
	end
	if self:coinsOf(seat) < Config.Economy.DuelStakes[1] or #opponents == 0 then
		return ("%s wants a duel, but nobody has the coins"):format(name)
	end
	local labels = {}
	for i, other in opponents do
		labels[i] = ("%s (%d coins)"):format(other.Participant.Name, self:coinsOf(other))
	end
	table.insert(labels, "No duel")
	local pick = self:ask(seat, {
		Kind = "DuelTarget",
		Prompt = "Duel! Challenge who?",
		Options = labels,
		Default = #labels,
		Data = { Seats = opponents },
	})
	local rival = opponents[pick]
	if not rival then
		return ("%s declined the duel"):format(name)
	end
	local stakes, stakeLabels = {}, {}
	for _, stake in Config.Economy.DuelStakes do
		if self:coinsOf(seat) >= stake and self:coinsOf(rival) >= stake then
			table.insert(stakes, stake)
			table.insert(stakeLabels, ("%d coins"):format(stake))
		end
	end
	local stake = stakes[self:ask(seat, {
		Kind = "DuelStake",
		Prompt = ("Duel %s: how many coins?"):format(rival.Participant.Name),
		Options = stakeLabels,
		Default = 1,
		Data = { Stakes = stakes, Rival = rival },
	})]
	local winner, loser, result
	local duelWinner, played = nil, false
	if self.Deps.Duel then
		duelWinner, played = self.Deps.Duel(seat, rival)
	end
	if played then
		result = ("%s vs %s"):format(name, rival.Participant.Name)
		if duelWinner ~= seat and duelWinner ~= rival then
			return result .. ": a draw!"
		end
		winner, loser = duelWinner, if duelWinner == seat then rival else seat
	else
		local mine, theirs = self:roll(), self:roll()
		result = ("%s %d vs %s %d"):format(name, mine, rival.Participant.Name, theirs)
		if mine == theirs then
			return result .. ": a draw!"
		end
		winner, loser = if mine > theirs then seat else rival, if mine > theirs then rival else seat
	end
	local _, taken = self.Deps.Wallet.add(loser.Participant, -stake)
	self:changeCoins(winner, -taken)
	return ("%s: %s wins %d coins"):format(result, winner.Participant.Name, -taken)
end

--[[
	Switch space: flip the board's gates (free), pay to move the Crown, or leave it.
]]
function Match:runSwitch(seat): string
	local name = seat.Participant.Name
	local options, actions = {}, {}
	if #(self.Board.Gates or {}) > 0 then
		table.insert(options, "Flip the gates")
		table.insert(actions, "Gates")
	end
	if self:coinsOf(seat) >= Config.Economy.CrownMovePrice then
		table.insert(options, ("Move the %s (%d coins)"):format(self.CollectibleName, Config.Economy.CrownMovePrice))
		table.insert(actions, "Crown")
	end
	table.insert(options, "Leave it")
	table.insert(actions, "None")
	local action = actions[self:ask(seat, {
		Kind = "Switch",
		Prompt = "Switch: change the board?",
		Options = options,
		Default = #options,
		Data = { Actions = actions },
	})]
	if action == "Gates" then
		local open = self:toggleGates()
		return ("%s flipped the gates: %s"):format(name, if open > 0 then "the shortcut is open" else "the shortcut is closed")
	elseif action == "Crown" and self.Deps.Wallet.spend(seat.Participant, Config.Economy.CrownMovePrice) then
		self:relocateCollectible()
		return ("%s paid %d coins to move the %s"):format(name, Config.Economy.CrownMovePrice, self.CollectibleName)
	end
	return ("%s left the board as it is"):format(name)
end

function Match:runEvent(seat): string
	local event = weightedPick(self.Rng, Events)
	return ("%s: %s"):format(event.Name, event.Apply(self, seat, self.Rng))
end

function Match:grantCosmetic(seat, itemId: string): boolean
	local ownerId = seat.Participant.Id
	if not self.Deps.Inventory.grant(ownerId, itemId) then
		return false
	end
	local item = Cosmetics.get(itemId)
	if not self.Deps.Inventory.getEquipped(ownerId)[item.Slot] then
		self.Deps.Inventory.equip(ownerId, itemId) -- first item in a slot goes straight on
	end
	return true
end

-- A random board item into the seat's inventory. Returns the item, or nil if it's full.
function Match:giveRandomItem(seat)
	if #seat.Items >= Config.Items.MaxHeld then
		return nil
	end
	local item = weightedPick(self.Rng, self:itemPool())
	self:giveItem(seat, item.Id)
	return item
end

function Match:giveReward(seat): string
	local name = seat.Participant.Name
	local reward = weightedPick(self.Rng, self:rewardsFor(seat))
	if reward.Kind == "Item" then
		local item = self:giveRandomItem(seat)
		if item then
			return ("%s unwrapped a %s!"):format(name, item.Name)
		end
		reward = { Kind = "Coins", Amount = 5 } -- bag is full
	end
	if reward.Kind == "Cosmetic" then
		local unowned = self.Deps.Inventory.unowned(seat.Participant.Id)
		if #unowned > 0 then
			local item = unowned[self.Rng:NextInteger(1, #unowned)]
			self:grantCosmetic(seat, item.Id)
			return ("%s unwrapped a %s!"):format(name, item.Name)
		end
		reward = { Kind = "Coins", Amount = 5 } -- owns everything already
	end
	if reward.Kind == "Collectible" then
		self.Deps.Wallet.addCollectibles(seat.Participant, reward.Amount)
		return ("%s unwrapped a %s!"):format(name, self.CollectibleName)
	end
	local delta = self:changeCoins(seat, reward.Amount)
	return ("%s unwrapped %d coins"):format(name, delta)
end

--[[
	Shop: up to Config.Economy.ShopItemOffers board items (if there's room in the bag) and
	Config.Economy.ShopOffers cosmetics the visitor doesn't own. Data.Items lists each offer
	as { Kind = "Item"|"Cosmetic", Id, Name, Price }.
]]
function Match:visitShop(seat): string
	local name = seat.Participant.Name
	local offers = {}
	if #seat.Items < Config.Items.MaxHeld then
		local pool = self:itemPool()
		for _ = 1, math.min(Config.Economy.ShopItemOffers, #pool) do
			local item = table.remove(pool, self.Rng:NextInteger(1, #pool))
			table.insert(offers, { Kind = "Item", Id = item.Id, Name = item.Name, Price = item.Price })
		end
	end
	local unowned = self.Deps.Inventory.unowned(seat.Participant.Id)
	for _ = 1, math.min(Config.Economy.ShopOffers, #unowned) do
		local item = table.remove(unowned, self.Rng:NextInteger(1, #unowned))
		table.insert(offers, { Kind = "Cosmetic", Id = item.Id, Name = item.Name, Price = item.Price })
	end
	if #offers == 0 then
		return ("%s already owns everything in the shop"):format(name)
	end
	local labels = {}
	for i, offer in offers do
		labels[i] = ("%s (%d coins)"):format(offer.Name, offer.Price)
	end
	table.insert(labels, "Leave")
	local pick = self:ask(seat, {
		Kind = "Shop",
		Prompt = "Shop: buy something?",
		Options = labels,
		Default = #labels,
		Data = { Items = offers },
	})
	local offer = offers[pick]
	if not offer then
		return ("%s left the shop"):format(name)
	end
	if offer.Kind == "Item" and #seat.Items >= Config.Items.MaxHeld then
		return ("%s has no room for the %s"):format(name, offer.Name)
	end
	if not self.Deps.Wallet.spend(seat.Participant, offer.Price) then
		return ("%s can't afford the %s"):format(name, offer.Name)
	end
	if offer.Kind == "Item" then
		self:giveItem(seat, offer.Id)
	else
		self:grantCosmetic(seat, offer.Id)
	end
	return ("%s bought a %s"):format(name, offer.Name)
end

-- Minigames + bonuses ---------------------------------------------------------------------------

--[[
	Records a minigame for the bonus stats. results: MinigameManager's normalized results
	({ Participant, Placement }); rows: the coin rows ({ Id, Coins }).
]]
function Match:recordMinigame(results, rows)
	local coinsById = {}
	for _, row in rows or {} do
		coinsById[row.Id] = row.Coins
	end
	for _, result in results or {} do
		local seat = self:seatOf(result.Participant)
		if seat then
			seat.Stats.MinigamePoints += Config.MinigamePointsByPlacement[result.Placement] or 0
			seat.Stats.CoinsEarned += coinsById[result.Participant.Id] or 0
		end
	end
end

--[[
	Hands out Config.Bonuses. Returns { { Bonus, Winners = {seats}, Value } } in config order.
	A bonus nobody scored on (best value 0) goes to nobody.
]]
function Match:awardBonuses(bonuses)
	local awarded = {}
	for _, bonus in bonuses or Config.Bonuses do
		local best = 0
		for _, seat in self.Seats do
			best = math.max(best, seat.Stats[bonus.Stat] or 0)
		end
		local winners = {}
		if best > 0 then
			for _, seat in self.Seats do
				if (seat.Stats[bonus.Stat] or 0) == best then
					table.insert(winners, seat)
				end
			end
			if #winners > 1 and not bonus.AwardTies then
				winners = {}
			end
		end
		for _, seat in winners do
			self.Deps.Wallet.addCollectibles(seat.Participant, bonus.Crowns or 1)
		end
		table.insert(awarded, { Bonus = bonus, Winners = winners, Value = best })
	end
	return awarded
end

-- Seats -----------------------------------------------------------------------------------------

-- A bot takes over a seat (its player left). Coins, collectibles, items and stats carry over.
function Match:replaceParticipant(seat, newParticipant)
	self.Deps.Wallet.transfer(seat.Participant, newParticipant)
	seat.Participant = newParticipant
end

--[[
	A returning player takes back the seat a bot kept for them. It is the same seat, so its
	position, items, stats and turn order carry over untouched; only control (and the wallet)
	moves. Refuses anything that would seat someone twice or push out a player who is here.
	Who may claim which seat (by UserId) is checked by SeatClaims before this.
	Returns ok, the participant who was replaced (or a reason).
]]
function Match:reclaimSeat(seat, participant): (boolean, any)
	if not participant or participant.IsBot or not table.find(self.Seats, seat) then
		return false, "invalid"
	end
	local previous = seat.Participant
	if not (previous.IsBot or previous.Left) then
		return false, "occupied"
	end
	for _, other in self.Seats do
		if other ~= seat and other.Participant.Id == participant.Id then
			return false, "seated"
		end
	end
	self:replaceParticipant(seat, participant)
	return true, previous
end

-- Bots ------------------------------------------------------------------------------------------

-- What a bot picks for an Ask request. `skill` is 0..1.
function Match:botDecision(seat, request, skill: number?): number
	return BotBrain.decide(self, seat, request, BotBrain.profile(self.Difficulty), skill or 0.5)
end

-- Which item (slot, target seat) a bot uses before rolling, or nil.
function Match:botItemChoice(seat)
	return BotBrain.chooseItem(self, seat, BotBrain.profile(self.Difficulty))
end

-- Standings -------------------------------------------------------------------------------------

--[[
	Ranks rows { Participant, Collectibles, Coins, ... }: most collectibles first, coins break
	ties, and rows equal on both share a placement. Returns a new sorted list with Placement set.
]]
function Match.rank(rows)
	local sorted = table.clone(rows)
	table.sort(sorted, function(a, b)
		if a.Collectibles ~= b.Collectibles then
			return a.Collectibles > b.Collectibles
		end
		if a.Coins ~= b.Coins then
			return a.Coins > b.Coins
		end
		return (a.SeatIndex or 0) < (b.SeatIndex or 0)
	end)
	for i, row in sorted do
		local previous = sorted[i - 1]
		if previous and previous.Collectibles == row.Collectibles and previous.Coins == row.Coins then
			row.Placement = previous.Placement
		else
			row.Placement = i
		end
	end
	return sorted
end

function Match:standings()
	local rows = {}
	for _, seat in self.Seats do
		table.insert(rows, {
			Participant = seat.Participant,
			SeatIndex = seat.Index,
			Collectibles = self:collectiblesOf(seat),
			Coins = self:coinsOf(seat),
		})
	end
	return Match.rank(rows)
end

return Match
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">RotatingBridge</string>
            <string name="Source"><![CDATA[-- Pure topology; no yields, rendering, randomness or mutation during queries.
local Bridge = {}
Bridge.Docks = {1,9,17,25}
function Bridge.isMoving(id) return id >= 33 and id <= 36 end
function Bridge.connected(zone, orientation)
 return zone == 0 or (if orientation == 0 then zone == 1 or zone == 3 else zone == 2 or zone == 4)
end
function Bridge.options(board, id, orientation)
 local options = {}
 for _, target in board:nextOptions(id) do
  local fromZone,toZone = board:get(id).Zone,board:get(target).Zone
  if fromZone == toZone or (Bridge.connected(fromZone,orientation) and Bridge.connected(toZone,orientation)) then
   table.insert(options,target)
  end
 end
 return options
end
function Bridge.distance(board, from, target, orientation)
 local queue,seen,head = {from},{[from]=0},1
 while queue[head] do
  local id=queue[head]; head+=1
  if id==target then return seen[id] end
  for _,nextId in Bridge.options(board,id,orientation) do
   if seen[nextId]==nil then seen[nextId]=seen[id]+1;table.insert(queue,nextId) end
  end
 end
 return math.huge
end
function Bridge.snapshot(match)
 if not match.Board.Bridge then return nil end
 local docks={}
 for zone,id in Bridge.Docks do
  table.insert(docks,{SpaceId=id,Name=match.Board.Zones[zone],Open=Bridge.connected(zone,match.Orientation)})
 end
 return { Orientation=match.Orientation, Alignment=if match.Orientation==0 then "N–S" else "E–W",
  NextAlignment=if match.Orientation==0 then "E–W" else "N–S", Revision=match.BridgeRevision,
  DialReadyRound=match.DialReadyRound, NextRound=match.LastRotationRound+match.Board.Bridge.EveryRounds,
  Docks=docks }
end
-- Validate this mechanism's contract as well as the union graph checked by BoardLayout.
function Bridge.validate(data)
 if not data.Bridge then return nil end
 local rule=data.Bridge
 if type(rule.EveryRounds)~="number" or rule.EveryRounds<1 or rule.EveryRounds%1~=0 then return "bridge needs a positive round interval" end
 if type(rule.WarningSeconds)~="number" or rule.WarningSeconds<0 or type(rule.RotationSeconds)~="number" or rule.RotationSeconds<=0 then return "bridge needs valid warning and rotation durations" end
 if type(rule.DialCooldownRounds)~="number" or rule.DialCooldownRounds<2 then return "Moon Dial cooldown must preserve a full automatic interval" end
 if not data.Zones or #data.Zones~=4 or #data.Spaces~=36 then return "moon bridge needs four eight-space zones and four moving spaces" end
 local byId={}
 for _,space in data.Spaces do byId[space.Id]=space end
 for zone=1,4 do
  for n=1,8 do
   local id=(zone-1)*8+n
   local space=byId[id]
   if not space or space.Zone~=zone or space.Next[1]~=(zone-1)*8+n%8+1 then return "each zone needs an uninterrupted local loop" end
   for _,target in space.Next do
    local allowed=target==(zone-1)*8+n%8+1 or (n==1 and target==(if zone<=2 then 33 else 36))
    if not allowed then return "zone edge bypasses the rotating bridge" end
   end
  end
 end
 local expected={ [33]={34,1,9}, [34]={33,35}, [35]={34,36}, [36]={35,17,25} }
 for id,edges in expected do
  local space=byId[id]
  if not space or space.Zone~=0 or #space.Next~=#edges then return "invalid straight bridge" end
  for _,target in edges do if not table.find(space.Next,target) then return "invalid bridge connection" end end
 end
 if not table.find(data.CrownSpaces,34) or not table.find(data.CrownSpaces,35) then return "bridge needs configured Crown fallback spaces" end
 return nil
end
return Bridge
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">SpaceTypes</string>
            <string name="Source"><![CDATA[--[[
	SpaceTypes
	What every kind of board space looks like and does. Board layouts refer to these by key.

	Each type:
	  Name      shown in the legend / landing toast
	  Short     a few characters drawn on the tile
	  Color     tile colour
	  Resolve   function(match, seat, space) -> string?  runs when a piece LANDS here
	            (passing over a space does nothing). Return a short line for the feed.
	            Use the match helpers: changeCoins, runEvent, runChaos, giveReward,
	            visitShop, itemSpace, runDuel, runSwitch.

	To add a type: add an entry here, then use its key in a board's Spaces.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.PartyShared.Config)

local function coinsText(name: string, delta: number, shielded: boolean?): string
	if shielded then
		return ("%s's Coin Shield blocked the loss and broke"):format(name)
	elseif delta == 0 then
		return ("%s has no coins to lose"):format(name)
	end
	return ("%s %s %d coins"):format(name, if delta > 0 then "gets" else "loses", math.abs(delta))
end

return {
	Neutral = {
		Name = "Plain space",
		Short = "",
		Color = Color3.fromRGB(200, 200, 215),
		Resolve = function()
			return nil
		end,
	},
	Gain = {
		Name = "Coin space",
		Short = "+" .. Config.Economy.GainSpaceCoins,
		Color = Color3.fromRGB(70, 140, 255),
		Resolve = function(match, seat)
			return coinsText(seat.Participant.Name, match:changeCoins(seat, match:spaceCoins(Config.Economy.GainSpaceCoins)))
		end,
	},
	Lose = {
		Name = "Ouch space",
		Short = "-" .. Config.Economy.LoseSpaceCoins,
		Color = Color3.fromRGB(240, 70, 70),
		Resolve = function(match, seat)
			local delta, shielded = match:changeCoins(seat, -match:spaceCoins(Config.Economy.LoseSpaceCoins))
			return coinsText(seat.Participant.Name, delta, shielded)
		end,
	},
	Event = {
		Name = "Event space",
		Short = "?",
		Color = Color3.fromRGB(80, 200, 110),
		Resolve = function(match, seat)
			return match:runEvent(seat)
		end,
	},
	Shop = {
		Name = "Shop",
		Short = "SHOP",
		Color = Color3.fromRGB(170, 90, 230),
		Resolve = function(match, seat)
			return match:visitShop(seat)
		end,
	},
	Item = {
		Name = "Item space",
		Short = "ITEM",
		Color = Color3.fromRGB(60, 200, 210),
		Resolve = function(match, seat)
			return match:itemSpace(seat)
		end,
	},
	Duel = {
		Name = "Duel space",
		Short = "DUEL",
		Color = Color3.fromRGB(255, 140, 40),
		Resolve = function(match, seat)
			return match:runDuel(seat)
		end,
	},
	Chaos = {
		Name = "Chaos space",
		Short = "!",
		Color = Color3.fromRGB(90, 40, 120),
		Resolve = function(match, seat)
			return match:runChaos(seat)
		end,
	},
	Switch = {
		Name = "Switch space",
		Short = "SWITCH",
		Color = Color3.fromRGB(240, 240, 255),
		Resolve = function(match, seat)
			return match:runSwitch(seat)
		end,
	},
	Reward = {
		Name = "Gift space",
		Short = "GIFT",
		Color = Color3.fromRGB(255, 190, 40),
		Resolve = function(match, seat)
			return match:giveReward(seat)
		end,
	},
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">BotService</string>
          <string name="Source"><![CDATA[--[[
	BotService
	Owns the AI players that fill empty seats.

	  BotService.getBots(count)    returns `count` bots with living bodies, creating/despawning as needed
	  BotService.setBrain(fn)      fn(bot, dt) runs every Config.BotThinkInterval for each live bot;
	                               the MinigameManager points this at the active minigame's UpdateBot
	  BotService.setActionHandler  how bot:Input(action) reaches the server (same path as player input)

	The Bot object a minigame's UpdateBot(bot, dt) receives:
	  bot.Participant              the bot's Participant for this round
	  bot.Memory                   scratch table, wiped every round - store your per-bot state here
	  bot.Skill                    0..1, use it to make some bots sloppier than others
	  bot:GetPosition()            Vector3?
	  bot:MoveTo(position)         walk towards a point
	  bot:Stop()
	  bot:Jump()
	  bot:Input(actionName)        press a minigame action exactly like a player would
	  bot:IsAlive()
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.PartyShared.Config)

local BotService = {}

local rng = Random.new()
local skillRange = Config.Match.BotDifficulties[Config.Match.BotDifficulty]
local bots = {} -- every bot we currently own, in seat order
local nextBotNumber = 0
local brain: ((any, number) -> ())? = nil
local actionHandler: ((any, string) -> ())? = nil
local botFolder: Folder? = nil

-- Bot ------------------------------------------------------------------------------

local Bot = {}
Bot.__index = Bot

function Bot:IsAlive(): boolean
	local model = self.Model
	local humanoid = self.Humanoid
	return model ~= nil and model.Parent ~= nil and humanoid ~= nil and humanoid.Health > 0
end

function Bot:GetPosition(): Vector3?
	return if self:IsAlive() then self.Root.Position else nil
end

function Bot:MoveTo(position: Vector3)
	if self:IsAlive() then
		self.Humanoid:MoveTo(position)
	end
end

function Bot:Stop()
	if self:IsAlive() then
		self.Humanoid:MoveTo(self.Root.Position)
	end
end

function Bot:Jump()
	if self:IsAlive() then
		self.Humanoid.Jump = true
	end
end

function Bot:Input(action: string)
	if actionHandler and self.Participant then
		actionHandler(self.Participant, action)
	end
end

-- Bodies -----------------------------------------------------------------------------

local function getFolder(): Folder
	if not botFolder or not botFolder.Parent then
		local folder = Instance.new("Folder")
		folder.Name = "PartyBots"
		folder.Parent = Workspace
		botFolder = folder
	end
	return botFolder :: Folder
end

-- Plain blocky rig, only used if Roblox can't build an avatar (e.g. asset service hiccup).
local function buildFallbackRig(color: Color3): Model
	local model = Instance.new("Model")

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	root.Color = color
	root.Parent = model

	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = Vector3.new(1.6, 1.6, 1.6)
	head.Color = color
	head.CFrame = root.CFrame * CFrame.new(0, 1.8, 0)
	head.Parent = model

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = head
	weld.Parent = root

	local humanoid = Instance.new("Humanoid")
	humanoid.HipHeight = 2
	humanoid.Parent = model

	model.PrimaryPart = root
	return model
end

local function buildBody(name: string): Model
	local color = Color3.fromHSV(rng:NextNumber(), 0.6, 1)
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = color
	description.TorsoColor = color
	description.LeftArmColor = color
	description.RightArmColor = color
	description.LeftLegColor = color:Lerp(Color3.new(0, 0, 0), 0.3)
	description.RightLegColor = color:Lerp(Color3.new(0, 0, 0), 0.3)

	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("[BotService] Avatar build failed, using fallback rig:", model)
		model = buildFallbackRig(color)
	end

	model.Name = name
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	humanoid.DisplayName = "🤖 " .. name
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Subject
	return model
end

-- Gives the bot a fresh body at `cframe`, replacing a dead or missing one.
local function respawn(bot, cframe: CFrame)
	if bot.Model then
		bot.Model:Destroy()
	end
	local model = buildBody(bot.Name)
	model:SetAttribute("PartyId", bot.Id) -- CosmeticService finds the bot's cosmetics by this
	model:PivotTo(cframe)
	model.Parent = getFolder()

	bot.Model = model
	bot.Humanoid = model:FindFirstChildOfClass("Humanoid")
	bot.Root = model:FindFirstChild("HumanoidRootPart")
	-- Server owns bot physics so MoveTo is smooth and nobody can hijack bots.
	bot.Root:SetNetworkOwner(nil)
end

local function pickName(): string
	local used = {}
	for _, bot in bots do
		used[bot.Name] = true
	end
	local candidates = {}
	for _, name in Config.BotNames do
		if not used[name] then
			table.insert(candidates, name)
		end
	end
	if #candidates == 0 then
		return "Bot " .. nextBotNumber
	end
	return candidates[rng:NextInteger(1, #candidates)]
end

local function createBot()
	nextBotNumber += 1
	local bot = setmetatable({
		Id = "bot_" .. nextBotNumber,
		Name = pickName(),
		Skill = rng:NextNumber(skillRange[1], skillRange[2]),
		Memory = {},
		Participant = nil,
		Model = nil,
		Humanoid = nil,
		Root = nil,
	}, Bot)
	return bot
end

-- Public API -------------------------------------------------------------------------

--[[
	Returns exactly `count` bots, each with a living body somewhere near `spawnAt(index)`.
	Extra bots from a previous round (e.g. a real player joined) are removed.
]]
function BotService.getBots(count: number, spawnAt: (number) -> CFrame)
	while #bots > count do
		local bot = table.remove(bots) :: any
		if bot.Model then
			bot.Model:Destroy()
		end
	end
	while #bots < count do
		table.insert(bots, createBot())
	end

	for index, bot in bots do
		bot.Memory = {}
		bot.Participant = nil
		if not bot:IsAlive() then
			respawn(bot, spawnAt(index))
		end
	end
	return table.clone(bots)
end

-- Removes one bot for good (a takeover bot whose player came back for their seat). Other
-- bots, including the ones filling empty seats, are left alone.
function BotService.release(bot)
	local index = table.find(bots, bot)
	if index then
		table.remove(bots, index)
	end
	bot.Participant = nil
	if bot.Model then
		bot.Model:Destroy()
		bot.Model = nil
	end
end

-- Respawns any bot whose body died during the round.
function BotService.reviveAll(spawnAt: (number) -> CFrame)
	for index, bot in bots do
		if not bot:IsAlive() then
			respawn(bot, spawnAt(index))
		end
	end
end

-- Match difficulty: every bot (current and future) gets a skill in [min, max].
function BotService.setSkillRange(range: { number })
	skillRange = range
	for _, bot in bots do
		bot.Skill = rng:NextNumber(range[1], range[2])
	end
end

function BotService.setBrain(fn: ((any, number) -> ())?)
	brain = fn
	for _, bot in bots do
		bot.Memory = {}
	end
end

function BotService.setActionHandler(fn: (any, string) -> ())
	actionHandler = fn
end

-- Think loop -------------------------------------------------------------------------

local accumulated = 0
RunService.Heartbeat:Connect(function(dt)
	accumulated += dt
	if accumulated < Config.BotThinkInterval then
		return
	end
	local step = accumulated
	accumulated = 0

	local currentBrain = brain
	if not currentBrain then
		return
	end
	for _, bot in bots do
		if bot.Participant and bot:IsAlive() then
			local ok, err = pcall(currentBrain, bot, step)
			if not ok then
				warn(("[BotService] %s's brain errored: %s"):format(bot.Name, tostring(err)))
			end
		end
	end
end)

return BotService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">CoinService</string>
          <string name="Source"><![CDATA[--[[
	CoinService
	Server-authoritative wallets: coins and the match collectible (Config.Collectible) for
	every seat, players and bots alike, keyed by participant Id. Real players also get
	leaderstats so the values show in the Roblox player list.

	Wallets are per match: BoardGame calls resetAll() when a match starts.
	(No persistence yet; add DataStore saving once the session systems are stable.)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.PartyShared.Config)

local CoinService = {}

local wallets: { [string]: { Coins: number, Collectibles: number } } = {}
local playersById: { [string]: Player } = {}

local function setupPlayer(player: Player)
	if player:FindFirstChild("leaderstats") then
		return
	end
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	-- Collectible first: it's what the player list sorts by.
	local collectibles = Instance.new("IntValue")
	collectibles.Name = Config.Collectible.Plural
	collectibles.Parent = leaderstats
	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Parent = leaderstats
	leaderstats.Parent = player
end

local function wallet(participant)
	local entry = wallets[participant.Id]
	if not entry then
		entry = { Coins = 0, Collectibles = 0 }
		wallets[participant.Id] = entry
	end
	if participant.Player then
		playersById[participant.Id] = participant.Player
	end
	return entry
end

-- Copies a wallet into the owner's leaderstats (real players only).
local function mirror(id: string)
	local player = playersById[id]
	local entry = wallets[id]
	local leaderstats = player and player.Parent and player:FindFirstChild("leaderstats")
	if not leaderstats then
		return
	end
	local coins = leaderstats:FindFirstChild("Coins")
	local collectibles = leaderstats:FindFirstChild(Config.Collectible.Plural)
	if coins then
		coins.Value = if entry then entry.Coins else 0
	end
	if collectibles then
		collectibles.Value = if entry then entry.Collectibles else 0
	end
end

function CoinService.get(participant): number
	return wallet(participant).Coins
end

function CoinService.getCollectibles(participant): number
	return wallet(participant).Collectibles
end

-- Adds (or with a negative amount, removes) coins. Never goes below 0.
-- Returns the new total and how many coins actually changed hands.
function CoinService.add(participant, amount: number): (number, number)
	local entry = wallet(participant)
	local before = entry.Coins
	entry.Coins = math.max(0, before + math.floor(amount))
	mirror(participant.Id)
	return entry.Coins, entry.Coins - before
end

function CoinService.addCollectibles(participant, amount: number): number
	local entry = wallet(participant)
	entry.Collectibles = math.max(0, entry.Collectibles + math.floor(amount))
	mirror(participant.Id)
	return entry.Collectibles
end

-- Takes `amount` coins only if the participant has them all. Returns true if paid.
function CoinService.spend(participant, amount: number): boolean
	local entry = wallet(participant)
	if amount < 0 or entry.Coins < amount then
		return false
	end
	entry.Coins -= amount
	mirror(participant.Id)
	return true
end

-- A bot taking over a seat inherits everything the leaver had.
-- Also used when a returning player takes their seat back from that bot. A returning player
-- whose seat never changed hands has the same Id, so the wallet already is theirs.
function CoinService.transfer(from, to)
	if from.Id == to.Id then
		wallet(to)
		mirror(to.Id)
		return
	end
	local entry = wallet(from)
	local target = wallet(to)
	target.Coins += entry.Coins
	target.Collectibles += entry.Collectibles
	wallets[from.Id] = nil
	mirror(from.Id)
	mirror(to.Id)
end

-- Fresh match: everyone back to zero.
function CoinService.resetAll()
	table.clear(wallets)
	for id in playersById do
		mirror(id)
	end
end

Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(function(player)
	for id, owner in playersById do
		if owner == player then
			playersById[id] = nil
		end
	end
end)
for _, player in Players:GetPlayers() do
	setupPlayer(player)
end

return CoinService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">CosmeticService</string>
          <string name="Source"><![CDATA[--[[
	CosmeticService
	Makes equipped cosmetics (Inventory) visible on characters, players and bots alike, and
	handles equip / unequip requests from clients.

	Drawing is self-healing: every REFRESH_INTERVAL it compares each character's drawn
	cosmetics with what its owner has equipped and redraws on any difference. That covers
	respawns, resets, board <-> minigame teleports, bot respawns and bot takeovers without
	hooking each one. Placeholder looks come from Cosmetics.Items[].Visual.

	Clients can only ask; requestEquip checks ownership through Inventory.equip.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Cosmetics = require(ReplicatedStorage.PartyShared.Cosmetics)
local Net = require(ReplicatedStorage.PartyShared.Net)
local Inventory = require(script.Parent.Inventory)

local CosmeticService = {}

local REFRESH_INTERVAL = 0.5
local TAG = "PartyCosmetic" -- name prefix of everything we add to a character
local KEY_ATTRIBUTE = "PartyCosmeticKey"

local sendToPlayer: ((Player, any) -> ())? = nil
local bankCoinsOf: ((Player) -> number)? = nil

local function color(rgb): Color3
	return Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end

-- Stable text describing an equipped set, e.g. "Hat=hat_party;Trail=trail_rainbow".
function CosmeticService.keyOf(equipped): string
	local parts = {}
	for _, slot in Cosmetics.Slots do
		if equipped[slot] then
			table.insert(parts, slot .. "=" .. equipped[slot])
		end
	end
	return table.concat(parts, ";")
end

local function clear(character: Model)
	for _, descendant in character:GetDescendants() do
		if string.sub(descendant.Name, 1, #TAG) == TAG then
			descendant:Destroy()
		end
	end
end

local function drawHat(character: Model, visual)
	local head = character:FindFirstChild("Head") :: BasePart?
	if not head then
		return
	end
	local size = Vector3.new(visual.Size[1], visual.Size[2], visual.Size[3])
	local hat = Instance.new("Part")
	hat.Name = TAG .. "_Hat"
	hat.Shape = Enum.PartType[visual.Shape] or Enum.PartType.Block
	hat.Size = size
	hat.Color = color(visual.Color)
	hat.Material = Enum.Material.SmoothPlastic
	hat.CanCollide = false
	hat.CanQuery = false
	hat.CanTouch = false
	hat.Massless = true
	-- Cylinders run along X: stand them up.
	local height = if hat.Shape == Enum.PartType.Cylinder then size.X else size.Y
	local tilt = if hat.Shape == Enum.PartType.Cylinder then CFrame.Angles(0, 0, math.pi / 2) else CFrame.identity
	hat.CFrame = head.CFrame * CFrame.new(0, head.Size.Y / 2 + height / 2 - 0.1, 0) * tilt
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = hat
	weld.Parent = hat
	hat.Parent = character
end

local function drawTrail(character: Model, visual)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local top = Instance.new("Attachment")
	top.Name = TAG .. "_TrailTop"
	top.Position = Vector3.new(0, 0.8, 0)
	top.Parent = root
	local bottom = Instance.new("Attachment")
	bottom.Name = TAG .. "_TrailBottom"
	bottom.Position = Vector3.new(0, -0.8, 0)
	bottom.Parent = root
	local trail = Instance.new("Trail")
	trail.Name = TAG .. "_Trail"
	trail.Attachment0 = top
	trail.Attachment1 = bottom
	trail.Lifetime = 0.45
	trail.Color = ColorSequence.new(color(visual.Colors[1]), color(visual.Colors[2]))
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.Parent = root
end

local function drawSparkles(character: Model, visual)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local sparkles = Instance.new("Sparkles")
	sparkles.Name = TAG .. "_Sparkles"
	sparkles.SparkleColor = color(visual.Color)
	sparkles.Parent = root
end

local drawers = { Hat = drawHat, Trail = drawTrail, Sparkles = drawSparkles }

-- Redraws a character's cosmetics to match `equipped` ({ [slot] = itemId }).
function CosmeticService.apply(character: Model, equipped)
	clear(character)
	for _, slot in Cosmetics.Slots do
		local item = equipped[slot] and Cosmetics.get(equipped[slot])
		local draw = item and item.Visual and drawers[item.Visual.Kind]
		if draw then
			draw(character, item.Visual)
		end
	end
	character:SetAttribute(KEY_ATTRIBUTE, CosmeticService.keyOf(equipped))
end

local function refresh(character: Model?, ownerId: string)
	if not character or not character.Parent or not character:FindFirstChild("Head") then
		return
	end
	local equipped = Inventory.getEquipped(ownerId)
	if character:GetAttribute(KEY_ATTRIBUTE) ~= CosmeticService.keyOf(equipped) then
		CosmeticService.apply(character, equipped)
	end
end

function CosmeticService.refreshAll()
	for _, player in Players:GetPlayers() do
		refresh(player.Character, "player_" .. player.UserId)
	end
	local bots = Workspace:FindFirstChild("PartyBots")
	for _, model in if bots then bots:GetChildren() else {} do
		local id = model:GetAttribute("PartyId")
		if model:IsA("Model") and type(id) == "string" then
			refresh(model, id)
		end
	end
end

-- Equip requests -----------------------------------------------------------------------------

-- Equip an owned cosmetic. Anything unowned or unknown is refused (returns false).
function CosmeticService.requestEquip(ownerId: string, itemId): boolean
	if type(itemId) ~= "string" then
		return false
	end
	return Inventory.equip(ownerId, itemId)
end

function CosmeticService.requestUnequip(ownerId: string, slot): boolean
	if type(slot) ~= "string" or not table.find(Cosmetics.Slots, slot) then
		return false
	end
	Inventory.unequip(ownerId, slot)
	return true
end

-- What a player's client needs for the wardrobe.
function CosmeticService.inventoryMessage(player: Player)
	local ownerId = "player_" .. player.UserId
	local owned = {}
	for _, itemId in Inventory.getOwned(ownerId) do
		local item = Cosmetics.get(itemId)
		if item then
			table.insert(owned, { Id = item.Id, Name = item.Name, Slot = item.Slot })
		end
	end
	return {
		Type = Net.Message.Inventory,
		Owned = owned,
		Equipped = Inventory.getEquipped(ownerId),
		BankCoins = if bankCoinsOf then bankCoinsOf(player) else 0,
	}
end

function CosmeticService.sendInventory(player: Player)
	if sendToPlayer and player.Parent then
		sendToPlayer(player, CosmeticService.inventoryMessage(player))
	end
end

function CosmeticService.handleInput(player: Player, payload): boolean
	local ownerId = "player_" .. player.UserId
	if payload.Kind == Net.Input.Equip then
		CosmeticService.requestEquip(ownerId, payload.ItemId)
	elseif payload.Kind == Net.Input.Unequip then
		CosmeticService.requestUnequip(ownerId, payload.Slot)
	else
		return false
	end
	CosmeticService.sendInventory(player) -- also corrects a client that guessed wrong
	return true
end

--[[
	Starts the redraw loop and wires messages. send(player, message) delivers to one client;
	getBankCoins(player) -> number shows permanent coins in the wardrobe (Profiles).
]]
function CosmeticService.start(send: (Player, any) -> (), getBankCoins: ((Player) -> number)?)
	sendToPlayer = send
	bankCoinsOf = getBankCoins
	Inventory.onChanged(function(ownerId)
		local userId = tonumber(string.match(ownerId, "^player_(%d+)$"))
		local player = userId and Players:GetPlayerByUserId(userId)
		if player then
			CosmeticService.sendInventory(player)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		Inventory.forget("player_" .. player.UserId)
	end)
	task.spawn(function()
		while true do
			local ok, err = pcall(CosmeticService.refreshAll)
			if not ok then
				warn("[CosmeticService] " .. tostring(err))
			end
			task.wait(REFRESH_INTERVAL)
		end
	end)
end

return CosmeticService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">CosmeticShop</string>
          <string name="Source"><![CDATA[--[[
	CosmeticShop
	The permanent cosmetics shop in the lobby. Players spend permanent bank coins (their
	profile's Coins), never match coins, and what they buy is owned for good through the
	profile layer (Inventory's record for a player IS their profile's Owned/Equipped tables).

	Every request is checked here on the server:
	  * the item id must be a string naming a real catalog item
	  * the price always comes from the catalog (Cosmetics.bankPrice); anything a client
	    sends about prices is ignored
	  * the buyer must have a loaded profile, must not own it yet, and must afford it
	  * one purchase at a time per player, and at most one every MIN_INTERVAL seconds

	  local shop = CosmeticShop.new(store, inventory, clock?)   (tests build their own)
	  shop:buy(key, itemId) -> ok, code, message
	      codes: "ok" | "bad_request" | "unknown_item" | "owned" | "too_fast" | "no_profile"
	             | "insufficient"
	  CosmeticShop.start(send, onChanged)   live wiring (Main): handles Input.BuyCosmetic
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Cosmetics = require(ReplicatedStorage.PartyShared.Cosmetics)
local Net = require(ReplicatedStorage.PartyShared.Net)

local CosmeticShop = {}
CosmeticShop.__index = CosmeticShop

CosmeticShop.MIN_INTERVAL = 0.75 -- seconds between purchase attempts per player

function CosmeticShop.new(store, inventory, clock)
	return setmetatable({
		Store = store,
		Inventory = inventory,
		Clock = clock or os.clock,
		LastAttempt = {},
		Busy = {},
	}, CosmeticShop)
end

function CosmeticShop:buy(key: string, itemId): (boolean, string, string)
	if type(itemId) ~= "string" or #itemId > 64 then
		return false, "bad_request", "That isn't a shop item."
	end
	local item = Cosmetics.get(itemId)
	if not item then
		return false, "unknown_item", "That item isn't in the shop."
	end
	local now = self.Clock()
	if self.Busy[key] or (self.LastAttempt[key] and now - self.LastAttempt[key] < CosmeticShop.MIN_INTERVAL) then
		return false, "too_fast", "One moment..."
	end
	self.LastAttempt[key] = now
	local profile = self.Store:get(key)
	if not profile then
		return false, "no_profile", "Your profile hasn't loaded yet. Try again in a moment."
	end
	if self.Inventory.owns(key, itemId) then
		return false, "owned", ("You already own the %s."):format(item.Name)
	end
	local price = Cosmetics.bankPrice(item)
	if profile.Coins < price then
		return false, "insufficient", ("The %s costs %d bank coins. You have %d."):format(item.Name, price, profile.Coins)
	end

	self.Busy[key] = true
	self.Store:addCoins(key, -price)
	local granted = self.Inventory.grant(key, itemId)
	if not granted then
		self.Store:addCoins(key, price) -- refund; shouldn't happen after the checks above
		self.Busy[key] = nil
		return false, "owned", ("You already own the %s."):format(item.Name)
	end
	if not self.Inventory.getEquipped(key)[item.Slot] then
		self.Inventory.equip(key, itemId) -- first item in a slot goes straight on
	end
	self.Busy[key] = nil
	task.spawn(self.Store.save, self.Store, key) -- save a purchase right away, not just at the next autosave
	return true, "ok", ("Bought the %s for %d bank coins!"):format(item.Name, price)
end

-- Live wiring --------------------------------------------------------------------------------

local live = nil

--[[
	send(player, message) delivers to one client; onChanged(player) refreshes their inventory
	(owned, equipped, bank coins). store/inventory are the game's Profiles store and Inventory.
]]
function CosmeticShop.start(store, inventory, send, onChanged)
	live = { Shop = CosmeticShop.new(store, inventory), Send = send, OnChanged = onChanged }
	Players.PlayerRemoving:Connect(function(player)
		local key = "player_" .. player.UserId
		live.Shop.LastAttempt[key] = nil
		live.Shop.Busy[key] = nil
	end)
end

function CosmeticShop.handleInput(player: Player, payload): boolean
	if payload.Kind ~= Net.Input.BuyCosmetic then
		return false
	end
	if not live then
		return true
	end
	local itemId = payload.ItemId -- payload.Price or anything else from the client is ignored
	local ok, code, text = live.Shop:buy("player_" .. player.UserId, itemId)
	live.Send(player, {
		Type = Net.Message.ShopResult,
		Ok = ok,
		Code = code,
		ItemId = if type(itemId) == "string" and #itemId <= 64 then itemId else nil,
		Text = text,
	})
	if ok then
		live.OnChanged(player)
	end
	return true
end

return CosmeticShop
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Inventory</string>
          <string name="Source"><![CDATA[--[[
	Inventory
	Who owns which cosmetic (PartyShared.Cosmetics) and what each owner has equipped.
	Server-authoritative; owners are participant Ids ("player_123", "bot_4").

	Players' records are their permanent profile tables (Profiles attaches them on join), so
	what they own and wear is saved with the profile. Bots get plain records that are wiped
	at the end of every match (resetBots).

	Inventory.onChanged(fn(ownerId)) fires after anything changes (CosmeticService redraws
	characters and tells the owner's client).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Cosmetics = require(ReplicatedStorage.PartyShared.Cosmetics)

local Inventory = {}

local owners: { [string]: { Owned: { [string]: boolean }, Equipped: { [string]: string } } } = {}
local listeners: { (string) -> () } = {}

local function entry(ownerId: string)
	local record = owners[ownerId]
	if not record then
		record = { Owned = {}, Equipped = {} }
		owners[ownerId] = record
	end
	return record
end

local function changed(ownerId: string)
	for _, listener in listeners do
		task.spawn(listener, ownerId)
	end
end

function Inventory.onChanged(fn: (string) -> ())
	table.insert(listeners, fn)
end

-- Uses `owned` / `equipped` (a player's profile tables) as this owner's record, so every
-- change lands straight in the profile.
function Inventory.attach(ownerId: string, owned: { [string]: boolean }, equipped: { [string]: string })
	owners[ownerId] = { Owned = owned, Equipped = equipped }
	changed(ownerId)
end

function Inventory.owns(ownerId: string, itemId: string): boolean
	local record = owners[ownerId]
	return record ~= nil and record.Owned[itemId] == true
end

-- Gives an item. Returns false for unknown items or ones already owned.
function Inventory.grant(ownerId: string, itemId: string): boolean
	if not Cosmetics.get(itemId) or Inventory.owns(ownerId, itemId) then
		return false
	end
	entry(ownerId).Owned[itemId] = true
	changed(ownerId)
	return true
end

-- Equips an owned item into its slot (replacing whatever was there).
function Inventory.equip(ownerId: string, itemId: string): boolean
	local item = Cosmetics.get(itemId)
	if not item or not Inventory.owns(ownerId, itemId) then
		return false
	end
	entry(ownerId).Equipped[item.Slot] = itemId
	changed(ownerId)
	return true
end

function Inventory.unequip(ownerId: string, slot: string)
	local record = owners[ownerId]
	if record and record.Equipped[slot] then
		record.Equipped[slot] = nil
		changed(ownerId)
	end
end

function Inventory.getEquipped(ownerId: string): { [string]: string }
	local record = owners[ownerId]
	return if record then table.clone(record.Equipped) else {}
end

function Inventory.getOwned(ownerId: string): { string }
	local list = {}
	local record = owners[ownerId]
	if record then
		for itemId in record.Owned do
			table.insert(list, itemId)
		end
	end
	table.sort(list)
	return list
end

-- Catalog items this owner doesn't have yet.
function Inventory.unowned(ownerId: string)
	local list = {}
	for _, item in Cosmetics.Items do
		if not Inventory.owns(ownerId, item.Id) then
			table.insert(list, item)
		end
	end
	return list
end

function Inventory.forget(ownerId: string)
	owners[ownerId] = nil
end

function Inventory.resetBots()
	for ownerId in owners do
		if string.sub(ownerId, 1, 4) == "bot_" then
			owners[ownerId] = nil
			changed(ownerId)
		end
	end
end

return Inventory
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="30">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Main (server entry point)
	The match loop: waiting room (host picks settings) -> seat 4 participants (real players
	first, bots fill the rest) -> the chosen mode -> back to the waiting room.
	  Board mode       BoardGame.play (board turns + a minigame every round -> bonuses -> standings)
	  Minigames mode   MinigameMode.play (back-to-back minigames, most coins wins)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.PartyShared.Config)
local Arena = require(script.Parent.Arena)
local BoardGame = require(script.Parent.Board.BoardGame)
local BotService = require(script.Parent.BotService)
local CosmeticService = require(script.Parent.CosmeticService)
local CosmeticShop = require(script.Parent.CosmeticShop)
local Inventory = require(script.Parent.Inventory)
local MinigameManager = require(script.Parent.MinigameManager)
local MinigameMode = require(script.Parent.MinigameMode)
local Participant = require(script.Parent.Participant)
local Profiles = require(script.Parent.Profiles)
local Tutorial = require(script.Parent.Tutorial)
local WaitingRoom = require(script.Parent.WaitingRoom)

Arena.ensureLobby()
MinigameManager.init()
Profiles.start() -- before cosmetics: a profile's cosmetics attach to Inventory on join
CosmeticService.start(MinigameManager.sendTo, Profiles.bankCoins)
CosmeticShop.start(Profiles.store, Inventory, MinigameManager.sendTo, CosmeticService.sendInventory)
MinigameManager.onReady(CosmeticService.sendInventory)
Tutorial.configure(Profiles.get, MinigameManager.sendTo)
Profiles.onLoaded(Tutorial.onProfileLoaded)
MinigameManager.onReady(Tutorial.send)
-- Studio only (testing the guided first actions again): the client command bar can send
-- { Kind = "ResetTutorial" }. Live servers ignore it; there is no player-facing button.
local function handleDevInput(player, payload): boolean
	if payload.Kind ~= "ResetTutorial" then
		return false
	end
	if RunService:IsStudio() then
		Tutorial.reset(player)
	end
	return true
end
MinigameManager.setInputHandler(function(player, payload)
	return handleDevInput(player, payload)
		or WaitingRoom.handleInput(player, payload)
		or BoardGame.handleInput(player, payload)
		or CosmeticService.handleInput(player, payload)
		or CosmeticShop.handleInput(player, payload)
end)

-- First come, first seated: track join order so seats are fair when >4 players are on.
local joinOrder: { Player } = {}
for _, player in Players:GetPlayers() do
	table.insert(joinOrder, player)
end
Players.PlayerAdded:Connect(function(player)
	table.insert(joinOrder, player)
end)
Players.PlayerRemoving:Connect(function(player)
	local index = table.find(joinOrder, player)
	if index then
		table.remove(joinOrder, index)
	end
end)

local function buildParticipants()
	local participants = {}
	for _, player in joinOrder do
		if #participants >= Config.PlayersPerMatch then
			break -- extra players watch this round from the lobby
		end
		table.insert(participants, Participant.fromPlayer(player))
	end

	local realCount = #participants
	local bots = BotService.getBots(Config.PlayersPerMatch - realCount, function(index)
		return Arena.lobbySpot(realCount + index)
	end)
	for _, bot in bots do
		table.insert(participants, Participant.fromBot(bot))
	end
	return participants
end

local function getHost(): Player?
	return joinOrder[1]
end

while true do
	while #Players:GetPlayers() == 0 do
		MinigameManager.showLobby("Waiting for players...")
		Players.PlayerAdded:Wait()
	end

	local settings = WaitingRoom.run(getHost)
	if #Players:GetPlayers() == 0 then
		continue -- everyone left during the countdown
	end
	BotService.setSkillRange(Config.Match.BotDifficulties[settings.Difficulty])

	local participants = buildParticipants()
	local play = if settings.Mode == "Minigames" then MinigameMode.play else BoardGame.play
	local ok, err = xpcall(play, debug.traceback, participants, settings)
	if not ok then
		warn("[Party] Match crashed, returning to the waiting room:\n" .. tostring(err))
		MinigameManager.abort("Match crashed, back to the lobby!")
		BoardGame.cleanup()
		MinigameMode.cleanup()
	end
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">MinigameInfo</string>
          <string name="Source"><![CDATA[--[[
	MinigameInfo
	Validates a minigame module and fills in defaults for its Info table, so the rest of
	the framework (and the client) can rely on a complete, predictable shape:

	  Info = {
	    Name, Description          strings
	    Duration                   seconds
	    Layout                     "FFA" | "1v3" | "2v2"
	    Camera = {                 optional, defaults to AngledOverhead
	      Mode = "AngledOverhead" | "FollowBehind" | "SideView",
	      ...any Config.CameraModes[Mode] number to override (Height, Distance, ...)
	      TouchZoom = 1           optional: replaces Config.TouchCamera's Zoom on phones/tablets
	      TouchLookAhead = 6      optional: replaces Config.TouchCamera's LookAhead on phones/tablets
	    },
	    Controls = {               optional, defaults to free movement + no actions
	      Move = true,             false = can't walk (server sets WalkSpeed 0)
	      Jump = true,             false = can't jump
	      WalkSpeed = 16,
	      Actions = { { Action = "Pass", Label = "Pass!", Key = "E" } },
	        per action, optional:  Keys = { "A", "Left" }  several keys instead of one Key
	                               Gamepads = { "DPadLeft", "ButtonL1" }  several pad buttons
	                               Hold = true             OnInput gets "<Action>" on press and
	                                                       "<Action>Stop" on release
	                               Side = "Left"           on-screen button goes bottom-left
	    },
	    ProgressLabel = "Score",   optional default label for the player chips
	    ClientModule = "IceDash",  optional: name of a module in client/Minigames that Main starts
	                               for the round (its messages arrive in OnClientMessage)
	    ProgressBar = true,        optional: show a race bar along the top instead of the chips;
	                               report values like "37%" (anything with 🏁 counts as 100%)
	  }
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.PartyShared.Config)

local MinigameInfo = {}

local REQUIRED_FUNCTIONS = { "Setup", "Start", "Cleanup", "GetResults" }

-- Returns an error string, or nil if the module is usable.
function MinigameInfo.validate(definition): string?
	if type(definition) ~= "table" then
		return "module must return a table"
	end
	local info = definition.Info
	if type(info) ~= "table" then
		return "missing Info table"
	end
	if type(info.Name) ~= "string" or type(info.Description) ~= "string" then
		return "Info.Name and Info.Description must be strings"
	end
	if type(info.Duration) ~= "number" or info.Duration <= 0 then
		return "Info.Duration must be a positive number"
	end
	if not table.find({ "FFA", "1v3", "2v2", "Duel" }, info.Layout) then
		return "Info.Layout must be FFA, 1v3, 2v2 or Duel"
	end
	local camera = info.Camera
	if camera ~= nil and (type(camera) ~= "table" or not Config.CameraModes[camera.Mode]) then
		return "Info.Camera.Mode must be AngledOverhead, FollowBehind or SideView"
	end
	local controls = info.Controls
	if controls ~= nil then
		if type(controls) ~= "table" then
			return "Info.Controls must be a table"
		end
		for _, action in controls.Actions or {} do
			if type(action.Action) ~= "string" or type(action.Label) ~= "string" then
				return "each Info.Controls.Actions entry needs Action and Label strings"
			end
		end
	end
	for _, name in REQUIRED_FUNCTIONS do
		if type(definition[name]) ~= "function" then
			return ("missing function %s"):format(name)
		end
	end
	return nil
end

-- Info with every optional field filled in. Safe to send to clients.
function MinigameInfo.normalize(id: string, info)
	local cameraIn = info.Camera or {}
	local mode = cameraIn.Mode or Config.DefaultCameraMode
	local camera = table.clone(Config.CameraModes[mode])
	for key, value in cameraIn do
		camera[key] = value
	end
	camera.Mode = mode

	local controlsIn = info.Controls or {}
	local actions = {}
	for _, action in controlsIn.Actions or {} do
		table.insert(actions, {
			Action = action.Action,
			Label = action.Label,
			Key = action.Key or (action.Keys and action.Keys[1]), -- Enum.KeyCode name, e.g. "E"
			Keys = action.Keys, -- optional list of Enum.KeyCode names (overrides Key for binding)
			Gamepad = action.Gamepad, -- optional Enum.KeyCode name, e.g. "ButtonX"
			Gamepads = action.Gamepads, -- optional list of Enum.KeyCode names (overrides Gamepad)
			Hold = action.Hold == true, -- also sends "<Action>Stop" when released
			Side = action.Side, -- "Left" puts the on-screen button in the bottom-left corner
			Color = if typeof(action.Color) == "Color3" then action.Color else nil, -- on-screen button colour
		})
	end
	local controls = {
		Move = controlsIn.Move ~= false,
		Jump = controlsIn.Jump ~= false,
		WalkSpeed = controlsIn.WalkSpeed or Config.DefaultWalkSpeed,
		Actions = actions,
	}

	return {
		Id = id,
		Name = info.Name,
		Description = info.Description,
		Layout = info.Layout,
		Duration = info.Duration,
		Camera = camera,
		Controls = controls,
		ProgressLabel = info.ProgressLabel,
		ProgressBar = info.ProgressBar == true,
		ClientModule = if type(info.ClientModule) == "string" then info.ClientModule else nil,
	}
end

return MinigameInfo
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">MinigameManager</string>
          <string name="Source"><![CDATA[--[[
	MinigameManager
	Runs one minigame round from start to finish. The server owns all game state;
	clients only receive PartyState messages and send validated inputs.

	Round flow (MinigameManager.runRound):
	  Vote -> Instructions (arena is built + everyone teleported & frozen)
	       -> Countdown 3-2-1 -> Playing -> Finished -> back to lobby -> Results

	Minigames are ModuleScripts in PartyServer/Minigames (names starting with "_" are
	ignored, e.g. _Template). See _Template.luau for the full interface.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.PartyShared.Config)
local Net = require(ReplicatedStorage.PartyShared.Net)
local Arena = require(script.Parent.Arena)
local BotService = require(script.Parent.BotService)
local CoinService = require(script.Parent.CoinService)
local MinigameInfo = require(script.Parent.MinigameInfo)
local ResultsUtil = require(script.Parent.ResultsUtil)
local RoundContext = require(script.Parent.RoundContext)
local Tutorial = require(script.Parent.Tutorial)

local MinigameManager = {}

local stateRemote = Net.stateRemote()
local inputRemote = Net.inputRemote()
local rng = Random.new()

local registry = {} -- { { Id = moduleName, Definition = module table } }
local extraInputHandler: ((Player, any) -> boolean)? = nil -- board game / lobby inputs
local readyHooks: { (Player) -> () } = {}

local state = {
	PhaseMessage = { Type = Net.Message.Phase, Phase = Net.Phase.Lobby } :: any,
	Status = nil :: string?,
	Participants = {},
	ByPlayer = {} :: { [Player]: any },
	Vote = nil :: any, -- { Choices, Votes = { [participant] = choiceIndex } }
	Active = nil :: any, -- the round in progress, see runRound
}

local function now(): number
	return Workspace:GetServerTimeNow()
end

-- Messaging ---------------------------------------------------------------------------

local function broadcast(message)
	stateRemote:FireAllClients(message)
end

local function setPhase(phase: string, data)
	local message = data or {}
	message.Type = Net.Message.Phase
	message.Phase = phase
	state.PhaseMessage = message
	if phase ~= Net.Phase.Playing then
		state.Status = nil
	end
	broadcast(message)
end

local function setStatus(text: string?)
	state.Status = text
	broadcast({ Type = Net.Message.Status, Text = text })
end

local function describeParticipants(participants)
	local list = {}
	for _, participant in participants do
		table.insert(list, participant:Describe())
	end
	return list
end

-- Player chips ----------------------------------------------------------------------------
-- One chip per participant: name, team, live value reported by the minigame, eliminated flag.
-- Updates are batched and sent at most every Config.ChipFlushInterval seconds.

local chipFlushQueued = false

local function chipsMessage()
	local active = state.Active
	local chips = {}
	for _, participant in state.Participants do
		local chip = participant:Describe()
		local progress = active and active.Progress[participant]
		chip.Value = progress and progress.Value
		chip.Label = progress and progress.Label or (active and active.Described.ProgressLabel)
		chip.Eliminated = active ~= nil and active.Round:IsEliminated(participant)
		chip.Character = participant:GetCharacter() -- lets clients spectate this participant
		table.insert(chips, chip)
	end
	return { Type = Net.Message.Chips, Chips = chips }
end

local function queueChipFlush()
	if chipFlushQueued then
		return
	end
	chipFlushQueued = true
	task.delay(Config.ChipFlushInterval, function()
		chipFlushQueued = false
		broadcast(chipsMessage())
	end)
end

-- Counts votes per card; also returns who voted for what (shown under each card).
local function tallyVotes(vote)
	local counts, voters = {}, {}
	for i = 1, #vote.Choices do
		counts[i] = 0
		voters[i] = {}
	end
	for participant, choice in vote.Votes do
		counts[choice] += 1
		table.insert(voters[choice], participant.Name)
	end
	return counts, voters
end

local function voteUpdateMessage(vote)
	local counts, voters = tallyVotes(vote)
	return { Type = Net.Message.VoteUpdate, Counts = counts, Voters = voters }
end

-- Late joiners / reloaded clients get the current screen re-sent.
local function sendSnapshot(player: Player)
	stateRemote:FireClient(player, state.PhaseMessage)
	if state.Vote then
		stateRemote:FireClient(player, voteUpdateMessage(state.Vote))
	end
	if state.Status then
		stateRemote:FireClient(player, { Type = Net.Message.Status, Text = state.Status })
	end
	if state.Active then
		stateRemote:FireClient(player, chipsMessage())
	end
	for _, hook in readyHooks do
		task.spawn(hook, player)
	end
end

-- Registry ----------------------------------------------------------------------------

local function loadMinigames()
	if #registry > 0 then
		return -- already loaded (init, or a test that loaded it first)
	end
	local folder = script.Parent:WaitForChild("Minigames")
	for _, module in folder:GetChildren() do
		if not module:IsA("ModuleScript") or string.sub(module.Name, 1, 1) == "_" then
			continue
		end
		local ok, definition = pcall(require, module)
		local problem = if ok then MinigameInfo.validate(definition) else tostring(definition)
		if problem then
			warn(("[MinigameManager] Skipping minigame %s: %s"):format(module.Name, problem))
			continue
		end
		table.insert(registry, {
			Id = module.Name,
			Definition = definition,
			Described = MinigameInfo.normalize(module.Name, definition.Info),
		})
	end
	table.sort(registry, function(a, b)
		return a.Id < b.Id
	end)
	print(("[MinigameManager] Loaded %d minigame(s)"):format(#registry))
end

local function describeMinigame(entry)
	return table.clone(entry.Described)
end

local function findEntry(id: string)
	for _, entry in registry do
		if entry.Id == id then
			return entry
		end
	end
	return nil
end

-- Calls an optional minigame method, logging (not propagating) errors.
local function safeCall(instance, methodName: string, ...)
	local method = instance[methodName]
	if type(method) ~= "function" then
		return true, nil
	end
	local ok, result = pcall(method, instance, ...)
	if not ok then
		warn(("[MinigameManager] %s:%s errored: %s"):format(instance.Info.Name, methodName, tostring(result)))
	end
	return ok, result
end

-- Voting -------------------------------------------------------------------------------

local function castVote(participant, choice)
	local vote = state.Vote
	if not vote or participant.Left then
		return
	end
	-- Inputs are untrusted: must be an integer index of a real card.
	if type(choice) ~= "number" or choice % 1 ~= 0 or choice < 1 or choice > #vote.Choices then
		return
	end
	vote.Votes[participant] = choice
	broadcast(voteUpdateMessage(vote))
end

local function everyoneVoted(vote, participants): boolean
	for _, participant in participants do
		if not participant.Left and vote.Votes[participant] == nil then
			return false
		end
	end
	return true
end

-- Minigames for the normal 4-player vote (Duel minigames are only played from Duel spaces).
local function votePool()
	local pool = {}
	for _, entry in registry do
		if entry.Definition.Info.Layout ~= "Duel" then
			table.insert(pool, entry)
		end
	end
	return pool
end

local function runVote(participants)
	local pool = votePool()
	for i = #pool, 2, -1 do -- shuffle
		local j = rng:NextInteger(1, i)
		pool[i], pool[j] = pool[j], pool[i]
	end

	local choices = {}
	for i = 1, math.min(Config.VoteChoices, #pool) do
		table.insert(choices, describeMinigame(pool[i]))
	end
	if #choices < Config.VoteChoices and #pool > 1 then
		table.insert(choices, table.clone(Config.RandomChoice))
	end

	local vote = { Choices = choices, Votes = {} }
	state.Vote = vote
	local endsAt = now() + Config.VoteDuration
	setPhase(Net.Phase.Vote, { Choices = choices, EndsAt = endsAt })
	broadcast(voteUpdateMessage(vote))

	-- Bots vote after a short "thinking" delay, through the same validated path as players.
	for _, participant in participants do
		if participant.IsBot then
			task.delay(rng:NextNumber(Config.BotVoteDelay[1], Config.BotVoteDelay[2]), function()
				if state.Vote == vote then
					castVote(participant, rng:NextInteger(1, #choices))
				end
			end)
		end
	end

	while now() < endsAt and not everyoneVoted(vote, participants) do
		task.wait(0.1)
	end
	if now() < endsAt then
		task.wait(1) -- everyone voted early: let them see the final tally for a beat
	end
	state.Vote = nil

	-- Most votes wins; ties (and no votes at all) are broken randomly.
	local tally = tallyVotes(vote)
	local best, bestCount = {}, -1
	for i, count in tally do
		if count > bestCount then
			best, bestCount = { i }, count
		elseif count == bestCount then
			table.insert(best, i)
		end
	end
	local winner = choices[best[rng:NextInteger(1, #best)]]

	if winner.Id == Config.RandomChoice.Id then
		local all = votePool()
		return all[rng:NextInteger(1, #all)]
	end
	return findEntry(winner.Id)
end

-- Teams ----------------------------------------------------------------------------------

local function assignTeams(participants, layout: string)
	local shuffled = table.clone(participants)
	for i = #shuffled, 2, -1 do
		local j = rng:NextInteger(1, i)
		shuffled[i], shuffled[j] = shuffled[j], shuffled[i]
	end
	for i, participant in shuffled do
		if layout == "1v3" then
			participant.Team = if i == 1 then 1 else 2 -- team 1 is the solo player
		elseif layout == "2v2" then
			participant.Team = if i <= 2 then 1 else 2
		else
			participant.Team = nil
		end
	end
end

-- Round lifecycle --------------------------------------------------------------------------

local function returnToLobby(participants)
	BotService.reviveAll(Arena.lobbySpot)
	for index, participant in participants do
		participant.Team = nil
		if participant:IsAlive() then
			participant:Teleport(Arena.lobbySpot(index))
			participant:ResetMovement()
		end
		-- Dead real players simply respawn at the lobby SpawnLocation.
	end
end

-- Tears down the active round. Safe to call more than once (used by abort too).
local function finishRound()
	local active = state.Active
	if not active then
		return
	end
	state.Active = nil
	BotService.setBrain(nil)
	for _, connection in active.Connections do
		connection:Disconnect()
	end
	safeCall(active.Instance, "Cleanup")
	Arena.destroy(active.Arena)
	returnToLobby(active.Round.Participants)
	if state.Status then
		setStatus(nil)
	end
end

-- A participant died, reset, or left mid-round: they are out.
local function onParticipantLost(participant, reason: string)
	local active = state.Active
	if not active or active.Round.Ended or active.Round:IsEliminated(participant) then
		return
	end
	active.Round:Eliminate(participant, true)
	active.Round:Toast(
		if reason == "Left" then ("👋 %s left the game"):format(participant.Name) else ("💥 %s is out"):format(participant.Name)
	)
	safeCall(active.Instance, "OnParticipantLost", participant, reason)
end

-- True if `participant` may press `action` right now (playing, alive, in this round).
local function canAct(participant, action: string): boolean
	local active = state.Active
	if not active or state.PhaseMessage.Phase ~= Net.Phase.Playing or active.Round.Ended then
		return false
	end
	if not active.Actions[action] or active.Round:IsEliminated(participant) or not participant:IsAlive() then
		return false
	end
	-- Only people playing this round (a duel has two; everyone else just watches).
	return table.find(active.Round.Participants, participant) ~= nil
end

-- Same entry point for real-player inputs (via the remote) and bot inputs (bot:Input).
local function submitAction(participant, action: string)
	if not canAct(participant, action) then
		return
	end
	Tutorial.complete(participant, "UsedMinigameAction") -- bots are ignored
	safeCall(state.Active.Instance, "OnInput", participant, action)
end

local function awardCoins(results)
	local rows = {}
	for _, result in results do
		local participant = result.Participant
		local coins = if participant.Left then 0 else (Config.CoinsByPlacement[result.Placement] or 0)
		local total = CoinService.add(participant, coins)
		local row = participant:Describe()
		row.Placement = result.Placement
		row.Coins = coins
		row.Total = total
		table.insert(rows, row)
	end
	return rows
end

local function ensureBodies(participants)
	BotService.reviveAll(Arena.lobbySpot)
	for _, participant in participants do
		if not participant.IsBot and not participant.Left and not participant:IsAlive() then
			pcall(function()
				participant.Player:LoadCharacter()
			end)
		end
	end
end

--[[
	Plays one full round with exactly Config.PlayersPerMatch participants.
	Returns the normalized ranked results and the coin rows shown on the results screen.
	BoardGame calls this after every full turn cycle.
]]
function MinigameManager.runRound(participants, options)
	options = options or {}
	assert(#registry > 0, "No minigames loaded")
	state.Participants = participants
	state.ByPlayer = {}
	for _, participant in participants do
		if participant.Player then
			state.ByPlayer[participant.Player] = participant
		end
	end

	-- 1. Vote (skipped when the caller already picked, e.g. a duel)
	local entry = options.Entry or runVote(participants)
	local definition = entry.Definition
	local info = definition.Info
	local described = describeMinigame(entry)
	assignTeams(participants, info.Layout)

	-- 2. Build the arena + a fresh minigame instance (all per-round state lives on it)
	local arena = Arena.create(entry.Id)
	local progress = {}
	local round = RoundContext.new({
		Participants = participants,
		Arena = arena,
		Broadcast = broadcast,
		SetStatus = setStatus,
		OnProgress = function(participant, value, label)
			progress[participant] = { Value = value, Label = label }
			queueChipFlush()
		end,
		OnEliminated = queueChipFlush,
	})
	local instance = setmetatable({ Round = round, Arena = arena, Participants = participants }, { __index = definition })

	local actions = {}
	for _, control in described.Controls.Actions do
		actions[control.Action] = true
		if control.Hold then
			actions[control.Action .. "Stop"] = true
		end
	end
	state.Active = {
		Entry = entry,
		Instance = instance,
		Round = round,
		Arena = arena,
		Actions = actions,
		Described = described,
		Progress = progress,
		Connections = {},
	}

	-- 3. Instructions card; build the map and teleport while everyone reads it
	local instructionsEnd = now() + Config.InstructionsDuration
	setPhase(Net.Phase.Instructions, {
		Minigame = described,
		Participants = describeParticipants(participants),
		ArenaOrigin = arena.Origin,
		EndsAt = instructionsEnd,
	})

	local spawns = instance:Setup(arena, participants, round) or {}
	ensureBodies(participants)
	for index, participant in participants do
		local spawn = spawns[index] or (arena.Origin + Vector3.new(index * 4, 4, 0))
		participant:Teleport(spawn)
		participant:Freeze()
	end
	broadcast(chipsMessage()) -- characters exist now, so spectating works from the start
	task.wait(math.max(0, instructionsEnd - now()))

	-- 4. Countdown
	for number = Config.CountdownFrom, 1, -1 do
		setPhase(Net.Phase.Countdown, { Number = number, Minigame = described, ArenaOrigin = arena.Origin })
		task.wait(1)
	end

	-- 5. Play
	for _, participant in participants do
		local humanoid = participant:GetHumanoid()
		if humanoid then
			table.insert(
				state.Active.Connections,
				humanoid.Died:Connect(function()
					onParticipantLost(participant, "Died")
				end)
			)
		end
		if participant:IsAlive() then
			participant:ApplyControls(described.Controls) -- server-side movement locking
		else
			onParticipantLost(participant, "Died")
		end
	end

	round.EndsAt = now() + info.Duration
	setPhase(Net.Phase.Playing, {
		Minigame = described,
		Participants = describeParticipants(participants),
		ArenaOrigin = arena.Origin,
		EndsAt = round.EndsAt,
	})
	BotService.setBrain(function(bot, dt)
		if
			instance.UpdateBot
			and not round.Ended
			and table.find(participants, bot.Participant)
			and not round:IsEliminated(bot.Participant)
		then
			instance:UpdateBot(bot, dt)
		end
	end)
	safeCall(instance, "Start")

	while not round.Ended and now() < round.EndsAt do
		task.wait(0.1)
	end
	local reason = if round.Ended then round.EndReason else "TimeUp"
	round:End(reason)
	BotService.setBrain(nil)
	safeCall(instance, "OnRoundEnding", reason)

	-- 6. Freeze, collect results, clean up, go home
	for _, participant in participants do
		if participant:IsAlive() then
			participant:Freeze()
		end
	end
	setPhase(Net.Phase.Finished, { Minigame = described })
	local ok, rawResults = safeCall(instance, "GetResults")
	local results = ResultsUtil.normalize(if ok then rawResults else nil, participants)
	task.wait(Config.FinishBannerDuration)
	finishRound()

	-- 7. Results screen
	local rows = if options.NoCoins then (function()
		local list = {}
		for _, result in results do
			local row = result.Participant:Describe()
			row.Placement = result.Placement
			row.Coins = 0
			row.Total = CoinService.get(result.Participant)
			table.insert(list, row)
		end
		return list
	end)() else awardCoins(results)
	setPhase(Net.Phase.Results, {
		Minigame = described,
		Results = rows,
		EndsAt = now() + Config.ResultsDuration,
	})
	task.wait(Config.ResultsDuration)
	return results, rows
end

-- Minigames the normal 4-player vote draws from (never Duel ones).
function MinigameManager.voteMinigames()
	return votePool()
end

-- Loads the minigame registry without starting anything else (tests; init does this too).
MinigameManager.loadMinigames = function()
	loadMinigames()
end

-- Duel minigames (Info.Layout = "Duel") registered, for Duel spaces.
function MinigameManager.duelMinigames()
	local list = {}
	for _, entry in registry do
		if entry.Definition.Info.Layout == "Duel" then
			table.insert(list, entry)
		end
	end
	return list
end

--[[
	Plays a random Duel minigame between two participants (everyone else watches) without
	placement coins. Returns the winning participant, or nil for a draw / no duel minigames.
]]
function MinigameManager.runDuel(a, b)
	local duels = MinigameManager.duelMinigames()
	if #duels == 0 then
		return nil
	end
	local results = MinigameManager.runRound({ a, b }, { Entry = duels[rng:NextInteger(1, #duels)], NoCoins = true })
	local first = {}
	for _, result in results do
		if result.Placement == 1 then
			table.insert(first, result.Participant)
		end
	end
	return if #first == 1 then first[1] else nil
end

-- Emergency stop if anything in runRound threw. Leaves the server ready for the next round.
function MinigameManager.abort(message: string?)
	state.Vote = nil
	finishRound()
	broadcast({ Type = Net.Message.Toast, Text = message or "Round cancelled" })
end

-- Shows the lobby screen and waits `duration` seconds (0 = just show it).
function MinigameManager.showLobby(text: string, duration: number?)
	setPhase(Net.Phase.Lobby, {
		Text = text,
		EndsAt = if duration then now() + duration else nil,
	})
	if duration then
		task.wait(duration)
	end
end

-- Hooks for the board game and lobby, which share the same remotes and phase snapshot.
MinigameManager.setPhase = setPhase
MinigameManager.broadcast = broadcast

function MinigameManager.sendTo(player: Player, message)
	stateRemote:FireClient(player, message)
end

-- fn(player, payload) -> true if it handled the input. Runs after rate limiting, before votes/actions.
function MinigameManager.setInputHandler(fn: ((Player, any) -> boolean)?)
	extraInputHandler = fn
end

-- fn(player) runs whenever a client asks for the current state (join / reload).
function MinigameManager.onReady(fn: (Player) -> ())
	table.insert(readyHooks, fn)
end

function MinigameManager.getMinigames()
	local list = {}
	for _, entry in registry do
		table.insert(list, describeMinigame(entry))
	end
	return list
end

function MinigameManager.init()
	loadMinigames()
	BotService.setActionHandler(submitAction)

	-- Messages from a minigame's own client code go to the running minigame, rate limited.
	-- The minigame must validate them: they are whatever the client chose to send.
	local messageBuckets: { [Player]: { Start: number, Count: number } } = {}
	local function onMinigameMessage(player: Player, payload)
		local clock = os.clock()
		local bucket = messageBuckets[player]
		if not bucket or clock - bucket.Start >= 1 then
			bucket = { Start = clock, Count = 0 }
			messageBuckets[player] = bucket
		end
		bucket.Count += 1
		if bucket.Count > Config.MinigameMessageRateLimit then
			return
		end
		local active = state.Active
		local participant = state.ByPlayer[player]
		if not active or not participant or state.PhaseMessage.Phase ~= Net.Phase.Playing or active.Round.Ended then
			return
		end
		if active.Round:IsEliminated(participant) then
			return
		end
		safeCall(active.Instance, "OnClientMessage", participant, payload)
	end
	Net.minigameRemote().OnServerEvent:Connect(onMinigameMessage)
	Net.minigameFastRemote().OnServerEvent:Connect(onMinigameMessage)
	Players.PlayerRemoving:Connect(function(player)
		messageBuckets[player] = nil
	end)

	-- Rate limit: at most Config.InputRateLimit inputs per player per second.
	local buckets: { [Player]: { Start: number, Count: number } } = {}
	inputRemote.OnServerEvent:Connect(function(player: Player, payload)
		if type(payload) ~= "table" then
			return
		end
		local clock = os.clock()
		local bucket = buckets[player]
		if not bucket or clock - bucket.Start >= 1 then
			bucket = { Start = clock, Count = 0 }
			buckets[player] = bucket
		end
		bucket.Count += 1
		if bucket.Count > Config.InputRateLimit then
			return
		end

		local kind = payload.Kind
		if kind == Net.Input.Ready then
			sendSnapshot(player)
			return
		end
		if extraInputHandler and extraInputHandler(player, payload) then
			return
		end
		local participant = state.ByPlayer[player]
		if not participant then
			return -- spectators (5th+ player) can't vote or act
		end
		if kind == Net.Input.Vote then
			castVote(participant, payload.Choice)
		elseif kind == Net.Input.Action and type(payload.Action) == "string" then
			submitAction(participant, payload.Action)
		elseif kind == Net.Input.ActionUsed and type(payload.Action) == "string" then
			-- The minigame's own client code sent this action (e.g. Bumper Bout's dash); it only
			-- counts for the tutorial, and only when that action could really be pressed now.
			if canAct(participant, payload.Action) then
				Tutorial.complete(participant, "UsedMinigameAction")
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
		local participant = state.ByPlayer[player]
		if not participant then
			return
		end
		participant.Left = true
		state.ByPlayer[player] = nil
		if state.Vote then
			state.Vote.Votes[participant] = nil
			broadcast(voteUpdateMessage(state.Vote))
		end
		onParticipantLost(participant, "Left")
	end)
end

return MinigameManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">MinigameMode</string>
          <string name="Source"><![CDATA[--[[
	MinigameMode
	The "Minigames" match mode: no board, just back-to-back minigames (vote -> play ->
	results) for the chosen number of rounds. Most coins wins; ties share a place. Real
	players get bank coins by placement, same as the board party.

	  MinigameMode.play(participants, settings)   yields for the whole match; returns ranked rows
	  MinigameMode.reclaim(participants, claims, index, player)   hand a kept seat back (tested)

	A player who leaves keeps their seat (a bot plays it); if they rejoin they get it back
	after the current minigame (see SeatClaims). New late joiners watch until the next match.
	  MinigameMode.rank(participants, wallet)     pure ranking (tested)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.PartyShared.Config)
local Net = require(ReplicatedStorage.PartyShared.Net)
local Arena = require(script.Parent.Arena)
local BotService = require(script.Parent.BotService)
local CoinService = require(script.Parent.CoinService)
local CosmeticService = require(script.Parent.CosmeticService)
local Inventory = require(script.Parent.Inventory)
local MinigameManager = require(script.Parent.MinigameManager)
local Participant = require(script.Parent.Participant)
local Profiles = require(script.Parent.Profiles)
local SeatClaims = require(script.Parent.SeatClaims)

local MinigameMode = {}

local running = nil -- { Participants, Claims } while a Minigames match is on

local function isAway(participant): boolean
	return participant.Left or (not participant.IsBot and (not participant.Player or participant.Player.Parent == nil))
end

-- Ranks by coins (most first); equal coins share a placement. Stable by seat order.
function MinigameMode.rank(participants, wallet)
	local rows = {}
	for index, participant in participants do
		table.insert(rows, { Participant = participant, SeatIndex = index, Coins = wallet.get(participant) })
	end
	table.sort(rows, function(a, b)
		if a.Coins ~= b.Coins then
			return a.Coins > b.Coins
		end
		return a.SeatIndex < b.SeatIndex
	end)
	for i, row in rows do
		local previous = rows[i - 1]
		row.Placement = if previous and previous.Coins == row.Coins then previous.Placement else i
	end
	return rows
end

-- A bot takes over the seat of anyone who left (keeping their coins).
local function replaceLeavers(participants)
	for index, participant in participants do
		if not isAway(participant) then
			continue
		end
		participant.Left = true
		if running and participant.UserId and Config.SeatReclaim.Enabled then
			running.Claims:reserve(index, participant.UserId)
		end
		local seated = {}
		local count = 0
		for _, other in participants do
			if other.IsBot then
				seated[other.Bot] = other
				count += 1
			end
		end
		local newcomer
		for _, bot in BotService.getBots(count + 1, Arena.lobbySpot) do
			if seated[bot] then
				bot.Participant = seated[bot] -- getBots clears these
			else
				newcomer = bot
			end
		end
		if newcomer then
			local replacement = Participant.fromBot(newcomer)
			CoinService.transfer(participant, replacement)
			participants[index] = replacement
			MinigameManager.broadcast({
				Type = Net.Message.Toast,
				Text = ("%s left, %s takes over their seat"):format(participant.Name, replacement.Name),
			})
		end
	end
end

--[[
	Hands seat `index` back to `player`, whose UserId it is reserved for. Same slot, so the
	turn order stays; the wallet moves from the bot back to them. Returns the new participant
	and the one it replaced, or nil.
]]
function MinigameMode.reclaim(participants, claims, index, player)
	if claims:pendingFor(index) ~= player then
		return nil
	end
	claims:consume(index)
	local previous = participants[index]
	if not previous or not (previous.IsBot or isAway(previous)) then
		return nil
	end
	local returning = Participant.fromPlayer(player)
	for other, participant in participants do
		if other ~= index and participant.Id == returning.Id then
			return nil
		end
	end
	CoinService.transfer(previous, returning)
	participants[index] = returning
	return returning, previous
end

-- Between minigames: everyone waiting gets their seat back.
local function settleReclaims(participants)
	for index in participants do
		local player = running.Claims:pendingFor(index)
		local returning, previous = if player then MinigameMode.reclaim(participants, running.Claims, index, player) else nil
		if returning then
			if previous.IsBot and previous.Bot then
				BotService.release(previous.Bot)
			end
			MinigameManager.broadcast({
				Type = Net.Message.Toast,
				Text = ("%s is back and takes their seat again"):format(returning.Name),
			})
			MinigameManager.sendTo(player, { Type = Net.Message.Toast, Text = SeatClaims.Messages.now })
		end
	end
end

Players.PlayerAdded:Connect(function(player)
	if running and Config.SeatReclaim.Enabled and running.Claims:request(player) then
		MinigameManager.sendTo(player, { Type = Net.Message.Toast, Text = SeatClaims.Messages.after_minigame })
	end
end)
Players.PlayerRemoving:Connect(function(player)
	if not running then
		return
	end
	running.Claims:cancel(player)
	for index, participant in running.Participants do
		if participant.Player == player and Config.SeatReclaim.Enabled then
			running.Claims:reserve(index, player.UserId)
		end
	end
end)

-- Forget seat reservations (match crashed); safe any time.
function MinigameMode.cleanup()
	running = nil
end

function MinigameMode.play(participants, settings)
	CoinService.resetAll()
	Inventory.resetBots()
	participants = table.clone(participants)
	local rounds = settings.Rounds or Config.Match.BoardRounds
	running = { Participants = participants, Claims = SeatClaims.new() }

	for round = 1, rounds do
		settleReclaims(participants)
		replaceLeavers(participants)
		MinigameManager.showLobby(("Minigame %d of %d"):format(round, rounds), Config.IntermissionDuration)
		local ok, err = xpcall(MinigameManager.runRound, debug.traceback, participants)
		if not ok then
			warn("[MinigameMode] Minigame crashed, carrying on:\n" .. tostring(err))
			MinigameManager.abort("Minigame crashed, on to the next one!")
		end
	end

	settleReclaims(participants)
	replaceLeavers(participants)
	-- Seats are final now: reservations end with the match.
	for _, player in running.Claims:clear() do
		MinigameManager.sendTo(player, { Type = Net.Message.Toast, Text = SeatClaims.Messages.ended })
	end
	running = nil
	local rows = MinigameMode.rank(participants, CoinService)
	local described = {}
	for _, row in rows do
		local entry = row.Participant:Describe()
		entry.Placement = row.Placement
		entry.Coins = row.Coins
		entry.Collectibles = 0
		local player = row.Participant.Player
		local bank = Config.Profile.BankCoinsByPlacement[row.Placement] or 0
		if player and player.Parent and not row.Participant.Left and bank > 0 then
			Profiles.addBankCoins(player, bank)
			entry.BankCoins = bank
			CosmeticService.sendInventory(player)
		end
		table.insert(described, entry)
	end
	MinigameManager.setPhase(Net.Phase.Standings, {
		Stage = "Final",
		Mode = "Minigames",
		Rows = described,
		EndsAt = Workspace:GetServerTimeNow() + Config.Match.StandingsDuration,
	})
	task.wait(Config.Match.StandingsDuration)
	CoinService.resetAll()
	return rows
end

return MinigameMode
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="34">
        <Properties>
          <string name="Name">Minigames</string>
        </Properties>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Bullseye</string>
            <string name="Source"><![CDATA[--[[
	Bullseye (1v3, timing + precision)
	Everyone has a gauge with a marker sweeping back and forth. Press STOP to lock the marker
	as close to the centre as you can: 100 points dead centre, 0 at the edge. Three shots,
	each sweep faster than the last. The solo player's total takes on the team's AVERAGE
	total; the higher side wins.

	Server-authoritative: the marker's position is a function of the server clock, and a
	press is scored at the moment the server receives it. Bots aim with skill-based error.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.PartyShared.Config)
local ResultsUtil = require(script.Parent.Parent.ResultsUtil)

local Bullseye = {}

Bullseye.Info = {
	Name = "Bullseye",
	Description = "Stop the sliding marker as close to the middle as you can. 3 shots, faster each time. 1 vs 3: the solo player's score takes on the team's average!",
	Duration = 40,
	Layout = Config.Layouts.OneVsThree,
	Camera = { Mode = "AngledOverhead", Height = 40, Distance = 30 },
	Controls = {
		Move = false,
		Jump = false,
		Actions = {
			{ Action = "Stop", Label = "STOP!", Key = "Space", Gamepad = "ButtonA" },
		},
	},
	ProgressLabel = "Points",
}

-- Tuning ----------------------------------------------------------------------------------
Bullseye.SHOTS = 3
Bullseye.SPEEDS = { 2.2, 3.0, 3.8 } -- radians/second of the sweep, per shot
Bullseye.SHOT_TIME = 7 -- seconds to take a shot before it counts as a miss (0)
Bullseye.BETWEEN_SHOTS = 1.5
local HALF_WIDTH = 8 -- studs from centre to edge of a gauge
local LANE_SPACING = 7

-- Marker offset (-1..1 of the half width) at `t` seconds into a shot.
function Bullseye.offsetAt(shot: number, t: number): number
	return math.sin(t * Bullseye.SPEEDS[shot] + 0.6)
end

-- Points for stopping at `offset` (-1..1).
function Bullseye.scoreFor(offset: number): number
	return math.floor(math.max(0, 1 - math.abs(offset)) * 100 + 0.5)
end

function Bullseye:Setup(arena, participants, _round)
	self.Now = self.Now or os.clock
	self.Totals, self.Locked, self.Markers = {}, {}, {}
	self.Shot = 0
	self.ShotStart = nil

	-- One floor under every gauge and every player's spot.
	local floor = Instance.new("Part")
	floor.Name = "Floor"
	floor.Anchored = true
	floor.Size = Vector3.new(HALF_WIDTH * 2 + 10, 1, #participants * LANE_SPACING + 12)
	floor.CFrame = arena.Origin * CFrame.new(0, -0.8, 2)
	floor.Color = Color3.fromRGB(70, 70, 90)
	floor.Parent = arena.Folder

	for index, participant in participants do
		self.Totals[participant] = 0
		local z = (index - (#participants + 1) / 2) * LANE_SPACING
		local gauge = Instance.new("Part")
		gauge.Name = "Gauge"
		gauge.Anchored = true
		gauge.Size = Vector3.new(HALF_WIDTH * 2, 0.6, 3)
		gauge.CFrame = arena.Origin * CFrame.new(0, 0, z)
		gauge.Color = if participant.Team == 1 then Color3.fromRGB(255, 120, 120) else Color3.fromRGB(120, 170, 255)
		gauge.Parent = arena.Folder
		local centre = Instance.new("Part")
		centre.Name = "Centre"
		centre.Anchored = true
		centre.CanCollide = false
		centre.Size = Vector3.new(0.6, 0.7, 3.1)
		centre.CFrame = gauge.CFrame
		centre.Color = Color3.fromRGB(255, 230, 80)
		centre.Material = Enum.Material.Neon
		centre.Parent = arena.Folder
		local marker = Instance.new("Part")
		marker.Name = "Marker"
		marker.Anchored = true
		marker.CanCollide = false
		marker.Size = Vector3.new(0.8, 2, 0.8)
		marker.CFrame = gauge.CFrame * CFrame.new(0, 1.3, 0)
		marker.Color = Color3.new(1, 1, 1)
		marker.Parent = arena.Folder
		self.Markers[participant] = { Part = marker, Base = gauge.CFrame }
	end

	local spawns = {}
	for index, participant in participants do
		spawns[index] = self.Markers[participant].Base * CFrame.new(0, 3, 4)
	end
	return spawns
end

function Bullseye:_report()
	for participant, total in self.Totals do
		self.Round:ReportProgress(participant, total)
	end
end

function Bullseye:_startShot()
	self.Shot += 1
	self.ShotStart = self.Now()
	self.Locked = {}
	self.Round:SetStatus(("Shot %d of %d: STOP in the middle!"):format(self.Shot, Bullseye.SHOTS))
	local shot = self.Shot
	task.delay(Bullseye.SHOT_TIME, function()
		if self.Shot == shot and not self.Round.Ended then
			self:_endShot()
		end
	end)
end

function Bullseye:_endShot()
	self.ShotStart = nil
	self:_report()
	if self.Shot >= Bullseye.SHOTS then
		self.Round:End("AllShots")
		return
	end
	task.delay(Bullseye.BETWEEN_SHOTS, function()
		if not self.Round.Ended then
			self:_startShot()
		end
	end)
end

-- A STOP press, scored at the server's clock. One per shot.
function Bullseye:Stop(participant)
	if not self.ShotStart or self.Locked[participant] ~= nil then
		return nil
	end
	local offset = Bullseye.offsetAt(self.Shot, self.Now() - self.ShotStart)
	local points = Bullseye.scoreFor(offset)
	self.Locked[participant] = offset
	self.Totals[participant] += points
	local marker = self.Markers[participant]
	if marker then
		marker.Part.CFrame = marker.Base * CFrame.new(offset * HALF_WIDTH, 1.3, 0)
		marker.Part.Color = Color3.fromRGB(255, 230, 80)
	end
	self:_report()
	local everyone = true
	for _, other in self.Participants do
		if self.Locked[other] == nil and not other.Left then
			everyone = false
		end
	end
	if everyone then
		self:_endShot()
	end
	return points
end

function Bullseye:Start()
	self:_report()
	self.Connection = RunService.Heartbeat:Connect(function()
		if not self.ShotStart then
			return
		end
		local t = self.Now() - self.ShotStart
		for participant, marker in self.Markers do
			if self.Locked[participant] == nil then
				marker.Part.Color = Color3.new(1, 1, 1)
				marker.Part.CFrame = marker.Base * CFrame.new(Bullseye.offsetAt(self.Shot, t) * HALF_WIDTH, 1.3, 0)
			end
		end
	end)
	self:_startShot()
end

function Bullseye:OnInput(participant, action)
	if action == "Stop" then
		self:Stop(participant)
	end
end

-- Bots pick an aim (worse with low skill) and press when the marker gets there.
function Bullseye:UpdateBot(bot, _dt)
	local memory = bot.Memory
	if not self.ShotStart or memory.Shot == self.Shot then
		return
	end
	memory.Shot = self.Shot
	local aim = (math.random() * 2 - 1) * (0.05 + (1 - bot.Skill) * 0.45)
	-- First moment after a short look when the marker passes `aim`.
	local shot, start = self.Shot, self.ShotStart
	local earliest = self.Now() - start + 0.6 + math.random() * 0.8
	local t = earliest
	while t < Bullseye.SHOT_TIME - 0.2 and math.abs(Bullseye.offsetAt(shot, t) - aim) > 0.03 do
		t += 1 / 120
	end
	task.delay(math.max(0, start + t - self.Now()), function()
		if self.Shot == shot and self.ShotStart == start then
			bot:Input("Stop")
		end
	end)
end

-- 1v3: solo (team 1) total vs the team's average total.
function Bullseye:TeamScores()
	local solo, teamSum, teamCount = 0, 0, 0
	for _, participant in self.Participants do
		if participant.Team == 1 then
			solo += self.Totals[participant]
		else
			teamSum += self.Totals[participant]
			teamCount += 1
		end
	end
	return solo, if teamCount > 0 then teamSum / teamCount else 0
end

function Bullseye:GetResults()
	local solo, team = self:TeamScores()
	if solo == team then
		return ResultsUtil.fromScores(self.Participants, function()
			return 0
		end)
	end
	return ResultsUtil.fromTeams(self.Participants, if solo > team then 1 else 2)
end

function Bullseye:Cleanup()
	if self.Connection then
		self.Connection:Disconnect()
	end
	self.Shot = math.huge
end

return Bullseye
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">BumperBout</string>
            <string name="Source"><![CDATA[--[[
	Bumper Bout (Duel: exactly two players, played from board Duel spaces)
	A shoving match on a small round platform floating in the sky. Walk around freely and
	press DASH to lunge: dash into your opponent and they're knocked back. Fall off and you
	lose. After a few seconds the platform shrinks to a small final circle. At the time limit
	whoever stands closest to the middle wins (then most hits, then a short sudden death).
	It's about positioning and timing: get between your opponent and the middle, read where
	they're going, and don't dash yourself off the edge.

	Server-authoritative:
	  * A DASH is a request ("Dash" action, or a direction from client/Minigames/BumperBout);
	    the server checks cooldown, phase and the direction, then drives the lunge itself.
	  * The server decides hits (one per dash), knockback, ring-outs and the result, from its
	    own view of where everyone is. Lunges and knockback are velocity constraints made
	    here, so they work whoever simulates the body, and implausible movement is snapped back.
	  * The visible platform is resized together with the safe radius; the safe radius (not
	    the parts) decides ring-outs.
	The pure rule functions below the tuning are what the unit tests drive.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.PartyShared.Config)
local Net = require(ReplicatedStorage.PartyShared.Net)
local ResultsUtil = require(script.Parent.Parent.ResultsUtil)

local BumperBout = {}

-- Tuning ----------------------------------------------------------------------------------

BumperBout.START_RADIUS = 22 -- studs
BumperBout.FINAL_RADIUS = 10 -- still room to walk around and line up a dash
BumperBout.SHRINK_DELAY = 4 -- seconds before shrinking starts
BumperBout.SHRINK_DURATION = 8 -- seconds to go from start to final radius
BumperBout.SHRINK_WARNING = 1.5 -- seconds of "Platform shrinking!" before it starts
BumperBout.ROUND_LIMIT = 18 -- seconds; then closest to the middle wins
BumperBout.SUDDEN_DEATH = 6 -- extra seconds if the time limit can't separate them
BumperBout.WALK_SPEED = 16
BumperBout.DASH_SPEED = 55 -- studs/second during a lunge
BumperBout.DASH_DURATION = 0.22 -- seconds (about 12 studs)
BumperBout.DASH_COOLDOWN = 2.0 -- seconds between dashes (server clock)
BumperBout.HIT_WINDOW_EXTRA = 0.12 -- a lunge can still connect this long after it ends (lag)
BumperBout.HIT_RADIUS = 4.5 -- studs between the two bodies' centres
BumperBout.KNOCKBACK = 62 -- studs/second at the moment of impact
BumperBout.KNOCKBACK_MAX = 90 -- hard cap on any knockback speed
BumperBout.KNOCKBACK_DECAY = 6 -- per second (exponential): ~9.5 studs of push in total
BumperBout.KNOCKBACK_TIME = 0.45 -- seconds the push is applied
BumperBout.CLASH_FACTOR = 0.6 -- both dash into each other: both bounce back this much
BumperBout.EDGE_GRACE = 0.75 -- studs past the safe radius a body's centre may be (feet on the rim)
BumperBout.FALL_DEPTH = 3 -- studs below the platform top that count as fallen
BumperBout.CENTER_TIE = 0.5 -- studs: closer than this to each other's distance is a tie
BumperBout.MAX_PLAUSIBLE_SPEED = 75 -- studs/second a player's body may move before it's snapped back
BumperBout.PLATFORM_HEIGHT = 2
BumperBout.SPAWN_DISTANCE = 7.5 -- studs from the middle: one opening hit can't ring anyone out

-- Bots (skill 0..1 blends from the first number to the second)
BumperBout.BOT = {
	Reaction = { 0.45, 0.12 }, -- seconds between decisions
	Lead = { 0, 0.35 }, -- seconds of opponent movement predicted when aiming
	Mistake = { 0.25, 0.03 }, -- chance a dash is mistimed or badly angled
	MistakeAngle = 35, -- degrees of error on a bad angle
	EdgeMargin = { 3, 5.5 }, -- studs from the (upcoming) edge where they head back in
	Dodge = { 0, 0.8 }, -- chance to sidestep a dash coming at them
	DashReach = 12, -- studs: how far away they'll start a lunge
}

BumperBout.Info = {
	Name = "Bumper Bout",
	Description = "Shove your rival off the platform! Walk around and press DASH to lunge into them. The platform shrinks, so stay near the middle. Don't dash yourself off!",
	Duration = BumperBout.ROUND_LIMIT,
	Layout = Config.Layouts.Duel,
	Camera = { Mode = "AngledOverhead", Height = 50, Distance = 30, Follow = 0, Smooth = 20, TouchZoom = 1, TouchLookAhead = 4 },
	Controls = {
		Move = true,
		Jump = false,
		WalkSpeed = BumperBout.WALK_SPEED,
		Actions = {
			{ Action = "Dash", Label = "DASH", Keys = { "E", "Space" }, Gamepads = { "ButtonX", "ButtonR1" } },
		},
	},
	ProgressLabel = "Hits",
	ClientModule = "BumperBout", -- sends the dash with the stick/keys direction; cooldown on the button
}

-- Rules (pure) ------------------------------------------------------------------------------

local function finite(n): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end
BumperBout.finite = finite

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- Safe radius `elapsed` seconds into the round: flat, then a smooth shrink, then flat.
function BumperBout.radiusAt(elapsed: number): number
	local t = math.clamp((elapsed - BumperBout.SHRINK_DELAY) / BumperBout.SHRINK_DURATION, 0, 1)
	t = t * t * (3 - 2 * t)
	return BumperBout.START_RADIUS + (BumperBout.FINAL_RADIUS - BumperBout.START_RADIUS) * t
end

--[[
	Per-round rule state. `fighters` = the two participants. Positions handed to the rule
	functions are relative to the platform centre (Y = height above the platform top).
]]
function BumperBout.newCore(fighters)
	local core = { Active = false, Step = 0, Fighters = {} }
	for _, participant in fighters do
		core.Fighters[participant] = {
			LastDashAt = -math.huge,
			Dash = nil, -- { Id, Dir, StartedAt, Until, Hit }
			DashCount = 0,
			Hits = 0,
			HitStep = nil, -- step they were last hit on
			Out = false,
			OutStep = nil,
		}
	end
	return core
end

--[[
	A dash request at server time `now`. `dir` is an optional direction (Vector3 or {X, Z})
	from the player's client; nil or zero falls back to `fallback` (their facing). Returns
	ok, reason, and the normalized flat direction.
]]
function BumperBout.validateDash(core, participant, dir, fallback, now: number)
	local fighter = core.Fighters[participant]
	if not fighter then
		return false, "not_in_duel"
	end
	if not core.Active then
		return false, "not_playing"
	end
	if fighter.Out then
		return false, "out"
	end
	if not finite(now) or now - fighter.LastDashAt < BumperBout.DASH_COOLDOWN then
		return false, "cooldown"
	end
	local x, z
	if typeof(dir) == "Vector3" then
		x, z = dir.X, dir.Z
	elseif type(dir) == "table" then
		x, z = dir.X, dir.Z
	elseif dir ~= nil then
		return false, "malformed"
	end
	if dir ~= nil then
		if not finite(x) or not finite(z) then
			return false, "malformed"
		end
		if x * x + z * z > 1.5 * 1.5 then
			return false, "malformed" -- a direction, not a destination
		end
	end
	local chosen = if x and (x * x + z * z) > 0.01 then Vector3.new(x, 0, z) else nil
	if not chosen and typeof(fallback) == "Vector3" and finite(fallback.X) and finite(fallback.Z) then
		chosen = flat(fallback)
	end
	if not chosen or chosen.Magnitude < 0.01 then
		return false, "no_direction"
	end
	fighter.LastDashAt = now
	fighter.DashCount += 1
	fighter.Dash = {
		Id = fighter.DashCount,
		Dir = chosen.Unit,
		StartedAt = now,
		Until = now + BumperBout.DASH_DURATION,
		Hit = false,
	}
	return true, nil, chosen.Unit
end

local function lunging(fighter, now: number): boolean
	local dash = fighter.Dash
	return dash ~= nil and not dash.Hit and now <= dash.Until + BumperBout.HIT_WINDOW_EXTRA
end

--[[
	Who hit whom this step. positions[p] = Vector3 (relative). Each dash can hit once. Two
	lunges meeting is a clash: both bounce back (weaker) and both count a hit.
	Returns a list of { Attacker, Victim, Dir (flat unit, away from the attacker), Speed }.
]]
function BumperBout.detectHits(core, positions, now: number)
	core.Step += 1
	local list = {}
	local a, b
	for participant in core.Fighters do
		if a then
			b = participant
		else
			a = participant
		end
	end
	if not a or not b then
		return list
	end
	local fa, fb = core.Fighters[a], core.Fighters[b]
	local pa, pb = positions[a], positions[b]
	if fa.Out or fb.Out or not pa or not pb then
		return list
	end
	local gap = flat(pb - pa)
	if gap.Magnitude > BumperBout.HIT_RADIUS then
		return list
	end
	local away = if gap.Magnitude > 0.01 then gap.Unit else Vector3.new(1, 0, 0)
	local la, lb = lunging(fa, now), lunging(fb, now)
	local function hit(attacker, victim, dir, speed)
		local fAttacker, fVictim = core.Fighters[attacker], core.Fighters[victim]
		fAttacker.Dash.Hit = true
		fAttacker.Hits += 1
		fVictim.HitStep = core.Step
		table.insert(list, { Attacker = attacker, Victim = victim, Dir = dir, Speed = math.min(speed, BumperBout.KNOCKBACK_MAX) })
	end
	if la and lb then
		local speed = BumperBout.KNOCKBACK * BumperBout.CLASH_FACTOR
		hit(a, b, away, speed)
		hit(b, a, -away, speed)
	elseif la then
		local dir = (away + fa.Dash.Dir).Unit -- mostly away from the attacker, along the lunge
		hit(a, b, dir, BumperBout.KNOCKBACK)
	elseif lb then
		local dir = (-away + fb.Dash.Dir).Unit
		hit(b, a, dir, BumperBout.KNOCKBACK)
	end
	return list
end

-- Knockback speed `t` seconds after impact (0 once it's over); never above the cap.
function BumperBout.knockbackSpeed(speed: number, t: number): number
	if not finite(speed) or not finite(t) or t < 0 or t > BumperBout.KNOCKBACK_TIME then
		return 0
	end
	return math.min(speed, BumperBout.KNOCKBACK_MAX) * math.exp(-BumperBout.KNOCKBACK_DECAY * t)
end

-- Is a body at `position` (relative) off a platform of `radius`?
function BumperBout.isOut(position: Vector3, radius: number): boolean
	if not finite(position.X) or not finite(position.Y) or not finite(position.Z) then
		return true
	end
	return position.Y < -BumperBout.FALL_DEPTH or flat(position).Magnitude > radius + BumperBout.EDGE_GRACE
end

--[[
	Marks ring-outs this step and decides the loser if both went out together:
	the one hit first loses; hit on the same step (or neither hit): the one farther from the
	middle loses; still equal: nobody (a shared result). Returns { out participants }, loser
	(nil = tie, or nobody out).
]]
function BumperBout.ringOuts(core, positions, radius: number)
	local out = {}
	for participant, fighter in core.Fighters do
		local position = positions[participant]
		if not fighter.Out and position and BumperBout.isOut(position, radius) then
			table.insert(out, participant)
		end
	end
	for _, participant in out do
		local fighter = core.Fighters[participant]
		fighter.Out = true
		fighter.OutStep = core.Step
	end
	if #out == 1 then
		return out, out[1]
	elseif #out == 2 then
		local a, b = out[1], out[2]
		local ha, hb = core.Fighters[a].HitStep or math.huge, core.Fighters[b].HitStep or math.huge
		if ha ~= hb then
			return out, if ha < hb then a else b
		end
		local da, db = flat(positions[a]).Magnitude, flat(positions[b]).Magnitude
		if math.abs(da - db) > BumperBout.CENTER_TIE then
			return out, if da > db then a else b
		end
		return out, nil
	end
	return out, nil
end

--[[
	Time limit: closest to the middle wins; within CENTER_TIE, more hits wins; otherwise nil
	(go to sudden death, or share the result if that's over too).
]]
function BumperBout.timeLimitWinner(core, positions)
	local a, b
	for participant, fighter in core.Fighters do
		if not fighter.Out then
			if a then
				b = participant
			else
				a = participant
			end
		end
	end
	if a and not b then
		return a
	end
	if not a then
		return nil
	end
	local da, db = flat(positions[a]).Magnitude, flat(positions[b]).Magnitude
	if math.abs(da - db) > BumperBout.CENTER_TIE then
		return if da < db then a else b
	end
	local ha, hb = core.Fighters[a].Hits, core.Fighters[b].Hits
	if ha ~= hb then
		return if ha > hb then a else b
	end
	return nil
end

-- Bot planning (pure) ---------------------------------------------------------------------

local function blend(pair, skill: number): number
	return pair[1] + (pair[2] - pair[1]) * skill
end

local function rotate(v: Vector3, degrees: number): Vector3
	local r = math.rad(degrees)
	local c, s = math.cos(r), math.sin(r)
	return Vector3.new(v.X * c - v.Z * s, 0, v.X * s + v.Z * c)
end

--[[
	One bot decision. All positions/velocities relative to the platform centre.
	  me, myVel, them, theirVel     where we both are and how we're moving
	  theirDash                     their lunge direction if they're lunging now, else nil
	  radius, radiusSoon            safe radius now and a moment from now (shrink-aware)
	  canDash                       my cooldown is ready
	Returns { MoveTo = Vector3, Dash = Vector3? (flat unit) }.
]]
function BumperBout.botPlan(state, skill: number, rng: Random)
	local bot = BumperBout.BOT
	local me, them = flat(state.Me), flat(state.Them)
	local radius = math.min(state.Radius, state.RadiusSoon or state.Radius)
	local margin = blend(bot.EdgeMargin, skill)
	local plan = { MoveTo = Vector3.zero, Dash = nil }

	-- 1. A lunge coming my way: sidestep (skill permitting), towards the middle side.
	if state.TheirDash then
		local toMe = me - them
		if toMe.Magnitude < bot.DashReach + 3 and toMe.Magnitude > 0.01 and toMe.Unit:Dot(flat(state.TheirDash)) > 0.7 then
			if rng:NextNumber() < blend(bot.Dodge, skill) then
				local side = Vector3.new(-state.TheirDash.Z, 0, state.TheirDash.X)
				if (me + side * 6).Magnitude > (me - side * 6).Magnitude then
					side = -side
				end
				plan.MoveTo = me + side * 8
				return plan
			end
		end
	end

	-- 2. Too close to the (upcoming) edge: head back in.
	if me.Magnitude > radius - margin then
		plan.MoveTo = Vector3.zero
		return plan
	end

	-- 3. Line up: stand on the middle side of the opponent, a dash-length away.
	local predicted = them + flat(state.TheirVel or Vector3.zero) * blend(bot.Lead, skill)
	local inward = if predicted.Magnitude > 0.01 then -predicted.Unit else Vector3.new(1, 0, 0)
	local spot = predicted + inward * 7
	if spot.Magnitude > radius - margin then
		spot = spot.Unit * math.max(0, radius - margin)
	end
	plan.MoveTo = spot

	-- 4. Lunge when they're in reach and the push sends them outward, and only if my own
	-- lunge can't carry me off the edge.
	if state.CanDash then
		local toThem = predicted - me
		local distance = toThem.Magnitude
		if distance > 0.5 and distance <= bot.DashReach then
			local dir = toThem.Unit
			local outward = if predicted.Magnitude > 0.01 then predicted.Unit else dir
			local lined = dir:Dot(outward) > 0.2 or predicted.Magnitude > me.Magnitude
			if rng:NextNumber() < blend(bot.Mistake, skill) then
				dir = rotate(dir, (rng:NextNumber() * 2 - 1) * bot.MistakeAngle) -- a poor angle
				lined = true -- ... or simply too eager
			end
			local landing = me + dir * (BumperBout.DASH_SPEED * BumperBout.DASH_DURATION)
			if lined and landing.Magnitude < radius - 1 then
				plan.Dash = dir
			end
		end
	end
	return plan
end

-- Round ---------------------------------------------------------------------------------------

local function now(): number
	return os.clock()
end

function BumperBout:_relative(participant): Vector3?
	local root = participant:GetRoot()
	if not root or not self.Top then
		return nil
	end
	return root.Position - self.Top
end

function BumperBout:_positions()
	local positions = {}
	for _, participant in self.Participants do
		positions[participant] = self:_relative(participant)
	end
	return positions
end

function BumperBout:_part(properties)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanTouch = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	for key, value in properties do
		part[key] = value
	end
	part.Parent = self.Arena.Folder
	return part
end

function BumperBout:_setRadius(radius: number)
	self.Radius = radius
	if self.ShownRadius and math.abs(self.ShownRadius - radius) < 0.1 then
		return
	end
	self.ShownRadius = radius
	local height = BumperBout.PLATFORM_HEIGHT
	-- A cylinder's axis is its X: turn it upright.
	local upright = CFrame.Angles(0, 0, math.rad(90))
	self.Platform.Size = Vector3.new(height, radius * 2, radius * 2)
	self.Platform.CFrame = self.Arena.Origin * CFrame.new(0, -height / 2, 0) * upright
	self.Rim.Size = Vector3.new(height * 0.6, radius * 2 + 1.2, radius * 2 + 1.2)
	self.Rim.CFrame = self.Arena.Origin * CFrame.new(0, -height * 0.5, 0) * upright
end

function BumperBout:Setup(arena, participants, round)
	self.Core = BumperBout.newCore(participants)
	self.Connections = {}
	self.Effects = {} -- [participant] = { Attachment, Dash = LinearVelocity, Push = LinearVelocity, Highlight }
	self.Owners = {}
	self.Rng = round.Rng or Random.new()
	self.Top = arena.Origin.Position
	self.Platform = self:_part({
		Name = "Platform",
		Shape = Enum.PartType.Cylinder,
		Color = Color3.fromRGB(235, 225, 200),
	})
	self.Rim = self:_part({
		Name = "Rim",
		Shape = Enum.PartType.Cylinder,
		CanCollide = false,
		CanQuery = false,
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 120, 60),
	})
	self:_setRadius(BumperBout.START_RADIUS)
	self:_part({
		Name = "CentreMark",
		Shape = Enum.PartType.Cylinder,
		CanCollide = false,
		CanQuery = false,
		Size = Vector3.new(0.1, 3, 3),
		CFrame = arena.Origin * CFrame.new(0, 0.02, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(200, 185, 150),
	})
	-- Invisible catch floor far below, so a ring-out lands somewhere instead of falling forever.
	self:_part({
		Name = "RecoveryFloor",
		Size = Vector3.new(160, 2, 160),
		CFrame = arena.Origin * CFrame.new(0, -30, 0),
		Transparency = 1,
		CanQuery = false,
	})
	local spawns = {}
	local spread = BumperBout.SPAWN_DISTANCE
	for index, participant in participants do
		local side = if index == 1 then -1 else 1
		local position = (arena.Origin * CFrame.new(side * spread, 4, 0)).Position
		spawns[index] = CFrame.lookAt(position, (arena.Origin * CFrame.new(0, 4, 0)).Position)
	end
	return spawns
end

-- Velocity constraint driving a body along the floor (gravity still acts).
function BumperBout:_drive(participant, kind: string, velocity: Vector3)
	local effects = self.Effects[participant]
	local root = participant:GetRoot()
	if not effects or not root or not root.Parent then
		return
	end
	if not effects.Attachment or not effects.Attachment.Parent then
		effects.Attachment = Instance.new("Attachment")
		effects.Attachment.Name = "BumperBoutAttachment"
		effects.Attachment.Parent = root
	end
	local constraint = effects[kind]
	if not constraint or not constraint.Parent then
		constraint = Instance.new("LinearVelocity")
		constraint.Name = "BumperBout" .. kind
		constraint.Attachment0 = effects.Attachment
		constraint.RelativeTo = Enum.ActuatorRelativeTo.World
		constraint.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
		constraint.PrimaryTangentAxis = Vector3.new(1, 0, 0)
		constraint.SecondaryTangentAxis = Vector3.new(0, 0, 1)
		constraint.MaxForce = 1e5
		constraint.Parent = root
		effects[kind] = constraint
	end
	constraint.PlaneVelocity = Vector2.new(velocity.X, velocity.Z)
	constraint.Enabled = velocity.Magnitude > 0.05
end

function BumperBout:_highlight(participant, color: Color3?, fill: number?)
	local effects = self.Effects[participant]
	local character = participant:GetCharacter()
	if not effects or not character then
		return
	end
	local highlight = effects.Highlight
	if not highlight or not highlight.Parent then
		highlight = Instance.new("Highlight")
		highlight.Name = "BumperBoutCue"
		highlight.Parent = character
		effects.Highlight = highlight
	end
	highlight.Enabled = color ~= nil
	if color then
		highlight.OutlineColor = color
		highlight.FillColor = color
		highlight.FillTransparency = fill or 1 -- outline only: cosmetics stay visible
	end
end

-- The one way a dash starts, for players and bots alike.
function BumperBout:RequestDash(participant, dir)
	if self.Round.Ended or not participant:IsAlive() then
		return false
	end
	local root = participant:GetRoot()
	local fallback = root and root.CFrame.LookVector
	local humanoid = participant:GetHumanoid()
	if dir == nil and humanoid and humanoid.MoveDirection.Magnitude > 0.1 then
		dir = humanoid.MoveDirection -- moving: lunge that way
	end
	local ok, _, chosen = BumperBout.validateDash(self.Core, participant, dir, fallback, now())
	if not ok then
		return false
	end
	self:_drive(participant, "Dash", chosen * BumperBout.DASH_SPEED)
	self:_highlight(participant, Color3.fromRGB(255, 230, 80), 1)
	if participant.Player then
		Net.minigameRemote():FireClient(participant.Player, { Type = "Cooldown", Seconds = BumperBout.DASH_COOLDOWN })
	end
	return true
end

function BumperBout:_knockOut(participant, why: string?)
	local root = participant:GetRoot()
	self:_drive(participant, "Dash", Vector3.zero)
	self:_drive(participant, "Push", Vector3.zero)
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
	end
	self.Round:Eliminate(participant, true)
	self.Round:Toast(("💥 %s %s"):format(participant.Name, why or "fell off!"))
end

function BumperBout:_finish(winner, reason: string)
	self.Winner = winner
	self.Decided = true
	self.Core.Active = false
	self.Round:End(reason)
end

function BumperBout:_other(participant)
	for _, other in self.Participants do
		if other ~= participant then
			return other
		end
	end
end

-- Snap a player back if their body moved faster than anything in the game allows.
function BumperBout:_checkPlausible(participant, dt: number)
	if participant.IsBot or dt <= 0 then
		return
	end
	local root = participant:GetRoot()
	if not root then
		return
	end
	local last = self.LastGood[participant]
	local position = root.Position
	if last and (flat(position - last.Position)).Magnitude / dt > BumperBout.MAX_PLAUSIBLE_SPEED then
		root.CFrame = last.CFrame
		root.AssemblyLinearVelocity = Vector3.zero
		self.Snaps = (self.Snaps or 0) + 1
		return
	end
	self.LastGood[participant] = { Position = position, CFrame = root.CFrame }
end

function BumperBout:_step(dt: number)
	local round = self.Round
	if round.Ended or not self.Core.Active then
		return
	end
	local clock = now()
	local elapsed = clock - self.StartedAt
	local radius = BumperBout.radiusAt(if self.SuddenDeath then math.huge else elapsed)
	self:_setRadius(radius)

	-- Status warnings before anything changes under anyone.
	if not self.Warned and elapsed >= BumperBout.SHRINK_DELAY - BumperBout.SHRINK_WARNING then
		self.Warned = true
		round:SetStatus("⚠ Platform shrinking!")
	end
	if not self.WarnedFinal and elapsed >= BumperBout.SHRINK_DELAY + BumperBout.SHRINK_DURATION then
		self.WarnedFinal = true
		round:SetStatus("Final circle!")
	end

	-- Lunges and pushes play out.
	for _, participant in self.Participants do
		local fighter = self.Core.Fighters[participant]
		local dash = fighter.Dash
		if dash and clock > dash.Until and not dash.Ended then
			dash.Ended = true
			self:_drive(participant, "Dash", Vector3.zero)
			self:_highlight(participant, nil)
		end
		local push = self.Pushes[participant]
		if push then
			local speed = BumperBout.knockbackSpeed(push.Speed, clock - push.At)
			self:_drive(participant, "Push", push.Dir * speed)
			if speed <= 0 then
				self.Pushes[participant] = nil
				self:_highlight(participant, nil)
			end
		end
		self:_checkPlausible(participant, dt)
	end

	local positions = self:_positions()
	for _, hit in BumperBout.detectHits(self.Core, positions, clock) do
		self.Pushes[hit.Victim] = { Dir = hit.Dir, Speed = hit.Speed, At = clock }
		self:_drive(hit.Victim, "Push", hit.Dir * hit.Speed) -- push starts on the impact frame
		self:_drive(hit.Attacker, "Dash", Vector3.zero) -- the lunge stops on impact
		self:_drive(hit.Victim, "Dash", Vector3.zero) -- and so does any lunge the victim was in
		self:_highlight(hit.Victim, Color3.new(1, 1, 1), 0.7) -- brief impact flash
		round:ReportProgress(hit.Attacker, self.Core.Fighters[hit.Attacker].Hits)
		round:Toast(("💢 %s bumps %s!"):format(hit.Attacker.Name, hit.Victim.Name))
	end

	local out, loser = BumperBout.ringOuts(self.Core, positions, radius)
	if #out > 0 then
		for _, participant in out do
			self:_knockOut(participant)
		end
		if #out == 2 then
			self:_finish(if loser then self:_other(loser) else nil, "RingOut")
		else
			self:_finish(self:_other(out[1]), "RingOut")
		end
		return
	end

	-- Time limit: closest to the middle; then hits; then a short sudden death.
	if not self.SuddenDeath and elapsed >= BumperBout.ROUND_LIMIT then
		local winner = BumperBout.timeLimitWinner(self.Core, positions)
		if winner then
			round:Toast(("⏱ %s is closest to the middle!"):format(winner.Name))
			self:_finish(winner, "TimeLimit")
		else
			self.SuddenDeath = true
			self.SuddenDeathEnds = clock + BumperBout.SUDDEN_DEATH
			round:SetStatus("⚡ Sudden death!")
		end
	elseif self.SuddenDeath and clock >= self.SuddenDeathEnds then
		self:_finish(BumperBout.timeLimitWinner(self.Core, positions), "SuddenDeath")
	end
end

function BumperBout:Start()
	self.StartedAt = now()
	self.Core.Active = true
	self.Pushes = {}
	self.LastGood = {}
	-- The framework ends the round at Duration; we decide at ROUND_LIMIT ourselves and may
	-- need sudden death, so its hard stop is pushed back by that much.
	if self.Round.EndsAt then
		self.Round.EndsAt += BumperBout.SUDDEN_DEATH + 1
	end
	for _, participant in self.Participants do
		self.Effects[participant] = {}
		self.Round:ReportProgress(participant, 0)
		-- Pin who simulates each body for the whole bout: the player for their own, the server
		-- for bots, so ownership can't flip back and forth when they get close.
		local root = participant:GetRoot()
		if root and not root.Anchored then
			pcall(function()
				root:SetNetworkOwner(participant.Player)
			end)
			table.insert(self.Owners, root)
		end
	end
	self.Round:SetStatus("Bump your rival off! DASH to lunge")
	table.insert(
		self.Connections,
		RunService.Heartbeat:Connect(function(dt)
			self:_step(dt)
		end)
	)
end

function BumperBout:OnInput(participant, action)
	if action == "Dash" then
		local memory = participant.IsBot and participant.Bot and participant.Bot.Memory
		self:RequestDash(participant, memory and memory.Aim or nil)
	end
end

-- From client/Minigames/BumperBout: { Type = "Dash", X, Z } (the stick/keys direction).
function BumperBout:OnClientMessage(participant, message)
	if participant.IsBot or type(message) ~= "table" or message.Type ~= "Dash" then
		return
	end
	if not finite(message.X) or not finite(message.Z) then
		return
	end
	self:RequestDash(participant, { X = message.X, Z = message.Z })
end

function BumperBout:OnParticipantLost(participant, reason)
	local fighter = self.Core.Fighters[participant]
	if not fighter or self.Decided then
		return
	end
	fighter.Out = true
	fighter.OutStep = self.Core.Step
	self.Round:Toast(("💥 %s %s"):format(participant.Name, if reason == "Left" then "left the duel" else "is out!"))
	self:_finish(self:_other(participant), "Lost")
end

function BumperBout:UpdateBot(bot, _dt)
	local me = bot.Participant
	local fighter = self.Core.Fighters[me]
	if not fighter or fighter.Out or not self.Core.Active then
		return
	end
	local memory = bot.Memory
	local clock = now()
	if clock < (memory.NextThink or 0) then
		return
	end
	memory.NextThink = clock + blend(BumperBout.BOT.Reaction, bot.Skill or 0.5) * self.Rng:NextNumber(0.8, 1.2)
	local them = self:_other(me)
	local myPos, theirPos = self:_relative(me), them and self:_relative(them)
	if not myPos or not theirPos then
		return
	end
	local theirFighter = self.Core.Fighters[them]
	local theirDash = theirFighter.Dash
	local myRoot, theirRoot = me:GetRoot(), them:GetRoot()
	local elapsed = clock - self.StartedAt
	local plan = BumperBout.botPlan({
		Me = myPos,
		MyVel = myRoot and myRoot.AssemblyLinearVelocity or Vector3.zero,
		Them = theirPos,
		TheirVel = theirRoot and theirRoot.AssemblyLinearVelocity or Vector3.zero,
		TheirDash = if theirDash and clock <= theirDash.Until then theirDash.Dir else nil,
		Radius = self.Radius,
		RadiusSoon = BumperBout.radiusAt(if self.SuddenDeath then math.huge else elapsed + 1.5),
		CanDash = clock - fighter.LastDashAt >= BumperBout.DASH_COOLDOWN,
	}, bot.Skill or 0.5, self.Rng)
	bot:MoveTo(self.Top + plan.MoveTo)
	if plan.Dash then
		memory.Aim = plan.Dash
		bot:Input("Dash")
		memory.Aim = nil
	end
end

function BumperBout:GetResults()
	if self.Decided and self.Winner then
		return ResultsUtil.fromScores(self.Participants, function(participant)
			return if participant == self.Winner then 1 else 0
		end)
	end
	-- Undecided (shared result): everyone ties.
	return ResultsUtil.fromScores(self.Participants, function()
		return 0
	end)
end

function BumperBout:Cleanup()
	for _, connection in self.Connections do
		connection:Disconnect()
	end
	table.clear(self.Connections)
	if self.Core then
		self.Core.Active = false
	end
	for _, effects in self.Effects or {} do
		for _, key in { "Dash", "Push", "Attachment", "Highlight" } do
			if effects[key] then
				effects[key]:Destroy()
			end
		end
	end
	self.Effects = {}
	for _, root in self.Owners or {} do
		if root.Parent then
			pcall(function()
				root:SetNetworkOwnershipAuto()
			end)
		end
	end
	self.Owners = {}
	-- Platform, rim and catch floor live in arena.Folder, which the framework destroys.
end

BumperBout.blend = blend

return BumperBout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">FallingPlatforms</string>
            <string name="Source"><![CDATA[--[[
	Falling Platforms (FFA, elimination)
	A grid of tiles floating over the void. Any tile you stand on starts to crumble, and
	random tiles drop faster and faster as the round goes on. Fall and you're out.
	Last one standing wins; if time runs out every survivor ties for 1st.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.PartyShared.Config)
local ResultsUtil = require(script.Parent.Parent.ResultsUtil)

local FallingPlatforms = {}

FallingPlatforms.Info = {
	Name = "Falling Platforms",
	Description = "Tiles crumble after you step on them and random ones drop out. Keep moving, don't fall!",
	Duration = 75,
	Layout = Config.Layouts.FFA,
	Camera = { Mode = "FollowBehind" },
	Controls = { Move = true, Jump = true, WalkSpeed = 18 }, -- no actions, slightly zippier
	ProgressLabel = "Survived",
}

-- Tuning ----------------------------------------------------------------------------------
-- These decide how long a round lasts. Aim: 30-45 seconds with four players.

local GRID_SIZE = 10 -- GRID_SIZE x GRID_SIZE tiles
local TILE_SIZE = 8
local GAP = 1
-- Seconds a tile survives after being stepped on: { at GO, once the round is fully sped up }.
local CRUMBLE_DELAY = { 3.0, 1.2 }
-- Random drops: warning time for the tile, and seconds between drops { at GO, sped up }.
local RANDOM_DELAY = 2.0
local RANDOM_INTERVAL = { 3.0, 0.8 }
local RAMP_TIME = 45 -- seconds after GO until both of the above reach their fastest value
local START_GRACE = 1.5 -- tiles ignore footsteps this long after GO, so nobody drops before they can react
local CHECK_INTERVAL = 0.1

local SOLID_COLOR = Color3.fromRGB(110, 220, 255)
local WARNING_COLOR = Color3.fromRGB(255, 200, 40)
local CRUMBLE_COLOR = Color3.fromRGB(255, 70, 70)

-- Setup -----------------------------------------------------------------------------------

function FallingPlatforms:Setup(arena, participants, _round)
	self.Tiles = {} -- [row][col] = { Part, State = "Solid" | "Warning" | "Fallen", Row, Col }
	self.Connections = {}

	local pitch = TILE_SIZE + GAP
	local half = (GRID_SIZE - 1) / 2
	for row = 1, GRID_SIZE do
		self.Tiles[row] = {}
		for col = 1, GRID_SIZE do
			local part = Instance.new("Part")
			part.Name = ("Tile_%d_%d"):format(row, col)
			part.Anchored = true
			part.Size = Vector3.new(TILE_SIZE, 1, TILE_SIZE)
			part.CFrame = arena.Origin * CFrame.new((col - 1 - half) * pitch, 0, (row - 1 - half) * pitch)
			-- Checkerboard tint so the grid reads well from above.
			part.Color = if (row + col) % 2 == 0 then SOLID_COLOR else SOLID_COLOR:Lerp(Color3.new(1, 1, 1), 0.3)
			part.Material = Enum.Material.SmoothPlastic
			part.Parent = arena.Folder
			self.Tiles[row][col] = { Part = part, State = "Solid", Row = row, Col = col }
		end
	end

	-- One player per corner-ish tile.
	local spawnTiles = { { 2, 2 }, { 2, GRID_SIZE - 1 }, { GRID_SIZE - 1, 2 }, { GRID_SIZE - 1, GRID_SIZE - 1 } }
	local spawns = {}
	for index = 1, #participants do
		local cell = spawnTiles[(index - 1) % #spawnTiles + 1]
		local tile = self.Tiles[cell[1]][cell[2]]
		local position = tile.Part.Position + Vector3.new(0, 4, 0)
		spawns[index] = CFrame.lookAt(position, Vector3.new(arena.Origin.X, position.Y, arena.Origin.Z))
	end
	return spawns
end

-- Tiles -----------------------------------------------------------------------------------

-- Which tile (if any) is directly under a world position.
function FallingPlatforms:_tileAt(position: Vector3)
	local localPosition = self.Arena.Origin:PointToObjectSpace(position)
	local pitch = TILE_SIZE + GAP
	local half = (GRID_SIZE - 1) / 2
	local col = math.floor(localPosition.X / pitch + half + 0.5) + 1
	local row = math.floor(localPosition.Z / pitch + half + 0.5) + 1
	local tileRow = self.Tiles[row]
	return tileRow and tileRow[col]
end

function FallingPlatforms:_crumble(tile, delay: number)
	if tile.State ~= "Solid" then
		return
	end
	tile.State = "Warning"
	tile.FallsAt = os.clock() + delay
	tile.Part.Color = WARNING_COLOR
	tile.Part.Material = Enum.Material.Neon

	task.delay(delay * 0.5, function()
		if tile.State == "Warning" and tile.Part.Parent then
			tile.Part.Color = CRUMBLE_COLOR
		end
	end)
	task.delay(delay, function()
		if tile.State ~= "Warning" or not tile.Part.Parent then
			return
		end
		tile.State = "Fallen"
		tile.Part.CanCollide = false
		tile.Part.Material = Enum.Material.Slate
		TweenService:Create(tile.Part, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			CFrame = tile.Part.CFrame * CFrame.new(0, -40, 0) * CFrame.Angles(math.rad(25), 0, math.rad(15)),
			Transparency = 1,
		}):Play()
	end)
end

-- 0 at GO, 1 once the round has fully sped up.
function FallingPlatforms:_ramp(): number
	return math.clamp((os.clock() - (self.StartedAt or os.clock())) / RAMP_TIME, 0, 1)
end

function FallingPlatforms:_crumbleDelay(): number
	return CRUMBLE_DELAY[1] + (CRUMBLE_DELAY[2] - CRUMBLE_DELAY[1]) * self:_ramp()
end

function FallingPlatforms:_solidTiles()
	local list = {}
	for _, row in self.Tiles do
		for _, tile in row do
			if tile.State == "Solid" then
				table.insert(list, tile)
			end
		end
	end
	return list
end

-- Interface -------------------------------------------------------------------------------

function FallingPlatforms:Start()
	local round = self.Round
	local startedAt = os.clock()
	self.StartedAt = startedAt
	local nextChipUpdate = 0
	local nextCheck = 0
	local nextRandomDrop = os.clock() + RANDOM_INTERVAL[1]
	local floorY = self.Arena.Origin.Y

	table.insert(
		self.Connections,
		RunService.Heartbeat:Connect(function()
			local clock = os.clock()
			if round.Ended or clock < nextCheck then
				return
			end
			nextCheck = clock + CHECK_INTERVAL

			for _, participant in round:GetAlive() do
				local position = participant:GetPosition()
				if not position then
					continue
				end
				if position.Y < floorY - Config.FallOutDepth then
					round:Eliminate(participant, true)
					round:Toast(("🪂 %s fell into the void"):format(participant.Name))
					round:ReportProgress(participant, ("🪂 %ds"):format(clock - startedAt))
				elseif position.Y < floorY + 8 and clock - startedAt >= START_GRACE then
					-- Standing (or nearly) on the grid: the tile underneath starts crumbling.
					local tile = self:_tileAt(position)
					if tile then
						self:_crumble(tile, self:_crumbleDelay())
					end
				end
			end

			-- Random drops speed up over the round.
			if clock >= nextRandomDrop then
				local progress = math.clamp((clock - startedAt) / self.Info.Duration, 0, 1)
				local interval = RANDOM_INTERVAL[1] + (RANDOM_INTERVAL[2] - RANDOM_INTERVAL[1]) * progress
				nextRandomDrop = clock + interval
				local solid = self:_solidTiles()
				if #solid > 0 then
					self:_crumble(solid[round.Rng:NextInteger(1, #solid)], RANDOM_DELAY)
				end
			end

			-- Chips: seconds survived for anyone still standing.
			if clock >= nextChipUpdate then
				nextChipUpdate = clock + 1
				for _, participant in round:GetAlive() do
					round:ReportProgress(participant, ("%ds"):format(clock - startedAt))
				end
			end

			if #round:GetAlive() <= 1 then
				round:End("LastStanding")
			end
		end)
	)
	round:SetStatus("Keep moving! 🏃")
end

--[[
	Bot behaviour: stand on a tile until it is about to drop, then step to a neighbour.
	(Leaving a tile the moment it starts to crumble would burn through the whole floor in
	seconds.) Sloppier bots cut it closer and pick worse tiles, which is funny.
]]
function FallingPlatforms:_solidNeighbours(tile)
	local list = {}
	for _, offset in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
		local row = self.Tiles[tile.Row + offset[1]]
		local neighbour = row and row[tile.Col + offset[2]]
		if neighbour and neighbour.State == "Solid" then
			table.insert(list, neighbour)
		end
	end
	return list
end

function FallingPlatforms:UpdateBot(bot, _dt)
	local position = bot:GetPosition()
	if not position then
		return
	end
	local memory = bot.Memory
	local clock = os.clock()
	local current = self:_tileAt(position)
	if current and current.State == "Fallen" then
		current = nil
	end
	if not memory.Target then
		memory.Target = current
		memory.Margin = 0.6
	end
	local target = memory.Target

	if target and target ~= current and target.State == "Solid" then
		-- On the way. Hop if the floor ahead is already gone.
		local toTarget = target.Part.Position - position
		local flat = Vector3.new(toTarget.X, 0, toTarget.Z)
		if flat.Magnitude > 1 then
			local ahead = self:_tileAt(position + flat.Unit * 4)
			if not ahead or ahead.State == "Fallen" then
				bot:Jump()
			end
		end
		bot:MoveTo(target.Part.Position + Vector3.new(0, 3, 0))
		return
	end
	if target and target == current and (current.State == "Solid" or current.FallsAt - clock > memory.Margin) then
		bot:MoveTo(current.Part.Position + Vector3.new(0, 3, 0))
		return -- this tile still has time left: stay put
	end

	-- Pick the next tile: a solid 4-neighbour, preferring ones that aren't dead ends.
	local from = current or target
	local options = if from then self:_solidNeighbours(from) else {}
	if #options == 0 then
		-- Stranded: make a run (and a jump) for the nearest solid tile anywhere.
		local best, bestDistance = nil, math.huge
		for _, tile in self:_solidTiles() do
			local distance = (tile.Part.Position - position).Magnitude
			if distance < bestDistance then
				best, bestDistance = tile, distance
			end
		end
		options = { best }
	end
	if #options == 0 then
		memory.Target = nil -- no floor left anywhere; enjoy the fall
		return
	end

	local choice = options[math.random(1, #options)]
	if math.random() < bot.Skill then
		local bestExits = -1
		for _, tile in options do
			local exits = #self:_solidNeighbours(tile) + math.random() * 0.5
			if exits > bestExits then
				choice, bestExits = tile, exits
			end
		end
	end

	memory.Target = choice
	-- How late this bot dares to leave its next tile (seconds before it drops).
	memory.Margin = 0.35 + bot.Skill * 0.25 + math.random() * 0.45
	bot:MoveTo(choice.Part.Position + Vector3.new(0, 3, 0))
end

function FallingPlatforms:GetResults()
	return ResultsUtil.fromElimination(self.Participants, self.Round)
end

function FallingPlatforms:Cleanup()
	for _, connection in self.Connections do
		connection:Disconnect()
	end
end

return FallingPlatforms
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">HotPotato</string>
            <string name="Source"><![CDATA[--[[
	Hot Potato (FFA, elimination)
	One player holds a burning potato with a hidden fuse. Get next to someone and press
	Pass to hand it over. Whoever holds it when it explodes is out. Last one standing wins.
	If time runs out, the current holder explodes and everyone left ties for 1st.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.PartyShared.Config)
local ResultsUtil = require(script.Parent.Parent.ResultsUtil)

local HotPotato = {}

HotPotato.Info = {
	Name = "Hot Potato",
	Description = "Someone's holding a spicy potato 🥔🔥. Get close and pass it before it goes BOOM. Last one standing wins!",
	Duration = 90,
	Layout = Config.Layouts.FFA,
	Camera = { Mode = "AngledOverhead", Height = 50, Distance = 38 },
	Controls = {
		Move = true,
		Jump = true,
		Actions = {
			{ Action = "Pass", Label = "Pass!", Key = "E", Gamepad = "ButtonX" },
		},
	},
	ProgressLabel = "Potato",
}

local ARENA_RADIUS = 30
local PASS_RANGE = 9 -- studs between root parts
local PASS_COOLDOWN = 1.0 -- holder can't pass again this soon after receiving
local NO_TAG_BACKS = 3.0 -- can't pass straight back to whoever just gave it to you
local RECEIVE_STUN = 0.9 -- "hot hands": a new holder is rooted this long, so everyone else can scatter
local FUSE_RANGE = { 8, 14 } -- seconds, re-rolled for every new potato
local HOLDER_SPEED = 21 -- holder is a bit faster so they can actually catch people
local NEW_POTATO_DELAY = 2

-- Bot feel. Reaction times are { sloppiest bot, sharpest bot } in seconds, plus random jitter.
local BOT_PASS_REACTION = { 1.4, 0.25 } -- in range of a victim -> actually pressing Pass
local BOT_FLEE_REACTION = { 0.55, 0.12 } -- potato changes hands -> noticing and changing direction
local BOT_COMFORT_DISTANCE = { 16, 26 } -- each bot stops running once it is this far from the holder
local BOT_PERSONAL_SPACE = 13 -- non-holders steer apart when closer than this to each other

local function now()
	return Workspace:GetServerTimeNow()
end

-- Setup ---------------------------------------------------------------------------------

function HotPotato:Setup(arena, participants, _round)
	local origin = arena.Origin

	-- Round floor (cylinder parts lie along X, so rotate it flat).
	local floor = Instance.new("Part")
	floor.Name = "Floor"
	floor.Shape = Enum.PartType.Cylinder
	floor.Size = Vector3.new(2, ARENA_RADIUS * 2, ARENA_RADIUS * 2)
	floor.CFrame = origin * CFrame.Angles(0, 0, math.rad(90))
	floor.Anchored = true
	floor.Material = Enum.Material.Sand
	floor.Color = Color3.fromRGB(255, 200, 120)
	floor.Parent = arena.Folder

	-- Ring of see-through walls so nobody runs off the edge.
	local segments = 24
	for i = 1, segments do
		local angle = (i / segments) * math.pi * 2
		local wall = Instance.new("Part")
		wall.Name = "Wall"
		wall.Anchored = true
		wall.Size = Vector3.new(2, 8, ARENA_RADIUS * 2 * math.pi / segments + 1)
		wall.CFrame = origin
			* CFrame.Angles(0, -angle, 0)
			* CFrame.new(ARENA_RADIUS, 5, 0)
		wall.Transparency = 0.6
		wall.Color = Color3.fromRGB(255, 120, 60)
		wall.Material = Enum.Material.ForceField
		wall.Parent = arena.Folder
	end

	-- The potato itself. Anchored and moved every frame above the holder's head.
	local potato = Instance.new("Part")
	potato.Name = "Potato"
	potato.Shape = Enum.PartType.Ball
	potato.Size = Vector3.new(2.5, 2.5, 2.5)
	potato.Color = Color3.fromRGB(160, 110, 60)
	potato.Material = Enum.Material.Slate
	potato.Anchored = true
	potato.CanCollide = false
	potato.CanQuery = false
	potato.CanTouch = false
	potato.Transparency = 1
	potato.CFrame = origin
	local fire = Instance.new("Fire")
	fire.Size = 4
	fire.Heat = 8
	fire.Parent = potato
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 140, 40)
	light.Range = 12
	light.Parent = potato
	potato.Parent = arena.Folder

	self.Potato = potato
	self.Fire = fire
	self.Holder = nil
	self.PreviousHolder = nil
	self.ReceivedAt = 0
	self.FuseEndsAt = math.huge
	self.Connections = {}
	self.Highlight = nil

	-- Spawns: evenly around a circle, facing the middle.
	local spawns = {}
	for index = 1, #participants do
		local angle = (index / #participants) * math.pi * 2
		local position = (origin * CFrame.new(math.cos(angle) * 14, 4, math.sin(angle) * 14)).Position
		spawns[index] = CFrame.lookAt(position, Vector3.new(origin.X, position.Y, origin.Z))
	end
	return spawns
end

-- Potato handling -----------------------------------------------------------------------

-- Player chips: who's holding it, who's safe, who's toast.
function HotPotato:_refreshChips()
	for _, participant in self.Participants do
		local value = if self.Round:IsEliminated(participant)
			then "💥 cooked"
			elseif participant == self.Holder then "🥔 HOT!"
			else "😎 safe"
		self.Round:ReportProgress(participant, value)
	end
end

function HotPotato:_setHolder(participant)
	local previous = self.Holder
	if previous then
		previous:SetMovement(Config.DefaultWalkSpeed, true)
	end
	if self.Highlight then
		self.Highlight:Destroy()
		self.Highlight = nil
	end

	self.PreviousHolder = previous
	self.Holder = participant
	self.ReceivedAt = now()
	if not participant then
		self.Potato.Transparency = 1
		self.Fire.Enabled = false
		self:_refreshChips()
		return
	end

	-- Rooted for a beat, then faster than everyone else.
	participant:SetMovement(0, false)
	local receivedAt = self.ReceivedAt
	task.delay(RECEIVE_STUN, function()
		if not self.Cleaned and not self.Round.Ended and self.Holder == participant and self.ReceivedAt == receivedAt then
			participant:SetMovement(HOLDER_SPEED, true)
		end
	end)
	local character = participant:GetCharacter()
	if character then
		local highlight = Instance.new("Highlight")
		highlight.FillColor = Color3.fromRGB(255, 80, 0)
		highlight.OutlineColor = Color3.fromRGB(255, 230, 0)
		highlight.FillTransparency = 0.5
		highlight.Parent = character
		self.Highlight = highlight
	end
	self.Potato.Transparency = 0
	self.Fire.Enabled = true
	self.Round:SetStatus(("🥔 %s has the potato!"):format(participant.Name))
	self:_refreshChips()
end

-- Hands a fresh potato (new fuse) to a random survivor.
function HotPotato:_newPotato()
	local round = self.Round
	if round.Ended then
		return
	end
	local alive = round:GetAlive()
	if #alive <= 1 then
		round:End("LastStanding")
		return
	end
	self.FuseEndsAt = now() + round.Rng:NextNumber(FUSE_RANGE[1], FUSE_RANGE[2])
	self:_setHolder(alive[round.Rng:NextInteger(1, #alive)])
	round:Toast(("🔥 New potato! %s is holding it"):format(self.Holder.Name))
end

function HotPotato:_explode(spawnNext: boolean)
	local holder = self.Holder
	if not holder then
		return
	end
	self:_setHolder(nil)
	self.FuseEndsAt = math.huge

	local position = holder:GetPosition()
	if position then
		-- Visual only: no flinging and no joint breaking.
		local explosion = Instance.new("Explosion")
		explosion.Position = position
		explosion.BlastPressure = 0
		explosion.DestroyJointRadiusPercent = 0
		explosion.Parent = self.Arena.Folder
	end
	self.Round:Toast(("💥 BOOM! The potato popped on %s"):format(holder.Name))
	self.Round:Eliminate(holder, true)
	self:_refreshChips()

	if spawnNext then
		if #self.Round:GetAlive() <= 1 then
			self.Round:End("LastStanding")
		else
			self.Round:SetStatus("🥔 Reheating the potato...")
			task.delay(NEW_POTATO_DELAY, function()
				if not self.Cleaned then
					self:_newPotato()
				end
			end)
		end
	end
end

-- Closest eligible survivor in pass range, or nil.
function HotPotato:_passTarget(from)
	local fromPosition = from:GetPosition()
	if not fromPosition then
		return nil
	end
	local best, bestDistance = nil, PASS_RANGE
	for _, other in self.Round:GetAlive() do
		local position = other:GetPosition()
		local isTagBack = other == self.PreviousHolder and now() - self.ReceivedAt < NO_TAG_BACKS
		if other ~= from and position and not isTagBack then
			local distance = (position - fromPosition).Magnitude
			if distance <= bestDistance then
				best, bestDistance = other, distance
			end
		end
	end
	return best
end

function HotPotato:_tryPass(from)
	if from ~= self.Holder or now() - self.ReceivedAt < PASS_COOLDOWN then
		return
	end
	local target = self:_passTarget(from)
	if target then
		self:_setHolder(target)
	end
end

-- Interface -----------------------------------------------------------------------------

function HotPotato:Start()
	self:_refreshChips()
	self:_newPotato()
	table.insert(
		self.Connections,
		RunService.Heartbeat:Connect(function()
			if self.Round.Ended or not self.Holder then
				return
			end
			-- Keep the potato floating above the holder's head.
			local position = self.Holder:GetPosition()
			if position then
				self.Potato.CFrame = CFrame.new(position + Vector3.new(0, 4, 0))
					* CFrame.Angles(0, os.clock() * 4, 0)
			end
			-- Flicker harder as the fuse gets short (we never show the real number).
			local remaining = self.FuseEndsAt - now()
			self.Fire.Size = if remaining < 3 then 7 + math.sin(os.clock() * 30) * 2 else 4
			if remaining <= 0 then
				self:_explode(true)
			end
		end)
	)
end

function HotPotato:OnInput(participant, action)
	if action == "Pass" then
		self:_tryPass(participant)
	end
end

-- Someone died or left: if they had the potato, hand out a new one.
function HotPotato:OnParticipantLost(participant)
	if participant == self.Holder then
		self:_setHolder(nil)
		task.delay(NEW_POTATO_DELAY, function()
			if not self.Cleaned then
				self:_newPotato()
			end
		end)
	elseif #self.Round:GetAlive() <= 1 then
		self.Round:End("LastStanding")
	end
end

-- Time's up: whoever is holding it explodes on the buzzer.
function HotPotato:OnRoundEnding(reason)
	if reason == "TimeUp" then
		self:_explode(false)
	end
end

--[[
	Bot behaviour: if I have the potato, chase the nearest player I'm allowed to pass to and
	hand it over after a human-ish reaction delay. Otherwise keep my distance from the holder
	and from the other runners, so the pack spreads around the ring instead of clumping.
]]
local function reaction(range, skill: number): number
	return (range[1] + (range[2] - range[1]) * skill) * (0.7 + math.random() * 0.6)
end

function HotPotato:UpdateBot(bot, _dt)
	local me = bot.Participant
	local myPosition = bot:GetPosition()
	if not myPosition then
		return
	end
	local memory = bot.Memory
	local clock = now()
	local center = self.Arena.Origin.Position

	if self.Holder == me then
		if clock - self.ReceivedAt < RECEIVE_STUN then
			return
		end
		-- Chase whoever is closest, but not the player I can't tag back yet (unless nobody else is left).
		local target, targetDistance = nil, math.huge
		local fallback, fallbackDistance = nil, math.huge
		for _, other in self.Round:GetAlive() do
			local position = other:GetPosition()
			if other ~= me and position then
				local distance = (position - myPosition).Magnitude
				local blocked = other == self.PreviousHolder and clock - self.ReceivedAt < NO_TAG_BACKS
				if blocked then
					if distance < fallbackDistance then
						fallback, fallbackDistance = other, distance
					end
				elseif distance < targetDistance then
					target, targetDistance = other, distance
				end
			end
		end
		if not target then
			target, targetDistance = fallback, fallbackDistance
		end
		if not target then
			return
		end
		-- Each time it gets the potato a bot picks who to go after. Usually the closest
		-- player, sometimes someone further away, so the chases aren't all the same length.
		if memory.VictimFor ~= self.ReceivedAt then
			memory.VictimFor = self.ReceivedAt
			memory.Victim = target
			if math.random() > 0.45 + bot.Skill * 0.35 then
				local others = {}
				for _, other in self.Round:GetAlive() do
					if other ~= me and other ~= self.PreviousHolder and other:GetPosition() then
						table.insert(others, other)
					end
				end
				if #others > 0 then
					memory.Victim = others[math.random(1, #others)]
				end
			end
		end
		local victim = memory.Victim
		local victimPosition = victim and not self.Round:IsEliminated(victim) and victim:GetPosition()
		bot:MoveTo(victimPosition or target:GetPosition())
		-- Whoever wanders into reach gets it, victim or not.
		if targetDistance <= PASS_RANGE * 0.9 then
			memory.PassAt = memory.PassAt or (clock + reaction(BOT_PASS_REACTION, bot.Skill))
			if clock >= memory.PassAt then
				memory.PassAt = nil
				bot:Input("Pass")
			end
		else
			memory.PassAt = nil
		end
		return
	end
	memory.PassAt = nil

	local holder = self.Holder
	local holderPosition = holder and holder:GetPosition()
	if not holderPosition then
		-- Nobody has it right now: wander to my own spot instead of bunching up in the middle.
		if not memory.IdleSpot or clock >= (memory.IdleUntil or 0) then
			local angle = math.random() * math.pi * 2
			local radius = 6 + math.random() * (ARENA_RADIUS - 14)
			memory.IdleSpot = center + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
			memory.IdleUntil = clock + 1.5 + math.random() * 1.5
		end
		bot:MoveTo(Vector3.new(memory.IdleSpot.X, myPosition.Y, memory.IdleSpot.Z))
		memory.SeenHolder = nil
		return
	end

	-- It takes a moment to notice the potato changed hands.
	if memory.SeenHolder ~= holder then
		memory.SeenHolder = holder
		memory.ReactAt = clock + reaction(BOT_FLEE_REACTION, bot.Skill)
	end
	if clock < (memory.ReactAt or 0) then
		return
	end
	memory.Comfort = memory.Comfort
		or (BOT_COMFORT_DISTANCE[1] + math.random() * (BOT_COMFORT_DISTANCE[2] - BOT_COMFORT_DISTANCE[1]))

	local away = myPosition - holderPosition
	away = Vector3.new(away.X, 0, away.Z)
	if away.Magnitude < 0.1 then
		away = Vector3.new(1, 0, 0)
	end

	-- Push away from the other runners too.
	local spread = Vector3.zero
	for _, other in self.Round:GetAlive() do
		local position = other ~= me and other ~= holder and other:GetPosition()
		if position then
			local apart = Vector3.new(myPosition.X - position.X, 0, myPosition.Z - position.Z)
			if apart.Magnitude < 0.1 then
				apart = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5)
			end
			if apart.Magnitude < BOT_PERSONAL_SPACE then
				spread += apart.Unit * (1 - apart.Magnitude / BOT_PERSONAL_SPACE)
			end
		end
	end

	if away.Magnitude > memory.Comfort and spread.Magnitude < 0.15 then
		bot:Stop() -- far enough and not crowded: catch a breath
		return
	end

	-- Each bot leans to one side for a while, so they don't all flee in the same straight line.
	if clock >= (memory.SwerveUntil or 0) then
		memory.Swerve = (math.random() - 0.5) * 1.2
		memory.SwerveUntil = clock + 0.8 + math.random() * 1.4
	end
	local urgency = math.clamp(1.6 - away.Magnitude / memory.Comfort, 0.2, 1.6)
	local direction = away.Unit * urgency
		+ Vector3.new(-away.Unit.Z, 0, away.Unit.X) * memory.Swerve
		+ spread * 1.4
	if direction.Magnitude < 0.05 then
		direction = away.Unit
	end
	local goal = myPosition + direction.Unit * 12
	local fromCenter = Vector3.new(goal.X - center.X, 0, goal.Z - center.Z)
	if fromCenter.Magnitude > ARENA_RADIUS - 5 then
		-- Cornered against the wall: slide around the ring instead, away from the holder.
		local tangent = Vector3.new(-fromCenter.Z, 0, fromCenter.X).Unit
		if tangent:Dot(away) < 0 then
			tangent = -tangent
		end
		goal = center + fromCenter.Unit * (ARENA_RADIUS - 7) + tangent * 8
	end
	bot:MoveTo(Vector3.new(goal.X, myPosition.Y, goal.Z))
end

function HotPotato:GetResults()
	return ResultsUtil.fromElimination(self.Participants, self.Round)
end

function HotPotato:Cleanup()
	self.Cleaned = true
	for _, connection in self.Connections do
		connection:Disconnect()
	end
	if self.Highlight then
		self.Highlight:Destroy()
	end
	-- The potato and map live in arena.Folder, which the framework destroys.
end

return HotPotato
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">IceDash</string>
            <string name="Source"><![CDATA[--[[
	Ice Dash (FFA, race)
	Everyone slides forward down a frozen track on their own; you only steer left and right.
	It's ice, so you drift: momentum carries you sideways after you let go. Snow drifts and
	puddles slow you, bumpers and walls bounce you, and some stretches have no side walls -
	slide off and you restart from the last checkpoint.
	First over the finish line wins. Everyone else is ranked by how far they got.

	Who simulates what (so it stays smooth on a laggy connection):
	  * Each player's client runs its own racer with the shared rules in PartyShared.IceDashSim
	    (see client/Minigames/IceDash) and reports its state ~20 times a second.
	  * The server checks every report (see _validateReport) and only then adopts it. It works
	    out checkpoints, falls and the finish itself, so finish order can't be faked.
	  * Bots are simulated here with the same rules.
	  * The server broadcasts everyone's accepted state ~20 times a second; clients draw the
	    other racers by interpolating between those snapshots.

	Physics and track tuning live at the top of PartyShared.IceDashSim (shared with the
	client). Network and anti-cheat tuning is below.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.PartyShared.Config)
local Net = require(ReplicatedStorage.PartyShared.Net)
local Sim = require(ReplicatedStorage.PartyShared.IceDashSim)
local ResultsUtil = require(script.Parent.Parent.ResultsUtil)

local IceDash = {}

-- Tuning ----------------------------------------------------------------------------------

local ROUND_DURATION = 40

-- Networking
local SNAPSHOT_RATE = 20 -- snapshots of every racer sent to clients per second
local FALLBACK_PLACE_RATE = 2 -- times per second the server itself moves the bodies (for late joiners)
local MAX_REPORT_AGE = 0.25 -- seconds a player's last report is projected forward in snapshots

-- Anti-cheat: how far a client's report may stray from what the rules allow before it is
-- thrown away and the client is snapped back to the last accepted state.
local CLOCK_SLACK = 0.35 -- seconds a client's race clock may run ahead of the server's
local SPEED_TOLERANCE = 1.08 -- sustained forward speed allowed, as a multiple of MAX_SPEED
local SPEED_BURST = 14 -- studs of extra forward travel allowed in a burst (bumper kicks, bounces)
local STEP_SLACK = 3 -- studs of slack on any single report's movement
local WALL_SLACK = 1 -- studs a report may poke past a wall or into a barrier
local RESPAWN_GRACE = 1.5 -- extra seconds a client gets to reappear at its checkpoint after falling

-- Start/checkpoint/finish arches. Tall enough that the chase camera (Height 12) passes
-- under the beam instead of having it fill the top of the screen after you finish.
local GATE_HEIGHT = 20

IceDash.Info = {
	Name = "Ice Dash",
	Description = "Slide down the ice ❄! You move on your own, so just steer. Dodge bumpers and snow, don't slip off the edge. First to the flag wins!",
	Duration = ROUND_DURATION,
	Layout = Config.Layouts.FFA,
	Camera = { Mode = "FollowBehind", Height = 12, Distance = 22, Smooth = 12 },
	Controls = {
		Move = false, -- you slide on your own; you only steer
		Jump = false,
		Actions = {
			{ Action = "Left", Label = "◀", Keys = { "A", "Left" }, Gamepad = "DPadLeft", Hold = true, Side = "Left" },
			{ Action = "Right", Label = "▶", Keys = { "D", "Right" }, Gamepad = "DPadRight", Hold = true },
		},
	},
	ProgressLabel = "Progress",
	ProgressBar = true,
	ClientModule = "IceDash", -- client/Minigames/IceDash runs the local racer and smooths the others
}

local HALF_WIDTH = Sim.HALF_WIDTH
local TRACK_LENGTH = Sim.TRACK_LENGTH

-- Track building ----------------------------------------------------------------------------

function IceDash:_part(properties)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in properties do
		part[key] = value
	end
	part.Parent = self.Arena.Folder
	return part
end

-- Track space -> world. x = sideways (+ is the racer's right), s = distance from the start line.
function IceDash:_at(x: number, y: number, s: number): CFrame
	return self.Frame * CFrame.new(x, y, -s)
end

-- Turns the layout (plain numbers from IceDashSim) into parts.
function IceDash:_buildTrack(layout)
	local width = Sim.TRACK_WIDTH
	local total = TRACK_LENGTH + 60
	self:_part({
		Name = "Ice",
		Size = Vector3.new(width, 1, total),
		CFrame = self:_at(0, 0, total / 2 - 10),
		Material = Enum.Material.Ice,
		Color = Color3.fromRGB(190, 235, 255),
		CanCollide = true,
	})

	for _, snow in layout.Snow do
		self:_part({
			Name = "SnowDrift",
			Size = Vector3.new(Sim.SNOW_SIZE.X, 0.8, Sim.SNOW_SIZE.Y),
			CFrame = self:_at(snow.X, 0.7, snow.S),
			Color = Color3.fromRGB(255, 255, 255),
		})
	end
	for _, puddle in layout.Puddles do
		self:_part({
			Name = "Puddle",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.2, Sim.PUDDLE_RADIUS * 2, Sim.PUDDLE_RADIUS * 2),
			CFrame = self:_at(puddle.X, 0.56, puddle.S) * CFrame.Angles(0, 0, math.rad(90)),
			Material = Enum.Material.Glass,
			Color = Color3.fromRGB(40, 110, 220),
			Transparency = 0.25,
		})
	end
	for _, bumper in layout.Bumpers do
		self:_part({
			Name = "Bumper",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(3, Sim.BUMPER_RADIUS * 2, Sim.BUMPER_RADIUS * 2),
			CFrame = self:_at(bumper.X, 2, bumper.S) * CFrame.Angles(0, 0, math.rad(90)),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(255, 80, 140),
		})
	end
	for _, barrier in layout.Barriers do
		self:_part({
			Name = "Barrier",
			Size = Vector3.new(barrier.X1 - barrier.X0, 4, barrier.S1 - barrier.S0),
			CFrame = self:_at((barrier.X0 + barrier.X1) / 2, 2.5, (barrier.S0 + barrier.S1) / 2),
			Material = Enum.Material.Brick,
			Color = Color3.fromRGB(255, 170, 60),
		})
	end

	-- Side walls everywhere except the open stretches, which get a red warning stripe.
	local function wall(s0: number, s1: number)
		if s1 - s0 < 1 then
			return
		end
		for _, side in { -1, 1 } do
			self:_part({
				Name = "SideWall",
				Size = Vector3.new(1.5, 4, s1 - s0),
				CFrame = self:_at(side * (HALF_WIDTH + 0.75), 2.5, (s0 + s1) / 2),
				Material = Enum.Material.Glass,
				Color = Color3.fromRGB(120, 200, 255),
				Transparency = 0.45,
			})
		end
	end
	local wallStart = -10
	for _, open in layout.Open do
		wall(wallStart, open.S0)
		wallStart = open.S1
		for _, side in { -1, 1 } do
			self:_part({
				Name = "EdgeWarning",
				Size = Vector3.new(2, 0.2, open.S1 - open.S0),
				CFrame = self:_at(side * (HALF_WIDTH - 1), 0.56, (open.S0 + open.S1) / 2),
				Material = Enum.Material.Neon,
				Color = Color3.fromRGB(255, 60, 60),
			})
		end
	end
	wall(wallStart, TRACK_LENGTH + 50)

	-- Start line, checkpoints and the finish arch.
	local function gate(at: number, color: Color3, name: string)
		self:_part({
			Name = name,
			Size = Vector3.new(width, 0.2, 2),
			CFrame = self:_at(0, 0.58, at),
			Material = Enum.Material.Neon,
			Color = color,
		})
		for _, side in { -1, 1 } do
			self:_part({
				Name = name .. "Post",
				Size = Vector3.new(1.5, GATE_HEIGHT, 1.5),
				CFrame = self:_at(side * (HALF_WIDTH + 0.75), GATE_HEIGHT / 2 + 0.5, at),
				Material = Enum.Material.Neon,
				Color = color,
			})
		end
		self:_part({
			Name = name .. "Beam",
			Size = Vector3.new(width + 3, 1.5, 1.5),
			CFrame = self:_at(0, GATE_HEIGHT + 0.5, at),
			Material = Enum.Material.Neon,
			Color = color,
		})
	end
	gate(0, Color3.fromRGB(255, 255, 255), "StartLine")
	for _, checkpoint in layout.Checkpoints do
		gate(checkpoint, Color3.fromRGB(90, 255, 140), "Checkpoint")
	end
	gate(TRACK_LENGTH, Color3.fromRGB(255, 220, 60), "FinishLine")
end

function IceDash:Setup(arena, participants, round)
	-- The track runs along the arena's +Z (away from the lobby); racers face down it.
	self.Frame = arena.Origin * CFrame.Angles(0, math.pi, 0)
	self.Connections = {}
	self.Racers = {}
	self.Anchored = {}
	self.FinishCount = 0
	self.Layout = Sim.generateLayout(round.Rng)
	self:_buildTrack(self.Layout)

	local spawns = {}
	for index, participant in participants do
		local lane = Sim.START_LANES[(index - 1) % #Sim.START_LANES + 1]
		local racer = Sim.newRacer(lane)
		racer.IsBot = participant.IsBot
		racer.Left = false -- bots only: held steer buttons
		racer.Right = false
		racer.RideHeight = 3.5
		racer.FinishTime = nil
		-- Players only: bookkeeping for checking their reports.
		racer.ClientTime = 0
		racer.Budget = SPEED_BURST
		racer.FellAt = 0
		racer.Violations = 0
		self.Racers[participant] = racer
		spawns[index] = self:_at(lane, 4, Sim.START_S)
	end
	return spawns
end

-- Racing --------------------------------------------------------------------------------------

function IceDash:_progressText(racer): string
	if racer.FinishTime then
		return ("🏁 %.1fs"):format(racer.FinishTime)
	end
	return ("%d%%"):format(math.clamp(racer.S / TRACK_LENGTH, 0, 0.99) * 100)
end

function IceDash:_finish(participant, racer)
	racer.State = "Finished"
	racer.FinishTime = os.clock() - self.StartedAt
	self.FinishCount += 1
	self.Round:Toast(("🏁 %s finished in %.1fs"):format(participant.Name, racer.FinishTime))
	self.Round:ReportProgress(participant, self:_progressText(racer))
end

-- Puts the body where the server believes the racer is.
function IceDash:_place(participant, racer)
	local character = participant:GetCharacter()
	if character then
		local lean = math.clamp(racer.VX / Sim.MAX_SIDE_SPEED, -1, 1) * 0.3
		character:PivotTo(
			self:_at(racer.X, racer.RideHeight - Sim.fallDrop(racer), racer.S) * CFrame.Angles(0, 0, -lean)
		)
	end
end

-- Tells one client to drop its own idea of where it is and use the server's.
function IceDash:_correct(participant, racer)
	Net.minigameRemote():FireClient(participant.Player, {
		Type = "Correct",
		X = racer.X,
		S = racer.S,
		VX = racer.VX,
		VS = racer.VS,
		State = racer.State,
		Checkpoint = racer.Checkpoint,
	})
end

--[[
	A player's client says "I am here, moving like this". Decide whether the rules allow that
	given the last accepted state. Returns nil if fine, or a short reason if not.
]]
function IceDash:_checkReport(racer, x: number, s: number, vx: number, vs: number, dt: number): string?
	local layout = self.Layout
	-- One report can't move further than top speed (plus a bounce) allows.
	if math.abs(s - racer.S) > (Sim.MAX_SPEED + Sim.BUMPER_KICK) * dt + STEP_SLACK then
		return "jump"
	end
	if math.abs(x - racer.X) > (Sim.MAX_SIDE_SPEED + Sim.BUMPER_KICK) * dt + STEP_SLACK then
		return "sidejump"
	end
	if math.abs(vx) > Sim.MAX_SIDE_SPEED + Sim.BUMPER_KICK + 1 or vs > Sim.MAX_SPEED + Sim.BUMPER_KICK + 1 then
		return "velocity"
	end
	-- Sustained speed: forward travel is paid for out of a budget that refills at top speed.
	local budget = math.min(SPEED_BURST, racer.Budget + Sim.MAX_SPEED * SPEED_TOLERANCE * dt)
	if s > racer.S then
		budget -= s - racer.S
	end
	if budget < 0 then
		return "speed"
	end
	-- Solid things stay solid.
	if Sim.hasWall(layout, s) and math.abs(x) > HALF_WIDTH - Sim.RACER_RADIUS + WALL_SLACK then
		return "wall"
	end
	for _, barrier in layout.Barriers do
		if
			x > barrier.X0 + WALL_SLACK
			and x < barrier.X1 - WALL_SLACK
			and s > barrier.S0 + WALL_SLACK * 0.5
			and s < barrier.S1 - WALL_SLACK * 0.5
		then
			return "barrier"
		end
	end
	for _, bumper in layout.Bumpers do
		local dx, ds = x - bumper.X, s - bumper.S
		if dx * dx + ds * ds < (Sim.BUMPER_RADIUS * 0.5) ^ 2 then
			return "bumper"
		end
	end
	racer.Budget = budget
	return nil
end

function IceDash:_validateReport(participant, racer, message)
	local t, x, s, vx, vs = message.T, message.X, message.S, message.VX, message.VS
	for _, value in { t, x, s, vx, vs } do
		if type(value) ~= "number" or value ~= value or math.abs(value) > 1e5 then
			return
		end
	end
	if racer.State == "Finished" or self.Round.Ended or not self.StartedAt then
		return
	end
	local elapsed = os.clock() - self.StartedAt
	-- The client's race clock can't run ahead of real time (that would be a speed hack), and
	-- reports can arrive out of order on the unreliable channel: drop stale ones.
	if t <= racer.ClientTime then
		return
	end
	if t > elapsed + CLOCK_SLACK then
		racer.Violations += 1
		racer.LastProblem = "clock"
		self:_correct(participant, racer)
		return
	end
	local dt = math.min(t - racer.ClientTime, 0.5)
	racer.ClientTime = t

	if racer.State == "Falling" then
		-- The only way back is the checkpoint the server has on record.
		if math.abs(s - racer.Checkpoint) < 3 and math.abs(x - racer.Lane) < 3 then
			Sim.respawn(racer)
			racer.Budget = SPEED_BURST
		elseif os.clock() - racer.FellAt > Sim.RESPAWN_DELAY + RESPAWN_GRACE then
			Sim.respawn(racer)
			racer.Budget = SPEED_BURST
			self:_correct(participant, racer)
		else
			racer.FallTime = os.clock() - racer.FellAt
			racer.X = math.clamp(x, -HALF_WIDTH - 20, HALF_WIDTH + 20)
		end
		return
	end

	local problem = self:_checkReport(racer, x, s, vx, vs, dt)
	if problem then
		racer.Violations += 1
		racer.LastProblem = problem
		self:_correct(participant, racer)
		return
	end
	racer.X, racer.S, racer.VX, racer.VS = x, s, vx, vs
	racer.AcceptedAt = os.clock()

	-- Checkpoints, falls and the finish are decided here, from accepted positions only.
	racer.Checkpoint = math.max(racer.Checkpoint, Sim.checkpointFor(self.Layout, s))
	if not Sim.hasWall(self.Layout, s) and math.abs(x) > HALF_WIDTH + 0.5 then
		racer.State = "Falling"
		racer.FallTime = 0
		racer.FellAt = os.clock()
		self.Round:Toast(("❄ %s slid off the edge"):format(participant.Name))
	elseif s >= TRACK_LENGTH then
		self:_finish(participant, racer)
	end
end

-- Interface -----------------------------------------------------------------------------

function IceDash:Start()
	local round = self.Round
	self.StartedAt = os.clock()
	local nextReport, nextSnapshot, nextPlace = 0, 0, 0

	-- Take over the bodies: anchored for the whole race. Clients position them every frame
	-- (their own racer from local simulation, everyone else from snapshots).
	local describe = {}
	for _, participant in self.Participants do
		local racer = self.Racers[participant]
		local character = participant:GetCharacter()
		local root = participant:GetRoot()
		if character and root then
			racer.RideHeight = self.Frame:PointToObjectSpace(character:GetPivot().Position).Y
			root.AssemblyLinearVelocity = Vector3.zero
			root.Anchored = true
			table.insert(self.Anchored, root)
		end
		table.insert(describe, {
			Id = participant.Id,
			Character = character,
			Lane = racer.Lane,
			RideHeight = racer.RideHeight,
		})
	end
	Net.minigameRemote():FireAllClients({
		Type = "Setup",
		Layout = self.Layout,
		Frame = self.Frame,
		Racers = describe,
	})
	round:SetStatus("Steer! ◀ ▶")

	table.insert(
		self.Connections,
		RunService.Heartbeat:Connect(function(dt)
			if round.Ended then
				return
			end
			dt = math.min(dt, 0.05)
			local clock = os.clock()
			local alive = round:GetAlive()

			-- Bots run the shared rules here. Players are driven by their own reports.
			for _, participant in alive do
				local racer = self.Racers[participant]
				if racer.IsBot then
					local steer = (if racer.Right then 1 else 0) - (if racer.Left then 1 else 0)
					local event = Sim.step(self.Layout, racer, steer, dt)
					if event == "fell" then
						round:Toast(("❄ %s slid off the edge"):format(participant.Name))
					elseif event == "finished" then
						self:_finish(participant, racer)
					end
				elseif racer.State == "Falling" then
					racer.FallTime = clock - racer.FellAt
				end
			end
			-- Bots bump into everyone; a player's own client handles the player's half.
			for i = 1, #alive do
				local a = self.Racers[alive[i]]
				for j = i + 1, #alive do
					local b = self.Racers[alive[j]]
					if a.IsBot or b.IsBot then
						Sim.collide(a, b, a.IsBot, b.IsBot)
					end
				end
			end

			if clock >= nextSnapshot then
				nextSnapshot = clock + 1 / SNAPSHOT_RATE
				local racers = {}
				for _, participant in self.Participants do
					local racer = self.Racers[participant]
					local x, s = racer.X, racer.S
					if not racer.IsBot and racer.State == "Racing" and racer.AcceptedAt then
						-- A player's report is a little old by now: project it to this instant,
						-- so everyone else sees steady motion instead of stair-steps.
						local age = math.min(clock - racer.AcceptedAt, MAX_REPORT_AGE)
						x += racer.VX * age
						s += racer.VS * age
					end
					table.insert(racers, {
						participant.Id,
						x,
						s,
						racer.VX,
						racer.VS,
						if racer.State == "Falling" then racer.FallTime else -1,
					})
				end
				Net.minigameFastRemote():FireAllClients({ T = clock, R = racers })
			end

			if clock >= nextPlace then
				nextPlace = clock + 1 / FALLBACK_PLACE_RATE
				for _, participant in alive do
					self:_place(participant, self.Racers[participant])
				end
			end

			if clock >= nextReport then
				nextReport = clock + 0.1
				for _, participant in self.Participants do
					round:ReportProgress(participant, self:_progressText(self.Racers[participant]))
				end
			end

			if self.FinishCount >= #alive then
				round:End("Finish")
			end
		end)
	)
end

-- Bots steer through the normal input path. Players steer on their own client.
function IceDash:OnInput(participant, action)
	local racer = self.Racers[participant]
	if not racer or not racer.IsBot then
		return
	end
	if action == "Left" then
		racer.Left = true
	elseif action == "LeftStop" then
		racer.Left = false
	elseif action == "Right" then
		racer.Right = true
	elseif action == "RightStop" then
		racer.Right = false
	end
end

-- A state report from a player's client (see client/Minigames/IceDash).
function IceDash:OnClientMessage(participant, message)
	local racer = self.Racers[participant]
	if racer and not racer.IsBot and type(message) == "table" then
		self:_validateReport(participant, racer, message)
	end
end

-- The round is over: put every body where the server has it, for everyone.
function IceDash:OnRoundEnding(_reason)
	for _, participant in self.Participants do
		local racer = self.Racers[participant]
		self:_place(participant, racer)
		if racer.Violations > 0 then
			print(
				("[IceDash] %s: %d report(s) rejected (last: %s)"):format(
					participant.Name,
					racer.Violations,
					tostring(racer.LastProblem)
				)
			)
		end
	end
end

--[[
	Bot behaviour: look a little way down the track, score a handful of lines across it
	(bumpers and walls are terrible, snow and puddles are bad, the edge of an open stretch is
	scary), pick the cheapest and steer for it, allowing for drift. Sloppier bots look less
	far ahead, misjudge their drift, re-plan less often and sometimes just pick a bad line.
]]
function IceDash:_lineCost(me, x: number, fromS: number, toS: number): number
	local layout = self.Layout
	local cost = 0
	local margin = Sim.RACER_RADIUS + 1.2
	-- Don't tuck in right behind (or drive into) another racer.
	for _, other in self.Racers do
		if other ~= me and other.State == "Racing" and other.S > fromS - 3 and other.S < fromS + 14 then
			if math.abs(x - other.X) < Sim.RACER_RADIUS * 2 + 0.5 then
				cost += 45
			end
		end
	end
	for _, bumper in layout.Bumpers do
		if bumper.S > fromS and bumper.S < toS and math.abs(x - bumper.X) < Sim.BUMPER_RADIUS + margin then
			cost += 120
		end
	end
	for _, barrier in layout.Barriers do
		if barrier.S1 > fromS and barrier.S0 < toS and x > barrier.X0 - margin and x < barrier.X1 + margin then
			cost += 150
		end
	end
	for _, snow in layout.Snow do
		if snow.S > fromS - 4 and snow.S < toS and math.abs(x - snow.X) < Sim.SNOW_SIZE.X / 2 + 1 then
			cost += 35
		end
	end
	for _, puddle in layout.Puddles do
		if puddle.S > fromS - 4 and puddle.S < toS and math.abs(x - puddle.X) < Sim.PUDDLE_RADIUS + 1 then
			cost += 28
		end
	end
	for _, open in layout.Open do
		if open.S1 > fromS and open.S0 < toS and math.abs(x) > HALF_WIDTH - 6 then
			cost += 70
		end
	end
	return cost
end

function IceDash:UpdateBot(bot, _dt)
	local racer = self.Racers[bot.Participant]
	if not racer or racer.State ~= "Racing" then
		return
	end
	local memory = bot.Memory
	local clock = os.clock()

	if clock >= (memory.PlanAt or 0) then
		memory.PlanAt = clock + 0.2 + (1 - bot.Skill) * 0.45
		local lookAhead = 24 + bot.Skill * 30
		if math.random() < (1 - bot.Skill) * 0.07 then
			-- Brain fart: commit to a random line for a moment.
			memory.TargetX = (math.random() - 0.5) * (Sim.TRACK_WIDTH - 6)
			memory.PlanAt = clock + 0.7
		else
			local best, bestCost = racer.X, math.huge
			for x = -HALF_WIDTH + 3, HALF_WIDTH - 3, 3 do
				local cost = self:_lineCost(racer, x, racer.S + 1, racer.S + lookAhead)
					+ math.abs(x - racer.X) * 0.7 -- don't cross the whole track for nothing
					+ math.abs(x) * 0.2 -- the middle leaves the most options
					+ math.random() * (1 - bot.Skill) * 25 -- sloppy judgement
				if cost < bestCost then
					best, bestCost = x, cost
				end
			end
			memory.TargetX = best
		end
	end

	-- Steer for the line, allowing for how far the current drift will carry me.
	local anticipation = 0.15 + bot.Skill * 0.45
	local miss = (memory.TargetX or racer.X) - (racer.X + racer.VX * anticipation)
	local wantLeft, wantRight = miss < -1.3, miss > 1.3
	if wantLeft ~= memory.Left then
		memory.Left = wantLeft
		bot:Input(if wantLeft then "Left" else "LeftStop")
	end
	if wantRight ~= memory.Right then
		memory.Right = wantRight
		bot:Input(if wantRight then "Right" else "RightStop")
	end
end

function IceDash:GetResults()
	return ResultsUtil.fromScores(self.Participants, function(participant)
		local racer = self.Racers[participant]
		-- Finishers beat everyone still on the track; earlier finish = better.
		return if racer.FinishTime then 1e6 - racer.FinishTime else racer.S
	end)
end

function IceDash:Cleanup()
	for _, connection in self.Connections do
		connection:Disconnect()
	end
	for _, root in self.Anchored do
		if root.Parent then
			root.Anchored = false
		end
	end
	-- The track lives in arena.Folder, which the framework destroys.
end

return IceDash
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">KernelCatch</string>
            <string name="Source"><![CDATA[--[[
	Kernel Catch (FFA, score)
	Popcorn and rocks rain from the sky. Every drop shows a shadow on the floor about a
	second before it lands. Stand under popcorn to catch it in your head bucket (+1);
	a rock knocks kernels out of the bucket and stuns you for a moment.
	Most popcorn when the timer runs out wins.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.PartyShared.Config)
local ResultsUtil = require(script.Parent.Parent.ResultsUtil)

local KernelCatch = {}

-- Tuning ----------------------------------------------------------------------------------

local ROUND_DURATION = 30
-- Seconds between drops: { at GO, at the buzzer }. Smaller = more stuff falling.
local DROP_INTERVAL = { 0.45, 0.15 }
-- Chance that a drop is a rock instead of popcorn: { at GO, at the buzzer }.
local ROCK_RATIO = { 0.22, 0.38 }
local WARNING_TIME = 1.0 -- the shadow shows up this long before impact
local AIMED_POPCORN_CHANCE = 0.3 -- share of kernels aimed near a random player instead of anywhere
local AIMED_ROCK_CHANCE = 0.7 -- share of rocks aimed near a random player
local AIM_SPREAD = 6 -- studs of scatter around the player an aimed drop targets

local POPCORN_POINTS = 1
local ROCK_PENALTY = 4 -- kernels lost per rock hit (score never goes below 0)
local STUN_TIME = 1.2 -- seconds a rock hit roots you (you can't catch while stunned)
local STUN_IMMUNITY = 0.6 -- extra seconds after a stun before another rock can hit you

local CATCH_RADIUS = 3.2 -- how close (flat distance) your bucket must be to a landing kernel
local ROCK_RADIUS = 3.6 -- how close a landing rock must be to hit you
local ARENA_RADIUS = 26
-- Nothing lands in this strip along the edge nearest the camera, where a falling drop would
-- fill the screen and cross the HUD.
local NEAR_EDGE_MARGIN = 9
local DROP_HEIGHT = 30
local WALK_SPEED = 18

KernelCatch.Info = {
	Name = "Kernel Catch",
	Description = "It's raining popcorn 🍿! Stand on the shadows to catch kernels in your head bucket. Dodge the rocks or lose your snacks!",
	Duration = ROUND_DURATION,
	Layout = Config.Layouts.FFA,
	Camera = { Mode = "AngledOverhead", Height = 42, Distance = 32 },
	Controls = { Move = true, Jump = true, WalkSpeed = WALK_SPEED },
	ProgressLabel = "Popcorn",
}

local POPCORN_COLOR = Color3.fromRGB(255, 244, 190)
local ROCK_COLOR = Color3.fromRGB(110, 110, 120)

local function now()
	return Workspace:GetServerTimeNow()
end

local function lerp(range, alpha: number): number
	return range[1] + (range[2] - range[1]) * alpha
end

local function flat(vector: Vector3): Vector3
	return Vector3.new(vector.X, 0, vector.Z)
end

-- Setup ---------------------------------------------------------------------------------

-- A striped popcorn bucket welded on top of the head. It lives in `parent` (the arena folder),
-- not in the character, so Highlights on the character (the stun flash) don't tint it.
local function makeBucket(character: Model, parent: Instance): Model?
	local head = character:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return nil
	end
	local bucket = Instance.new("Model")
	bucket.Name = "KernelBucket"

	local function piece(name: string, size: Vector3, offset: CFrame, color: Color3, shape)
		local part = Instance.new("Part")
		part.Name = name
		part.Shape = shape
		part.Size = size
		part.Color = color
		part.Material = Enum.Material.SmoothPlastic
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Massless = true
		part.CFrame = head.CFrame * CFrame.new(0, head.Size.Y / 2, 0) * offset
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = head
		weld.Part1 = part
		weld.Parent = part
		part.Parent = bucket
		return part
	end

	-- Cylinders lie along X, so stand them upright.
	local upright = CFrame.Angles(0, 0, math.rad(90))
	piece("Tub", Vector3.new(1.6, 2.4, 2.4), CFrame.new(0, 0.8, 0) * upright, Color3.fromRGB(230, 60, 60), Enum.PartType.Cylinder)
	piece("Stripe", Vector3.new(0.5, 2.5, 2.5), CFrame.new(0, 0.8, 0) * upright, Color3.fromRGB(255, 255, 255), Enum.PartType.Cylinder)
	piece("Rim", Vector3.new(0.25, 2.8, 2.8), CFrame.new(0, 1.6, 0) * upright, Color3.fromRGB(255, 255, 255), Enum.PartType.Cylinder)
	local kernels = piece("Kernels", Vector3.new(2.2, 2.2, 2.2), CFrame.new(0, 1.5, 0), POPCORN_COLOR, Enum.PartType.Ball)
	kernels.Transparency = 1 -- shown once there is popcorn in the bucket

	bucket.Parent = parent
	return bucket
end

function KernelCatch:Setup(arena, participants, _round)
	local origin = arena.Origin
	self.Connections = {}
	self.Score = {}
	self.StunnedUntil = {}
	self.Buckets = {}
	self.Highlights = {}
	self.Drops = {}

	-- Round floor (cylinder parts lie along X, so rotate it flat).
	local floor = Instance.new("Part")
	floor.Name = "Floor"
	floor.Shape = Enum.PartType.Cylinder
	floor.Size = Vector3.new(2, ARENA_RADIUS * 2, ARENA_RADIUS * 2)
	floor.CFrame = origin * CFrame.Angles(0, 0, math.rad(90))
	floor.Anchored = true
	floor.Material = Enum.Material.SmoothPlastic
	floor.Color = Color3.fromRGB(120, 60, 160)
	floor.Parent = arena.Folder

	-- Ring of see-through walls so nobody runs off the edge.
	local segments = 24
	for i = 1, segments do
		local angle = (i / segments) * math.pi * 2
		local wall = Instance.new("Part")
		wall.Name = "Wall"
		wall.Anchored = true
		wall.Size = Vector3.new(2, 8, ARENA_RADIUS * 2 * math.pi / segments + 1)
		wall.CFrame = origin * CFrame.Angles(0, -angle, 0) * CFrame.new(ARENA_RADIUS, 5, 0)
		wall.Transparency = 0.6
		wall.Color = Color3.fromRGB(255, 220, 90)
		wall.Material = Enum.Material.ForceField
		wall.Parent = arena.Folder
	end

	local spawns = {}
	for index, participant in participants do
		self.Score[participant] = 0
		self.StunnedUntil[participant] = 0
		local angle = (index / #participants) * math.pi * 2
		local position = (origin * CFrame.new(math.cos(angle) * 12, 4, math.sin(angle) * 12)).Position
		spawns[index] = CFrame.lookAt(position, Vector3.new(origin.X, position.Y, origin.Z))

		local character = participant:GetCharacter()
		if character then
			self.Buckets[participant] = makeBucket(character, arena.Folder)
		end
	end
	return spawns
end

-- Scoring -------------------------------------------------------------------------------

function KernelCatch:_setScore(participant, score: number)
	self.Score[participant] = score
	self.Round:ReportProgress(participant, ("🍿 %d"):format(score))
	local bucket = self.Buckets[participant]
	local kernels = bucket and bucket:FindFirstChild("Kernels")
	if kernels then
		kernels.Transparency = if score > 0 then 0 else 1
	end
end

function KernelCatch:_isStunned(participant): boolean
	return now() < self.StunnedUntil[participant]
end

function KernelCatch:_hitByRock(participant, position: Vector3)
	local stunEnds = now() + STUN_TIME
	self.StunnedUntil[participant] = stunEnds + STUN_IMMUNITY
	self:_setScore(participant, math.max(0, self.Score[participant] - ROCK_PENALTY))
	participant:SetMovement(0, false)
	self.Round:Toast(("💥 %s got hit by a rock!"):format(participant.Name))

	-- Hit effect: a puff at the impact point and a red flash on the victim while stunned.
	local burst = Instance.new("Explosion")
	burst.Position = position
	burst.BlastPressure = 0
	burst.DestroyJointRadiusPercent = 0
	burst.Parent = self.Arena.Folder

	local character = participant:GetCharacter()
	local highlight
	if character then
		highlight = Instance.new("Highlight")
		highlight.FillColor = Color3.fromRGB(255, 40, 40)
		highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		highlight.FillTransparency = 0.35
		highlight.Parent = character
		self.Highlights[highlight] = true
	end

	task.delay(STUN_TIME, function()
		if highlight then
			self.Highlights[highlight] = nil
			highlight:Destroy()
		end
		if not self.Cleaned and not self.Round.Ended then
			participant:SetMovement(WALK_SPEED, true)
		end
	end)
end

-- Drops ---------------------------------------------------------------------------------

function KernelCatch:_spawnDrop(progress: number)
	local round = self.Round
	local origin = self.Arena.Origin

	local isRock = round.Rng:NextNumber() < lerp(ROCK_RATIO, progress)

	-- Where it lands (arena-local X/Z): near a random player, or anywhere on the floor.
	local offset
	local alive = round:GetAlive()
	local aimedChance = if isRock then AIMED_ROCK_CHANCE else AIMED_POPCORN_CHANCE
	if #alive > 0 and round.Rng:NextNumber() < aimedChance then
		local target = alive[round.Rng:NextInteger(1, #alive)]
		local position = target:GetPosition()
		if position then
			local angle = round.Rng:NextNumber() * math.pi * 2
			offset = flat(origin:PointToObjectSpace(position))
				+ Vector3.new(math.cos(angle), 0, math.sin(angle)) * round.Rng:NextNumber() * AIM_SPREAD
		end
	end
	if not offset then
		local angle = round.Rng:NextNumber() * math.pi * 2
		local radius = math.sqrt(round.Rng:NextNumber()) * (ARENA_RADIUS - 3)
		offset = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
	end
	if offset.Magnitude > ARENA_RADIUS - 3 then
		offset = offset.Unit * (ARENA_RADIUS - 3)
	end
	-- The overhead camera sits on the arena's +Z side: keep drops out of the strip closest to it.
	local nearLimit = ARENA_RADIUS - 3 - NEAR_EDGE_MARGIN
	if offset.Z > nearLimit then
		offset = Vector3.new(offset.X, 0, nearLimit)
	end
	local landing = origin:PointToWorldSpace(Vector3.new(offset.X, 1, offset.Z))

	local size = if isRock then 3.4 else 1.8

	local object = Instance.new("Part")
	object.Name = if isRock then "Rock" else "Popcorn"
	object.Shape = Enum.PartType.Ball
	object.Size = Vector3.new(size, size, size)
	object.Color = if isRock then ROCK_COLOR else POPCORN_COLOR
	object.Material = if isRock then Enum.Material.Slate else Enum.Material.SmoothPlastic
	object.Anchored = true
	object.CanCollide = false
	object.CanQuery = false
	object.CanTouch = false
	object.Position = landing + Vector3.new(0, DROP_HEIGHT, 0)
	object.Parent = self.Arena.Folder

	-- Shadow: a flat disc that grows as the drop gets closer. Rocks cast a darker, redder one.
	local shadow = Instance.new("Part")
	shadow.Name = "Shadow"
	shadow.Shape = Enum.PartType.Cylinder
	shadow.Anchored = true
	shadow.CanCollide = false
	shadow.CanQuery = false
	shadow.CanTouch = false
	shadow.Material = Enum.Material.Neon
	shadow.Color = if isRock then Color3.fromRGB(60, 0, 10) else Color3.fromRGB(255, 225, 90)
	shadow.Transparency = 0.6
	shadow.Size = Vector3.new(0.1, 1, 1)
	shadow.CFrame = CFrame.new(landing + Vector3.new(0, 0.06, 0)) * CFrame.Angles(0, 0, math.rad(90))
	shadow.Parent = self.Arena.Folder

	table.insert(self.Drops, {
		IsRock = isRock,
		Position = landing,
		LandsAt = now() + WARNING_TIME,
		Object = object,
		Shadow = shadow,
		ShadowSize = if isRock then ROCK_RADIUS * 2 else CATCH_RADIUS * 2,
	})
end

function KernelCatch:_land(drop)
	drop.Shadow:Destroy()
	local caught = false

	if drop.IsRock then
		for _, participant in self.Round:GetAlive() do
			local position = participant:GetPosition()
			if
				position
				and now() >= self.StunnedUntil[participant]
				and flat(position - drop.Position).Magnitude <= ROCK_RADIUS
			then
				self:_hitByRock(participant, drop.Position)
			end
		end
	else
		-- The closest bucket in reach gets the kernel.
		local best, bestDistance = nil, CATCH_RADIUS
		for _, participant in self.Round:GetAlive() do
			local position = participant:GetPosition()
			if position and not self:_isStunned(participant) then
				local distance = flat(position - drop.Position).Magnitude
				if distance <= bestDistance then
					best, bestDistance = participant, distance
				end
			end
		end
		if best then
			caught = true
			self:_setScore(best, self.Score[best] + POPCORN_POINTS)
		end
	end

	if caught then
		drop.Object:Destroy()
	else
		-- Missed kernels and rocks sit on the floor for a moment, then vanish.
		local object = drop.Object
		object.Position = drop.Position + Vector3.new(0, object.Size.Y / 2, 0)
		object.Transparency = 0.4
		task.delay(0.5, function()
			object:Destroy()
		end)
	end
end

-- Interface -----------------------------------------------------------------------------

function KernelCatch:Start()
	local round = self.Round
	local startedAt = now()
	local nextDropAt = startedAt + 0.5
	for _, participant in self.Participants do
		self:_setScore(participant, 0)
	end
	round:SetStatus("Catch the popcorn! 🍿")

	table.insert(
		self.Connections,
		RunService.Heartbeat:Connect(function()
			if round.Ended then
				return
			end
			local clock = now()
			local progress = math.clamp((clock - startedAt) / ROUND_DURATION, 0, 1)

			while clock >= nextDropAt do
				nextDropAt += lerp(DROP_INTERVAL, progress)
				self:_spawnDrop(progress)
			end

			for index = #self.Drops, 1, -1 do
				local drop = self.Drops[index]
				local remaining = drop.LandsAt - clock
				if remaining <= 0 then
					table.remove(self.Drops, index)
					self:_land(drop)
				else
					local alpha = 1 - remaining / WARNING_TIME -- 0 = just spawned, 1 = impact
					local height = DROP_HEIGHT * (1 - alpha * alpha) -- speeds up as it falls
					drop.Object.Position = drop.Position + Vector3.new(0, height + drop.Object.Size.Y / 2, 0)
					local diameter = drop.ShadowSize * (0.35 + 0.65 * alpha)
					drop.Shadow.Size = Vector3.new(0.1, diameter, diameter)
					drop.Shadow.Transparency = 0.6 - 0.35 * alpha
				end
			end
		end)
	)
end

--[[
	Bot behaviour: step out from under any rock that is about to land, otherwise run to the
	best popcorn shadow it can still reach. Sloppier bots notice rocks later, re-think less
	often and sometimes run for kernels that have a rock coming down beside them.
]]
function KernelCatch:UpdateBot(bot, _dt)
	local me = bot.Participant
	local myPosition = bot:GetPosition()
	if not myPosition or self:_isStunned(me) then
		return
	end
	local memory = bot.Memory
	local clock = now()
	local center = self.Arena.Origin.Position

	local function inside(goal: Vector3): Vector3
		local fromCenter = flat(goal - center)
		if fromCenter.Magnitude > ARENA_RADIUS - 4 then
			fromCenter = fromCenter.Unit * (ARENA_RADIUS - 4)
		end
		return Vector3.new(center.X + fromCenter.X, myPosition.Y, center.Z + fromCenter.Z)
	end

	-- Dodge: a rock landing on top of me soon wins over everything else.
	local noticeTime = 0.2 + bot.Skill * 0.5
	local dodge = Vector3.zero
	for _, drop in self.Drops do
		if drop.IsRock and drop.LandsAt - clock < noticeTime then
			local away = flat(myPosition - drop.Position)
			if away.Magnitude < ROCK_RADIUS + 1.5 then
				if away.Magnitude < 0.1 then
					away = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5)
				end
				dodge += away.Unit
			end
		end
	end
	if dodge.Magnitude > 0.05 then
		memory.Goal = nil
		bot:MoveTo(inside(myPosition + dodge.Unit * 8))
		return
	end

	-- Keep the current plan for a beat instead of re-deciding every tick.
	if memory.Goal and clock < (memory.DecideAt or 0) and memory.Goal.LandsAt > clock then
		bot:MoveTo(inside(memory.Goal.Position))
		return
	end
	memory.DecideAt = clock + 0.15 + (1 - bot.Skill) * 0.35 + math.random() * 0.15

	local carefulness = 0.35 + bot.Skill * 0.65
	local best, bestCost = nil, math.huge
	for _, drop in self.Drops do
		if not drop.IsRock then
			local distance = flat(drop.Position - myPosition).Magnitude
			local timeLeft = drop.LandsAt - clock
			local reachable = distance - CATCH_RADIUS * 0.6 <= WALK_SPEED * timeLeft
			-- Skip kernels with a rock coming down right beside them (if this bot is paying attention).
			local risky = false
			for _, other in self.Drops do
				if
					other.IsRock
					and math.abs(other.LandsAt - drop.LandsAt) < 0.7
					and flat(other.Position - drop.Position).Magnitude < ROCK_RADIUS + 1
				then
					risky = true
					break
				end
			end
			-- Leave kernels that someone else is clearly going to reach first, so the pack spreads out.
			local cost = distance
			for _, other in self.Round:GetAlive() do
				local position = other ~= me and other:GetPosition()
				local claimed = other.IsBot and other.Bot.Memory.Goal == drop
				if position and (claimed or flat(drop.Position - position).Magnitude < distance - 1) then
					cost += 25
				end
			end
			if reachable and not (risky and math.random() < carefulness) and cost < bestCost then
				best, bestCost = drop, cost
			end
		end
	end

	-- Only fight over a contested kernel when it is right next to me.
	if best and bestCost >= 25 and bestCost - 25 > CATCH_RADIUS * 2 then
		best = nil
	end
	memory.Goal = best
	if best then
		bot:MoveTo(inside(best.Position))
	elseif not memory.Wander or clock >= (memory.WanderUntil or 0) then
		-- Nothing worth chasing: patrol my own side of the ring so the bots cover the floor.
		memory.HomeAngle = memory.HomeAngle or math.random() * math.pi * 2
		local angle = memory.HomeAngle + (math.random() - 0.5) * 1.6
		local radius = ARENA_RADIUS * (0.25 + math.random() * 0.4)
		memory.Wander = center + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
		memory.WanderUntil = clock + 1 + math.random()
		bot:MoveTo(inside(memory.Wander))
	end
end

function KernelCatch:GetResults()
	return ResultsUtil.fromScores(self.Participants, function(participant)
		return self.Score[participant]
	end)
end

function KernelCatch:Cleanup()
	self.Cleaned = true
	for _, connection in self.Connections do
		connection:Disconnect()
	end
	for _, bucket in self.Buckets do
		bucket:Destroy()
	end
	for highlight in self.Highlights do
		highlight:Destroy()
	end
	-- Drops, shadows and the map live in arena.Folder, which the framework destroys.
end

return KernelCatch
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">MashDash</string>
            <string name="Source"><![CDATA[--[[
	Mash Dash (2v2, side view)
	Everyone is locked in their lane (no walking, no jumping). Every Mash press scoots you
	forward. First runner across the line wins it for their team; if time runs out, the
	team that covered the most total distance wins.

	Exercises: SideView camera, movement locking, an action button (keyboard + mobile),
	ReportProgress chips, and the 2v2 team layout.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.PartyShared.Config)
local ResultsUtil = require(script.Parent.Parent.ResultsUtil)

local MashDash = {}

MashDash.Info = {
	Name = "Mash Dash",
	Description = "Mash to run! First one over the finish line wins it for their team. Tap as fast as you can! 👍",
	Duration = 30,
	Layout = Config.Layouts.TwoVsTwo,
	Camera = { Mode = "SideView", Distance = 55, Height = 10 },
	Controls = {
		Move = false, -- lane-locked: the server moves you
		Jump = false,
		Actions = {
			{ Action = "Mash", Label = "MASH!", Key = "Space", Gamepad = "ButtonA" },
		},
	},
	ProgressLabel = "Progress",
}

local TRACK_LENGTH = 80
local STEP = 1.2 -- studs per press
local PRESS_COOLDOWN = 0.08 -- caps mashing at ~12 presses/s, so autoclickers don't win outright
local LANE_SPACING = 5
local TEAM_COLORS = { Color3.fromRGB(255, 90, 90), Color3.fromRGB(90, 160, 255) }

function MashDash:Setup(arena, participants, _round)
	self.Distance = {}
	self.LastPress = {}
	self.Lanes = {}
	self.Finished = nil

	-- Lanes sorted by team so teammates run next to each other.
	local ordered = table.clone(participants)
	table.sort(ordered, function(a, b)
		return (a.Team or 0) < (b.Team or 0)
	end)

	local startX = -TRACK_LENGTH / 2
	for laneIndex, participant in ordered do
		local z = (laneIndex - (#ordered + 1) / 2) * LANE_SPACING
		local lane = Instance.new("Part")
		lane.Name = "Lane_" .. participant.Name
		lane.Anchored = true
		lane.Size = Vector3.new(TRACK_LENGTH + 10, 1, LANE_SPACING - 0.5)
		lane.CFrame = arena.Origin * CFrame.new(0, 0, z)
		lane.Color = TEAM_COLORS[participant.Team or 1]
		lane.Material = Enum.Material.SmoothPlastic
		lane.Parent = arena.Folder

		self.Lanes[participant] = arena.Origin * CFrame.new(startX, 4, z)
		self.Distance[participant] = 0
		self.LastPress[participant] = 0
	end

	local finish = Instance.new("Part")
	finish.Name = "FinishLine"
	finish.Anchored = true
	finish.CanCollide = false
	finish.Size = Vector3.new(1, 0.2, LANE_SPACING * #ordered)
	finish.CFrame = arena.Origin * CFrame.new(TRACK_LENGTH / 2, 0.6, 0)
	finish.Material = Enum.Material.Neon
	finish.Color = Color3.fromRGB(255, 255, 255)
	finish.Parent = arena.Folder

	local spawns = {}
	for index, participant in participants do
		spawns[index] = self:_laneCFrame(participant)
	end
	return spawns
end

-- Where a participant should stand right now, facing down the track (+X).
function MashDash:_laneCFrame(participant): CFrame
	local base = self.Lanes[participant] * CFrame.new(self.Distance[participant], 0, 0)
	return CFrame.lookAt(base.Position, base.Position + self.Arena.Origin.RightVector)
end

function MashDash:Start()
	for _, participant in self.Participants do
		self.Round:ReportProgress(participant, "0%")
	end
	self.Round:SetStatus("MASH! 🏃💨")
end

function MashDash:OnInput(participant, action)
	if action ~= "Mash" or self.Finished then
		return
	end
	local clock = os.clock()
	if clock - self.LastPress[participant] < PRESS_COOLDOWN then
		return
	end
	self.LastPress[participant] = clock

	local distance = math.min(TRACK_LENGTH, self.Distance[participant] + STEP)
	self.Distance[participant] = distance
	participant:Teleport(self:_laneCFrame(participant))
	self.Round:ReportProgress(participant, ("%d%%"):format(distance / TRACK_LENGTH * 100))

	if distance >= TRACK_LENGTH then
		self.Finished = participant
		self.Round:Toast(("🏁 %s crossed the line for team %d!"):format(participant.Name, participant.Team or 1))
		self.Round:End("Finish")
	end
end

function MashDash:UpdateBot(bot, _dt)
	-- Bots mash 3-5 times a second depending on skill.
	if math.random() < 0.55 + bot.Skill * 0.4 then
		bot:Input("Mash")
	end
end

function MashDash:_teamTotals()
	local totals = {}
	for _, participant in self.Participants do
		local team = participant.Team or 1
		totals[team] = (totals[team] or 0) + self.Distance[participant]
	end
	return totals
end

function MashDash:GetResults()
	local totals = self:_teamTotals()
	return ResultsUtil.fromScores(self.Participants, function(participant)
		local team = participant.Team or 1
		-- Crossing the line beats any distance total.
		local bonus = if self.Finished and self.Finished.Team == participant.Team then 1e6 else 0
		return totals[team] + bonus
	end)
end

function MashDash:Cleanup()
	-- Everything lives in arena.Folder; nothing else to undo.
end

return MashDash
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">PatternRecall</string>
            <string name="Source"><![CDATA[--[[
	Pattern Recall (FFA, memory)
	Four coloured pads flash a sequence. Then everyone repeats it with the four colour
	buttons. A wrong colour, or not finishing in time, knocks you out. Each round the
	sequence is one longer. Last one standing wins (players out in the same round tie).

	Server-authoritative: the server makes the sequence and checks every press. Bots
	remember each step with a chance that drops as the sequence grows (less with skill).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.PartyShared.Config)
local ResultsUtil = require(script.Parent.Parent.ResultsUtil)

local PatternRecall = {}

PatternRecall.COLORS = { "Red", "Blue", "Green", "Yellow" }
local COLOR_VALUES = {
	Red = Color3.fromRGB(235, 70, 70),
	Blue = Color3.fromRGB(70, 130, 245),
	Green = Color3.fromRGB(70, 210, 100),
	Yellow = Color3.fromRGB(250, 210, 60),
}

PatternRecall.Info = {
	Name = "Pattern Recall",
	Description = "Watch the pads flash, then repeat the colours in order with the buttons. One mistake and you're out. It gets longer every round!",
	Duration = 75,
	Layout = Config.Layouts.FFA,
	Camera = { Mode = "AngledOverhead", Height = 34, Distance = 26 },
	Controls = {
		Move = false,
		Jump = false,
		Actions = {
			{ Action = "Red", Label = "RED", Key = "One", Gamepad = "ButtonB", Side = "Left", Color = COLOR_VALUES.Red },
			{ Action = "Blue", Label = "BLUE", Key = "Two", Gamepad = "ButtonX", Side = "Left", Color = COLOR_VALUES.Blue },
			{ Action = "Green", Label = "GREEN", Key = "Three", Gamepad = "ButtonA", Color = COLOR_VALUES.Green },
			{ Action = "Yellow", Label = "YELLOW", Key = "Four", Gamepad = "ButtonY", Color = COLOR_VALUES.Yellow },
		},
	},
	ProgressLabel = "Recalled",
}

-- Tuning ----------------------------------------------------------------------------------
PatternRecall.START_LENGTH = 3
PatternRecall.FLASH_TIME = 0.55 -- each colour is lit this long ...
PatternRecall.GAP_TIME = 0.2 -- ... with this gap between colours
PatternRecall.INPUT_TIME_PER_STEP = 1.2 -- seconds allowed per colour to repeat it
PatternRecall.INPUT_TIME_BASE = 2
PatternRecall.BOT_STEP_ACCURACY = 0.985 -- skill-1 bot's chance per colour, falls with length
PatternRecall.BOT_FORGET_PER_STEP = 0.02 -- extra miss chance per colour of length (skill 0)

function PatternRecall:Setup(arena, participants, round)
	self.Rng = round.Rng
	self.Sequence = {}
	self.Progress = {} -- participant -> how many of this round's colours they've entered
	self.Done = {} -- participant -> finished this round's sequence
	self.Phase = "Idle" -- Idle | Show | Input
	self.Pads = {}
	self.OutRound = {} -- participant -> round they were knocked out in

	local floor = Instance.new("Part")
	floor.Name = "Floor"
	floor.Anchored = true
	floor.Size = Vector3.new(36, 1, 30)
	floor.CFrame = arena.Origin
	floor.Color = Color3.fromRGB(60, 60, 80)
	floor.Parent = arena.Folder
	for index, colour in PatternRecall.COLORS do
		local pad = Instance.new("Part")
		pad.Name = "Pad" .. colour
		pad.Anchored = true
		pad.Size = Vector3.new(6, 1, 6)
		pad.CFrame = arena.Origin * CFrame.new((index - 2.5) * 7.5, 0.6, -6)
		pad.Color = COLOR_VALUES[colour]:Lerp(Color3.new(0, 0, 0), 0.55)
		pad.Parent = arena.Folder
		self.Pads[colour] = pad
	end

	local spawns = {}
	for index, participant in participants do
		local position = (arena.Origin * CFrame.new((index - (#participants + 1) / 2) * 6, 4, 8)).Position
		spawns[index] = CFrame.lookAt(position, (arena.Origin * CFrame.new(0, 4, -6)).Position)
	end
	return spawns
end

function PatternRecall:_light(colour: string?, on: boolean)
	local pad = colour and self.Pads[colour]
	if pad and pad.Parent then
		pad.Color = if on then COLOR_VALUES[colour] else COLOR_VALUES[colour]:Lerp(Color3.new(0, 0, 0), 0.55)
		pad.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
	end
end

-- Next round: one colour longer, shown, then everyone repeats it.
function PatternRecall:_nextRound()
	local length = if #self.Sequence == 0 then PatternRecall.START_LENGTH else #self.Sequence + 1
	while #self.Sequence < length do
		table.insert(self.Sequence, PatternRecall.COLORS[self.Rng:NextInteger(1, #PatternRecall.COLORS)])
	end
	self.Phase = "Show"
	self.RoundNumber = (self.RoundNumber or 0) + 1
	local roundNumber = self.RoundNumber
	self.Round:SetStatus(("Watch! %d colours"):format(#self.Sequence))
	task.spawn(function()
		for _, colour in self.Sequence do
			if self.Round.Ended or self.RoundNumber ~= roundNumber then
				return
			end
			self:_light(colour, true)
			task.wait(PatternRecall.FLASH_TIME)
			self:_light(colour, false)
			task.wait(PatternRecall.GAP_TIME)
		end
		if self.Round.Ended or self.RoundNumber ~= roundNumber then
			return
		end
		self:_beginInput()
	end)
end

function PatternRecall:_beginInput()
	self.Phase = "Input"
	self.Progress, self.Done = {}, {}
	for _, participant in self.Round:GetAlive() do
		self.Progress[participant] = 0
	end
	self.Round:SetStatus("Your turn: repeat the colours!")
	local roundNumber = self.RoundNumber
	task.delay(PatternRecall.INPUT_TIME_BASE + PatternRecall.INPUT_TIME_PER_STEP * #self.Sequence, function()
		if self.RoundNumber == roundNumber and self.Phase == "Input" and not self.Round.Ended then
			self:_finishInput()
		end
	end)
end

-- Input over: anyone who didn't finish is out. Then the next round, or the end.
function PatternRecall:_finishInput()
	self.Phase = "Idle"
	for _, participant in self.Round:GetAlive() do
		if not self.Done[participant] then
			self:_knockOut(participant)
		end
	end
	if #self.Round:GetAlive() <= 1 then
		self.Round:End("LastStanding")
		return
	end
	task.delay(1, function()
		if not self.Round.Ended then
			self:_nextRound()
		end
	end)
end

-- A colour press. Wrong colour = out; finishing the sequence = safe this round.
function PatternRecall:Press(participant, colour: string)
	if self.Phase ~= "Input" or self.Done[participant] or self.Round:IsEliminated(participant) then
		return nil
	end
	local index = (self.Progress[participant] or 0) + 1
	if self.Sequence[index] ~= colour then
		self:_knockOut(participant)
		self.Round:Toast(("%s pressed %s, it was %s"):format(participant.Name, colour, self.Sequence[index]))
		self:_checkEveryoneDone()
		return false
	end
	self.Progress[participant] = index
	self.Round:ReportProgress(participant, ("%d/%d"):format(index, #self.Sequence))
	if index == #self.Sequence then
		self.Done[participant] = true
		self:_checkEveryoneDone()
	end
	return true
end

function PatternRecall:_knockOut(participant)
	self.OutRound[participant] = self.RoundNumber or 0
	self.Round:Eliminate(participant)
end

function PatternRecall:_checkEveryoneDone()
	for _, participant in self.Round:GetAlive() do
		if not self.Done[participant] then
			return
		end
	end
	if self.Phase == "Input" then
		self:_finishInput()
	end
end

function PatternRecall:Start()
	for _, participant in self.Participants do
		self.Round:ReportProgress(participant, "0")
	end
	self:_nextRound()
end

function PatternRecall:OnInput(participant, action)
	if table.find(PatternRecall.COLORS, action) then
		self:Press(participant, action)
	end
end

-- Chance a bot gets one colour right in a sequence of `length` (tested).
function PatternRecall.botStepChance(skill: number, length: number): number
	return PatternRecall.BOT_STEP_ACCURACY - (1 - skill) * PatternRecall.BOT_FORGET_PER_STEP * length
end

function PatternRecall:UpdateBot(bot, _dt)
	local participant = bot.Participant
	if self.Phase ~= "Input" or self.Done[participant] then
		return
	end
	local memory = bot.Memory
	if memory.Round ~= self.RoundNumber then
		memory.Round = self.RoundNumber
		memory.NextAt = os.clock() + 0.4 + math.random() * 0.4
	end
	if os.clock() < memory.NextAt then
		return
	end
	memory.NextAt = os.clock() + 0.25 + math.random() * 0.35
	local expected = self.Sequence[(self.Progress[participant] or 0) + 1]
	local colour = expected
	if math.random() > PatternRecall.botStepChance(bot.Skill, #self.Sequence) then
		repeat
			colour = PatternRecall.COLORS[math.random(1, #PatternRecall.COLORS)]
		until colour ~= expected
	end
	bot:Input(colour)
end

-- Lasting longer is better; everyone knocked out in the same round ties.
function PatternRecall:GetResults()
	return ResultsUtil.fromScores(self.Participants, function(participant)
		return self.OutRound[participant] or math.huge
	end)
end

function PatternRecall:Cleanup()
	self.RoundNumber = -1
	self.Phase = "Idle"
end

return PatternRecall
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">PoleShimmy</string>
            <string name="Source"><![CDATA[--[[
	Pole Shimmy (FFA, race)
	Four poles side by side. Alternate left and right (A / D, or the two on-screen buttons) to
	shimmy up yours. Only alternating counts, a steady rhythm climbs faster, and pausing lets
	your momentum fade. First to ring the bell wins; everyone else ranks by height.

	Who decides what (so it is fair and smooth on a laggy connection):
	  * The climbing rules live in PartyShared.PoleShimmySim, shared with the client.
	  * Each player's client stamps every press with its own race clock and sends it here
	    (client/Minigames/PoleShimmy). The server replays those presses through the rules and
	    its result is the only one that counts: heights, finish times, placements.
	    Using the client's timestamps means network jitter can't ruin your rhythm; the server
	    still refuses timestamps from the future, out-of-order presses and too-fast tapping.
	  * Bots press on the server's own clock.
	  * ~20 times a second the server broadcasts every climber's height. Clients draw other
	    climbers by interpolating between those, and their own climber from local prediction
	    that is nudged back onto the server's numbers.

	Climbing tuning is at the top of PartyShared.PoleShimmySim. Round, network, anti-cheat
	and bot tuning is below.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.PartyShared.Config)
local Net = require(ReplicatedStorage.PartyShared.Net)
local Sim = require(ReplicatedStorage.PartyShared.PoleShimmySim)
local ResultsUtil = require(script.Parent.Parent.ResultsUtil)

local PoleShimmy = {}

-- Tuning ----------------------------------------------------------------------------------

local ROUND_DURATION = 25
local POLE_SPACING = 7 -- studs between neighbouring poles
local POLE_RADIUS = 0.8
local CLING_OFFSET = 1.6 -- how far in front of the pole (towards the camera) climbers hang

-- Networking
local SNAPSHOT_RATE = 20 -- height snapshots sent to clients per second
local FALLBACK_PLACE_RATE = 2 -- times per second the server itself moves the bodies

-- Anti-cheat
local CLOCK_SLACK = 0.3 -- seconds a client's race clock may run ahead of the server's
local MAX_PRESSES_PER_SECOND = 14 -- presses arriving faster than this (per player) are dropped
local DEFAULT_DELAY = 0.3 -- assumed client delay until its first press tells us better
local DELAY_MARGIN = 0.05 -- extra seconds the server waits so presses arrive before they're due
local MAX_DELAY = 1.0 -- delays above this are treated as this (very laggy clients just lag)

-- Bots: seconds between presses { sloppiest, sharpest }, wobble per press, stumbles
local BOT_GAP = { 0.36, 0.21 }
local BOT_WOBBLE = { 0.3, 0.06 } -- random +/- share of the gap on each press
local BOT_STUMBLE_CHANCE = { 0.07, 0.015 } -- per press
local BOT_STUMBLE_PAUSE = { 0.5, 1.3 } -- seconds a stumble costs (or a wasted same-hand press)

PoleShimmy.Info = {
	Name = "Pole Shimmy",
	Description = "Alternate LEFT and RIGHT to shimmy up your pole! Keep a steady rhythm to climb faster. First to ring the bell wins 🔔",
	Duration = ROUND_DURATION,
	Layout = Config.Layouts.FFA,
	Camera = { Mode = "SideView", Distance = 26, Height = 3, Smooth = 7, FollowY = true },
	Controls = {
		Move = false,
		Jump = false,
		Actions = {
			{ Action = "Left", Label = "LEFT", Key = "A", Gamepad = "ButtonX", Side = "Left" },
			{ Action = "Right", Label = "RIGHT", Key = "D", Gamepad = "ButtonB" },
		},
	},
	ProgressLabel = "Height",
	ClientModule = "PoleShimmy", -- client/Minigames/PoleShimmy: press timing + smooth drawing
}

local function lerp(range, alpha: number): number
	return range[1] + (range[2] - range[1]) * alpha
end

-- Setup -----------------------------------------------------------------------------------

function PoleShimmy:_part(properties)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in properties do
		part[key] = value
	end
	part.Parent = self.Arena.Folder
	return part
end

-- Base CFrame of pole `index` (on the ground, facing the same way as the arena).
function PoleShimmy:_poleBase(index: number): CFrame
	local offset = (index - (#self.Participants + 1) / 2) * POLE_SPACING
	return self.Arena.Origin * CFrame.new(offset, 0, 0)
end

function PoleShimmy:Setup(arena, participants, _round)
	self.Connections = {}
	self.Climbers = {}
	self.Anchored = {}
	self.FinishCount = 0
	local top = Sim.POLE_HEIGHT

	self:_part({
		Name = "Ground",
		Size = Vector3.new(POLE_SPACING * (#participants + 1), 1, 14),
		CFrame = arena.Origin * CFrame.new(0, -0.5, 0),
		Color = Color3.fromRGB(255, 170, 210),
		CanCollide = true,
	})

	local colors = {
		Color3.fromRGB(255, 220, 60),
		Color3.fromRGB(255, 90, 140),
		Color3.fromRGB(90, 220, 255),
		Color3.fromRGB(120, 255, 140),
	}
	local spawns = {}
	for index, participant in participants do
		local base = self:_poleBase(index)
		local color = colors[(index - 1) % #colors + 1]
		self:_part({
			Name = "Pole",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(top + 6, POLE_RADIUS * 2, POLE_RADIUS * 2),
			CFrame = base * CFrame.new(0, (top + 6) / 2, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Material = Enum.Material.Metal,
			Color = Color3.fromRGB(220, 225, 235),
		})
		-- Height marks every 10 studs, in the pole's colour.
		for mark = 10, top - 1, 10 do
			self:_part({
				Name = "Mark",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.4, POLE_RADIUS * 2 + 0.3, POLE_RADIUS * 2 + 0.3),
				CFrame = base * CFrame.new(0, mark + 3, 0) * CFrame.Angles(0, 0, math.rad(90)),
				Material = Enum.Material.Neon,
				Color = color,
			})
		end
		self:_part({
			Name = "Bell",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(2.6, 2.6, 2.6),
			CFrame = base * CFrame.new(0, top + 7.5, 0),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(255, 215, 0),
		})

		self.Climbers[participant] = {
			Sim = Sim.newClimber(),
			Index = index,
			IsBot = participant.IsBot,
			RideHeight = 3.5,
			-- Players: how far behind the server their race clock runs (measured from presses).
			Delay = DEFAULT_DELAY,
			DelaySamples = {},
			LastPressT = -math.huge,
			Arrivals = {},
			Rejected = 0,
			-- Bots
			NextPressAt = nil,
			NextKey = "Left",
		}
		spawns[index] = base * CFrame.new(0, 4, CLING_OFFSET)
	end
	return spawns
end

-- Climbing --------------------------------------------------------------------------------------

function PoleShimmy:_heightText(climber): string
	if climber.Sim.FinishedAt then
		return ("🏁 %.1fs"):format(climber.Sim.FinishedAt)
	end
	return ("%d%%"):format(math.clamp(climber.Sim.Height / Sim.POLE_HEIGHT, 0, 0.99) * 100)
end

-- Race time this climber's state should be at right now.
function PoleShimmy:_clockFor(climber): number
	local elapsed = os.clock() - self.StartedAt
	return if climber.IsBot then elapsed else math.max(0, elapsed - climber.Delay)
end

function PoleShimmy:_place(participant, climber)
	local character = participant:GetCharacter()
	if character then
		character:PivotTo(
			self:_poleBase(climber.Index) * CFrame.new(0, climber.RideHeight + climber.Sim.Height, CLING_OFFSET)
		)
	end
end

function PoleShimmy:_checkFinish(participant, climber)
	if climber.Sim.FinishedAt and not climber.Finished then
		climber.Finished = true
		self.FinishCount += 1
		self.Round:Toast(("🔔 %s rang the bell in %.1fs"):format(participant.Name, climber.Sim.FinishedAt))
		self.Round:ReportProgress(participant, self:_heightText(climber))
	end
end

-- A press from a player's client, stamped with that client's race clock.
function PoleShimmy:_playerPress(participant, climber, key, t)
	if (key ~= "Left" and key ~= "Right") or type(t) ~= "number" or t ~= t then
		return
	end
	local elapsed = os.clock() - self.StartedAt
	-- Rate limit by arrival: autoclickers and floods get dropped before anything else.
	local now = os.clock()
	local arrivals = climber.Arrivals
	while arrivals[1] and now - arrivals[1] > 1 do
		table.remove(arrivals, 1)
	end
	if #arrivals >= MAX_PRESSES_PER_SECOND then
		climber.Rejected += 1
		return
	end
	table.insert(arrivals, now)
	-- No pressing in the future, and no rewriting the past.
	if t > elapsed + CLOCK_SLACK or t < climber.LastPressT then
		climber.Rejected += 1
		return
	end
	climber.LastPressT = t

	-- The server works this climber out a little behind real time, far enough back that
	-- presses normally arrive *before* the moment they were pressed comes up (the slowest
	-- recent arrival, plus a margin). Then every press lands at its own timestamp and the
	-- server's numbers match what the player's own client predicted.
	table.insert(climber.DelaySamples, elapsed - t)
	if #climber.DelaySamples > 20 then
		table.remove(climber.DelaySamples, 1)
	end
	local delay = 0
	for _, sample in climber.DelaySamples do
		delay = math.max(delay, sample)
	end
	climber.Delay = math.clamp(delay + DELAY_MARGIN, 0, MAX_DELAY)

	-- A press can't land before the state we have already worked out (a late packet).
	Sim.press(climber.Sim, key, math.max(t, climber.Sim.Time))
	self:_checkFinish(participant, climber)
end

-- Bots: a press every so often, with wobble and the odd stumble.
function PoleShimmy:_updateBot(participant, climber, elapsed: number)
	local bot = participant.Bot
	if climber.Sim.FinishedAt or not bot then
		return
	end
	local skill = bot.Skill
	local gap = lerp(BOT_GAP, skill)
	if not climber.NextPressAt then
		-- Everyone reacts to GO at a slightly different moment.
		climber.NextPressAt = elapsed + 0.15 + math.random() * (0.5 - skill * 0.35)
	end
	if elapsed < climber.NextPressAt then
		return
	end
	local key = climber.NextKey
	if math.random() < lerp(BOT_STUMBLE_CHANCE, skill) then
		-- Stumble: either a fumbled same-hand press, or a moment to regrip.
		if math.random() < 0.5 then
			key = if key == "Left" then "Right" else "Left"
		end
		climber.NextPressAt = elapsed + lerp(BOT_STUMBLE_PAUSE, math.random())
	else
		local wobble = lerp(BOT_WOBBLE, skill)
		climber.NextPressAt = elapsed + gap * (1 + (math.random() * 2 - 1) * wobble)
	end
	climber.NextKey = if key == "Left" then "Right" else "Left"
	bot:Input(key) -- same validated path as player inputs; arrives in OnInput
end

-- Interface -----------------------------------------------------------------------------

function PoleShimmy:Start()
	local round = self.Round
	self.StartedAt = os.clock()
	local nextSnapshot, nextPlace, nextReport = 0, 0, 0

	local describe = {}
	for _, participant in self.Participants do
		local climber = self.Climbers[participant]
		local character = participant:GetCharacter()
		local root = participant:GetRoot()
		if character and root then
			local base = self:_poleBase(climber.Index)
			climber.RideHeight = base:PointToObjectSpace(character:GetPivot().Position).Y
			root.AssemblyLinearVelocity = Vector3.zero
			root.Anchored = true
			table.insert(self.Anchored, root)
		end
		table.insert(describe, {
			Id = participant.Id,
			Character = character,
			Base = self:_poleBase(climber.Index) * CFrame.new(0, 0, CLING_OFFSET),
			RideHeight = climber.RideHeight,
		})
	end
	Net.minigameRemote():FireAllClients({ Type = "Setup", Climbers = describe })
	round:SetStatus("Alternate LEFT + RIGHT!")

	table.insert(
		self.Connections,
		RunService.Heartbeat:Connect(function()
			if round.Ended then
				return
			end
			local clock = os.clock()
			local elapsed = clock - self.StartedAt
			for _, participant in round:GetAlive() do
				local climber = self.Climbers[participant]
				if climber.IsBot then
					self:_updateBot(participant, climber, elapsed)
				end
				-- A player's climber waits for their first press, so that press (and the
				-- delay it reveals) decides where their timeline starts.
				if climber.IsBot or climber.LastPressT > -math.huge then
					Sim.advance(climber.Sim, self:_clockFor(climber))
				end
				self:_checkFinish(participant, climber)
			end

			if clock >= nextSnapshot then
				nextSnapshot = clock + 1 / SNAPSHOT_RATE
				local list = {}
				for _, participant in self.Participants do
					local state = self.Climbers[participant].Sim
					table.insert(list, { participant.Id, state.Height, state.Time, state.LastKey == "Left" })
				end
				Net.minigameFastRemote():FireAllClients({ T = clock, R = list })
			end
			if clock >= nextPlace then
				nextPlace = clock + 1 / FALLBACK_PLACE_RATE
				for _, participant in round:GetAlive() do
					self:_place(participant, self.Climbers[participant])
				end
			end
			if clock >= nextReport then
				nextReport = clock + 0.1
				for _, participant in self.Participants do
					round:ReportProgress(participant, self:_heightText(self.Climbers[participant]))
				end
			end
			if self.FinishCount >= #round:GetAlive() then
				round:End("Finish")
			end
		end)
	)
end

-- Bot presses (and a player's, if their client code isn't running) arrive here, on server time.
function PoleShimmy:OnInput(participant, action)
	local climber = self.Climbers[participant]
	if not climber or (action ~= "Left" and action ~= "Right") then
		return
	end
	if climber.IsBot then
		Sim.press(climber.Sim, action, os.clock() - self.StartedAt)
		self:_checkFinish(participant, climber)
	else
		self:_playerPress(participant, climber, action, self:_clockFor(climber))
	end
end

-- Timestamped presses from client/Minigames/PoleShimmy.
function PoleShimmy:OnClientMessage(participant, message)
	local climber = self.Climbers[participant]
	if climber and not climber.IsBot and type(message) == "table" and message.Type == "Press" then
		self:_playerPress(participant, climber, message.Key, message.T)
	end
end

function PoleShimmy:OnRoundEnding(_reason)
	for _, participant in self.Participants do
		local climber = self.Climbers[participant]
		self:_place(participant, climber)
		if climber.Rejected > 0 then
			print(("[PoleShimmy] %s: %d press(es) rejected"):format(participant.Name, climber.Rejected))
		end
	end
end

function PoleShimmy:GetResults()
	return ResultsUtil.fromScores(self.Participants, function(participant)
		local state = self.Climbers[participant].Sim
		-- Bell-ringers beat everyone still climbing; earlier = better.
		return if state.FinishedAt then 1e6 - state.FinishedAt else state.Height
	end)
end

function PoleShimmy:Cleanup()
	for _, connection in self.Connections do
		connection:Disconnect()
	end
	for _, root in self.Anchored do
		if root.Parent then
			root.Anchored = false
		end
	end
end

return PoleShimmy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">QuickDraw</string>
            <string name="Source"><![CDATA[--[[
	Quick Draw (Duel: exactly two players, played from board Duel spaces)
	A reaction duel. "Wait for it..." then the light turns green: first to press DRAW wins
	the point. Press before the light and you lose the point (false start). First to 2.

	Server-authoritative: the server picks the moment, and judges presses by when it
	receives them. Bots react after a skill-based delay and sometimes jump the gun.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.PartyShared.Config)
local ResultsUtil = require(script.Parent.Parent.ResultsUtil)

local QuickDraw = {}

QuickDraw.Info = {
	Name = "Quick Draw",
	Description = "Wait for the light to turn green, then press DRAW first. Too early and you lose the point! First to 2.",
	Duration = 40,
	Layout = Config.Layouts.Duel,
	Camera = { Mode = "SideView", Distance = 36, Height = 6 },
	Controls = {
		Move = false,
		Jump = false,
		Actions = {
			{ Action = "Draw", Label = "DRAW!", Key = "Space", Gamepad = "ButtonA" },
		},
	},
	ProgressLabel = "Points",
}

-- Tuning ----------------------------------------------------------------------------------
QuickDraw.POINTS_TO_WIN = 2
QuickDraw.WAIT_RANGE = { 1.5, 4 } -- seconds before the light turns green
QuickDraw.BETWEEN_POINTS = 2 -- pause after each point
QuickDraw.BOT_REACTION = { 0.22, 0.6 } -- fastest (skill 1) .. slowest (skill 0), seconds
QuickDraw.BOT_FALSE_START = 0.12 -- chance per point a skill-0 bot jumps the gun (less with skill)
local GAP = 16

local COLORS = { Wait = Color3.fromRGB(220, 60, 60), Draw = Color3.fromRGB(60, 220, 90), Idle = Color3.fromRGB(90, 90, 110) }

function QuickDraw:Setup(arena, participants, round)
	self.Points = {}
	self.State = "Idle" -- Idle | Waiting | Draw
	self.Now = self.Now or os.clock
	self.Rng = round.Rng
	for _, participant in participants do
		self.Points[participant] = 0
	end

	local floor = Instance.new("Part")
	floor.Name = "Floor"
	floor.Anchored = true
	floor.Size = Vector3.new(GAP + 12, 1, 10)
	floor.CFrame = arena.Origin
	floor.Color = Color3.fromRGB(200, 170, 120)
	floor.Parent = arena.Folder

	local light = Instance.new("Part")
	light.Name = "Light"
	light.Anchored = true
	light.Shape = Enum.PartType.Ball
	light.Size = Vector3.new(4, 4, 4)
	light.Material = Enum.Material.Neon
	light.Color = COLORS.Idle
	light.CFrame = arena.Origin * CFrame.new(0, 9, 0)
	light.Parent = arena.Folder
	self.Light = light

	local spawns = {}
	for index, participant in participants do
		local side = if index == 1 then -1 else 1
		local position = (arena.Origin * CFrame.new(side * GAP / 2, 4, 0)).Position
		spawns[index] = CFrame.lookAt(position, (arena.Origin * CFrame.new(0, 4, 0)).Position)
		participant.QuickDrawSide = side
	end
	return spawns
end

function QuickDraw:_setLight(state: string)
	self.State = state
	if self.Light then
		self.Light.Color = COLORS[if state == "Draw" then "Draw" elseif state == "Waiting" then "Wait" else "Idle"]
	end
end

function QuickDraw:_report()
	for participant, points in self.Points do
		self.Round:ReportProgress(participant, points)
	end
end

-- Starts a point: red light, then green after a random wait.
function QuickDraw:_arm()
	self:_setLight("Waiting")
	self.Round:SetStatus("Wait for it...")
	self.PointId = (self.PointId or 0) + 1
	local pointId = self.PointId
	local wait = self.Rng:NextNumber(QuickDraw.WAIT_RANGE[1], QuickDraw.WAIT_RANGE[2])
	self.DrawAt = self.Now() + wait
	task.delay(wait, function()
		if self.PointId == pointId and self.State == "Waiting" and not self.Round.Ended then
			self:_setLight("Draw")
			self.Round:SetStatus("DRAW!")
		end
	end)
end

-- Awards the point and starts the next one (or ends the duel).
function QuickDraw:_award(winner, why: string)
	self:_setLight("Idle")
	self.Points[winner] += 1
	self:_report()
	self.Round:Toast(("%s %s"):format(winner.Name, why))
	if self.Points[winner] >= QuickDraw.POINTS_TO_WIN then
		self.Round:End("Winner")
		return
	end
	task.delay(QuickDraw.BETWEEN_POINTS, function()
		if not self.Round.Ended then
			self:_arm()
		end
	end)
end

function QuickDraw:_other(participant)
	for _, other in self.Participants do
		if other ~= participant then
			return other
		end
	end
	return nil
end

-- A DRAW press. Judged on the server's clock.
function QuickDraw:Press(participant)
	if self.State == "Waiting" then
		local other = self:_other(participant)
		if other then
			self:_award(other, ("wins the point: %s jumped the gun"):format(participant.Name))
		end
	elseif self.State == "Draw" then
		self:_award(participant, "drew first!")
	end
end

function QuickDraw:Start()
	self:_report()
	self:_arm()
end

function QuickDraw:OnInput(participant, action)
	if action == "Draw" then
		self:Press(participant)
	end
end

function QuickDraw:UpdateBot(bot, _dt)
	local memory = bot.Memory
	if memory.Point ~= self.PointId then
		memory.Point = self.PointId
		local reaction = QuickDraw.BOT_REACTION[2] - (QuickDraw.BOT_REACTION[2] - QuickDraw.BOT_REACTION[1]) * bot.Skill
		memory.PressAt = (self.DrawAt or math.huge) + reaction * (0.85 + math.random() * 0.3)
		if math.random() < QuickDraw.BOT_FALSE_START * (1 - bot.Skill) then
			memory.PressAt = (self.DrawAt or math.huge) - 0.4 -- jumps the gun
		end
	end
	if self.State ~= "Idle" and memory.PressAt and self.Now() >= memory.PressAt then
		memory.PressAt = nil
		bot:Input("Draw")
	end
end

function QuickDraw:GetResults()
	return ResultsUtil.fromScores(self.Participants, function(participant)
		return self.Points[participant] or 0
	end)
end

function QuickDraw:Cleanup()
	self.PointId = -1
	self.State = "Idle"
end

return QuickDraw
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">TrailTangle</string>
            <string name="Source"><![CDATA[--[[
	Trail Tangle (FFA, strategy / survival)
	Everyone rides across a grid one cell at a time, on their own, leaving a solid trail.
	You only turn left or right. Hit the edge, any trail (yours too), or move into the same
	cell as someone else in the same moment, and you're out. Last rider wins; if time runs
	out, the riders still going rank by cells claimed. It starts slow and speeds up, so it
	rewards planning ahead and cutting off space rather than fast fingers.

	Server-authoritative fixed-step grid simulation (the pure functions below the tuning are
	what the unit tests drive):
	  * Turns are requests: at most one is buffered per rider and it is applied on the next
	    tick. Turning is relative (left / right), so a rider can never reverse into its trail.
	  * Each tick every rider's next cell is worked out first, then all collisions are resolved
	    together (edge, trails, two riders entering one cell, swaps), then survivors move.
	  * Ticks run on a fixed schedule from the round clock, so frame rate never changes
	    outcomes. One small message per tick goes to clients (client/Minigames/TrailTangle),
	    which glide the riders between cells.
	Bots plan right after each tick through the same turn requests players make.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.PartyShared.Config)
local Net = require(ReplicatedStorage.PartyShared.Net)
local ResultsUtil = require(script.Parent.Parent.ResultsUtil)

local TrailTangle = {}

-- Tuning ----------------------------------------------------------------------------------

TrailTangle.GRID_WIDTH = 26 -- cells
TrailTangle.GRID_HEIGHT = 26
TrailTangle.CELL_SIZE = 3 -- studs per cell
TrailTangle.START_INTERVAL = 0.32 -- seconds per step at the start (slow enough to learn)
TrailTangle.FINAL_INTERVAL = 0.13 -- seconds per step once fully sped up
TrailTangle.RAMP_START = 6 -- seconds before the pace starts rising
TrailTangle.RAMP_END = 28 -- seconds when it reaches FINAL_INTERVAL
TrailTangle.RAMP_CURVE = 1.3 -- >1: speeds up gently at first, harder later
TrailTangle.SPEED_WARNINGS = { 6, 14, 22 } -- seconds: "speeding up" toast when these pass
TrailTangle.TURN_COOLDOWN = 0.06 -- seconds: turn requests closer together than this are dropped
TrailTangle.ROUND_DURATION = 35
TrailTangle.MAX_CATCH_UP = 3 -- ticks run at most per frame after a server hitch
TrailTangle.TRAIL_HEIGHT = 1.2 -- studs; trail blocks the riders stand on

-- Bots (skill 0..1 blends from the first number to the second)
TrailTangle.BOT = {
	Reach = { 30, 220 }, -- open cells counted down each option (planning depth)
	Mistake = { 0.14, 0.01 }, -- chance per decision of a late or wrong reaction
	Aggression = { 0.1, 0.35 }, -- weight on claiming space before opponents can (cutting off)
	Caution = { 0.3, 1 }, -- how much a cell an opponent could also enter next step is feared
	Noise = { 10, 1 }, -- random judgement added to each option's score
	Pocket = 2.5, -- extra penalty per missing cell when an option leads into a small pocket
	Crowding = 15, -- penalty for steering within two cells of an opponent's head
}

TrailTangle.Info = {
	Name = "Trail Tangle",
	Description = "You ride on your own and leave a solid trail. Turn LEFT or RIGHT to dodge the edge and every trail. Trap the others; last rider wins! It speeds up, so plan ahead.",
	Duration = TrailTangle.ROUND_DURATION,
	Layout = Config.Layouts.FFA,
	-- Steep, fixed view of the whole grid (no drift toward you). On phones it's a little
	-- closer and aimed further ahead, so the grid fills the gap between the chips and the
	-- bottom edge, between the LEFT and RIGHT buttons.
	Camera = {
		Mode = "AngledOverhead",
		Height = 92,
		Distance = 40,
		Follow = 0,
		Smooth = 20,
		TouchZoom = 0.92,
		TouchLookAhead = 12,
	},
	Controls = {
		Move = false,
		Jump = false,
		-- Hold = true only so on-screen buttons fire the moment a finger lands (the "...Stop"
		-- half is ignored); one press is one turn.
		Actions = {
			{ Action = "Left", Label = "LEFT", Keys = { "A", "Left" }, Gamepads = { "DPadLeft", "ButtonL1" }, Side = "Left", Hold = true },
			{ Action = "Right", Label = "RIGHT", Keys = { "D", "Right" }, Gamepads = { "DPadRight", "ButtonR1" }, Hold = true },
		},
	},
	ProgressLabel = "Cells",
	ClientModule = "TrailTangle", -- client/Minigames/TrailTangle glides the riders between cells
}

-- Grid simulation (pure) ------------------------------------------------------------------

-- Directions: 1 = north (-Y), 2 = east (+X), 3 = south (+Y), 4 = west (-X).
local DX = { 0, 1, 0, -1 }
local DY = { -1, 0, 1, 0 }
TrailTangle.DX, TrailTangle.DY = DX, DY

local function turned(dir: number, side: string): number
	return if side == "Right" then dir % 4 + 1 else (dir + 2) % 4 + 1
end
local function reverse(dir: number): number
	return (dir + 1) % 4 + 1
end
TrailTangle.turned = turned

-- A pinwheel: everyone starts the same distance from the edge, each heading for the
-- next one's corner, so nobody starts boxed in and the first turns come early.
function TrailTangle.startCells(width: number, height: number)
	local a, bx, by = 6, width - 7, height - 7
	return {
		{ X = a, Y = a, Dir = 2 },
		{ X = bx, Y = a, Dir = 3 },
		{ X = bx, Y = by, Dir = 4 },
		{ X = a, Y = by, Dir = 1 },
	}
end

function TrailTangle.newSim(count: number, width: number?, height: number?)
	local sim = {
		Width = width or TrailTangle.GRID_WIDTH,
		Height = height or TrailTangle.GRID_HEIGHT,
		Cells = {}, -- [index] = rider index that claimed it
		Riders = {},
		Tick = 0,
	}
	local starts = TrailTangle.startCells(sim.Width, sim.Height)
	for index = 1, count do
		local start = starts[(index - 1) % #starts + 1]
		local rider = {
			Index = index,
			X = start.X,
			Y = start.Y,
			Dir = start.Dir,
			Pending = nil, -- the one buffered turn (a direction), applied next tick
			Alive = true,
			Claimed = 1,
			EliminatedTick = nil,
			LastTurnAt = -math.huge,
		}
		sim.Riders[index] = rider
		sim.Cells[TrailTangle.cellIndex(sim, rider.X, rider.Y)] = index
	end
	return sim
end

function TrailTangle.cellIndex(sim, x: number, y: number): number
	return y * sim.Width + x + 1
end

function TrailTangle.inside(sim, x: number, y: number): boolean
	return x >= 0 and y >= 0 and x < sim.Width and y < sim.Height
end

function TrailTangle.isOpen(sim, x: number, y: number): boolean
	return TrailTangle.inside(sim, x, y) and sim.Cells[TrailTangle.cellIndex(sim, x, y)] == nil
end

--[[
	A turn request ("Left" / "Right") at time `now` (seconds). Returns ok, reason.
	Only one turn is buffered per tick; requests faster than TURN_COOLDOWN are dropped.
]]
function TrailTangle.requestTurn(sim, rider, side, now: number): (boolean, string?)
	if not rider or not rider.Alive then
		return false, "out"
	end
	if side ~= "Left" and side ~= "Right" then
		return false, "malformed"
	end
	if type(now) ~= "number" or now ~= now or now - rider.LastTurnAt < TrailTangle.TURN_COOLDOWN then
		return false, "too_fast"
	end
	if rider.Pending then
		return false, "buffered"
	end
	local dir = turned(rider.Dir, side)
	if dir == reverse(rider.Dir) then
		return false, "reverse" -- can't happen with relative turns; kept as a hard rule
	end
	rider.Pending = dir
	rider.LastTurnAt = now
	return true, nil
end

-- Removes a rider (left the game / body lost). Their trail stays.
function TrailTangle.knockOut(sim, rider)
	if rider.Alive then
		rider.Alive = false
		rider.EliminatedTick = sim.Tick
		rider.Pending = nil
	end
end

--[[
	One fixed step for everyone. All next cells are decided before anything moves, so the
	order riders are listed in never matters:
	  * off the grid, or into any trail cell (heads included) -> out
	  * two or more riders entering the same cell -> all of them out
	  * swapping cells is two riders entering each other's (already claimed) head -> both out
	Returns the riders knocked out this tick.
]]
function TrailTangle.step(sim)
	sim.Tick += 1
	local moves = {}
	local targets = {} -- [cell index] = number of riders heading there
	for _, rider in sim.Riders do
		if rider.Alive then
			if rider.Pending and rider.Pending ~= reverse(rider.Dir) then
				rider.Dir = rider.Pending
			end
			rider.Pending = nil
			local x, y = rider.X + DX[rider.Dir], rider.Y + DY[rider.Dir]
			local move = { Rider = rider, X = x, Y = y, Crash = not TrailTangle.isOpen(sim, x, y) }
			if TrailTangle.inside(sim, x, y) then
				move.Cell = TrailTangle.cellIndex(sim, x, y)
				targets[move.Cell] = (targets[move.Cell] or 0) + 1
			end
			table.insert(moves, move)
		end
	end
	local out = {}
	for _, move in moves do
		if move.Crash or (move.Cell and targets[move.Cell] > 1) then
			move.Rider.Alive = false
			move.Rider.EliminatedTick = sim.Tick
			table.insert(out, move.Rider)
		end
	end
	for _, move in moves do
		local rider = move.Rider
		if rider.Alive then
			rider.X, rider.Y = move.X, move.Y
			rider.Claimed += 1
			sim.Cells[move.Cell] = rider.Index
		end
	end
	return out
end

-- Seconds per step `elapsed` seconds into the round.
function TrailTangle.intervalAt(elapsed: number): number
	if elapsed <= TrailTangle.RAMP_START then
		return TrailTangle.START_INTERVAL
	end
	local alpha = math.clamp((elapsed - TrailTangle.RAMP_START) / (TrailTangle.RAMP_END - TrailTangle.RAMP_START), 0, 1)
	alpha ^= TrailTangle.RAMP_CURVE
	return TrailTangle.START_INTERVAL + (TrailTangle.FINAL_INTERVAL - TrailTangle.START_INTERVAL) * alpha
end

function TrailTangle.alive(sim)
	local list = {}
	for _, rider in sim.Riders do
		if rider.Alive then
			table.insert(list, rider)
		end
	end
	return list
end

-- Ranking score: later elimination is better (survivors best), then cells claimed.
function TrailTangle.score(sim, rider): number
	return (rider.EliminatedTick or (sim.Tick + 1)) * 100000 + rider.Claimed
end

-- Bot planning (pure) ---------------------------------------------------------------------

local function blend(pair, skill: number): number
	return pair[1] + (pair[2] - pair[1]) * skill
end

-- Open cells reachable from (x, y) (which counts as taken), up to `cap`.
function TrailTangle.openArea(sim, x: number, y: number, cap: number): number
	local seen = { [TrailTangle.cellIndex(sim, x, y)] = true }
	local queue, head, count = { x, y }, 1, 0
	while head < #queue and count < cap do
		local cx, cy = queue[head], queue[head + 1]
		head += 2
		for dir = 1, 4 do
			local nx, ny = cx + DX[dir], cy + DY[dir]
			if TrailTangle.isOpen(sim, nx, ny) then
				local index = TrailTangle.cellIndex(sim, nx, ny)
				if not seen[index] then
					seen[index] = true
					count += 1
					table.insert(queue, nx)
					table.insert(queue, ny)
				end
			end
		end
	end
	return count
end

-- Cells I could reach strictly before any opponent (starting from (x, y)) minus theirs.
local function territory(sim, me, x: number, y: number): number
	local owner, dist = {}, {}
	local queue = {}
	local function seed(cx, cy, who)
		local index = TrailTangle.cellIndex(sim, cx, cy)
		owner[index], dist[index] = who, 0
		table.insert(queue, { cx, cy, who, 0 })
	end
	seed(x, y, me.Index)
	for _, other in sim.Riders do
		if other ~= me and other.Alive then
			seed(other.X, other.Y, other.Index)
		end
	end
	local head = 1
	while head <= #queue do
		local cx, cy, who, d = table.unpack(queue[head])
		head += 1
		if owner[TrailTangle.cellIndex(sim, cx, cy)] ~= 0 then
			for dir = 1, 4 do
				local nx, ny = cx + DX[dir], cy + DY[dir]
				if TrailTangle.isOpen(sim, nx, ny) then
					local index = TrailTangle.cellIndex(sim, nx, ny)
					if dist[index] == nil then
						owner[index], dist[index] = who, d + 1
						table.insert(queue, { nx, ny, who, d + 1 })
					elseif dist[index] == d + 1 and owner[index] ~= who then
						owner[index] = 0 -- contested
					end
				end
			end
		end
	end
	local mine, theirs = 0, 0
	for _, who in owner do
		if who == me.Index then
			mine += 1
		elseif who ~= 0 then
			theirs += 1
		end
	end
	return mine - theirs / 3
end

--[[
	What a bot of `skill` (0..1) asks for this tick: "Left", "Right" or nil (straight on).
	It looks only at the visible grid: open space down each option (deeper with skill),
	small dead-end pockets, cells an opponent could enter at the same moment, and how much
	space it would claim before opponents (aggression). Sloppier bots look less far, judge
	noisily and sometimes react late or pick the second-best option (never a move that
	crashes on the spot: their mistakes show up as worse positions a few steps later).
]]
function TrailTangle.botChoice(sim, rider, skill: number, rng: Random)
	if not rider.Alive then
		return nil
	end
	local bot = TrailTangle.BOT
	local reach = math.floor(blend(bot.Reach, skill))
	local options, straight = {}, nil
	for _, side in { false, "Left", "Right" } do
		local dir = if side then turned(rider.Dir, side) else rider.Dir
		local x, y = rider.X + DX[dir], rider.Y + DY[dir]
		local score
		if not TrailTangle.isOpen(sim, x, y) then
			score = -1e9
		else
			local area = TrailTangle.openArea(sim, x, y, reach)
			score = area
			if area < reach then
				score -= (reach - area) * bot.Pocket -- walled-in pocket: avoid
			end
			for _, other in sim.Riders do
				if other ~= rider and other.Alive then
					local gap = math.abs(other.X - x) + math.abs(other.Y - y)
					if gap == 1 then
						score -= 40 * blend(bot.Caution, skill) -- they could take this cell too
					elseif gap == 2 then
						score -= bot.Crowding * blend(bot.Caution, skill) -- don't ride head to head
					end
				end
			end
			score += territory(sim, rider, x, y) * blend(bot.Aggression, skill) * 0.5
			score += rng:NextNumber() * blend(bot.Noise, skill)
			if not side then
				score += 0.5 -- no reason to wiggle
			end
		end
		local option = { Side = side, Score = score }
		straight = straight or option
		table.insert(options, option)
	end
	table.sort(options, function(a, b)
		return a.Score > b.Score
	end)
	local pick = options[1]
	if rng:NextNumber() < blend(bot.Mistake, skill) then
		-- A believable slip: react a step late (carry straight on) or take the runner-up. Never
		-- one that crashes on the spot; the cost shows up later as a worse position.
		local slip = if rng:NextNumber() < 0.5 then straight else options[2]
		if slip.Score > -1e9 then
			pick = slip
		end
	end
	return pick.Side or nil
end

-- Round ---------------------------------------------------------------------------------------

local COLORS = {
	Color3.fromRGB(255, 80, 80),
	Color3.fromRGB(70, 160, 255),
	Color3.fromRGB(90, 225, 110),
	Color3.fromRGB(255, 205, 60),
}

-- Grid cell -> world (centre of the cell, on the floor's top surface).
function TrailTangle:_cellCFrame(x: number, y: number, height: number?): CFrame
	local cell = TrailTangle.CELL_SIZE
	local w, h = self.Sim.Width, self.Sim.Height
	return self.Arena.Origin * CFrame.new((x - (w - 1) / 2) * cell, height or 0, (y - (h - 1) / 2) * cell)
end

local function yawOf(dir: number): number
	-- CFrame looks down -Z: north (-Y on the grid, -Z in the world) is yaw 0.
	return ({ 0, -math.pi / 2, math.pi, math.pi / 2 })[dir]
end
TrailTangle.yawOf = yawOf

function TrailTangle:_part(properties)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanQuery = false
	part.CanTouch = false
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in properties do
		part[key] = value
	end
	part.Parent = self.Arena.Folder
	return part
end

function TrailTangle:_buildGrid()
	local cell = TrailTangle.CELL_SIZE
	local w, h = self.Sim.Width * cell, self.Sim.Height * cell
	self:_part({
		Name = "Floor",
		Size = Vector3.new(w, 1, h),
		CFrame = self.Arena.Origin * CFrame.new(0, -0.5, 0),
		Color = Color3.fromRGB(40, 44, 62),
	})
	-- Faint lines so the cells can be counted at a glance.
	for i = 0, self.Sim.Width do
		self:_part({
			Name = "GridLine",
			CanCollide = false,
			Size = Vector3.new(0.15, 0.05, h),
			CFrame = self.Arena.Origin * CFrame.new(i * cell - w / 2, 0.03, 0),
			Color = Color3.fromRGB(70, 76, 102),
		})
	end
	for i = 0, self.Sim.Height do
		self:_part({
			Name = "GridLine",
			CanCollide = false,
			Size = Vector3.new(w, 0.05, 0.15),
			CFrame = self.Arena.Origin * CFrame.new(0, 0.03, i * cell - h / 2),
			Color = Color3.fromRGB(70, 76, 102),
		})
	end
	-- The edge is deadly: a bright rim.
	for _, side in { { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } } do
		local alongX = side[1] == 0
		self:_part({
			Name = "Edge",
			Material = Enum.Material.Neon,
			Size = if alongX then Vector3.new(w + 2, 2, 1) else Vector3.new(1, 2, h + 2),
			CFrame = self.Arena.Origin * CFrame.new(side[1] * (w / 2 + 0.5), 1, side[2] * (h / 2 + 0.5)),
			Color = Color3.fromRGB(255, 90, 160),
		})
	end
end

function TrailTangle:_trail(rider)
	local cell = TrailTangle.CELL_SIZE
	self:_part({
		Name = "Trail",
		Size = Vector3.new(cell - 0.25, TrailTangle.TRAIL_HEIGHT, cell - 0.25),
		CFrame = self:_cellCFrame(rider.X, rider.Y, TrailTangle.TRAIL_HEIGHT / 2),
		Color = COLORS[(rider.Index - 1) % #COLORS + 1],
	})
end

-- Height of a body's pivot (root) standing on a trail block.
function TrailTangle:_rideHeight(participant): number
	local humanoid = participant:GetHumanoid()
	local root = participant:GetRoot()
	local hip = if humanoid then humanoid.HipHeight else 2
	return TrailTangle.TRAIL_HEIGHT + hip + (if root then root.Size.Y / 2 else 1)
end

function TrailTangle:_place(participant)
	local rider = self.RiderOf[participant]
	local character = participant:GetCharacter()
	if rider and rider.Alive and character then
		character:PivotTo(self:_cellCFrame(rider.X, rider.Y, self.Heights[participant]) * CFrame.Angles(0, yawOf(rider.Dir), 0))
	end
end

function TrailTangle:Setup(arena, participants, _round)
	self.Connections = {}
	self.Anchored = {}
	self.Highlights = {}
	self.Heights = {}
	self.Sim = TrailTangle.newSim(#participants)
	self.RiderOf = {}
	self.ParticipantOf = {}
	self.BotRng = Random.new()
	self:_buildGrid()
	local spawns = {}
	for index, participant in participants do
		local rider = self.Sim.Riders[index]
		self.RiderOf[participant] = rider
		self.ParticipantOf[rider] = participant
		self:_trail(rider)
		self.Heights[participant] = self:_rideHeight(participant)
		spawns[index] = self:_cellCFrame(rider.X, rider.Y, self.Heights[participant] + 0.5)
			* CFrame.Angles(0, yawOf(rider.Dir), 0)
	end
	return spawns
end

function TrailTangle:_tickMessage(interval: number)
	local riders = {}
	for _, rider in self.Sim.Riders do
		table.insert(riders, { rider.X, rider.Y, rider.Dir, rider.Alive })
	end
	return { Type = "Tick", N = self.Sim.Tick, I = interval, R = riders }
end

function TrailTangle:_tick(elapsed: number)
	local sim = self.Sim
	local round = self.Round
	local out = TrailTangle.step(sim)
	for _, rider in sim.Riders do
		if rider.Alive then
			self:_trail(rider)
		end
	end
	for _, rider in out do
		local participant = self.ParticipantOf[rider]
		local root = participant:GetRoot()
		if root then
			root.Anchored = false
		end
		round:Eliminate(participant)
	end
	for participant, rider in self.RiderOf do
		round:ReportProgress(participant, rider.Claimed)
		self:_place(participant)
	end
	Net.minigameRemote():FireAllClients(self:_tickMessage(TrailTangle.intervalAt(elapsed)))

	local warning = TrailTangle.SPEED_WARNINGS[self.NextWarning]
	if warning and elapsed >= warning then
		self.NextWarning += 1
		round:Toast("⚡ Speeding up!")
	end

	local alive = TrailTangle.alive(sim)
	if #alive <= 1 and #sim.Riders > 1 then
		round:End(if #alive == 1 then "LastRider" else "AllOut")
		return
	end
	-- Bots decide for the next step now, through the same turn requests players make.
	for _, participant in self.Participants do
		if participant.IsBot and participant.Bot and self.RiderOf[participant].Alive then
			self:_botThink(participant.Bot)
		end
	end
end

function TrailTangle:_botThink(bot)
	local participant = bot.Participant
	local rider = participant and self.RiderOf[participant]
	if not rider or not rider.Alive or bot.Memory.Tick == self.Sim.Tick then
		return
	end
	bot.Memory.Tick = self.Sim.Tick
	local side = TrailTangle.botChoice(self.Sim, rider, bot.Skill or 0.5, self.BotRng)
	if side then
		bot:Input(side)
	end
end

function TrailTangle:Start()
	local round = self.Round
	self.StartedAt = os.clock()
	self.NextTickAt = TrailTangle.intervalAt(0)
	self.NextWarning = 1
	local describe = {}
	for _, participant in self.Participants do
		local rider = self.RiderOf[participant]
		local root = participant:GetRoot()
		local character = participant:GetCharacter()
		if root then
			root.AssemblyLinearVelocity = Vector3.zero
			root.Anchored = true
			table.insert(self.Anchored, root)
		end
		if character then
			local highlight = Instance.new("Highlight")
			highlight.Name = "TrailTangleColor"
			highlight.FillColor = COLORS[(rider.Index - 1) % #COLORS + 1]
			highlight.FillTransparency = 0.45
			highlight.OutlineColor = Color3.new(1, 1, 1)
			highlight.Parent = character
			table.insert(self.Highlights, highlight)
		end
		self:_place(participant)
		round:ReportProgress(participant, rider.Claimed)
		table.insert(describe, {
			Id = participant.Id,
			Character = character,
			Height = self.Heights[participant],
			Color = COLORS[(rider.Index - 1) % #COLORS + 1],
		})
	end
	Net.minigameRemote():FireAllClients({
		Type = "Setup",
		Origin = self.Arena.Origin,
		Cell = TrailTangle.CELL_SIZE,
		Width = self.Sim.Width,
		Height = self.Sim.Height,
		Riders = describe,
	})
	Net.minigameRemote():FireAllClients(self:_tickMessage(TrailTangle.intervalAt(0)))
	round:SetStatus("Turn LEFT / RIGHT · don't hit any trail")
	for _, participant in self.Participants do
		if participant.IsBot and participant.Bot then
			self:_botThink(participant.Bot)
		end
	end

	table.insert(
		self.Connections,
		RunService.Heartbeat:Connect(function()
			local catchUp = 0
			while not round.Ended and os.clock() - self.StartedAt >= self.NextTickAt and catchUp < TrailTangle.MAX_CATCH_UP do
				catchUp += 1
				local at = self.NextTickAt
				self:_tick(at)
				self.NextTickAt = at + TrailTangle.intervalAt(at)
			end
		end)
	)
end

function TrailTangle:OnInput(participant, action)
	local rider = self.RiderOf[participant]
	if rider and (action == "Left" or action == "Right") then
		TrailTangle.requestTurn(self.Sim, rider, action, os.clock())
	end
end

-- Backup brain on the framework's think loop (normally bots plan right after each tick).
function TrailTangle:UpdateBot(bot, _dt)
	if self.StartedAt then
		self:_botThink(bot)
	end
end

function TrailTangle:OnParticipantLost(participant, _reason)
	local rider = self.RiderOf[participant]
	if rider then
		TrailTangle.knockOut(self.Sim, rider)
		local root = participant:GetRoot()
		if root then
			root.Anchored = false
		end
	end
end

function TrailTangle:GetResults()
	return ResultsUtil.fromScores(self.Participants, function(participant)
		return TrailTangle.score(self.Sim, self.RiderOf[participant])
	end)
end

function TrailTangle:Cleanup()
	for _, connection in self.Connections do
		connection:Disconnect()
	end
	table.clear(self.Connections)
	for _, root in self.Anchored do
		if root.Parent then
			root.Anchored = false
		end
	end
	for _, highlight in self.Highlights do
		highlight:Destroy()
	end
	table.clear(self.Highlights)
	-- Grid and trails live in arena.Folder, which the framework destroys.
end

return TrailTangle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">_Template</string>
            <string name="Source"><![CDATA[--[[
	_Template — copy this file to start a new minigame.
	Files whose names start with "_" are ignored by the MinigameManager, so rename the copy
	(e.g. "CoinRush") and it will show up in the vote automatically.

	Lifecycle (all called by the MinigameManager on a fresh instance each round, so keep
	per-round state on `self`):

	  Setup(arena, participants, round) -> { CFrame }   REQUIRED
	      Build your map inside arena.Folder (around arena.Origin). Return one spawn CFrame
	      per participant, same order as `participants`. Players are teleported there and
	      frozen while the instructions card + 3-2-1 countdown play.
	  Start()                                           REQUIRED
	      GO! Connect your loops here. Movement is already unfrozen.
	  GetResults() -> results                           REQUIRED
	      Ranked array { { Participant = p, Placement = 1 }, ... }. Use ResultsUtil
	      (fromElimination(self.Participants, self.Round) / fromScores / fromTeams) - ties share a placement.
	  Cleanup()                                         REQUIRED
	      Disconnect everything and remove anything you put outside arena.Folder
	      (e.g. Highlights on characters). arena.Folder itself is destroyed for you.

	  OnInput(participant, action)          optional - a player or bot pressed one of Info.Controls
	  UpdateBot(bot, dt)                    optional - bot brain, runs every Config.BotThinkInterval
	  OnParticipantLost(participant, why)   optional - why = "Died" | "Left" (already eliminated)
	  OnRoundEnding(reason)                 optional - reason = "TimeUp" or whatever you passed to round:End()

	Available on self: self.Round (RoundContext), self.Arena, self.Participants, self.Info.
	Handy RoundContext calls: Eliminate(p) (they get a spectator camera), ReportProgress(p, value,
	label?) (player chips), SetStatus(text), Toast(text), End(reason), GetAlive(), GetTeam(n).
	Each participant has a .Team (1 or 2) in 1v3 / 2v2 layouts; team 1 is the solo side in 1v3.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.PartyShared.Config)
local ResultsUtil = require(script.Parent.Parent.ResultsUtil)

local Template = {}

Template.Info = {
	Name = "My Minigame",
	Description = "One or two sentences shown on the vote card and instructions screen.",
	Duration = 60, -- seconds; the round ends automatically when this runs out
	Layout = Config.Layouts.FFA, -- FFA | OneVsThree ("1v3") | TwoVsTwo ("2v2")

	-- Each player's camera. Modes: "AngledOverhead", "FollowBehind", "SideView".
	-- Any number from Config.CameraModes[Mode] (Height, Distance, ...) can be overridden here.
	Camera = { Mode = "AngledOverhead" },

	-- Movement locking + action buttons. Actions get a keyboard key, a gamepad button and
	-- an on-screen button on phones/tablets automatically, and arrive in OnInput.
	Controls = {
		Move = true, -- false = can't walk (enforced on the server)
		Jump = true,
		WalkSpeed = 16,
		Actions = {
			{ Action = "Smack", Label = "Smack!", Key = "E", Gamepad = "ButtonX" },
		},
	},

	-- Caption under each player chip; values come from self.Round:ReportProgress(p, value).
	ProgressLabel = "Score",
}

function Template:Setup(arena, participants, _round)
	self.Connections = {}
	self.Score = {}

	local floor = Instance.new("Part")
	floor.Anchored = true
	floor.Size = Vector3.new(60, 2, 60)
	floor.CFrame = arena.Origin
	floor.Parent = arena.Folder

	local spawns = {}
	for index, participant in participants do
		self.Score[participant] = 0
		spawns[index] = arena.Origin * CFrame.new((index - 2.5) * 8, 4, 0)
	end
	return spawns
end

function Template:Start()
	table.insert(
		self.Connections,
		RunService.Heartbeat:Connect(function()
			-- game logic; call self.Round:End() to finish early
		end)
	)
end

function Template:OnInput(participant, action)
	if action == "Smack" then
		self.Score[participant] += 1
		self.Round:ReportProgress(participant, self.Score[participant])
	end
end

function Template:UpdateBot(bot, _dt)
	bot:MoveTo(self.Arena.Origin.Position)
	if math.random() < 0.2 then
		bot:Input("Smack")
	end
end

function Template:GetResults()
	return ResultsUtil.fromScores(self.Participants, function(participant)
		return self.Score[participant]
	end)
end

function Template:Cleanup()
	for _, connection in self.Connections do
		connection:Disconnect()
	end
end

return Template
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">Participant</string>
          <string name="Source"><![CDATA[--[[
	Participant
	One seat in a round. Wraps either a real Player or a Bot behind the same API,
	so minigames never need to care which one they are dealing with.

	Fields:
	  Id      unique string ("player_123" / "bot_1"), also what the client sees
	  Name    display name
	  IsBot   true for bots
	  Player  the Player (real players only)
	  UserId  the player's numeric UserId (real players only; seat reservations use it)
	  Bot     the Bot object from BotService (bots only)
	  Team    team number for 1v3 / 2v2 layouts, nil in FFA
	  Left    true once a real player leaves mid-round
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.PartyShared.Config)

local Participant = {}
Participant.__index = Participant

function Participant.fromPlayer(player: Player)
	return setmetatable({
		Id = "player_" .. player.UserId,
		Name = player.DisplayName,
		IsBot = false,
		Player = player,
		UserId = player.UserId,
		Bot = nil,
		Team = nil,
		Left = false,
	}, Participant)
end

function Participant.fromBot(bot)
	local self = setmetatable({
		Id = bot.Id,
		Name = bot.Name,
		IsBot = true,
		Player = nil,
		Bot = bot,
		Team = nil,
		Left = false,
	}, Participant)
	bot.Participant = self
	return self
end

function Participant:GetCharacter(): Model?
	if self.IsBot then
		return self.Bot.Model
	end
	return self.Player.Character
end

function Participant:GetHumanoid(): Humanoid?
	local character = self:GetCharacter()
	return character and character:FindFirstChildOfClass("Humanoid")
end

function Participant:GetRoot(): BasePart?
	local character = self:GetCharacter()
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function Participant:GetPosition(): Vector3?
	local root = self:GetRoot()
	return root and root.Position
end

-- True if the participant is still in the game and has a living body in the world.
function Participant:IsAlive(): boolean
	if self.Left then
		return false
	end
	local character = self:GetCharacter()
	local humanoid = self:GetHumanoid()
	return character ~= nil
		and character.Parent ~= nil
		and humanoid ~= nil
		and humanoid.Health > 0
		and self:GetRoot() ~= nil
end

-- Moves the whole character, killing any leftover momentum.
function Participant:Teleport(cframe: CFrame)
	local character = self:GetCharacter()
	local root = self:GetRoot()
	if not character or not root then
		return
	end
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	character:PivotTo(cframe)
	if self.IsBot then
		self.Bot:Stop()
	end
end

function Participant:SetMovement(walkSpeed: number, canJump: boolean)
	local humanoid = self:GetHumanoid()
	if not humanoid then
		return
	end
	humanoid.WalkSpeed = walkSpeed
	-- Set both so it works whichever of UseJumpPower the place uses.
	humanoid.JumpPower = if canJump then Config.DefaultJumpPower else 0
	humanoid.JumpHeight = if canJump then Config.DefaultJumpHeight else 0
end

function Participant:Freeze()
	self:SetMovement(0, false)
	if self.IsBot then
		self.Bot:Stop()
	end
end

function Participant:ResetMovement()
	self:SetMovement(Config.DefaultWalkSpeed, true)
end

-- Applies a minigame's normalized Info.Controls (see MinigameInfo). Done on the server so
-- movement locks hold even if a client ignores them.
function Participant:ApplyControls(controls)
	self:SetMovement(if controls.Move then controls.WalkSpeed else 0, controls.Jump)
end

-- Data the client needs to draw this participant (names, bot icon, team colour).
function Participant:Describe()
	return {
		Id = self.Id,
		Name = self.Name,
		IsBot = self.IsBot,
		Team = self.Team,
	}
end

return Participant
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">Profiles</string>
          <string name="Source"><![CDATA[--[[
	Profiles
	The game's door to permanent player data (ProfileStore). Loads a profile when a player
	joins, hands their cosmetic tables to Inventory, and saves when they leave or the server
	closes. Bots never have profiles.

	  Profiles.start()                    call once from Main
	  Profiles.get(player) -> profile?    { Coins, Owned, Equipped } (see ProfileStore)
	  Profiles.addBankCoins(player, n)    permanent coins
	  Profiles.bankCoins(player) -> number
	  Profiles.onLoaded(fn)               fn(player, profile) after a profile has loaded

	Backend: Config.Profile.Backend ("Auto" = DataStore live, Memory in Studio). Saves happen
	on leave (and release the session lock), every Config.Profile.AutosaveInterval, and at
	shutdown (BindToClose). A profile that failed to load is never saved over.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.PartyShared.Config)
local Inventory = require(script.Parent.Inventory)
local DataStoreBackend = require(script.DataStoreBackend)
local MemoryBackend = require(script.MemoryBackend)
local ProfileStore = require(script.ProfileStore)

local Profiles = {}

Profiles.ProfileStore = ProfileStore
Profiles.MemoryBackend = MemoryBackend

function Profiles.chooseBackend(setting: string, isStudio: boolean): string
	if setting == "Auto" then
		return if isStudio then "Memory" else "DataStore"
	end
	return if setting == "DataStore" then "DataStore" else "Memory"
end

-- When DataStores can't be reached at all (e.g. an unpublished place), every profile loads
-- blank and is never saved: better than pretending to save, or crashing the server.
local UnavailableBackend = {
	read = function()
		error("DataStores are unavailable on this server")
	end,
	write = function()
		error("DataStores are unavailable on this server")
	end,
}

Profiles.backendName = Profiles.chooseBackend(Config.Profile.Backend, RunService:IsStudio())
local backend
if Profiles.backendName == "DataStore" then
	local ok, result = pcall(DataStoreBackend.new)
	if ok then
		backend = result
	else
		warn("[Profiles] DataStore unavailable, profiles won't save this session: " .. tostring(result))
		Profiles.backendName = "Unavailable"
		backend = UnavailableBackend
	end
else
	backend = MemoryBackend.new()
end
Profiles.store = ProfileStore.new(backend)

local loadedHooks: { (Player, any) -> () } = {}

function Profiles.onLoaded(fn: (Player, any) -> ())
	table.insert(loadedHooks, fn)
end

local function keyOf(player: Player): string
	return "player_" .. player.UserId
end

function Profiles.get(player: Player)
	return Profiles.store:get(keyOf(player))
end

function Profiles.bankCoins(player: Player): number
	local profile = Profiles.get(player)
	return if profile then profile.Coins else 0
end

function Profiles.addBankCoins(player: Player, amount: number): number
	return Profiles.store:addCoins(keyOf(player), amount)
end

local function onJoin(player: Player)
	local key = keyOf(player)
	local profile = Profiles.store:load(key)
	if not player.Parent then
		Profiles.store:release(key) -- left while loading
		return
	end
	-- Inventory edits these tables directly, so cosmetics bought in a match are saved too.
	Inventory.attach(key, profile.Owned, profile.Equipped)
	for _, hook in loadedHooks do
		task.spawn(hook, player, profile)
	end
end

function Profiles.start()
	Players.PlayerAdded:Connect(onJoin)
	for _, player in Players:GetPlayers() do
		task.spawn(onJoin, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		Profiles.store:release(keyOf(player))
	end)
	task.spawn(function()
		while true do
			task.wait(Config.Profile.AutosaveInterval)
			for _, key in Profiles.store:keys() do
				task.spawn(Profiles.store.save, Profiles.store, key)
			end
		end
	end)
	-- Shutdown: save and release everyone in parallel, and wait (Roblox allows ~30 s).
	game:BindToClose(function()
		local pending = 0
		for _, key in Profiles.store:keys() do
			pending += 1
			task.spawn(function()
				Profiles.store:release(key)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

return Profiles
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">DataStoreBackend</string>
            <string name="Source"><![CDATA[--[[
	DataStoreBackend
	Real saving through a Roblox DataStore, with:
	  * retries with backoff on every call (DataStores fail now and then)
	  * session locking: a profile is claimed by one server at a time. Each record is
	    { Data = <profile>, Session = { JobId, Time } }. Loading claims the lock; a lock held
	    by another live server is waited on, and only taken over once it is older than
	    LOCK_EXPIRY (that server crashed without releasing). Saves refuse if another server
	    has taken the lock, so a stale server can never overwrite newer data.
	  * every write goes through UpdateAsync (never SetAsync)

	The store is injected, so tests use a fake one: anything with UpdateAsync(key, fn).
	Profiles (init) picks this backend in live servers (see Config.Profile.Backend).
]]

local DataStoreBackend = {}
DataStoreBackend.__index = DataStoreBackend

DataStoreBackend.STORE_NAME = "PartyProfiles_v1"
DataStoreBackend.RETRIES = 4
DataStoreBackend.RETRY_DELAY = 1 -- seconds, doubled after every failed attempt
DataStoreBackend.LOCK_EXPIRY = 30 * 60 -- a lock not refreshed for this long is abandoned
DataStoreBackend.LOCK_WAIT = 6 -- seconds between checks while another server holds the lock
DataStoreBackend.LOCK_CHECKS = 3 -- checks before giving up on loading (player plays unsaved)

-- options: { Store, JobId, Now = function() -> seconds, Wait = function(seconds) }
function DataStoreBackend.new(options)
	options = options or {}
	local store = options.Store
	if not store then
		store = game:GetService("DataStoreService"):GetDataStore(DataStoreBackend.STORE_NAME)
	end
	return setmetatable({
		Store = store,
		JobId = options.JobId or (if game.JobId ~= "" then game.JobId else "studio"),
		Now = options.Now or os.time,
		Wait = options.Wait or task.wait,
	}, DataStoreBackend)
end

-- Runs fn with retries; errors only if every attempt failed.
function DataStoreBackend:retry(what: string, fn)
	local delay = DataStoreBackend.RETRY_DELAY
	local lastError
	for attempt = 1, DataStoreBackend.RETRIES do
		local ok, result = pcall(fn)
		if ok then
			return result
		end
		lastError = result
		if attempt < DataStoreBackend.RETRIES then
			self.Wait(delay)
			delay *= 2
		end
	end
	error(("%s failed after %d tries: %s"):format(what, DataStoreBackend.RETRIES, tostring(lastError)), 0)
end

local function lockedByOther(self, record): boolean
	local session = type(record) == "table" and record.Session
	return type(session) == "table"
		and session.JobId ~= self.JobId
		and self.Now() - (tonumber(session.Time) or 0) < DataStoreBackend.LOCK_EXPIRY
end

-- Loads a profile and claims its session lock. Errors if it can't (the caller then lets the
-- player play without saving rather than risk overwriting their data).
function DataStoreBackend:read(key: string)
	for check = 1, DataStoreBackend.LOCK_CHECKS do
		local blocked = false
		local data = self:retry("load " .. key, function()
			local result
			self.Store:UpdateAsync(key, function(record)
				if lockedByOther(self, record) then
					blocked = true
					return nil -- cancel: leave the record untouched
				end
				blocked = false
				record = if type(record) == "table" then record else {}
				result = record.Data
				record.Session = { JobId = self.JobId, Time = self.Now() }
				return record
			end)
			return result
		end)
		if not blocked then
			return data
		end
		if check < DataStoreBackend.LOCK_CHECKS then
			self.Wait(DataStoreBackend.LOCK_WAIT)
		end
	end
	error(("profile %s is in use on another server"):format(key), 0)
end

-- Saves (and refreshes our lock). release = true also drops the lock (player left).
function DataStoreBackend:write(key: string, data, release: boolean?)
	local refused = false
	self:retry("save " .. key, function()
		self.Store:UpdateAsync(key, function(record)
			if lockedByOther(self, record) then
				refused = true
				return nil
			end
			refused = false
			record = if type(record) == "table" then record else {}
			record.Data = data
			record.Session = if release then nil else { JobId = self.JobId, Time = self.Now() }
			return record
		end)
	end)
	if refused then
		error(("profile %s was taken over by another server; not saving"):format(key), 0)
	end
end

return DataStoreBackend
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">MemoryBackend</string>
            <string name="Source"><![CDATA[--[[
	MemoryBackend
	Keeps profiles in a Lua table: survives players leaving and rejoining the same server,
	gone when the server shuts down. Used in Studio and the unit tests.
]]

local ProfileStore = require(script.Parent.ProfileStore)

local MemoryBackend = {}
MemoryBackend.__index = MemoryBackend

function MemoryBackend.new()
	return setmetatable({ Data = {}, Writes = 0 }, MemoryBackend)
end

function MemoryBackend:read(key: string)
	return ProfileStore.deepCopy(self.Data[key])
end

function MemoryBackend:write(key: string, data, _release: boolean?)
	self.Writes += 1
	self.Data[key] = ProfileStore.deepCopy(data)
end

return MemoryBackend
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">ProfileStore</string>
            <string name="Source"><![CDATA[--[[
	ProfileStore
	Permanent per-player data, behind a swappable storage backend. Only things that should
	survive between matches and sessions live here:

	  Version    schema version (bump + handle in reconcile when the shape changes)
	  Coins      permanent "bank" coins (NOT match coins: those live in CoinService and reset)
	  Owned      { [cosmeticId] = true }
	  Equipped   { [slot] = cosmeticId }
	  Tutorial   { [flag] = true }  guided first actions already done (Config.Tutorial.Flags)

	Match coins, Crowns, board items and stats are never written here.

	A backend is any table with:
	  read(key)                 -> data table or nil (may yield; may error)
	  write(key, data, release) -> () (may yield; may error). release = the player is leaving
	MemoryBackend is used in Studio and tests; DataStoreBackend saves for real (retries,
	session locking).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("PartyShared"):WaitForChild("Config"))

local ProfileStore = {}
ProfileStore.__index = ProfileStore

-- 1: Coins, Owned, Equipped.  2: + Tutorial flags.
ProfileStore.Version = 2

function ProfileStore.template()
	return { Version = ProfileStore.Version, Coins = 0, Owned = {}, Equipped = {}, Tutorial = {} }
end

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, inner in value do
		copy[key] = deepCopy(inner)
	end
	return copy
end
ProfileStore.deepCopy = deepCopy

-- Fills in missing fields and drops anything malformed, so old or damaged saves still load.
function ProfileStore.reconcile(data)
	local profile = ProfileStore.template()
	if type(data) ~= "table" then
		return profile
	end
	if type(data.Coins) == "number" and data.Coins >= 0 then
		profile.Coins = math.floor(data.Coins)
	end
	if type(data.Owned) == "table" then
		for id, owned in data.Owned do
			if type(id) == "string" and owned == true then
				profile.Owned[id] = true
			end
		end
	end
	if type(data.Equipped) == "table" then
		for slot, id in data.Equipped do
			if type(slot) == "string" and type(id) == "string" and profile.Owned[id] then
				profile.Equipped[slot] = id
			end
		end
	end
	-- Version 1 saves have no Tutorial table: they start with every flag unset (the template).
	if type(data.Tutorial) == "table" then
		for _, flag in Config.Tutorial.Flags do
			if data.Tutorial[flag] == true then
				profile.Tutorial[flag] = true
			end
		end
	end
	return profile
end

function ProfileStore.new(backend)
	return setmetatable({ Backend = backend, Loaded = {} }, ProfileStore)
end

-- Loads (or creates) a profile. On a backend error the player gets a fresh profile that is
-- marked so it's never saved over their real data.
function ProfileStore:load(key: string)
	local ok, data = pcall(self.Backend.read, self.Backend, key)
	local profile = ProfileStore.reconcile(if ok then data else nil)
	local entry = { Data = profile, CanSave = ok }
	if not ok then
		warn(("[Profiles] Could not load %s, playing without saving: %s"):format(key, tostring(data)))
	end
	self.Loaded[key] = entry
	return profile
end

function ProfileStore:get(key: string)
	local entry = self.Loaded[key]
	return entry and entry.Data
end

function ProfileStore:save(key: string, release: boolean?): boolean
	local entry = self.Loaded[key]
	if not entry or not entry.CanSave then
		return false
	end
	local ok, err = pcall(self.Backend.write, self.Backend, key, deepCopy(entry.Data), release == true)
	if not ok then
		warn(("[Profiles] Could not save %s: %s"):format(key, tostring(err)))
	end
	return ok
end

-- Saves and forgets a profile (player left).
function ProfileStore:release(key: string): boolean
	local saved = self:save(key, true)
	self.Loaded[key] = nil
	return saved
end

-- Keys of every loaded profile (autosave / shutdown).
function ProfileStore:keys(): { string }
	local list = {}
	for key in self.Loaded do
		table.insert(list, key)
	end
	return list
end

-- Permanent bank coins (never negative).
function ProfileStore:addCoins(key: string, amount: number): number
	local profile = self:get(key)
	if not profile then
		return 0
	end
	profile.Coins = math.max(0, profile.Coins + math.floor(amount))
	return profile.Coins
end

return ProfileStore
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">ResultsUtil</string>
          <string name="Source"><![CDATA[--[[
	ResultsUtil
	Helpers for the ranked results table every minigame returns from GetResults().

	A results table is an array sorted best-first:
	    { { Participant = p, Placement = 1 }, { Participant = q, Placement = 2 }, ... }
	Ties share a placement using standard competition ranking (1, 1, 3, 4).
]]

local ResultsUtil = {}

-- Ranks participants by a score. Higher is better unless lowerIsBetter is true.
function ResultsUtil.fromScores(participants, scoreOf: (any) -> number, lowerIsBetter: boolean?)
	local entries = {}
	for index, participant in participants do
		table.insert(entries, { Participant = participant, Score = scoreOf(participant), Index = index })
	end
	table.sort(entries, function(a, b)
		if a.Score == b.Score then
			return a.Index < b.Index -- keep the sort deterministic
		end
		if lowerIsBetter then
			return a.Score < b.Score
		end
		return a.Score > b.Score
	end)

	local results = {}
	for i, entry in entries do
		local placement = i
		if i > 1 and entries[i - 1].Score == entry.Score then
			placement = results[i - 1].Placement
		end
		results[i] = { Participant = entry.Participant, Placement = placement }
	end
	return results
end

-- Survivors tie for 1st; everyone else ranks by how long they lasted (last out = best).
-- Participants knocked out in the same instant (e.g. two falling on one tick) tie.
function ResultsUtil.fromElimination(participants, round)
	return ResultsUtil.fromScores(participants, function(participant)
		return round.EliminatedAt[participant] or math.huge
	end)
end

-- Every member of winningTeam ties for 1st, everyone else ties for the next placement.
function ResultsUtil.fromTeams(participants, winningTeam: number)
	return ResultsUtil.fromScores(participants, function(participant)
		return if participant.Team == winningTeam then 1 else 0
	end)
end

--[[
	Makes whatever a minigame returned safe to use:
	  * drops entries for unknown participants and duplicates
	  * appends anyone missing (and anyone who left mid-round) at the bottom
	  * recomputes placements so they are consistent competition ranks
]]
function ResultsUtil.normalize(rawResults, participants)
	local known = {}
	for _, participant in participants do
		known[participant] = true
	end

	local seen = {}
	local entries = {}
	if type(rawResults) == "table" then
		for _, entry in rawResults do
			local participant = type(entry) == "table" and entry.Participant
			local placement = type(entry) == "table" and tonumber(entry.Placement)
			if participant and known[participant] and not seen[participant] and not participant.Left then
				seen[participant] = true
				table.insert(entries, { Participant = participant, Placement = placement or math.huge })
			end
		end
	end

	-- Missing participants share last place; leavers go below them.
	for _, participant in participants do
		if not seen[participant] then
			table.insert(entries, {
				Participant = participant,
				Placement = if participant.Left then math.huge else 1e6,
			})
		end
	end

	for i, entry in entries do
		entry.Order = i
	end
	table.sort(entries, function(a, b)
		if a.Placement == b.Placement then
			return a.Order < b.Order
		end
		return a.Placement < b.Placement
	end)

	local results = {}
	for i, entry in entries do
		local placement = i
		if i > 1 and entries[i - 1].Placement == entry.Placement then
			placement = results[i - 1].Placement
		end
		results[i] = { Participant = entry.Participant, Placement = placement }
	end
	return results
end

return ResultsUtil
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">RoundContext</string>
          <string name="Source"><![CDATA[--[[
	RoundContext
	The toolbox the framework hands to a minigame for one round (third argument of Setup,
	and stored on the minigame instance as self.Round). Minigames use it instead of
	touching framework internals:

	  round.Participants        all four participants (real players + bots)
	  round.Arena               the arena object (Folder / Origin / SpectatorCFrame)
	  round.Rng                 a Random for this round
	  round.EliminationOrder    participants in the order they were eliminated
	  round.EliminatedAt        participant -> server time they were eliminated

	  round:Eliminate(p)        mark p out and send them to the spectator box
	  round:IsEliminated(p)
	  round:GetAlive()          participants still in play
	  round:GetTeam(n)          participants on team n (1v3 / 2v2)
	  round:End()               finish the round early (e.g. one player left)
	  round:TimeLeft()
	  round:Toast(text)         short feed message on every client
	  round:SetStatus(text)     persistent HUD line on every client
	  round:ReportProgress(p, value, label?)
	                            update p's player chip (score / progress / lives / any short text)
]]

local Workspace = game:GetService("Workspace")

local RoundContext = {}
RoundContext.__index = RoundContext

function RoundContext.new(params)
	return setmetatable({
		Participants = params.Participants,
		Arena = params.Arena,
		Rng = Random.new(),
		EliminationOrder = {},
		EliminatedAt = {},
		Ended = false,
		EndReason = nil,
		EndsAt = math.huge,
		_eliminated = {},
		_broadcast = params.Broadcast,
		_setStatus = params.SetStatus,
		_onProgress = params.OnProgress,
		_onEliminated = params.OnEliminated,
	}, RoundContext)
end

function RoundContext:Eliminate(participant, silent: boolean?)
	if self._eliminated[participant] then
		return
	end
	self._eliminated[participant] = true
	table.insert(self.EliminationOrder, participant)
	self.EliminatedAt[participant] = Workspace:GetServerTimeNow()

	if participant:IsAlive() then
		local jitter = Vector3.new(self.Rng:NextNumber(-6, 6), 0, self.Rng:NextNumber(-6, 6))
		participant:Teleport(self.Arena.SpectatorCFrame + jitter)
		participant:ResetMovement() -- spectators may walk around the glass box
	end
	if not silent then
		self:Toast(("❌ %s is out!"):format(participant.Name))
	end
	self._onEliminated(participant)
end

function RoundContext:IsEliminated(participant): boolean
	return self._eliminated[participant] == true
end

function RoundContext:GetAlive()
	local alive = {}
	for _, participant in self.Participants do
		if not self._eliminated[participant] and not participant.Left then
			table.insert(alive, participant)
		end
	end
	return alive
end

function RoundContext:GetTeam(team: number)
	local members = {}
	for _, participant in self.Participants do
		if participant.Team == team then
			table.insert(members, participant)
		end
	end
	return members
end

function RoundContext:End(reason: string?)
	if not self.Ended then
		self.Ended = true
		self.EndReason = reason or "Ended"
	end
end

function RoundContext:TimeLeft(): number
	return math.max(0, self.EndsAt - Workspace:GetServerTimeNow())
end

function RoundContext:Toast(text: string)
	self._broadcast({ Type = "Toast", Text = text })
end

function RoundContext:SetStatus(text: string?)
	self._setStatus(text)
end

-- value: number or short string ("3 ❤️", "45%"). label: optional caption, defaults to
-- Info.ProgressLabel. Cheap to call every frame; updates are batched.
function RoundContext:ReportProgress(participant, value: number | string, label: string?)
	if type(value) == "number" then
		value = math.floor(value * 10 + 0.5) / 10 -- keep chips tidy
	end
	self._onProgress(participant, value, label)
end

return RoundContext
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">SeatClaims</string>
          <string name="Source"><![CDATA[--[[
	SeatClaims
	Seat reservations for players who leave a match and come back. When a real player
	leaves, their seat is reserved for their numeric UserId until the match ends; a bot keeps
	playing it meanwhile. If the same UserId rejoins, their claim is queued here and the
	running mode hands the seat back at a safe moment (see SeatClaims.timing).

	Pure bookkeeping, no networking or world, so it can be tested on its own. A `key` is
	whatever the mode uses to name a seat: the Match seat table (board) or a seat index
	(Minigames mode). Every check is by UserId, never by name.

	  local claims = SeatClaims.new()
	  claims:reserve(key, userId)    -> true if the seat is (now) reserved for that user
	  claims:keyFor(userId)          -> the seat reserved for them, or nil
	  claims:reservedFor(key)        -> the UserId a seat is reserved for, or nil
	  claims:request(player)         -> key?, code: a returning player asks for their seat
	      codes: "queued" | "bad_user" | "none" | "duplicate"
	  claims:pendingFor(key)         -> the player waiting to take that seat back, or nil
	  claims:consume(key)            forget the pending claim on that seat (done or refused)
	  claims:cancel(player)          that player left again before getting their seat
	  claims:clear()                 -> players still waiting (match over); forgets everything

	  SeatClaims.timing(stage, isTurnSeat) -> "now" | "after_turn" | "after_minigame" | "later"
]]

local SeatClaims = {}
SeatClaims.__index = SeatClaims

-- Board stages where no dice, movement, prompt, event or bridge rotation is in progress for
-- a seat that isn't taking its turn, so a seat can change hands right away.
SeatClaims.SAFE_STAGES = { Start = true, Roll = true, Landed = true, OrderDone = true, Standings = true }

-- Text the returning player sees for each timing.
SeatClaims.Messages = {
	now = "Welcome back! You're in your seat again.",
	after_turn = "Rejoining your seat when this turn ends.",
	after_minigame = "Rejoining your seat after this minigame.",
	later = "Rejoining your seat in a moment.",
	ended = "The match ended before you could rejoin your seat.",
}

-- Live accounts have positive UserIds; Studio's local-server test players have negative ones.
local function validUserId(id): boolean
	return type(id) == "number" and id ~= 0 and id % 1 == 0 and id == id
end

function SeatClaims.new()
	return setmetatable({
		ByUser = {}, -- [userId] = key
		ByKey = {}, -- [key] = userId
		Pending = {}, -- [userId] = Player waiting to take the seat back
	}, SeatClaims)
end

-- Reserving the same seat for the same user again is fine (they left a second time).
function SeatClaims:reserve(key, userId): boolean
	if key == nil or not validUserId(userId) then
		return false
	end
	local holder = self.ByKey[key]
	if holder ~= nil and holder ~= userId then
		return false -- one user per seat
	end
	local held = self.ByUser[userId]
	if held ~= nil and held ~= key then
		return false -- one seat per user
	end
	self.ByUser[userId] = key
	self.ByKey[key] = userId
	return true
end

function SeatClaims:keyFor(userId)
	return self.ByUser[userId]
end

function SeatClaims:reservedFor(key): number?
	return self.ByKey[key]
end

function SeatClaims:request(player)
	local userId = player and player.UserId
	if not validUserId(userId) then
		return nil, "bad_user"
	end
	local key = self.ByUser[userId]
	if key == nil then
		return nil, "none" -- a genuinely new late joiner: they watch until the next match
	end
	local queued = self.Pending[userId]
	if queued ~= nil and queued ~= player and queued.Parent ~= nil then
		return nil, "duplicate" -- an earlier session of the same user is still waiting
	end
	self.Pending[userId] = player
	return key, "queued"
end

-- Only a player whose UserId owns the reservation (and who is still in the game) counts.
function SeatClaims:pendingFor(key)
	local userId = self.ByKey[key]
	local player = userId and self.Pending[userId]
	if not player then
		return nil
	end
	if player.Parent == nil or player.UserId ~= userId then
		self.Pending[userId] = nil
		return nil
	end
	return player
end

function SeatClaims:consume(key)
	local userId = self.ByKey[key]
	if userId then
		self.Pending[userId] = nil
	end
end

function SeatClaims:cancel(player)
	local userId = player and player.UserId
	if userId and self.Pending[userId] == player then
		self.Pending[userId] = nil
	end
end

function SeatClaims:clear()
	local waiting = {}
	for _, player in self.Pending do
		table.insert(waiting, player)
	end
	table.clear(self.ByUser)
	table.clear(self.ByKey)
	table.clear(self.Pending)
	return waiting
end

--[[
	When a returning player may take their seat back on the board:
	  during a minigame (or a duel)        after it, before the next board turn
	  while it's their seat's turn         when that turn ends
	  any other seat's dice/move/prompt,
	  board event or bridge rotation       at the next safe stage
	  otherwise                            now
]]
function SeatClaims.timing(stage: string?, isTurnSeat: boolean): string
	if stage == "Minigame" then
		return "after_minigame"
	end
	if isTurnSeat then
		return "after_turn"
	end
	if stage and SeatClaims.SAFE_STAGES[stage] then
		return "now"
	end
	return "later"
end

return SeatClaims
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">Tutorial</string>
          <string name="Source"><![CDATA[--[[
	Tutorial
	Which guided first actions a real player has already done (Config.Tutorial.Flags). The
	client points at the right button while a flag is unset; the server sets a flag only when
	the matching action really went through (a roll was accepted, a route was picked...).

	  Tutorial.configure(getProfile, send)   Main wires in Profiles.get and MinigameManager.sendTo
	  Tutorial.complete(who, flag) -> bool   who = Player or Participant; bots are ignored
	  Tutorial.flags(player) -> { [flag] = true }
	  Tutorial.send(player)                  push the flags to that player's client
	  Tutorial.reset(player)                 development only (see README)

	Flags live in the profile (ProfileStore.Tutorial) and are saved with it. A player whose
	profile isn't available (still loading, or DataStores down) keeps flags for this session
	only, so the guidance still works and never repeats within the session.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("PartyShared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))

local Tutorial = {}

local known = {}
for _, flag in Config.Tutorial.Flags do
	known[flag] = true
end

local getProfile: (Player) -> any = function()
	return nil
end
local sendTo: ((Player, any) -> ())? = nil
local session: { [number]: { [string]: boolean } } = {} -- by UserId, when there's no profile

local function realPlayer(value): boolean
	return typeof(value) == "Instance" and value:IsA("Player")
end
local isPlayer = realPlayer

-- playerCheck: unit tests pass one that accepts their stand-in players.
function Tutorial.configure(profileGetter: (Player) -> any, sender: ((Player, any) -> ())?, playerCheck: ((any) -> boolean)?)
	getProfile = profileGetter
	sendTo = sender
	isPlayer = playerCheck or realPlayer
end

-- A Player, or a Participant that is a real player (bots and seats taken over by bots: nil).
local function playerOf(who): Player?
	if isPlayer(who) then
		return who
	end
	if type(who) == "table" and not who.IsBot and isPlayer(who.Player) then
		return who.Player
	end
	return nil
end

-- The table the flags are kept in: the profile's, or this session's.
local function store(player: Player): { [string]: boolean }
	local profile = getProfile(player)
	if type(profile) == "table" then
		if type(profile.Tutorial) ~= "table" then
			profile.Tutorial = {}
		end
		-- Anything done before the profile finished loading counts too.
		local early = session[player.UserId]
		if early then
			for flag in early do
				profile.Tutorial[flag] = true
			end
			session[player.UserId] = nil
		end
		return profile.Tutorial
	end
	session[player.UserId] = session[player.UserId] or {}
	return session[player.UserId]
end

function Tutorial.flags(player: Player): { [string]: boolean }
	local flags = {}
	for flag, done in store(player) do
		if known[flag] and done == true then
			flags[flag] = true
		end
	end
	return flags
end

function Tutorial.send(player: Player)
	if sendTo and player.Parent ~= nil then
		sendTo(player, { Type = Net.Message.Tutorial, Flags = Tutorial.flags(player) })
	end
end

-- Marks `flag` done. Returns true if it was newly set (and tells that player's client).
function Tutorial.complete(who, flag: string): boolean
	local player = playerOf(who)
	if not player or not known[flag] then
		return false
	end
	local flags = store(player)
	if flags[flag] then
		return false
	end
	flags[flag] = true
	Tutorial.send(player)
	return true
end

-- Development only: forget a player's flags (profile and session) so the guidance starts over.
function Tutorial.reset(player: Player)
	local profile = getProfile(player)
	if type(profile) == "table" then
		profile.Tutorial = {}
	end
	session[player.UserId] = nil
	Tutorial.send(player)
end

-- Profile just loaded: optional Studio reset, then send the saved flags.
function Tutorial.onProfileLoaded(player: Player, _profile)
	if Config.Tutorial.ResetInStudio and RunService:IsStudio() then
		Tutorial.reset(player)
	else
		Tutorial.send(player)
	end
end

Players.PlayerRemoving:Connect(function(player)
	session[player.UserId] = nil
end)

return Tutorial
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">WaitingRoom</string>
          <string name="Source"><![CDATA[--[[
	WaitingRoom
	The pre-match lobby: counts down, shows who's in, and lets the host (first player in
	the server) pick the match settings or start early. Empty seats are filled with bots
	when the match starts, so one player is enough.

	  WaitingRoom.run(getHost) -> settings { Mode, Rounds, Difficulty, Board } (yields)
	  WaitingRoom.handleInput(player, payload) -> true if it was a waiting-room input
	  WaitingRoom.applySetting(key, value) -> true if it was a legal choice (and applied it)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.PartyShared.Config)
local Net = require(ReplicatedStorage.PartyShared.Net)
local MinigameManager = require(script.Parent.MinigameManager)
local Tutorial = require(script.Parent.Tutorial)

local WaitingRoom = {}

-- What each board in the picker is called on screen (its DisplayName, e.g. "Sunny Loop").
function WaitingRoom.boardNames()
	local names = {}
	local folder = script.Parent:FindFirstChild("Board") and script.Parent.Board:FindFirstChild("Boards")
	for _, id in Config.Match.Boards do
		local module = folder and folder:FindFirstChild(id)
		local ok, data = pcall(function()
			return module and require(module)
		end)
		names[id] = if ok and type(data) == "table" and type(data.DisplayName) == "string" then data.DisplayName else id
	end
	return names
end

-- Kept between matches, so the host doesn't have to pick again.
local settings = {
	Mode = Config.Match.Mode,
	Rounds = Config.Match.BoardRounds,
	Difficulty = Config.Match.BotDifficulty,
	Board = Config.Match.Board,
}

-- Every setting the host can change, and its legal values.
local function choices()
	return {
		Mode = Config.Match.Modes,
		Rounds = Config.Match.BoardRoundChoices,
		Difficulty = Config.Match.BotDifficultyOrder,
		Board = Config.Match.Boards,
	}
end

local open = false
local changed = false
local startNow = false
local hostGetter: (() -> Player?)? = nil

local function publish(endsAt: number)
	local host = hostGetter and hostGetter()
	MinigameManager.setPhase(Net.Phase.Lobby, {
		Text = "Next match starting soon",
		EndsAt = endsAt,
		WaitingRoom = true,
		Settings = table.clone(settings),
		Choices = choices(),
		BoardNames = WaitingRoom.boardNames(),
		HostId = host and host.UserId,
		HostName = host and host.DisplayName,
		PlayerCount = math.min(#Players:GetPlayers(), Config.PlayersPerMatch),
		Seats = Config.PlayersPerMatch,
	})
end

function WaitingRoom.run(getHost: () -> Player?)
	hostGetter = getHost
	open = true
	startNow = false
	local endsAt = Workspace:GetServerTimeNow() + Config.Match.WaitingRoomDuration
	local playerCount = #Players:GetPlayers()
	local host = getHost()
	publish(endsAt)
	while Workspace:GetServerTimeNow() < endsAt and not startNow do
		task.wait(0.1)
		if changed or #Players:GetPlayers() ~= playerCount or getHost() ~= host then
			changed = false
			playerCount = #Players:GetPlayers()
			host = getHost()
			publish(endsAt)
		end
	end
	open = false
	return table.clone(settings)
end

function WaitingRoom.getSettings()
	return table.clone(settings)
end

function WaitingRoom.handleInput(player: Player, payload): boolean
	local kind = payload.Kind
	if kind ~= Net.Input.Setting and kind ~= Net.Input.StartMatch then
		return false
	end
	if not open or not hostGetter or hostGetter() ~= player then
		return true -- only the host, only while the waiting room is open
	end
	if kind == Net.Input.StartMatch then
		startNow = true
		Tutorial.complete(player, "StartedMatch")
	elseif WaitingRoom.applySetting(payload.Key, payload.Value) then
		changed = true
	end
	return true
end

function WaitingRoom.applySetting(key, value): boolean
	local legal = type(key) == "string" and choices()[key]
	if not legal or not table.find(legal, value) then
		return false
	end
	settings[key] = value
	return true
end

return WaitingRoom
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="57">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="58">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="59">
        <Properties>
          <string name="Name">PartyClient</string>
        </Properties>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">CameraController</string>
            <string name="Source"><![CDATA[--[[
	CameraController
	Per-player scripted camera for minigames. Every client runs its own, so each player
	gets their own view of the one shared world.

	  start(cameraConfig, arenaOrigin)   CameraType -> Scriptable, mode from Info.Camera
	  setSpectating(on)                  switch to the spectator orbit cam (eliminated / spectators)
	  setTargets(chips)                  who can be spectated (alive participants)
	  cycle(direction)                   next / previous spectate target
	  stop()                             restore the normal Roblox camera

	Modes (numbers come from Config.CameraModes, overridable per minigame):
	  AngledOverhead  fixed angle over the arena centre, drifting toward you by `Follow`
	  FollowBehind    chase cam behind your character
	  SideView        side-scroller; tracks you along the arena's RightVector (and up/down
	                  too with FollowY = true)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("PartyShared"):WaitForChild("Config"))

local CameraController = {}

local player = Players.LocalPlayer
local active = false
local params = nil
local arenaOrigin = CFrame.new()
local spectating = false
local targets = {} -- { { Id, Name, Character } }
local targetId = nil
local focus: Vector3? = nil
local heading: Vector3? = nil
local orbit = 0

local function myRoot(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function currentTarget()
	for _, target in targets do
		if target.Id == targetId then
			return target
		end
	end
	return targets[1]
end

function CameraController.start(cameraConfig, origin: CFrame)
	params = table.clone(cameraConfig)
	local touch = UserInputService.TouchEnabled and Config.TouchCamera[params.Mode]
	if touch then
		local zoom = params.TouchZoom or touch.Zoom -- a minigame can ask for its own phone zoom
		params.Height *= zoom
		params.Distance *= zoom
		params.LookAhead = params.TouchLookAhead or touch.LookAhead
	end
	arenaOrigin = origin
	active = true
	focus = nil
	heading = nil
	Workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
end

function CameraController.isActive(): boolean
	return active
end

function CameraController.setSpectating(on: boolean)
	if on and not spectating then
		focus = nil
	end
	spectating = on
end

function CameraController.isSpectating(): boolean
	return spectating
end

-- chips: the server's player-chip list; anyone not eliminated with a body can be watched.
function CameraController.setTargets(chips)
	targets = {}
	for _, chip in chips do
		if not chip.Eliminated and chip.Character and chip.Character.Parent then
			table.insert(targets, { Id = chip.Id, Name = chip.Name, Character = chip.Character })
		end
	end
	if not currentTarget() or currentTarget().Id ~= targetId then
		local first = targets[1]
		targetId = first and first.Id
	end
end

function CameraController.cycle(direction: number)
	if #targets == 0 then
		return
	end
	local index = 1
	for i, target in targets do
		if target.Id == targetId then
			index = i
		end
	end
	index = (index - 1 + direction) % #targets + 1
	targetId = targets[index].Id
	focus = nil
end

function CameraController.getTargetName(): string?
	local target = currentTarget()
	return target and target.Name
end

function CameraController.stop()
	if not active then
		return
	end
	active = false
	spectating = false
	local camera = Workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Custom
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

-- Per-frame camera placement ------------------------------------------------------------------

local function smoothTowards(goal: Vector3, rate: number, dt: number): Vector3
	if not focus then
		focus = goal
		return goal
	end
	local alpha = 1 - math.exp(-rate * dt)
	focus = (focus :: Vector3):Lerp(goal, alpha)
	return focus :: Vector3
end

local function spectatorCFrame(dt: number): CFrame
	local settings = Config.Spectator
	local target = currentTarget()
	local root = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
	local center = if root then root.Position else arenaOrigin.Position
	local point = smoothTowards(center, 5, dt)
	orbit += dt * settings.OrbitSpeed
	local offset = Vector3.new(math.sin(orbit) * settings.Distance, settings.Height, math.cos(orbit) * settings.Distance)
	return CFrame.lookAt(point + offset, point)
end

local function angledOverhead(dt: number): CFrame
	local center = arenaOrigin.Position
	local root = myRoot()
	local goal = if root then center:Lerp(root.Position, params.Follow) else center
	local point = smoothTowards(goal, params.Smooth, dt)
	local offset = arenaOrigin:VectorToWorldSpace(Vector3.new(0, params.Height, params.Distance))
	local aim = point + arenaOrigin:VectorToWorldSpace(Vector3.new(0, 0, -(params.LookAhead or 0)))
	return CFrame.lookAt(point + offset, aim)
end

local function followBehind(dt: number): CFrame
	local root = myRoot()
	if not root then
		return Workspace.CurrentCamera.CFrame
	end
	local point = smoothTowards(root.Position, params.Smooth, dt)
	-- Heading turns slower than the character so quick spins don't whip the camera.
	local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if look.Magnitude < 0.01 then
		look = Vector3.new(0, 0, -1)
	end
	heading = if heading then (heading :: Vector3):Lerp(look.Unit, 1 - math.exp(-3 * dt)) else look.Unit
	local back = (heading :: Vector3).Unit * -params.Distance + Vector3.new(0, params.Height, 0)
	return CFrame.lookAt(point + back, point + Vector3.new(0, 2, 0) + (heading :: Vector3).Unit * 6)
end

local function sideView(dt: number): CFrame
	local center = arenaOrigin.Position
	local right = arenaOrigin.RightVector
	local root = myRoot()
	local along = if root then (root.Position - center):Dot(right) else 0
	-- FollowY = true also rises and falls with you (e.g. climbing); otherwise height is fixed.
	local rise = if root and params.FollowY then root.Position.Y - center.Y else 0
	local point = smoothTowards(center + right * along + Vector3.new(0, rise, 0), params.Smooth, dt)
	-- Stand on the side the arena faces away from, so the arena's +RightVector is screen-right.
	local eye = point - arenaOrigin.LookVector * params.Distance + Vector3.new(0, params.Height, 0)
	return CFrame.lookAt(eye, point + Vector3.new(0, 2, 0))
end

local MODES = {
	AngledOverhead = angledOverhead,
	FollowBehind = followBehind,
	SideView = sideView,
}

RunService.RenderStepped:Connect(function(dt)
	if not active then
		return
	end
	local camera = Workspace.CurrentCamera
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable -- respawns reset it
	end
	if spectating then
		camera.CFrame = spectatorCFrame(dt)
	else
		local mode = MODES[params.Mode] or angledOverhead
		camera.CFrame = mode(dt)
	end
end)

return CameraController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">Controls</string>
            <string name="Source"><![CDATA[--[[
	Controls
	Applies a minigame's Info.Controls on this client:
	  * Actions -> keyboard key + gamepad button (ContextActionService) AND a big on-screen
	    button (ActionBar), so keyboard, controller and touch all work out of the box
	  * Move / Jump = false -> the default Roblox movement controls (thumbstick, WASD,
	    jump button) are switched off. The server enforces the same lock independently.

	Pressing anything only *sends an input*; the server decides what happens.
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")

local Controls = {}

local DEFAULT_GAMEPAD = { "ButtonX", "ButtonY", "ButtonB" }
local bound: { string } = {}
local current = nil -- the bound Info.Controls (nil when nothing is bound)
local actionBar = nil
local movementDisabled = false

-- Roblox's PlayerModule owns WASD / thumbstick / jump. It may not exist (e.g. custom setups).
local function getPlayerControls()
	local playerScripts = Players.LocalPlayer:FindFirstChild("PlayerScripts")
	local module = playerScripts and playerScripts:FindFirstChild("PlayerModule")
	if not module then
		return nil
	end
	local ok, playerModule = pcall(require, module)
	return ok and playerModule and playerModule:GetControls() or nil
end

local function keyCode(name: string?): EnumItem?
	if type(name) ~= "string" then
		return nil
	end
	local ok, item = pcall(function()
		return (Enum.KeyCode :: any)[name]
	end)
	return if ok then item else nil
end

-- The on-screen buttons live in UI/ActionBar; Main hands it over once at startup.
function Controls.setActionBar(bar)
	actionBar = bar
end

function Controls.bind(controls, send: (string) -> ())
	Controls.unbind()
	current = controls

	for index, action in controls.Actions do
		local bindName = "Party_" .. action.Action
		local inputs = {}
		for _, name in action.Keys or { action.Key } do
			local key = keyCode(name)
			if key then
				table.insert(inputs, key)
			end
		end
		for _, name in action.Gamepads or { action.Gamepad or DEFAULT_GAMEPAD[index] } do
			local pad = keyCode(name)
			if pad then
				table.insert(inputs, pad)
			end
		end
		ContextActionService:BindActionAtPriority(bindName, function(_, inputState)
			if inputState == Enum.UserInputState.Begin then
				send(action.Action)
			elseif inputState == Enum.UserInputState.End and action.Hold then
				send(action.Action .. "Stop")
			end
			return Enum.ContextActionResult.Sink
		end, false, Enum.ContextActionPriority.High.Value, table.unpack(inputs))
		table.insert(bound, bindName)
	end

	if actionBar then
		actionBar:show(controls.Actions, send, not controls.Move)
	end

	if not controls.Move or not controls.Jump then
		local playerControls = getPlayerControls()
		if playerControls and not controls.Move then
			playerControls:Disable()
			movementDisabled = true
		end
	end
end

-- The minigame controls bound right now, or nil (spectating, knocked out, between rounds).
function Controls.current()
	return current
end

function Controls.unbind()
	current = nil
	for _, bindName in bound do
		ContextActionService:UnbindAction(bindName)
	end
	table.clear(bound)
	if actionBar then
		actionBar:hide()
	end
	if movementDisabled then
		movementDisabled = false
		local playerControls = getPlayerControls()
		if playerControls then
			playerControls:Enable()
		end
	end
end

return Controls
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="62">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	Main (client entry point)
	Renders whatever state the server sends and forwards inputs. No game logic lives here:
	the client never decides who won, who has the potato, or when a round ends.
	It does own purely local presentation: this player's camera, UI and control bindings.
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = require(ReplicatedStorage:WaitForChild("PartyShared"):WaitForChild("Net"))
local CameraController = require(script.Parent:WaitForChild("CameraController"))
local Controls = require(script.Parent:WaitForChild("Controls"))
local Onboarding = require(script.Parent:WaitForChild("Onboarding"))
local UI = script.Parent:WaitForChild("UI")
local Theme = require(UI:WaitForChild("Theme"))
local ActionBar = require(UI:WaitForChild("ActionBar"))
local BoardView = require(UI:WaitForChild("BoardView"))
local GuidePointer = require(UI:WaitForChild("GuidePointer"))
local Hud = require(UI:WaitForChild("Hud"))
local InstructionsCard = require(UI:WaitForChild("InstructionsCard"))
local LobbyPanel = require(UI:WaitForChild("LobbyPanel"))
local PlayerChips = require(UI:WaitForChild("PlayerChips"))
local ProgressBar = require(UI:WaitForChild("ProgressBar"))
local ResultsScreen = require(UI:WaitForChild("ResultsScreen"))
local ShopScreen = require(UI:WaitForChild("ShopScreen"))
local SpectatorBar = require(UI:WaitForChild("SpectatorBar"))
local StandingsScreen = require(UI:WaitForChild("StandingsScreen"))
local VoteScreen = require(UI:WaitForChild("VoteScreen"))
local YouMarker = require(UI:WaitForChild("YouMarker"))

local player = Players.LocalPlayer
local myId = "player_" .. player.UserId
local stateRemote = Net.stateRemote()
local inputRemote = Net.inputRemote()

local onboarding -- guided first actions (made once the screens exist, below)

local function sendInput(payload)
	if onboarding then
		onboarding:noteInput(payload) -- the step this answers is done: drop the pointer now
	end
	inputRemote:FireServer(payload)
end

-- Some minigames run their own client code for the round (Info.ClientModule), e.g. Ice Dash
-- simulates your racer locally. Those modules live in the Minigames folder next to this script.
local minigameClients = script.Parent:FindFirstChild("Minigames")
local activeMinigameClient = nil

local function stopMinigameClient()
	if activeMinigameClient then
		local client = activeMinigameClient
		activeMinigameClient = nil
		client.stop()
	end
end

local function startMinigameClient(name: string?)
	stopMinigameClient()
	local module = name and minigameClients and minigameClients:FindFirstChild(name)
	if module and module:IsA("ModuleScript") then
		local ok, client = pcall(require, module)
		if ok and type(client) == "table" then
			activeMinigameClient = client
			client.start()
		else
			warn("[PartyClient] Could not load minigame client " .. tostring(name) .. ": " .. tostring(client))
		end
	end
end

local function sendAction(action: string)
	-- The minigame's client code gets first go; if it handles the action, the server needn't hear.
	if activeMinigameClient and activeMinigameClient.onAction and activeMinigameClient.onAction(action) then
		-- Sent by the minigame's own code; tell the server only while the tutorial still needs it.
		if onboarding and not onboarding:isDone("UsedMinigameAction") then
			sendInput({ Kind = Net.Input.ActionUsed, Action = action })
		end
		return
	end
	sendInput({ Kind = Net.Input.Action, Action = action })
end

-- Screens ---------------------------------------------------------------------------------

local screen = Theme.make("ScreenGui", {
	Name = "PartyUI",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	DisplayOrder = 10, -- draw the vote / results cards over the mobile thumbstick and jump button
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

local hud = Hud.new(screen)
local voteScreen = VoteScreen.new(screen, function(choice)
	sendInput({ Kind = Net.Input.Vote, Choice = choice })
end)
local instructions = InstructionsCard.new(screen)
local results = ResultsScreen.new(screen)
local chips = PlayerChips.new(screen)
local progressBar = ProgressBar.new(screen)
local spectatorBar
spectatorBar = SpectatorBar.new(screen, function(direction)
	CameraController.cycle(direction)
	spectatorBar:show(CameraController.getTargetName())
end)
Controls.setActionBar(ActionBar.new(screen))
local boardView = BoardView.new(screen, sendInput)
local lobbyPanel = LobbyPanel.new(screen, sendInput)
local shopScreen = ShopScreen.new(screen, sendInput)
lobbyPanel.OnShop = function()
	shopScreen:toggle()
end

local standings = StandingsScreen.new(screen)

-- Guided first actions: one bouncing pointer at a time, only for this player.
local playerGui = player:WaitForChild("PlayerGui")
onboarding = Onboarding.new({
	Guide = GuidePointer.new(playerGui),
	Lobby = lobbyPanel,
	Board = boardView,
	Shop = shopScreen,
	Screen = screen,
	PlayerGui = playerGui,
	Modals = { voteScreen.Root, instructions.Root, results.Root, standings.Root },
})

-- "YOU" over your own character while you're playing (only this client sees it).
local youMarker = YouMarker.new(function()
	return player.Character
end, playerGui)

-- The top/bottom HUD strips are sized in pixels for a desktop window. On a phone they would
-- cover almost half the screen, so shrink them (and their pixel offsets) with the viewport.
local HUD_STRIPS = {
	"Timer",
	"Status",
	"PlayerChips",
	"ProgressBar",
	"SpectatorBar",
	"Lobby",
	"BoardHeader",
	"BoardStandings",
	"BoardRoll",
	"BoardPrompt",
	"BoardItems",
	"BoardMap",
	"BoardMapPanel",
	"WaitingRoom",
	"CosmeticShop",
}
local HUD_DESIGN_HEIGHT = 720
-- Panels full of buttons would shrink below a tappable size; they don't go smaller than this.
local HUD_MIN_SCALE = { CosmeticShop = 0.85, WaitingRoom = 0.85, BoardPrompt = 0.75, BoardMap = 0.85, BoardMapPanel = 0.75 }
local hudBasePositions = {}

local function fitHudToScreen()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local baseScale = math.clamp(camera.ViewportSize.Y / HUD_DESIGN_HEIGHT, 0.55, 1)
	for _, name in HUD_STRIPS do
		local strip = screen:FindFirstChild(name)
		local scale = math.max(baseScale, HUD_MIN_SCALE[name] or 0)
		if strip and strip:IsA("GuiObject") then
			local base = hudBasePositions[name] or strip.Position
			hudBasePositions[name] = base
			local uiScale = strip:FindFirstChildOfClass("UIScale") or Theme.make("UIScale", { Parent = strip })
			uiScale.Scale = scale
			strip:SetAttribute("HudScale", scale) -- Theme.pop animates back to this, not to 1
			strip.Position = UDim2.new(base.X.Scale, base.X.Offset * scale, base.Y.Scale, base.Y.Offset * scale)
		end
	end
end

fitHudToScreen()
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fitHudToScreen)

-- While a full-screen card (vote, instructions, results) is up, the mobile thumbstick and
-- jump button are switched off entirely, so they can never sit on top of the card.
local function setCardOpen(open: boolean)
	pcall(function()
		GuiService.TouchControlsEnabled = not open
	end)
end

-- The shop takes the waiting-room card's place while it's open, and the mobile thumbstick and
-- jump button step aside so they never sit on top of it.
shopScreen.OnOpenChanged = function(open)
	lobbyPanel.Root.Visible = not open and lobbyPanel.LastMessage ~= nil and lobbyPanel.Showing == true
	setCardOpen(open)
end

local function hideOverlays()
	voteScreen:hide()
	instructions:hide()
	results:hide()
	standings:hide()
	setCardOpen(false)
end

local function isParticipant(participants): boolean
	for _, participant in participants or {} do
		if participant.Id == myId then
			return true
		end
	end
	return false
end

-- Round presentation state -----------------------------------------------------------------

local currentPhase = nil
local inRound = false -- true from Instructions until Results/Lobby
local amParticipant = false
local useProgressBar = false -- this minigame shows a race bar instead of the chip strip

local function showRoundHud()
	if useProgressBar then
		progressBar:show()
	else
		chips:show()
	end
end

local function beginRound(message)
	if inRound then
		return
	end
	inRound = true
	amParticipant = isParticipant(message.Participants)
	useProgressBar = message.Minigame.ProgressBar == true
	startMinigameClient(message.Minigame.ClientModule)
	CameraController.start(message.Minigame.Camera, message.ArenaOrigin)
	CameraController.setSpectating(not amParticipant)
end

local function endRound()
	inRound = false
	onboarding:setMinigame(nil)
	stopMinigameClient()
	Controls.unbind()
	CameraController.stop()
	spectatorBar:hide()
	chips:hide()
	progressBar:hide()
end

local function refreshSpectator()
	if CameraController.isActive() and CameraController.isSpectating() then
		spectatorBar:show(CameraController.getTargetName())
	else
		spectatorBar:hide()
	end
end

local function onChips(list)
	if not inRound then
		return
	end
	chips:update(list, myId)
	progressBar:update(list, myId)
	CameraController.setTargets(list)
	for _, chip in list do
		if chip.Id == myId and chip.Eliminated and not CameraController.isSpectating() then
			-- Knocked out: lose the controls, switch to the spectator camera.
			Controls.unbind()
			CameraController.setSpectating(true)
			hud:showBanner("ELIMINATED", Theme.Colors.Hot, 1.2)
		end
	end
	refreshSpectator()
end

-- Phase handlers ------------------------------------------------------------------------------

local Phase = Net.Phase
local phaseHandlers = {}

phaseHandlers[Phase.Lobby] = function(message)
	hideOverlays()
	endRound()
	boardView:hide()
	hud:setTimer(nil)
	hud:setStatus(nil)
	if message.WaitingRoom then
		hud:setLobby(nil)
		lobbyPanel.Showing = true
		lobbyPanel:show(message)
		shopScreen:setAvailable(true)
		if shopScreen.Open then
			lobbyPanel.Root.Visible = false
		end
	else
		lobbyPanel.Showing = false
		lobbyPanel:hide()
		shopScreen:setAvailable(false)
		hud:setLobby(message.Text or "Lobby", message.EndsAt)
	end
end

phaseHandlers[Phase.Board] = function(_message)
	hideOverlays()
	lobbyPanel.Showing = false
	shopScreen:setAvailable(false)
	endRound()
	lobbyPanel:hide()
	hud:setLobby(nil)
	hud:setTimer(nil)
	hud:setStatus(nil)
	setCardOpen(true) -- no walking on the board: hide the thumbstick so the roll button is clear
	boardView:show()
end

phaseHandlers[Phase.Standings] = function(message)
	hideOverlays()
	lobbyPanel.Showing = false
	shopScreen:setAvailable(false)
	endRound()
	lobbyPanel:hide()
	boardView:show()
	boardView:hidePanels()
	hud:clearToasts()
	setCardOpen(true)
	standings:show(message, myId)
end

phaseHandlers[Phase.Vote] = function(message)
	hideOverlays()
	lobbyPanel.Showing = false
	shopScreen:setAvailable(false)
	boardView:hide()
	lobbyPanel:hide()
	hud:setLobby(nil)
	setCardOpen(true)
	voteScreen:show(message.Choices, message.EndsAt)
end

phaseHandlers[Phase.Instructions] = function(message)
	hideOverlays()
	boardView:hide() -- duels from a board space skip the vote, so the board HUD goes here too
	hud:setLobby(nil)
	setCardOpen(true)
	instructions:show(message.Minigame, message.Participants, message.EndsAt, myId)
	beginRound(message)
	if not amParticipant then
		hud:setStatus("👀 Spectating this round")
	end
	refreshSpectator()
end

phaseHandlers[Phase.Countdown] = function(message)
	hideOverlays()
	showRoundHud() -- not during Instructions: the strip would sit on top of the card
	hud:showBanner(tostring(message.Number), nil, 0.7)
end

phaseHandlers[Phase.Playing] = function(message)
	hideOverlays()
	beginRound(message) -- no-op normally; covers joining mid-round
	showRoundHud()
	hud:showBanner("GO!", Theme.Colors.Good, 0.8)
	hud:setTimer(message.EndsAt)
	if amParticipant and not CameraController.isSpectating() then
		Controls.bind(message.Minigame.Controls, sendAction)
	end
	onboarding:setMinigame({
		Playing = true,
		Participant = amParticipant,
		Controls = message.Minigame.Controls,
		Spectating = CameraController.isSpectating,
		Bound = function()
			return Controls.current() ~= nil
		end,
	})
end

phaseHandlers[Phase.Finished] = function(_message)
	onboarding:setMinigame(nil)
	stopMinigameClient() -- hand the bodies back to the server before it sends everyone home
	Controls.unbind()
	hud:setTimer(nil)
	hud:showBanner("FINISH!", Theme.Colors.Hot, 1.5)
end

phaseHandlers[Phase.Results] = function(message)
	hideOverlays()
	endRound() -- everyone is back in the lobby: normal camera + controls
	hud:setStatus(nil)
	hud:clearToasts()
	setCardOpen(true)
	results:show(message.Minigame, message.Results, myId)
end

-- Message routing ------------------------------------------------------------------------------

stateRemote.OnClientEvent:Connect(function(message)
	if type(message) ~= "table" then
		return
	end
	if message.Type == Net.Message.Phase then
		local handler = phaseHandlers[message.Phase]
		if handler then
			currentPhase = message.Phase
			handler(message)
		end
	elseif message.Type == Net.Message.VoteUpdate then
		voteScreen:updateCounts(message.Counts, message.Voters)
	elseif message.Type == Net.Message.Status then
		hud:setStatus(message.Text)
	elseif message.Type == Net.Message.Toast then
		hud:toast(message.Text)
	elseif message.Type == Net.Message.Chips then
		onChips(message.Chips)
	elseif message.Type == Net.Message.BoardLayout then
		boardView:setLayout(message)
	elseif message.Type == Net.Message.BoardState then
		boardView:setState(message)
	elseif message.Type == Net.Message.Prompt then
		boardView:showPrompt(message)
	elseif message.Type == Net.Message.Inventory then
		lobbyPanel:setInventory(message)
		shopScreen:setInventory(message)
	elseif message.Type == Net.Message.ShopResult then
		shopScreen:showResult(message)
	elseif message.Type == Net.Message.Tutorial then
		onboarding:setFlags(message.Flags)
	end
end)

local function amSeatedOnBoard(): boolean
	for _, seat in (boardView.State and boardView.State.Seats) or {} do
		if seat.Id == myId then
			return true
		end
	end
	return false
end

-- YOU marker: on the board while you hold a seat, in a minigame while you're playing it (not
-- spectating, not knocked out); never while a full-screen card is up.
local function youMarkerWanted(): boolean
	local cardOpen = false
	for _, card in { voteScreen.Root, instructions.Root, results.Root, standings.Root } do
		cardOpen = cardOpen or card.Visible
	end
	return YouMarker.shouldShow({
		CardOpen = cardOpen,
		Phase = currentPhase,
		InRound = inRound,
		Participant = amParticipant,
		Spectating = CameraController.isSpectating(),
		OnBoard = boardView.Visible and boardView.Header.Visible,
		Seated = amSeatedOnBoard(),
	})
end

RunService.RenderStepped:Connect(function()
	hud:update()
	voteScreen:update()
	instructions:update()
	boardView:update()
	lobbyPanel:update()
	onboarding:update()
	youMarker:setActive(youMarkerWanted())
	youMarker:update()
end)

-- Ask for the current state in case we joined mid-round.
sendInput({ Kind = Net.Input.Ready })
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="63">
          <Properties>
            <string name="Name">Minigames</string>
          </Properties>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">BumperBout</string>
              <string name="Source"><![CDATA[--[[
	Bumper Bout (client side)
	  * DASH sends the direction you're steering in (stick / WASD, world space) so the lunge
	    goes where you mean; standing still, the server uses the way you face. The server
	    checks the request and drives the lunge itself.
	  * When the server accepts a dash it says how long the cooldown is; the DASH button
	    gets a dark shade that drains away until you can dash again.

	Main starts and stops this module (Info.ClientModule = "BumperBout").
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("PartyShared")
local Net = require(Shared:WaitForChild("Net"))

local BumperBoutClient = {}

local player = Players.LocalPlayer
local running = false
local connections = {}
local shade = nil -- the cooldown overlay on the DASH button
local readyAt, cooldown = 0, 1

local function dashButton(): GuiObject?
	local gui = player:FindFirstChild("PlayerGui")
	local ui = gui and gui:FindFirstChild("PartyUI")
	return ui and ui:FindFirstChild("Action_Dash", true) :: GuiObject?
end

local function clearShade()
	if shade then
		shade:Destroy()
		shade = nil
	end
end

local function showCooldown(seconds: number)
	cooldown = math.max(seconds, 0.1)
	readyAt = os.clock() + cooldown
	local button = dashButton()
	if not button then
		return
	end
	clearShade()
	shade = Instance.new("Frame")
	shade.Name = "Cooldown"
	shade.AnchorPoint = Vector2.new(0.5, 1)
	shade.Position = UDim2.fromScale(0.5, 1)
	shade.Size = UDim2.fromScale(1, 1)
	shade.BackgroundColor3 = Color3.new(0, 0, 0)
	shade.BackgroundTransparency = 0.45
	shade.BorderSizePixel = 0
	shade.ZIndex = (button.ZIndex or 1) + 5
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = shade
	shade.Parent = button
end

function BumperBoutClient.start()
	BumperBoutClient.stop()
	running = true
	table.insert(
		connections,
		Net.minigameRemote().OnClientEvent:Connect(function(message)
			if type(message) == "table" and message.Type == "Cooldown" and type(message.Seconds) == "number" then
				showCooldown(message.Seconds)
			end
		end)
	)
	table.insert(
		connections,
		RunService.RenderStepped:Connect(function()
			if shade then
				local left = readyAt - os.clock()
				if left <= 0 then
					clearShade()
				else
					shade.Size = UDim2.fromScale(1, left / cooldown)
				end
			end
		end)
	)
end

function BumperBoutClient.stop()
	running = false
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	clearShade()
end

-- DASH: send it with the direction I'm steering. Returns true: handled here.
function BumperBoutClient.onAction(action: string): boolean
	if not running or action ~= "Dash" then
		return false
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local direction = humanoid and humanoid.MoveDirection or Vector3.zero
	Net.minigameRemote():FireServer({ Type = "Dash", X = direction.X, Z = direction.Z })
	return true
end

return BumperBoutClient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">IceDash</string>
              <string name="Source"><![CDATA[--[[
	Ice Dash (client side)
	Keeps the race smooth whatever the connection is like:

	  * Your own racer is simulated right here with the shared rules (PartyShared.IceDashSim),
	    so steering responds on the very next frame. Your state is reported to the server
	    ~20 times a second; the server checks it and can snap you back ("Correct").
	  * Every other racer is drawn a moment in the past, gliding between the snapshots the
	    server broadcasts, so they move every frame even though news of them arrives in bursts.

	The server anchors every body for the race; this module places them each frame, just
	before the camera updates. Nothing here decides who wins: the server does.

	Main starts and stops this module (Info.ClientModule = "IceDash").
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("PartyShared")
local Net = require(Shared:WaitForChild("Net"))
local Sim = require(Shared:WaitForChild("IceDashSim"))

local IceDashClient = {}

-- Tuning ----------------------------------------------------------------------------------

local REPORT_RATE = 20 -- state reports sent to the server per second
local INTERPOLATION_DELAY = 0.15 -- seconds in the past other racers are drawn (3 snapshots' worth)
local MAX_EXTRAPOLATION = 0.25 -- seconds to keep a racer coasting when snapshots stop arriving
local SNAPSHOT_HISTORY = 40
local BIND_NAME = "PartyIceDashClient"

local player = Players.LocalPlayer
local myId = "player_" .. player.UserId

local running = false
local connections = {}
local layout = nil
local frame = CFrame.new()
local bodies = {} -- [id] = { Character, RideHeight, Lane }
local mine = nil -- my racer (IceDashSim state), nil if I'm only watching
local left, right = false, false
local raceTime = 0 -- seconds my racer has been simulated; sent with every report
local reportTimer = 0
local snapshots = {} -- oldest first: { T = server clock, R = { [id] = { X, S, VX, VS, Fall } } }
local playback = nil -- server-clock time currently being drawn for other racers
local lastStepAt = 0 -- os.clock() of the last simulation step

local function trackCFrame(x: number, y: number, s: number): CFrame
	return frame * CFrame.new(x, y, -s)
end

local function place(body, x: number, s: number, vx: number, drop: number)
	local character = body.Character
	if character and character.Parent then
		local lean = math.clamp(vx / Sim.MAX_SIDE_SPEED, -1, 1) * 0.3
		character:PivotTo(trackCFrame(x, body.RideHeight - drop, s) * CFrame.Angles(0, 0, -lean))
	end
end

-- Where a racer was at server time `t`, blending the two snapshots around it.
local function sample(id: string, t: number)
	local before, after
	for index = #snapshots, 1, -1 do
		local snapshot = snapshots[index]
		if snapshot.R[id] then
			if snapshot.T <= t then
				before = snapshot
				break
			end
			after = snapshot
		end
	end
	if before and after then
		local a, b = before.R[id], after.R[id]
		-- A respawn is a teleport, not something to glide through.
		if math.abs(b.S - a.S) > 25 then
			return b
		end
		local alpha = (t - before.T) / math.max(after.T - before.T, 1e-3)
		return {
			X = a.X + (b.X - a.X) * alpha,
			S = a.S + (b.S - a.S) * alpha,
			VX = a.VX + (b.VX - a.VX) * alpha,
			VS = b.VS,
			Fall = if a.Fall >= 0 and b.Fall >= 0 then a.Fall + (b.Fall - a.Fall) * alpha else b.Fall,
		}
	end
	if before then
		-- Ran out of news: coast on the last known velocity for a moment.
		local state = before.R[id]
		local ahead = math.min(t - before.T, MAX_EXTRAPOLATION)
		if state.Fall >= 0 then
			return state
		end
		return { X = state.X + state.VX * ahead, S = state.S + state.VS * ahead, VX = state.VX, VS = state.VS, Fall = -1 }
	end
	return after and after.R[id]
end

local function fallDrop(fallTime: number): number
	return if fallTime >= 0 then math.min(18, 40 * fallTime * fallTime) else 0
end

local function step(dt: number)
	if not running or not layout then
		return
	end
	dt = math.min(dt, 0.1)
	lastStepAt = os.clock()

	-- Other racers: a steady clock that trails the newest snapshot by INTERPOLATION_DELAY.
	local newest = snapshots[#snapshots]
	local others = {}
	if newest then
		local target = newest.T - INTERPOLATION_DELAY
		if not playback or math.abs(target - playback) > 0.5 then
			playback = target
		else
			playback += dt
			playback += (target - playback) * math.min(1, dt * 2) -- ease out any drift
		end
		for id, body in bodies do
			if not (mine and id == myId) then
				local state = sample(id, playback)
				if state then
					place(body, state.X, state.S, state.VX, fallDrop(state.Fall))
					if state.Fall < 0 then
						table.insert(others, { X = state.X, S = state.S, VX = state.VX, VS = state.VS, State = "Racing" })
					end
				end
			end
		end
	end

	-- My racer: simulated here, right now.
	if mine then
		local steer = (if right then 1 else 0) - (if left then 1 else 0)
		-- Small fixed-size steps keep fast frames and slow frames behaving the same.
		local remaining = dt
		while remaining > 1e-4 do
			local slice = math.min(remaining, 1 / 60)
			Sim.step(layout, mine, steer, slice)
			remaining -= slice
		end
		for _, other in others do
			Sim.collide(mine, other, true, false)
		end
		raceTime += dt
		local body = bodies[myId]
		if body then
			place(body, mine.X, mine.S, mine.VX, Sim.fallDrop(mine))
		end

		reportTimer += dt
		if reportTimer >= 1 / REPORT_RATE then
			reportTimer = 0
			Net.minigameFastRemote():FireServer({ T = raceTime, X = mine.X, S = mine.S, VX = mine.VX, VS = mine.VS })
		end
	end
end

local function onSetup(message)
	layout = message.Layout
	frame = message.Frame
	bodies = {}
	mine = nil
	for _, racer in message.Racers do
		bodies[racer.Id] = { Character = racer.Character, RideHeight = racer.RideHeight, Lane = racer.Lane }
		if racer.Id == myId then
			mine = Sim.newRacer(racer.Lane)
		end
	end
	raceTime = 0
	reportTimer = 0
end

local function onCorrect(message)
	if not mine then
		return
	end
	mine.X, mine.S, mine.VX, mine.VS = message.X, message.S, message.VX, message.VS
	mine.Checkpoint = message.Checkpoint
	if message.State == "Racing" and mine.State == "Falling" then
		mine.State = "Racing"
		mine.FallTime = 0
	end
end

local function onSnapshot(message)
	if type(message) ~= "table" or type(message.T) ~= "number" or type(message.R) ~= "table" then
		return
	end
	-- The fast channel can deliver out of order: ignore anything older than what we have.
	local newest = snapshots[#snapshots]
	if newest and message.T <= newest.T then
		return
	end
	local racers = {}
	for _, entry in message.R do
		racers[entry[1]] = { X = entry[2], S = entry[3], VX = entry[4], VS = entry[5], Fall = entry[6] }
	end
	table.insert(snapshots, { T = message.T, R = racers })
	if #snapshots > SNAPSHOT_HISTORY then
		table.remove(snapshots, 1)
	end
end

-- Interface (called by Main) -------------------------------------------------------------------

function IceDashClient.start()
	IceDashClient.stop()
	running = true
	layout = nil
	mine = nil
	left, right = false, false
	snapshots = {}
	playback = nil
	table.insert(
		connections,
		Net.minigameRemote().OnClientEvent:Connect(function(message)
			if type(message) ~= "table" then
				return
			end
			if message.Type == "Setup" then
				onSetup(message)
			elseif message.Type == "Correct" then
				onCorrect(message)
			end
		end)
	)
	table.insert(connections, Net.minigameFastRemote().OnClientEvent:Connect(onSnapshot))
	-- Just before the camera, so the chase cam follows this frame's position.
	RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value - 5, step)
	-- Render steps stop when the window isn't being drawn (minimised, display asleep). Keep
	-- the racer going from Heartbeat in that case, or it would sit still until you came back.
	table.insert(
		connections,
		RunService.Heartbeat:Connect(function(dt)
			if os.clock() - lastStepAt > 0.25 then
				step(dt)
			end
		end)
	)
end

function IceDashClient.stop()
	if not running then
		return
	end
	running = false
	RunService:UnbindFromRenderStep(BIND_NAME)
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	layout = nil
	mine = nil
	bodies = {}
	snapshots = {}
end

-- A steer button went down or up. Returns true: handled here, nothing to send to the server.
function IceDashClient.onAction(action: string): boolean
	if action == "Left" then
		left = true
	elseif action == "LeftStop" then
		left = false
	elseif action == "Right" then
		right = true
	elseif action == "RightStop" then
		right = false
	end
	return true
end

return IceDashClient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">PoleShimmy</string>
              <string name="Source"><![CDATA[--[[
	Pole Shimmy (client side)
	  * Stamps each LEFT / RIGHT press with this client's race clock and sends it to the server,
	    which replays it through the shared rules (PartyShared.PoleShimmySim) and decides
	    everything that counts.
	  * Meanwhile runs the same rules locally so your climber moves on the very next frame,
	    and nudges it back onto the server's heights whenever they disagree (a dropped press,
	    say).
	  * Draws everyone else a moment in the past, gliding between the server's snapshots.

	Main starts and stops this module (Info.ClientModule = "PoleShimmy").
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("PartyShared")
local Net = require(Shared:WaitForChild("Net"))
local Sim = require(Shared:WaitForChild("PoleShimmySim"))

local PoleShimmyClient = {}

-- Tuning ----------------------------------------------------------------------------------

local INTERPOLATION_DELAY = 0.15 -- seconds in the past other climbers are drawn
local MAX_EXTRAPOLATION = 0.25 -- seconds to keep a climber moving when snapshots stop
local CORRECTION_RATE = 0.5 -- share of a disagreement with the server fixed per snapshot ...
local MAX_CORRECTION = 0.25 -- ... but never more than this many studs at once, so it can't jump
local SWAY = 0.12 -- radians of side-to-side lean per hand
local SNAPSHOT_HISTORY = 40
local BIND_NAME = "PartyPoleShimmyClient"

local myId = "player_" .. Players.LocalPlayer.UserId

local running = false
local connections = {}
local bodies = {} -- [id] = { Character, Base, RideHeight }
local mine = nil -- my climber (local prediction), nil if I'm only watching
local raceTime = 0
local history = {} -- my predicted { T = race time, H = height }, oldest first
local snapshots = {} -- { T = server clock, R = { [id] = { H, Time, Left } } }
local playback = nil
local lastStepAt = 0

local function place(body, height: number, leftHand: boolean?)
	local character = body.Character
	if character and character.Parent then
		local sway = if leftHand == nil then 0 elseif leftHand then SWAY else -SWAY
		character:PivotTo(body.Base * CFrame.new(0, body.RideHeight + height, 0) * CFrame.Angles(0, 0, sway))
	end
end

-- Height of climber `id` at server time `t`, blending the snapshots around it.
local function sample(id: string, t: number)
	local before, after
	for index = #snapshots, 1, -1 do
		local snapshot = snapshots[index]
		if snapshot.R[id] then
			if snapshot.T <= t then
				before = snapshot
				break
			end
			after = snapshot
		end
	end
	if before and after then
		local a, b = before.R[id], after.R[id]
		local alpha = (t - before.T) / math.max(after.T - before.T, 1e-3)
		return a.H + (b.H - a.H) * alpha, if alpha < 0.5 then a.Left else b.Left
	end
	if before then
		-- No newer news: keep going at the last known climbing speed for a moment.
		local previous
		for index = #snapshots, 1, -1 do
			if snapshots[index] ~= before and snapshots[index].T < before.T and snapshots[index].R[id] then
				previous = snapshots[index]
				break
			end
		end
		local state = before.R[id]
		if previous then
			local speed = (state.H - previous.R[id].H) / math.max(before.T - previous.T, 1e-3)
			return math.min(Sim.POLE_HEIGHT, state.H + speed * math.min(t - before.T, MAX_EXTRAPOLATION)), state.Left
		end
		return state.H, state.Left
	end
	if after then
		return after.R[id].H, after.R[id].Left
	end
	return nil
end

-- My predicted height at race time `t` (from the recent history).
local function predictedAt(t: number): number?
	for index = #history, 2, -1 do
		local a, b = history[index - 1], history[index]
		if a.T <= t and t <= b.T then
			return a.H + (b.H - a.H) * (t - a.T) / math.max(b.T - a.T, 1e-4)
		end
	end
	return nil
end

local function step(dt: number)
	if not running or not next(bodies) then
		return
	end
	dt = math.min(dt, 0.1)
	lastStepAt = os.clock()

	-- Everyone else: a steady clock trailing the newest snapshot.
	local newest = snapshots[#snapshots]
	if newest then
		local target = newest.T - INTERPOLATION_DELAY
		if not playback or math.abs(target - playback) > 0.5 then
			playback = target
		else
			playback += dt
			playback += (target - playback) * math.min(1, dt * 2)
		end
		for id, body in bodies do
			if not (mine and id == myId) then
				local height, leftHand = sample(id, playback)
				if height then
					place(body, height, leftHand)
				end
			end
		end
	end

	-- Me: predicted right here.
	if mine then
		raceTime += dt
		Sim.advance(mine, raceTime)
		table.insert(history, { T = raceTime, H = mine.Height })
		while history[1] and raceTime - history[1].T > 3 do
			table.remove(history, 1)
		end
		local body = bodies[myId]
		if body then
			place(body, mine.Height, if mine.LastKey then mine.LastKey == "Left" else nil)
		end
	end
end

local function onSetup(message)
	bodies = {}
	mine = nil
	for _, climber in message.Climbers do
		bodies[climber.Id] = { Character = climber.Character, Base = climber.Base, RideHeight = climber.RideHeight }
		if climber.Id == myId then
			mine = Sim.newClimber()
		end
	end
	raceTime = 0
	history = {}
end

local function onSnapshot(message)
	if type(message) ~= "table" or type(message.T) ~= "number" or type(message.R) ~= "table" then
		return
	end
	local newest = snapshots[#snapshots]
	if newest and message.T <= newest.T then
		return -- out of order
	end
	local climbers = {}
	for _, entry in message.R do
		climbers[entry[1]] = { H = entry[2], Time = entry[3], Left = entry[4] }
	end
	table.insert(snapshots, { T = message.T, R = climbers })
	if #snapshots > SNAPSHOT_HISTORY then
		table.remove(snapshots, 1)
	end

	-- Keep my prediction honest: compare with what the server had for the same race time.
	local official = mine and climbers[myId]
	if official and not mine.FinishedAt then
		local predicted = predictedAt(official.Time)
		if predicted then
			local error = official.H - predicted
			if math.abs(error) > 0.05 then
				local nudge = math.clamp(error * CORRECTION_RATE, -MAX_CORRECTION, MAX_CORRECTION)
				mine.Height = math.clamp(mine.Height + nudge, 0, Sim.POLE_HEIGHT)
			end
		end
	end
end

-- Interface (called by Main) -------------------------------------------------------------------

function PoleShimmyClient.start()
	PoleShimmyClient.stop()
	running = true
	bodies = {}
	mine = nil
	snapshots = {}
	playback = nil
	table.insert(
		connections,
		Net.minigameRemote().OnClientEvent:Connect(function(message)
			if type(message) == "table" and message.Type == "Setup" then
				onSetup(message)
			end
		end)
	)
	table.insert(connections, Net.minigameFastRemote().OnClientEvent:Connect(onSnapshot))
	RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value - 5, step)
	-- Keep the clock running even while the window isn't being drawn.
	table.insert(
		connections,
		RunService.Heartbeat:Connect(function(dt)
			if os.clock() - lastStepAt > 0.25 then
				step(dt)
			end
		end)
	)
end

function PoleShimmyClient.stop()
	if not running then
		return
	end
	running = false
	RunService:UnbindFromRenderStep(BIND_NAME)
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	bodies = {}
	mine = nil
	snapshots = {}
	history = {}
end

-- LEFT / RIGHT pressed. Returns true: handled here (sent with a timestamp below).
function PoleShimmyClient.onAction(action: string): boolean
	if action ~= "Left" and action ~= "Right" then
		return false
	end
	if mine then
		Sim.press(mine, action, raceTime)
		Net.minigameRemote():FireServer({ Type = "Press", Key = action, T = raceTime })
	end
	return true
end

return PoleShimmyClient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">TrailTangle</string>
              <string name="Source"><![CDATA[--[[
	Trail Tangle (client side)
	Presentation only. The server decides every move; it sends one small "Tick" message per
	grid step with each rider's cell, heading and whether they're still in. Here the riders
	glide from their previous cell to the new one over that step's length, so nobody visibly
	hops cell to cell. Bodies are anchored by the server; this module positions them every
	frame just before the camera updates.

	Main starts and stops this module (Info.ClientModule = "TrailTangle"). Turn buttons go
	straight to the server (onAction returns false).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("PartyShared")
local Net = require(Shared:WaitForChild("Net"))

local TrailTangleClient = {}

local BIND_NAME = "PartyTrailTangleClient"
local YAW = { 0, -math.pi / 2, math.pi, math.pi / 2 } -- by direction: north, east, south, west

local running = false
local connections = {}
local grid = nil -- { Origin, Cell, Width, Height }
local riders = {} -- [index] = { Character, Height, From, To, FromYaw, ToYaw, Alive }
local stepStart, stepLength = 0, 0.3
local lastDrawAt = 0

local function cellPosition(x: number, y: number): Vector3
	return Vector3.new((x - (grid.Width - 1) / 2) * grid.Cell, 0, (y - (grid.Height - 1) / 2) * grid.Cell)
end

-- Shortest way round from one heading to another.
local function lerpAngle(a: number, b: number, t: number): number
	local delta = (b - a + math.pi) % (2 * math.pi) - math.pi
	return a + delta * t
end

local function draw()
	if not running or not grid then
		return
	end
	lastDrawAt = os.clock()
	local t = math.clamp((os.clock() - stepStart) / math.max(stepLength, 0.05), 0, 1)
	for _, rider in riders do
		local character = rider.Character
		if rider.Alive and rider.To and character and character.Parent then
			local position = rider.From:Lerp(rider.To, t)
			-- Turn quickly at the start of the step rather than drifting round the whole way.
			local yaw = lerpAngle(rider.FromYaw, rider.ToYaw, math.min(1, t * 3))
			character:PivotTo(grid.Origin * CFrame.new(position + Vector3.new(0, rider.Height, 0)) * CFrame.Angles(0, yaw, 0))
		end
	end
end

local function onSetup(message)
	grid = { Origin = message.Origin, Cell = message.Cell, Width = message.Width, Height = message.Height }
	riders = {}
	for index, entry in message.Riders do
		riders[index] = { Character = entry.Character, Height = entry.Height, Alive = true }
	end
end

local function onTick(message)
	if not grid or type(message.R) ~= "table" then
		return
	end
	-- Finish the previous glide first, so a late message never jumps backwards.
	for index, entry in message.R do
		local rider = riders[index]
		if rider then
			local to = cellPosition(entry[1], entry[2])
			rider.From = rider.To or to
			rider.FromYaw = rider.ToYaw or YAW[entry[3]]
			rider.To = to
			rider.ToYaw = YAW[entry[3]]
			rider.Alive = entry[4] == true
		end
	end
	stepStart = os.clock()
	stepLength = if type(message.I) == "number" then message.I else stepLength
end

function TrailTangleClient.start()
	TrailTangleClient.stop()
	running = true
	grid = nil
	riders = {}
	table.insert(
		connections,
		Net.minigameRemote().OnClientEvent:Connect(function(message)
			if type(message) ~= "table" then
				return
			end
			if message.Type == "Setup" then
				onSetup(message)
			elseif message.Type == "Tick" then
				onTick(message)
			end
		end)
	)
	RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value - 5, draw)
	-- Render steps pause while the window isn't drawn; keep bodies roughly right anyway.
	table.insert(
		connections,
		RunService.Heartbeat:Connect(function()
			if os.clock() - lastDrawAt > 0.25 then
				draw()
			end
		end)
	)
end

function TrailTangleClient.stop()
	if not running then
		return
	end
	running = false
	RunService:UnbindFromRenderStep(BIND_NAME)
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	grid = nil
	riders = {}
end

-- Turns are decided on the server: let Main send them.
function TrailTangleClient.onAction(_action: string): boolean
	return false
end

return TrailTangleClient
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">Onboarding</string>
            <string name="Source"><![CDATA[--[[
	Onboarding (guided first actions)
	Leads a new player to each control the first time they need it, one at a time, with the
	GuidePointer (bouncing hand + ring + short label). Only this player is guided; nothing about
	it is sent to anyone else.

	  1 START (host only)              StartedMatch
	  2 ROLL for turn order            RolledForOrder      "Roll to decide turn order."
	  3 ROLL on a board turn           RolledBoardTurn     "Roll to move."
	  4 an item you could use          SawItem             what it does + "or roll without it"
	  5 a fork                         ChoseFork           rings every route, suggests the one
	                                                       closest to the Crown, numbers match the
	                                                       route on the board
	  6 the minigame action            UsedMinigameAction  real label: MASH, DASH, LEFT / RIGHT...
	                                                       (movement-only games: a short "move"
	                                                       hint, once per session, no flag)
	  7 a Crown you can afford         SawCrownPurchase    "Crowns win the match..."

	The server keeps the flags (Tutorial.luau, saved in the profile) and sets each one only when
	the action really went through; the client also marks a step done the moment you press,
	so the pointer goes away at once. Until the server has sent the flags, nothing is shown
	(so returning players never see a flash of tutorial).

	Onboarding.decide(context) is the whole rule set as a pure function (unit tested); the
	object below builds the context from the live UI every frame and drives the pointer.
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local UI = script.Parent:WaitForChild("UI")
local InputHint = require(UI:WaitForChild("InputHint"))
local GuidePointer = require(UI:WaitForChild("GuidePointer"))
local Theme = require(UI:WaitForChild("Theme"))
local make = Theme.make

local Onboarding = {}
Onboarding.__index = Onboarding

Onboarding.MOVE_HINT_SECONDS = 5

-- "TAP HERE" / "CLICK or press SPACE" / "PRESS A" for a button with a key and pad button.
local function pressText(mode: string, key: string?, pad: string?): string
	if mode == "Gamepad" and pad then
		return "PRESS " .. pad
	elseif mode == "Mouse" and key then
		return "CLICK or press " .. key
	end
	return InputHint.verb(mode) .. " HERE"
end

local function orRoll(mode: string): string
	return if mode == "Gamepad"
		then "Or press A to roll without it."
		else ("Or %s ROLL to roll without it."):format(string.lower(InputHint.verb(mode)))
end

local function done(context, flag: string): boolean
	return context.Flags[flag] == true
end

-- The recommended route: fewest moves to the Crown (nil if no route says).
function Onboarding.recommendedRoute(routes): number?
	local best, bestDistance = nil, math.huge
	for index, route in routes or {} do
		if route.CrownDistance and route.CrownDistance < bestDistance then
			best, bestDistance = index, route.CrownDistance
		end
	end
	return best
end

local function minigameStep(context)
	local round = context.Minigame
	if not round or not round.Playing or not round.Participant or round.Spectating or not round.Bound then
		return nil -- spectators, knocked-out players and anyone not in this round: nothing
	end
	local mode = context.Mode
	local actions = round.Actions or {}
	if #actions > 0 then
		if done(context, "UsedMinigameAction") then
			return nil
		end
		local first = actions[1]
		local extra = {}
		for index = 2, #actions do
			table.insert(extra, { Kind = "Action", Action = actions[index].Action })
		end
		local title
		if #actions == 2 then
			-- A pair (LEFT / RIGHT): name both.
			local words = InputHint.actionWord(first.Label) .. " / " .. InputHint.actionWord(actions[2].Label)
			if mode == "Mouse" and InputHint.keyFor(first) and InputHint.keyFor(actions[2]) then
				title = ("PRESS %s / %s"):format(InputHint.keyName(InputHint.keyFor(first)), InputHint.keyName(InputHint.keyFor(actions[2])))
			elseif mode == "Gamepad" and InputHint.gamepadFor(first, 1) and InputHint.gamepadFor(actions[2], 2) then
				title = ("PRESS %s / %s"):format(InputHint.keyName(InputHint.gamepadFor(first, 1)), InputHint.keyName(InputHint.gamepadFor(actions[2], 2)))
			else
				title = InputHint.verb(mode) .. " " .. words
			end
			if mode ~= "Touch" then
				title ..= "  (" .. words .. ")"
			end
		else
			local word = InputHint.actionWord(first.Label)
			local key = if mode == "Mouse"
				then InputHint.keyName(InputHint.keyFor(first))
				elseif mode == "Gamepad" then InputHint.keyName(InputHint.gamepadFor(first, 1))
				else nil
			title = if key then ("PRESS %s TO %s"):format(key, word) else ("%s TO %s"):format(InputHint.verb(mode), word)
		end
		return {
			Flag = "UsedMinigameAction",
			Key = "UsedMinigameAction",
			Target = { Kind = "Action", Action = first.Action },
			Extra = extra,
			Title = title,
			Note = if #actions > 2 then "Use these buttons to play." else nil,
			Sides = { "Left", "Above", "Right" },
		}
	end
	-- Movement only: a short pointer at the thumbstick (touch) or the keys (desktop).
	if round.Move and round.MoveHintDue then
		if mode == "Touch" then
			return { Key = "MoveHint", Target = { Kind = "Thumbstick" }, Title = "DRAG HERE TO MOVE", Sides = { "Above", "Right" }, Round = true }
		end
		local title = if mode == "Gamepad" then "LEFT STICK TO MOVE" else "WASD / ARROWS TO MOVE"
		if round.Jump then
			title ..= if mode == "Gamepad" then "  ·  A TO JUMP" else "  ·  SPACE TO JUMP"
		end
		return { Key = "MoveHint", Target = nil, Title = title }
	end
	return nil
end

--[[
	context = {
	  Known, Flags = { [flag] = true }, Mode = "Touch" | "Mouse" | "Gamepad",
	  Modal       a full-screen card (instructions, results, vote, standings) or the shop is up
	  Lobby       { StartVisible }                        START is on screen (host only)
	  Board       { OrderRoll, Roll, Items = { { Name, Description } }, Coins,
	                Prompt = { Kind, Price, Routes, Count }? }
	  Minigame    { Playing, Participant, Spectating, Bound, Actions, Move, Jump, MoveHintDue }
	}
	Returns at most one step: { Flag?, Key, Target, Extra?, Title, Note?, Sides? } or nil.
]]
function Onboarding.decide(context)
	if not context.Known or context.Modal then
		return nil
	end
	local mode = context.Mode

	local lobby = context.Lobby
	if lobby and lobby.StartVisible and not done(context, "StartedMatch") then
		return {
			Flag = "StartedMatch",
			Key = "StartedMatch",
			Target = { Kind = "Start" },
			Title = if mode == "Gamepad" then "SELECT HERE TO START" else InputHint.verb(mode) .. " HERE TO START",
			Sides = { "Right", "Left", "Above" },
		}
	end

	local board = context.Board
	if board then
		local prompt = board.Prompt
		if prompt and prompt.Kind == "Path" and not done(context, "ChoseFork") then
			local best = Onboarding.recommendedRoute(prompt.Routes)
			local extra = {}
			for index = 1, prompt.Count or 0 do
				if index ~= (best or 1) then
					table.insert(extra, { Kind = "Option", Index = index })
				end
			end
			local route = best and prompt.Routes[best]
			return {
				Flag = "ChoseFork",
				Key = "ChoseFork",
				Target = { Kind = "Option", Index = best or 1 },
				Extra = extra,
				Routes = prompt.Routes,
				Recommended = best,
				Title = InputHint.verb(mode) .. " A PATH",
				Note = if route
					then ("★ %d is closest to the Crown (%d move%s). Any path is fine."):format(
						best,
						route.CrownDistance,
						if route.CrownDistance == 1 then "" else "s"
					)
					else "Any path is fine. The numbers match the board.",
				Sides = { "Above" },
			}
		end
		if prompt and prompt.Kind == "Collectible" and not done(context, "SawCrownPurchase") then
			local affordable = type(prompt.Price) == "number" and type(board.Coins) == "number" and board.Coins >= prompt.Price
			if affordable then
				return {
					Flag = "SawCrownPurchase",
					Key = "SawCrownPurchase",
					Target = { Kind = "Option", Index = 1 },
					Title = InputHint.verb(mode) .. " HERE TO BUY",
					Note = "Crowns win the match. Coins break ties.",
					Sides = { "Above" },
				}
			end
			return nil
		end
		if board.OrderRoll and not done(context, "RolledForOrder") then
			return {
				Flag = "RolledForOrder",
				Key = "RolledForOrder",
				Target = { Kind = "Roll" },
				Title = pressText(mode, "SPACE", "A"),
				Note = "Roll to decide turn order.",
				Sides = { "Left", "Above" },
			}
		end
		if board.Roll then
			local items = board.Items or {}
			if #items > 0 and not done(context, "SawItem") then
				local item = items[1]
				return {
					Flag = "SawItem",
					Key = "SawItem",
					Target = { Kind = "Item", Slot = 1 },
					Title = InputHint.verb(mode) .. " HERE TO USE IT",
					Note = ("%s: %s. %s"):format(item.Name or "Item", string.gsub(item.Description or "", "%.$", ""), orRoll(mode)),
					Sides = { "Left", "Above" },
				}
			end
			if not done(context, "RolledBoardTurn") then
				return {
					Flag = "RolledBoardTurn",
					Key = "RolledBoardTurn",
					Target = { Kind = "Roll" },
					Title = pressText(mode, "SPACE", "A"),
					Note = "Roll to move.",
					Sides = { "Left", "Above" },
				}
			end
		end
	end

	return minigameStep(context)
end

-- Live controller ------------------------------------------------------------------------------

--[[
	deps = { Guide, Lobby (LobbyPanel), Board (BoardView), Shop (ShopScreen), Screen (PartyUI),
	         PlayerGui, Modals = { GuiObject } }
]]
function Onboarding.new(deps)
	local self = setmetatable({}, Onboarding)
	self.Deps = deps
	self.Guide = deps.Guide
	self.Known = false
	self.ServerFlags = {}
	self.LocalDone = {}
	self.Minigame = nil
	self.MoveHintUsed = false
	self.MoveHintUntil = 0
	self.Badges = {}
	self.BadgeKey = nil
	self.Step = nil
	return self
end

function Onboarding:setFlags(flags)
	self.Known = true
	self.ServerFlags = {}
	for flag, value in flags or {} do
		if value == true then
			self.ServerFlags[flag] = true
		end
	end
	-- The server is the authority: what this client marked on a press only bridges the gap
	-- until the server answers (and a dev reset wipes it too).
	self.LocalDone = {}
end

function Onboarding:flags()
	local flags = table.clone(self.ServerFlags)
	for flag in self.LocalDone do
		flags[flag] = true
	end
	return flags
end

function Onboarding:isDone(flag: string): boolean
	return self.ServerFlags[flag] == true or self.LocalDone[flag] == true
end

-- Main: a minigame's play phase started / ended for this client.
function Onboarding:setMinigame(info)
	self.Minigame = info
	-- Only spend the once-per-session move hint on a round you actually play.
	local movementOnly = info and info.Controls and #(info.Controls.Actions or {}) == 0 and info.Controls.Move
	if movementOnly and info.Participant and not self.MoveHintUsed then
		self.MoveHintUsed = true -- once per session
		self.MoveHintUntil = os.clock() + Onboarding.MOVE_HINT_SECONDS
	end
end

-- Every input this client sends passes through here: the step it answers is done at once.
function Onboarding:noteInput(payload)
	local kind = payload.Kind
	local step = self.Step
	if kind == "StartMatch" then
		self.LocalDone.StartedMatch = true
	elseif kind == "Roll" then
		local state = self.Deps.Board.State
		if state and state.Stage == "OrderRoll" then
			self.LocalDone.RolledForOrder = true
		else
			self.LocalDone.RolledBoardTurn = true
			if self.Deps.Board.ItemBar.Visible then
				self.LocalDone.SawItem = true -- rolled without using the item
			end
		end
	elseif kind == "UseItem" then
		-- Not marked here: the server may refuse the item (wrong target, cancelled). Its flag
		-- arrives when the item is really used; until then just drop the pointer.
		if step and step.Key == "SawItem" then
			self.Guide:clear("SawItem")
		end
	elseif kind == "Choice" then
		local prompt = self.Deps.Board.PromptMessage
		if prompt and prompt.Kind == "Path" then
			self.LocalDone.ChoseFork = true
		elseif prompt and prompt.Kind == "Collectible" then
			self.LocalDone.SawCrownPurchase = true
		end
	elseif kind == "Action" or kind == "ActionUsed" then
		self.LocalDone.UsedMinigameAction = true
	end
	if step and step.Flag and self.LocalDone[step.Flag] then
		self.Guide:clear(step.Key)
	end
end

local function mySeat(state)
	local myId = "player_" .. Players.LocalPlayer.UserId
	for _, seat in (state and state.Seats) or {} do
		if seat.Id == myId then
			return seat
		end
	end
	return nil
end

function Onboarding:context()
	local deps = self.Deps
	local modal = deps.Shop.Open == true
	for _, card in deps.Modals do
		if card.Visible then
			modal = true
		end
	end
	local context = { Known = self.Known, Flags = self:flags(), Mode = InputHint.mode(), Modal = modal }

	local lobby = deps.Lobby
	if lobby.Showing and GuidePointer.isOnScreen(lobby.StartButton) then
		context.Lobby = { StartVisible = true }
	end

	local board = deps.Board
	if board.Visible and board.Header.Visible and board.State then
		local state = board.State
		local seat = mySeat(state)
		local prompt = board.Prompt.Visible and board.PromptId and board.PromptMessage
		context.Board = {
			OrderRoll = board.RollButton.Visible and state.Stage == "OrderRoll",
			Roll = board.RollButton.Visible and state.Stage == "Roll",
			Items = if board.ItemBar.Visible and seat then seat.Items else {},
			Coins = seat and seat.Coins,
			Prompt = if prompt
				then { Kind = prompt.Kind, Price = prompt.Price, Routes = prompt.Routes, Count = #(prompt.Options or {}) }
				else nil,
		}
	end

	local round = self.Minigame
	if round then
		local controls = round.Controls or {}
		context.Minigame = {
			Playing = round.Playing,
			Participant = round.Participant,
			Spectating = round.Spectating and round.Spectating() or false,
			Bound = round.Bound and round.Bound() or false,
			Actions = controls.Actions,
			Move = controls.Move,
			Jump = controls.Jump,
			MoveHintDue = os.clock() < self.MoveHintUntil,
		}
	end
	return context
end

-- The actual GuiObject a step points at.
function Onboarding:resolve(target): GuiObject?
	if not target then
		return nil
	end
	local deps = self.Deps
	if target.Kind == "Start" then
		return deps.Lobby.StartButton
	elseif target.Kind == "Roll" then
		return deps.Board.RollButton
	elseif target.Kind == "Item" then
		for _, child in deps.Board.ItemBar:GetChildren() do
			if child:IsA("GuiButton") and child.LayoutOrder == target.Slot then
				return child
			end
		end
	elseif target.Kind == "Option" then
		for _, child in deps.Board.PromptButtons:GetChildren() do
			if child:IsA("GuiButton") and child.LayoutOrder == target.Index then
				return child
			end
		end
	elseif target.Kind == "Action" then
		return deps.Screen:FindFirstChild("Action_" .. target.Action, true) :: GuiObject?
	elseif target.Kind == "Thumbstick" then
		-- The stick itself, not Roblox's large invisible touch zone around it.
		local touchGui = deps.PlayerGui:FindFirstChild("TouchGui")
		for _, path in { { "DynamicThumbstickFrame", "ThumbstickStart" }, { "ThumbstickFrame", "OuterImage" } } do
			local frame = touchGui and touchGui:FindFirstChild(path[1], true)
			local stick = frame and frame:FindFirstChild(path[2])
			if stick and GuidePointer.isOnScreen(stick) then
				return stick :: GuiObject
			end
		end
	end
	return nil
end

-- Fork: a number on each route button and the same number over that route's first space.
function Onboarding:clearBadges()
	for _, badge in self.Badges do
		badge:Destroy()
	end
	self.Badges = {}
	self.BadgeKey = nil
end

function Onboarding:showBadges(step)
	local key = tostring(self.Deps.Board.PromptId)
	if self.BadgeKey == key then
		return
	end
	self:clearBadges()
	self.BadgeKey = key
	local layout = self.Deps.Board.Layout
	for index, route in step.Routes or {} do
		local text = (if index == step.Recommended then "★" else "") .. tostring(index)
		local button = self:resolve({ Kind = "Option", Index = index })
		if button then
			local chip = make("TextLabel", {
				Name = "RouteBadge",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0, 4, 0, 4),
				Size = UDim2.fromOffset(40, 30),
				BackgroundColor3 = Theme.Colors.Overlay,
				Font = Theme.TitleFont,
				TextScaled = true,
				TextColor3 = Theme.Colors.Accent,
				Text = text,
				Active = false,
				ZIndex = 5,
				Parent = button,
			}, { Theme.corner(10), Theme.stroke(Theme.Colors.Accent, 2) })
			table.insert(self.Badges, chip)
		end
		local position
		for _, space in (layout and layout.Spaces) or {} do
			if space.Id == route.SpaceId then
				position = space.Position
			end
		end
		if position then
			local anchor = make("Part", {
				Name = "RouteBadgeAnchor",
				Anchored = true,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				Transparency = 1,
				Size = Vector3.new(0.2, 0.2, 0.2),
				Position = position + Vector3.new(0, 2.5, 0), -- on the tile, below the YOU tag's height
				Parent = Workspace.CurrentCamera, -- local only
			})
			local billboard = make("BillboardGui", {
				Size = UDim2.fromOffset(42, 32),
				AlwaysOnTop = false,
				LightInfluence = 0,
				Parent = anchor,
			})
			make("TextLabel", {
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = Theme.Colors.Overlay,
				Font = Theme.TitleFont,
				TextScaled = true,
				TextColor3 = Theme.Colors.Accent,
				Text = text,
				Parent = billboard,
			}, { Theme.corner(12), Theme.stroke(Theme.Colors.Accent, 3), Theme.padding(4) })
			table.insert(self.Badges, anchor)
		end
	end
end

function Onboarding:update()
	local step = Onboarding.decide(self:context())
	self.Step = step
	if step and step.Key == "ChoseFork" then
		self:showBadges(step)
	elseif self.BadgeKey then
		self:clearBadges()
	end
	if not step then
		self.Guide:clear()
	else
		local target = self:resolve(step.Target)
		if step.Target and not target then
			self.Guide:clear() -- not on screen yet
		else
			local extra = {}
			for _, other in step.Extra or {} do
				local object = self:resolve(other)
				if object then
					table.insert(extra, object)
				end
			end
			self.Guide:show(step.Key, target, {
				Title = step.Title,
				Note = step.Note,
				Sides = step.Sides,
				Extra = extra,
				Round = step.Round,
				-- Board prompt choices: keep the hand and label above the prompt card.
				Outside = if step.Target and step.Target.Kind == "Option" then self.Deps.Board.Prompt else nil,
			})
		end
	end
	self.Guide:update()
end

return Onboarding
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="69">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">ActionBar</string>
              <string name="Source"><![CDATA[--[[
	ActionBar
	Big round on-screen buttons for the minigame's actions, bottom-right above the jump
	button. Work with touch and mouse; show the keyboard key on devices with a keyboard.
]]

local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Theme)
local make = Theme.make

local ActionBar = {}
ActionBar.__index = ActionBar

local BUTTON_SIZE = 96
local ABOVE_JUMP_BUTTON = -170 -- bottom offset that clears Roblox's mobile jump button
local BOTTOM_CORNER = -28 -- used when movement is locked, so there is no jump button to clear

function ActionBar.new(screen: ScreenGui)
	local self = setmetatable({}, ActionBar)
	self.Root = make("Frame", {
		Name = "ActionBar",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -24, 1, -170), -- clears Roblox's mobile jump button
		Size = UDim2.fromOffset(BUTTON_SIZE, BUTTON_SIZE * 3 + 24),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = screen,
	}, {
		make("UIListLayout", {
			Padding = UDim.new(0, 12),
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	-- Second column in the bottom-left corner for actions with Side = "Left" (e.g. steer left).
	self.LeftRoot = make("Frame", {
		Name = "ActionBarLeft",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 24, 1, -170),
		Size = UDim2.fromOffset(BUTTON_SIZE, BUTTON_SIZE * 3 + 24),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = screen,
	}, {
		make("UIListLayout", {
			Padding = UDim.new(0, 12),
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	self.Connections = {}
	return self
end

-- `low` = sit in the bottom corners (thumb reach) instead of above the jump button.
function ActionBar:show(actions, send: (string) -> (), low: boolean?)
	self:hide()
	local offset = if low then BOTTOM_CORNER else ABOVE_JUMP_BUTTON
	self.Root.Position = UDim2.new(1, -24, 1, offset)
	self.LeftRoot.Position = UDim2.new(0, 24, 1, offset)
	if #actions == 0 then
		return
	end
	-- Key hints only off touch screens: phones (and Studio's phone emulator) can report a
	-- keyboard and even a mouse, so any touch screen gets the plain button.
	local showKeys = UserInputService.KeyboardEnabled and not UserInputService.TouchEnabled
	for index, action in actions do
		local button = make("TextButton", {
			Name = "Action_" .. action.Action,
			LayoutOrder = index,
			Size = UDim2.fromOffset(BUTTON_SIZE, BUTTON_SIZE),
			BackgroundColor3 = action.Color or Theme.Colors.Hot,
			BackgroundTransparency = 0.1,
			Text = "",
			AutoButtonColor = true,
			Parent = if action.Side == "Left" then self.LeftRoot else self.Root,
		}, { Theme.corner(BUTTON_SIZE // 2), Theme.stroke(Color3.new(1, 1, 1), 3) })
		Theme.label({
			Size = UDim2.fromScale(1, if showKeys then 0.7 else 1),
			Font = Theme.TitleFont,
			Text = action.Label,
			Parent = button,
		}, 26)
		if showKeys and action.Key then
			Theme.label({
				Position = UDim2.fromScale(0, 0.65),
				Size = UDim2.fromScale(1, 0.25),
				TextColor3 = Theme.Colors.Accent,
				Text = "[" .. action.Key .. "]",
				Parent = button,
			}, 16)
		end
		if action.Hold then
			-- Press and hold: send on finger/mouse down, "<Action>Stop" when that same input ends.
			table.insert(
				self.Connections,
				button.InputBegan:Connect(function(input)
					if
						input.UserInputType ~= Enum.UserInputType.Touch
						and input.UserInputType ~= Enum.UserInputType.MouseButton1
					then
						return
					end
					send(action.Action)
					local released
					released = input.Changed:Connect(function()
						if input.UserInputState == Enum.UserInputState.End then
							released:Disconnect()
							send(action.Action .. "Stop")
						end
					end)
					table.insert(self.Connections, released)
				end)
			)
		else
			table.insert(
				self.Connections,
				button.Activated:Connect(function()
					send(action.Action)
				end)
			)
		end
	end
	self.Root.Visible = true
	self.LeftRoot.Visible = true
end

function ActionBar:hide()
	for _, connection in self.Connections do
		connection:Disconnect()
	end
	table.clear(self.Connections)
	for _, root in { self.Root, self.LeftRoot } do
		for _, child in root:GetChildren() do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		root.Visible = false
	end
end

return ActionBar
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">BoardView</string>
              <string name="Source"><![CDATA[--[[
	BoardView
	Everything the client shows during the board phase. Functional placeholder UI; the
	visual pass (style guide) comes later.

	  header      top centre, under Roblox's top bar: round, whose turn, dice / moves left
	  standings   left side: every seat's collectibles and coins, current turn highlighted
	  roll        big button bottom right, only on your turn (Space / ButtonA too)
	  prompt      bottom centre: fork / buy / shop choices sent to you by the server
	  camera      follows whoever's turn it is

	Only renders server state; every decision is validated on the server.
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Theme = require(script.Parent.Theme)
local make = Theme.make

local BoardView = {}
BoardView.__index = BoardView

local ROLL_ACTION = "PartyBoardRoll"
local CAMERA_BIND = "PartyBoardCamera"
local CAMERA_OFFSET = Vector3.new(0, 42, 34)
-- Landscape phones need extra breathing room around the board so the near row and
-- world labels stay clear of the HUD and rounded screen edges. Desktop is unchanged.
local TOUCH_CAMERA_OFFSET = Vector3.new(0, 60, 50)
local MAP_OFFSET = Vector3.new(0, 115, 60) -- MAP view: high enough to see the whole board
local MAP_ACTION = "PartyBoardMap"

local myId = "player_" .. Players.LocalPlayer.UserId

-- A key that changes whenever the item list does (so buttons are only rebuilt then).
local function itemKeyOf(items): string
	local ids = {}
	for _, item in items do
		table.insert(ids, item.Id)
	end
	return table.concat(ids, ",")
end

-- send(payload) fires the input remote.
function BoardView.new(screen: ScreenGui, send: (any) -> ())
	local self = setmetatable({ Send = send, Visible = false }, BoardView)

	-- Header
	self.Header = make("Frame", {
		Name = "BoardHeader",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 64), -- below Roblox's top bar
		Size = UDim2.fromOffset(460, 70),
		BackgroundColor3 = Theme.Colors.Card,
		BackgroundTransparency = 0.1,
		Visible = false,
		Parent = screen,
	}, { Theme.corner(18), Theme.stroke(Theme.Colors.Accent, 3) })
	self.Title = Theme.label({
		Position = UDim2.fromScale(0.03, 0.05),
		Size = UDim2.fromScale(0.94, 0.5),
		Font = Theme.TitleFont,
		TextColor3 = Theme.Colors.Accent,
		Parent = self.Header,
	}, 30)
	self.Subtitle = Theme.label({
		Position = UDim2.fromScale(0.03, 0.55),
		Size = UDim2.fromScale(0.94, 0.4),
		Parent = self.Header,
	}, 22)

	-- Standings (left side, below the top-left Roblox buttons)
	self.Standings = make("Frame", {
		Name = "BoardStandings",
		Position = UDim2.new(0, 12, 0, 150),
		Size = UDim2.fromOffset(230, 4 * 54 + 3 * 6),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = screen,
	}, { make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
	self.Rows = {}

	-- Roll button
	self.RollButton = make("TextButton", {
		Name = "BoardRoll",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -24, 1, -24),
		Size = UDim2.fromOffset(150, 150),
		BackgroundColor3 = Theme.Colors.Good,
		Font = Theme.TitleFont,
		Text = "",
		AutoButtonColor = true,
		Visible = false,
		Parent = screen,
	}, { Theme.corner(75), Theme.stroke(Color3.new(1, 1, 1), 4) })
	self.RollLabel = Theme.label({
		Size = UDim2.fromScale(1, 0.6),
		Position = UDim2.fromScale(0, 0.12),
		Font = Theme.TitleFont,
		TextColor3 = Theme.Colors.Overlay,
		Text = "ROLL!",
		Parent = self.RollButton,
	}, 44)
	self.RollClock = Theme.label({
		Size = UDim2.fromScale(1, 0.22),
		Position = UDim2.fromScale(0, 0.68),
		TextColor3 = Theme.Colors.Overlay,
		Parent = self.RollButton,
	}, 22)
	self.RollButton.Activated:Connect(function()
		self:roll()
	end)

	-- Item buttons (above the roll button, your turn only, before rolling)
	self.ItemBar = make("Frame", {
		Name = "BoardItems",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -24, 1, -186),
		Size = UDim2.fromOffset(520, 84),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = screen,
	}, {
		make("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	self.ItemKey = nil

	-- Prompt (bottom centre)
	self.Prompt = make("Frame", {
		Name = "BoardPrompt",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -20),
		Size = UDim2.fromOffset(620, 150),
		BackgroundColor3 = Theme.Colors.Card,
		Visible = false,
		Parent = screen,
	}, { Theme.corner(18), Theme.stroke(Theme.Colors.Accent, 3), Theme.padding(10) })
	self.PromptText = Theme.label({
		Size = UDim2.new(1, 0, 0, 40),
		Font = Theme.TitleFont,
		TextColor3 = Theme.Colors.Accent,
		Parent = self.Prompt,
	}, 30)
	self.PromptButtons = make("Frame", {
		Position = UDim2.new(0, 0, 0, 48),
		Size = UDim2.new(1, 0, 1, -48),
		BackgroundTransparency = 1,
		Parent = self.Prompt,
	}, {
		make("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	self.PromptId = nil
	self.PromptEndsAt = nil

	-- MAP: inspect the whole board, the Crown, gates, traps and everyone's items
	self.MapButton = make("TextButton", {
		Name = "BoardMap",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 24, 1, -24),
		Size = UDim2.fromOffset(130, 56),
		BackgroundColor3 = Theme.Colors.Card,
		Font = Theme.TitleFont,
		TextScaled = true,
		TextColor3 = Theme.Colors.Accent,
		Text = "MAP",
		Visible = false,
		Parent = screen,
	}, { Theme.corner(14), Theme.stroke(Theme.Colors.Accent, 2), Theme.padding(8) })
	self.MapButton.Activated:Connect(function()
		self:toggleMap()
	end)
	self.MapPanel = make("ScrollingFrame", {
		Name = "BoardMapPanel",
		Position = UDim2.new(0, 12, 0, 150),
		Size = UDim2.fromOffset(330, 260),
		BackgroundColor3 = Theme.Colors.Card,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Visible = false,
		Parent = screen,
	}, {
		Theme.corner(14),
		Theme.padding(10),
		make("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	self.MapOpen = false

	self.State = nil
	self.Layout = nil
	self.Focus = nil
	return self
end

-- Layout / state ------------------------------------------------------------------------------

function BoardView:setLayout(message)
	self.Layout = message
	local sum, count = Vector3.zero, 0
	for _, space in message.Spaces do
		sum += space.Position
		count += 1
	end
	self.Centre = if count > 0 then sum / count else Vector3.zero
end

local function seatLine(seat, plural: string): string
	return ("%d %s  ·  %d coins"):format(
		seat.Collectibles,
		if seat.Collectibles == 1 then string.sub(plural, 1, -2) else plural,
		seat.Coins
	)
end

function BoardView:setState(message)
	self.State = message
	if not self.Visible then
		return
	end
	if self.MapOpen then
		self:refreshMap()
	end

	-- Header
	local myTurn = message.TurnId == myId
	local who = if myTurn then "Your" else (message.TurnName and (message.TurnName .. "'s") or nil)
	self.Title.Text = ("%s %d / %d%s"):format(
		if message.Frenzy then "FINAL FRENZY · Round" else "Round",
		message.Round or 0,
		message.Rounds or 0,
		if who then "  ·  " .. who .. " turn" else ""
	)
	local sub = message.Text or ""
	if message.Stage == "OrderRoll" then
		self.Title.Text = ("Round %d / %d  ·  Turn order"):format(message.Round or 0, message.Rounds or 0)
		sub = if message.OrderPending and message.OrderPending[myId] then "Tap ROLL! Highest roll goes first" else (message.Text or "")
	elseif message.Stage == "Moving" and message.Remaining then
		sub = ("Rolled %d  ·  %d move%s left"):format(message.Roll or 0, message.Remaining, if message.Remaining == 1 then "" else "s")
	elseif message.Stage == "Roll" and myTurn then
		sub = if (message.Dice or 1) > 1
			then ("Tap ROLL to roll %d dice!"):format(message.Dice)
			else "Use an item, or tap ROLL to roll the die!"
	end
	if message.Bridge and message.Stage ~= "RotationWarning" and message.Stage ~= "Rotating" then sub ..= " · " .. message.Bridge.Alignment .. " → " .. message.Bridge.NextAlignment end
	if message.Bridge and message.Stage == "Roll" then
  for _,seat in message.Seats do
   local dock=seat.Zone and message.Bridge.Docks[seat.Zone]
   if seat.Id==message.TurnId and dock and not dock.Open then sub="Exit CLOSED · keep looping · " .. message.Bridge.Alignment .. " → " .. message.Bridge.NextAlignment end
  end
 end
 self.Subtitle.Text = sub

	-- Standings rows (turn order)
	for _, row in self.Rows do
		row:Destroy()
	end
	self.Rows = {}
	for _, seat in message.Seats do
		local isTurn = seat.Id == message.TurnId
		local isMe = seat.Id == myId
		local row = make("Frame", {
			LayoutOrder = seat.Order,
			Size = UDim2.new(1, 0, 0, 54),
			BackgroundColor3 = if isMe then Theme.Colors.CardLight else Theme.Colors.Card,
			BackgroundTransparency = 0.1,
			Parent = self.Standings,
		}, { Theme.corner(12) })
		if isTurn then
			Theme.stroke(Theme.Colors.Accent, 3).Parent = row
		end
		Theme.label({
			Position = UDim2.fromOffset(10, 4),
			Size = UDim2.new(1, -20, 0, 26),
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = Theme.TitleFont,
			Text = (if isTurn then "▶ " else "") .. (if isMe then "YOU" else seat.Name) .. (if seat.IsBot then " (bot)" else ""),
			Parent = row,
		}, 22)
		local line = seatLine(seat, message.CollectiblePlural or "Crowns")
		if seat.OrderRolls and #seat.OrderRolls > 0 then
			line = "Rolled " .. table.concat(seat.OrderRolls, ", then ")
		else
			line ..= ("  ·  %d item%s"):format(#(seat.Items or {}), if #(seat.Items or {}) == 1 then "" else "s")
			if seat.Shield then
				line ..= "  ·  shield"
			end
			if seat.Underdog then
				line ..= "  ·  underdog"
			end
		end
		Theme.label({
			Position = UDim2.fromOffset(10, 30),
			Size = UDim2.new(1, -20, 0, 20),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Theme.Colors.Accent,
			Text = line,
			Parent = row,
		}, 18)
		table.insert(self.Rows, row)
	end

	-- Item buttons: your turn, before rolling, no item used yet.
	local mySeat
	for _, seat in message.Seats do
		if seat.Id == myId then
			mySeat = seat
		end
	end
	local items = mySeat and mySeat.Items or {}
	local showItems = myTurn and message.Stage == "Roll" and not message.ItemUsed and #items > 0
	local itemKey = if showItems then itemKeyOf(items) else nil
	if itemKey ~= self.ItemKey then
		self.ItemKey = itemKey
		for _, child in self.ItemBar:GetChildren() do
			if child:IsA("GuiButton") then
				child:Destroy()
			end
		end
		for slot, item in items do
			local button = make("TextButton", {
				LayoutOrder = slot,
				Size = UDim2.fromOffset(160, 84), -- >= 44pt tall after the phone HUD scale (0.55)
				BackgroundColor3 = Theme.Colors.Cool,
				Font = Theme.BodyFont,
				TextScaled = true,
				TextColor3 = Theme.Colors.Overlay,
				Text = item.Name,
				Parent = self.ItemBar,
			}, { Theme.corner(14), Theme.padding(6), make("UITextSizeConstraint", { MaxTextSize = 22, MinTextSize = 10 }) })
			button.Activated:Connect(function()
				self.ItemBar.Visible = false
				self.Send({ Kind = "UseItem", Slot = slot })
			end)
		end
	end
	self.ItemBar.Visible = showItems

	-- Roll button: on your turn (or when rolling for turn order), while waiting for the roll.
	local canRoll = (myTurn and message.Stage == "Roll")
		or (message.Stage == "OrderRoll" and message.OrderPending ~= nil and message.OrderPending[myId] == true)
	if canRoll and not self.RollButton.Visible then
		Theme.pop(self.RollButton)
		ContextActionService:BindAction(ROLL_ACTION, function(_, inputState)
			if inputState == Enum.UserInputState.Begin then
				self:roll()
			end
			return Enum.ContextActionResult.Sink
		end, false, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)
	elseif not canRoll then
		ContextActionService:UnbindAction(ROLL_ACTION)
	end
	self.RollButton.Visible = canRoll
end

function BoardView:roll()
	if self.RollButton.Visible then
		self.RollButton.Visible = false
		ContextActionService:UnbindAction(ROLL_ACTION)
		self.Send({ Kind = "Roll" })
	end
end

-- Map ---------------------------------------------------------------------------------------------

local function mapLine(self, order: number, text: string, color: Color3?, swatch: Color3?)
	local row = make("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundTransparency = 1,
		Parent = self.MapPanel,
	})
	if swatch then
		make("Frame", {
			Size = UDim2.fromOffset(18, 18),
			Position = UDim2.fromOffset(0, 3),
			BackgroundColor3 = swatch,
			Parent = row,
		}, { Theme.corner(4) })
	end
	Theme.label({
		Position = UDim2.fromOffset(if swatch then 26 else 0, 0),
		Size = UDim2.new(1, if swatch then -26 else 0, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = color or Theme.Colors.Text,
		Text = text,
		Parent = row,
	}, 20)
end

-- Rebuilds the MAP panel from the latest state + layout.
function BoardView:refreshMap()
	for _, child in self.MapPanel:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local state, layout = self.State, self.Layout
	if not state then
		return
	end
	local order = 0
	local function line(text, color, swatch)
		order += 1
		mapLine(self, order, text, color, swatch)
	end
	line("MAP" .. (if layout and layout.Name then " · " .. layout.Name else ""), Theme.Colors.Accent)
	line(("%s: space %s · %d coins"):format(state.CollectibleName or "Crown", tostring(state.CollectibleSpace), state.CollectiblePrice or 0), Theme.Colors.Accent)
	if state.Bridge then
  line("Bridge " .. state.Bridge.Alignment .. " · next " .. state.Bridge.NextAlignment,Theme.Colors.Accent)
  line("Rotates after round " .. state.Bridge.NextRound .. " · Moon Dial ready round " .. state.Bridge.DialReadyRound)
  for _,dock in state.Bridge.Docks do line(dock.Name .. ": " .. (if dock.Open then "OPEN" else "EXIT CLOSED · local loop")) end
 end
	for _, gate in state.Gates or {} do
		line(("Gate %s: %s%s"):format(gate.Id, if gate.Open then "open" else "CLOSED", if gate.Open and gate.Toll > 0 then (" · toll %d"):format(gate.Toll) else ""))
	end
	for _, trap in state.Traps or {} do
		line(("Trap on space %d (%s)"):format(trap.SpaceId, trap.Owner), Theme.Colors.Hot)
	end
	line("Players", Theme.Colors.Accent)
	for _, seat in state.Seats do
		local names = {}
		for _, item in seat.Items or {} do
			table.insert(names, item.Name)
		end
		line(("%s: %d %s, %d coins"):format(if seat.Id == myId then "You" else seat.Name, seat.Collectibles, state.CollectiblePlural or "Crowns", seat.Coins))
		line("   " .. (if #names > 0 then table.concat(names, ", ") else "no items") .. (if seat.Shield then " · shield up" else ""), Theme.Colors.Muted)
	end
	if layout and layout.Legend then
		line("Spaces", Theme.Colors.Accent)
		local legend = table.clone(layout.Legend)
		table.sort(legend, function(a, b)
			return a.Name < b.Name
		end)
		for _, entry in legend do
			line(entry.Name .. (if entry.Short ~= "" then (" (%s)"):format(entry.Short) else ""), nil, entry.Color)
		end
	end
end

function BoardView:toggleMap(open: boolean?)
	if open == nil then
		open = not self.MapOpen
	end
	self.MapOpen = open and self.Visible
	self.MapPanel.Visible = self.MapOpen
	self.Standings.Visible = self.Visible and not self.MapOpen and self.Header.Visible
	self.MapButton.Text = if self.MapOpen then "CLOSE" else "MAP"
	self.Focus = nil
	if self.MapOpen then
		self:refreshMap()
	end
end

-- Prompt ------------------------------------------------------------------------------------------

function BoardView:showPrompt(message)
	for _, child in self.PromptButtons:GetChildren() do
		if child:IsA("GuiButton") then
			child:Destroy()
		end
	end
	self.PromptId = message.PromptId
	self.PromptEndsAt = message.EndsAt
	self.PromptMessage = message -- Kind / Routes / Price: read by the first-action guidance
	if not message.PromptId then
		self.Prompt.Visible = false
		return
	end
	self.PromptText.Text = message.Prompt
	local count = #message.Options
	for index, option in message.Options do
		local button = make("TextButton", {
			LayoutOrder = index,
			Size = UDim2.new(1 / count, -10, 1, 0),
			BackgroundColor3 = if index == count and count > 1 then Theme.Colors.CardLight else Theme.Colors.Cool,
			Font = Theme.BodyFont,
			TextScaled = true,
			TextColor3 = if index == count and count > 1 then Theme.Colors.Text else Theme.Colors.Overlay,
			Text = option,
			Parent = self.PromptButtons,
		}, {
			Theme.corner(14),
			Theme.padding(8),
			make("UITextSizeConstraint", { MaxTextSize = 26, MinTextSize = 10 }),
		})
		button.Activated:Connect(function()
			if self.PromptId == message.PromptId then
				self.Send({ Kind = "Choice", PromptId = message.PromptId, Index = index })
				self.PromptId = nil
				self.Prompt.Visible = false
			end
		end)
	end
	self.Prompt.Visible = true
	Theme.pop(self.Prompt)
end

-- Visibility + camera -----------------------------------------------------------------------------

local function turnFocus(self): Vector3?
	local state = self.State
	if not state then
		return self.Centre
	end
	for _, seat in state.Seats do
		if seat.Id == state.TurnId then
			local character = seat.Character
			local root = character and character.Parent and character:FindFirstChild("HumanoidRootPart")
			if root then
				return root.Position
			end
		end
	end
	return self.Centre
end

function BoardView:show()
	if self.Visible then
		return
	end
	self.Visible = true
	self.Header.Visible = true
	self.Standings.Visible = true
	self.MapButton.Visible = true
	ContextActionService:BindAction(MAP_ACTION, function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			self:toggleMap()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.M, Enum.KeyCode.ButtonY)
	self.Focus = nil
	local camera = Workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Scriptable
	RunService:BindToRenderStep(CAMERA_BIND, Enum.RenderPriority.Camera.Value + 1, function(dt)
		local festival = self.Layout and self.Layout.Festival
		local goal = if self.MapOpen or festival then self.Centre else turnFocus(self)
		if not goal then
			return
		end
		self.Focus = if self.Focus then self.Focus:Lerp(goal, 1 - math.exp(-4 * dt)) else goal
		camera.CameraType = Enum.CameraType.Scriptable
		-- MAP view, else the phone (touch) offset, else the desktop offset; the festival board
		-- overrides all of them with its own whole-board framing.
		local offset = if self.MapOpen
			then MAP_OFFSET
			elseif UserInputService.TouchEnabled then TOUCH_CAMERA_OFFSET
			else CAMERA_OFFSET
		if festival then
			local aspect = camera.ViewportSize.X / math.max(1, camera.ViewportSize.Y)
			local distance = math.max(190, 190 / math.max(0.5, aspect))
			offset = Vector3.new(0, distance, distance * 0.38)
		end
		camera.CFrame = CFrame.lookAt(self.Focus + offset, self.Focus)
		-- Your piece is teleported around; if it tips over, stand it back up.
		local character = Players.LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local humanoidState = humanoid and humanoid:GetState()
		if humanoidState == Enum.HumanoidStateType.FallingDown or humanoidState == Enum.HumanoidStateType.Ragdoll then
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
	if self.State then
		self:setState(self.State)
	end
end

function BoardView:hide()
	if not self.Visible then
		return
	end
	self.Visible = false
	self.Header.Visible = false
	self.Standings.Visible = false
	self.MapButton.Visible = false
	self:toggleMap(false)
	ContextActionService:UnbindAction(MAP_ACTION)
	self.RollButton.Visible = false
	self.ItemBar.Visible = false
	self.ItemKey = nil
	self.Prompt.Visible = false
	ContextActionService:UnbindAction(ROLL_ACTION)
	RunService:UnbindFromRenderStep(CAMERA_BIND)
	local camera = Workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Custom
	local character = Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

-- Keeps the board camera but hides the header, standings, roll and prompt (final standings card).
function BoardView:hidePanels()
	self.Header.Visible = false
	self.Standings.Visible = false
	self.MapButton.Visible = false
	self:toggleMap(false)
	ContextActionService:UnbindAction(MAP_ACTION)
	self.RollButton.Visible = false
	self.ItemBar.Visible = false
	self.ItemKey = nil
	self.Prompt.Visible = false
	ContextActionService:UnbindAction(ROLL_ACTION)
end

-- Per frame: countdown on the roll button.
function BoardView:update()
	if self.RollButton.Visible and self.State and self.State.RollEndsAt then
		self.RollClock.Text = ("%ds"):format(math.max(0, math.ceil(self.State.RollEndsAt - Workspace:GetServerTimeNow())))
	end
end

return BoardView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">GuidePointer</string>
              <string name="Source"><![CDATA[--[[
	GuidePointer
	Leads the player to one exact button: a gently bouncing hand, a pulsing ring around the
	button and a short label ("TAP HERE" + one line of help) next to it.

	  guide:show(key, target, { Title, Note?, Sides?, Extra? }) -> true if something changed
	  guide:show(key, nil, { Title, Note? })   no button to point at (desktop movement keys):
	                                           just the label, low on the screen
	  guide:clear(key?)       remove it (only if it's still `key`, when given)
	  guide:update()          every frame: follow the target, bounce, hide/clear when it's gone

	  * One pointer at a time: show() replaces whatever was there; showing the same key on the
	    same target again does nothing, so repeated messages can't stack pointers.
	  * Lives in its own ScreenGui above the party UI (DisplayOrder 11) but inside Roblox's
	    safe area (top bar, notch, home indicator), and is clamped to it.
	  * Never takes input: nothing in it is Active or Interactable, so the button underneath
	    still gets every tap and click. The ring is an outline, so the button's text shows.
	  * Follows the target every frame, so it stays on it when the HUD rescales or moves.
	  * Clears itself when the target is destroyed; hides while the target is hidden.
	  * Extra = more buttons that get a thinner ring (e.g. every route at a fork).
	  * Round = true: a circular ring for round images with no UICorner (the thumbstick).
	  * Outside = a panel the target sits in (the board prompt): the hand and label go above
	    that whole panel instead of over its title text.
	  * Reduced motion (if Roblox reports it): no bounce and no pulse.
]]

local GuiService = game:GetService("GuiService")

local Theme = require(script.Parent.Theme)
local make = Theme.make

local GuidePointer = {}
GuidePointer.__index = GuidePointer

local GAP = 6 -- between the ring and the hand
local RING_PAD = 6 -- ring sits this far outside the button
local BOUNCE = 9 -- pixels at full scale
local BOUNCE_HZ = 0.9 -- gentle: under once a second
local HANDS = { Above = "👇", Below = "👆", Left = "👉", Right = "👈" }
local DEFAULT_SIDES = { "Left", "Above", "Right", "Below" }

local function reducedMotion(): boolean
	local ok, value = pcall(function()
		return (GuiService :: any).ReducedMotionEnabled
	end)
	return ok and value == true
end

local function noInput(instance: GuiObject)
	instance.Active = false
	pcall(function()
		(instance :: any).Interactable = false
	end)
	return instance
end

-- Outline-only ring (yellow, with a dark edge so it reads on yellow buttons too).
local function ring(parent: Instance, name: string, thickness: number)
	local frame = noInput(make("Frame", {
		Name = name,
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 2,
		Parent = parent,
	}, { make("UICorner", { CornerRadius = UDim.new(0, 16) }) }))
	make("UIStroke", { Name = "Glow", Color = Theme.Colors.Accent, Thickness = thickness, Parent = frame })
	local edge = noInput(make("Frame", {
		Name = "Edge",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, thickness * 2 + 2, 1, thickness * 2 + 2),
		BackgroundTransparency = 1,
		Parent = frame,
	}, { make("UICorner", { CornerRadius = UDim.new(0, 18) }) }))
	make("UIStroke", { Color = Theme.Colors.Overlay, Thickness = 2, Transparency = 0.2, Parent = edge })
	return frame
end

-- parent: PlayerGui (a ScreenGui is made there) or any Instance (tests).
function GuidePointer.new(parent: Instance)
	local self = setmetatable({}, GuidePointer)
	self.Gui = make("ScreenGui", {
		Name = "PartyGuide",
		ResetOnSpawn = false,
		IgnoreGuiInset = false, -- stay below Roblox's top bar
		DisplayOrder = 11, -- over the party UI (10); modal cards hide the pointer instead
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = parent,
	})
	pcall(function()
		self.Gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets -- notch + home indicator
	end)
	self.Root = noInput(make("Frame", {
		Name = "Guide",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = self.Gui,
	}))
	self.Ring = ring(self.Root, "Ring", 4)
	self.Hand = noInput(make("TextLabel", {
		Name = "Hand",
		BackgroundTransparency = 1,
		Font = Theme.BodyFont,
		TextScaled = true,
		Text = HANDS.Left,
		Visible = false,
		ZIndex = 3,
		Parent = self.Root,
	}))
	self.Bubble = noInput(make("Frame", {
		Name = "Bubble",
		BackgroundColor3 = Theme.Colors.Overlay,
		BackgroundTransparency = 0.05,
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		ZIndex = 3,
		Parent = self.Root,
	}, {
		Theme.corner(12),
		Theme.stroke(Theme.Colors.Accent, 3),
		Theme.padding(8),
		make("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
	}))
	self.Title = noInput(make("TextLabel", {
		Name = "Title",
		LayoutOrder = 1,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Font = Theme.TitleFont,
		TextColor3 = Theme.Colors.Text,
		TextWrapped = true,
		ZIndex = 4,
		Parent = self.Bubble,
	}))
	self.Note = noInput(make("TextLabel", {
		Name = "Note",
		LayoutOrder = 2,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Font = Theme.BodyFont,
		TextColor3 = Theme.Colors.Accent,
		TextWrapped = true,
		ZIndex = 4,
		Parent = self.Bubble,
	}))
	self.ExtraRings = {}
	self.Key = nil
	self.Target = nil
	self.Options = nil
	self.Started = os.clock()
	return self
end

local function sameList(a, b): boolean
	a, b = a or {}, b or {}
	if #a ~= #b then
		return false
	end
	for i, value in a do
		if b[i] ~= value then
			return false
		end
	end
	return true
end

function GuidePointer:show(key: string, target: GuiObject?, options): boolean
	options = options or {}
	local current = self.Options
	if
		self.Key == key
		and self.Target == target
		and current
		and current.Title == options.Title
		and current.Note == options.Note
		and sameList(current.Extra, options.Extra)
	then
		return false -- already showing exactly this
	end
	if self.Key ~= key or self.Target ~= target then
		self.Started = os.clock()
	end
	self.Key = key
	self.Target = target
	self.Options = options
	self.Title.Text = options.Title or "TAP HERE"
	self.Note.Text = options.Note or ""
	self.Note.Visible = options.Note ~= nil and options.Note ~= ""
	for _, extra in self.ExtraRings do
		extra:Destroy()
	end
	self.ExtraRings = {}
	for index in options.Extra or {} do
		self.ExtraRings[index] = ring(self.Root, "ExtraRing" .. index, 3)
	end
	return true
end

function GuidePointer:clear(key: string?)
	if key and self.Key ~= key then
		return
	end
	self.Key = nil
	self.Target = nil
	self.Options = nil
	for _, extra in self.ExtraRings do
		extra:Destroy()
	end
	self.ExtraRings = {}
	self:setVisible(false)
end

function GuidePointer:isShowing(): string?
	return self.Key
end

function GuidePointer:setVisible(visible: boolean)
	self.Ring.Visible = visible
	self.Hand.Visible = visible
	self.Bubble.Visible = visible
	for _, extra in self.ExtraRings do
		extra.Visible = visible
	end
end

-- On screen = in the game tree, every GuiObject up to its ScreenGui visible, ScreenGui on.
function GuidePointer.isOnScreen(target: Instance?): boolean
	if not target or not target.Parent or not target:IsA("GuiObject") then
		return false
	end
	local node: Instance? = target
	while node do
		if node:IsA("GuiObject") then
			if not node.Visible then
				return false
			end
		elseif node:IsA("LayerCollector") then
			return node.Enabled and node.Parent ~= nil
		end
		node = node.Parent
	end
	return false
end

-- Target's rectangle in this guide's own coordinates.
function GuidePointer:rectOf(target: GuiObject): (Vector2, Vector2)
	return target.AbsolutePosition - self.Root.AbsolutePosition, target.AbsoluteSize
end

local function placeRing(self, frame: Frame, target: GuiObject, scale: number, pulse: number)
	local position, size = self:rectOf(target)
	local pad = (RING_PAD + pulse * 3) * scale
	frame.Position = UDim2.fromOffset(position.X - pad, position.Y - pad)
	frame.Size = UDim2.fromOffset(size.X + pad * 2, size.Y + pad * 2)
	-- Match the button's own rounding (round buttons get round rings). Offsets are in
	-- design pixels, so scale them like the button was; never past a full circle.
	local corner = target:FindFirstChildOfClass("UICorner")
	local half = math.min(size.X, size.Y) / 2
	local uiScale = target:FindFirstChildOfClass("UIScale")
	local radius = if corner
		then corner.CornerRadius.Offset * (if uiScale then uiScale.Scale else 1) + corner.CornerRadius.Scale * half * 2
		elseif self.Options and self.Options.Round then half
		else 12
	radius = math.min(radius, half) + pad
	frame:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0, radius)
	frame.Edge:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0, radius + 4)
	frame.Glow.Transparency = 0.25 * (1 - pulse)
	return position - Vector2.new(pad, pad), size + Vector2.new(pad * 2, pad * 2)
end

-- Picks the side of the target with room for the hand + bubble (first that fits, in order).
local function chooseSide(sides, position: Vector2, size: Vector2, bounds: Vector2, need: Vector2, hand: number): string
	local best, bestRoom = sides[1], -math.huge
	for _, side in sides do
		local room
		if side == "Left" then
			room = position.X - (hand + GAP + need.X)
		elseif side == "Right" then
			room = bounds.X - (position.X + size.X) - (hand + GAP + need.X)
		elseif side == "Above" then
			room = position.Y - (hand + GAP + need.Y)
		else
			room = bounds.Y - (position.Y + size.Y) - (hand + GAP + need.Y)
		end
		if room >= 0 then
			return side
		end
		if room > bestRoom then
			best, bestRoom = side, room
		end
	end
	return best
end

local function clampBox(position: Vector2, size: Vector2, bounds: Vector2): Vector2
	return Vector2.new(
		math.clamp(position.X, 0, math.max(0, bounds.X - size.X)),
		math.clamp(position.Y, 0, math.max(0, bounds.Y - size.Y))
	)
end

-- Label only, bottom centre (above the bottom HUD, clear of the screen centre).
local function placeHint(self)
	local bounds = self.Root.AbsoluteSize
	local scale = math.clamp(bounds.Y / 620, 0.72, 1)
	local width = math.floor(math.min(320 * scale, bounds.X * 0.5))
	self.Bubble.Size = UDim2.fromOffset(width, 0)
	self.Title.TextSize = math.floor(22 * scale)
	self.Note.TextSize = math.floor(16 * scale)
	local height = math.max(self.Bubble.AbsoluteSize.Y, 30 * scale)
	self.Bubble.Position = UDim2.fromOffset((bounds.X - width) / 2, bounds.Y * 0.72 - height / 2)
	self.Ring.Visible = false
	self.Hand.Visible = false
	self.Bubble.Visible = true
end

function GuidePointer:update()
	local target = self.Target
	if not target then
		if self.Key and self.Options then
			placeHint(self)
		end
		return
	end
	if not target.Parent then
		self:clear() -- the button is gone
		return
	end
	if not GuidePointer.isOnScreen(target) or target.AbsoluteSize.X < 1 then
		self:setVisible(false)
		return
	end
	local bounds = self.Root.AbsoluteSize
	if bounds.X < 1 then
		return
	end
	local scale = math.clamp(bounds.Y / 620, 0.72, 1)
	local still = reducedMotion()
	local t = os.clock() - self.Started
	local wave = if still then 0 else 0.5 - 0.5 * math.cos(t * math.pi * 2 * BOUNCE_HZ)

	-- Rings
	local ringPosition, ringSize = placeRing(self, self.Ring, target, scale, wave)
	for index, extra in self.ExtraRings do
		local other = self.Options.Extra[index]
		local shown = other and GuidePointer.isOnScreen(other)
		extra.Visible = shown == true
		if shown then
			placeRing(self, extra, other, scale, wave)
		end
	end

	-- Bubble size (width fixed; height from the text)
	local bubbleWidth = math.floor(math.min(250 * scale, bounds.X * 0.42))
	self.Bubble.Size = UDim2.fromOffset(bubbleWidth, 0)
	self.Title.TextSize = math.floor(22 * scale)
	self.Note.TextSize = math.floor(16 * scale)
	local bubbleSize = Vector2.new(bubbleWidth, math.max(self.Bubble.AbsoluteSize.Y, 30 * scale))
	local hand = math.floor(40 * scale)

	-- Above a panel: measure "above" from the panel's top edge, not the button's.
	local aboveTop = ringPosition.Y
	local outside = self.Options.Outside
	if outside and GuidePointer.isOnScreen(outside) then
		local panelTop = (outside.AbsolutePosition - self.Root.AbsolutePosition).Y
		aboveTop = math.min(aboveTop, panelTop)
	end
	local placeRect = Vector2.new(ringPosition.X, aboveTop)
	local placeSize = Vector2.new(ringSize.X, ringSize.Y + (ringPosition.Y - aboveTop))
	local side = chooseSide(self.Options.Sides or DEFAULT_SIDES, placeRect, placeSize, bounds, bubbleSize, hand)
	local bounce = BOUNCE * scale * wave
	local centre = ringPosition + ringSize / 2
	local handPosition, bubblePosition
	if side == "Left" then
		handPosition = Vector2.new(ringPosition.X - GAP - hand - bounce, centre.Y - hand / 2)
		bubblePosition = Vector2.new(handPosition.X - GAP - bubbleSize.X, centre.Y - bubbleSize.Y / 2)
	elseif side == "Right" then
		handPosition = Vector2.new(ringPosition.X + ringSize.X + GAP + bounce, centre.Y - hand / 2)
		bubblePosition = Vector2.new(handPosition.X + hand + GAP, centre.Y - bubbleSize.Y / 2)
	elseif side == "Above" then
		handPosition = Vector2.new(centre.X - hand / 2, aboveTop - GAP - hand - bounce)
		bubblePosition = Vector2.new(centre.X - bubbleSize.X / 2, handPosition.Y - GAP - bubbleSize.Y)
	else
		handPosition = Vector2.new(centre.X - hand / 2, ringPosition.Y + ringSize.Y + GAP + bounce)
		bubblePosition = Vector2.new(centre.X - bubbleSize.X / 2, handPosition.Y + hand + GAP)
	end
	handPosition = clampBox(handPosition, Vector2.new(hand, hand), bounds)
	bubblePosition = clampBox(bubblePosition, bubbleSize, bounds)

	self.Hand.Text = HANDS[side]
	self.Hand.Size = UDim2.fromOffset(hand, hand)
	self.Hand.Position = UDim2.fromOffset(handPosition.X, handPosition.Y)
	self.Bubble.Position = UDim2.fromOffset(bubblePosition.X, bubblePosition.Y)
	self.Side = side
	self.Ring.Visible = true
	self.Hand.Visible = true
	self.Bubble.Visible = true
end

function GuidePointer:destroy()
	self:clear()
	self.Gui:Destroy()
end

return GuidePointer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--[[
	Hud
	Always-on pieces of the screen: round timer, minigame status line, the big centre
	banner (3-2-1 / GO! / FINISH!), the toast feed, and the lobby message pill.
]]

local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Theme = require(script.Parent.Theme)
local make = Theme.make

local Hud = {}
Hud.__index = Hud

-- Phones get a smaller, shorter-lived feed so it doesn't cover the left side of the arena.
local TOUCH = game:GetService("UserInputService").TouchEnabled
local MAX_TOASTS = if TOUCH then 2 else 4
local TOAST_LIFETIME = if TOUCH then 2.5 else 3.5
local TOAST_HEIGHT = if TOUCH then 26 else 36
local TOAST_TEXT_SIZE = if TOUCH then 14 else 20
local TOAST_WIDTH = if TOUCH then 0.24 else 0.3
local TOAST_MIN_WIDTH = if TOUCH then 170 else 220

function Hud.new(screen: ScreenGui)
	local self = setmetatable({}, Hud)

	-- Timer pill (top centre)
	self.TimerFrame = make("Frame", {
		Name = "Timer",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.fromOffset(150, 52),
		BackgroundColor3 = Theme.Colors.Card,
		Visible = false,
		Parent = screen,
	}, { Theme.corner(26), Theme.stroke(Theme.Colors.Accent, 3) })
	self.TimerLabel = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Font = Theme.TitleFont,
		Text = "0:00",
		Parent = self.TimerFrame,
	}, 40)

	-- Status line under the timer
	self.StatusLabel = Theme.label({
		Name = "Status",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.new(0.8, 0, 0, 34),
		TextStrokeTransparency = 0.3,
		Text = "",
		Visible = false,
		Parent = screen,
	}, 30)

	-- Big centre banner
	self.Banner = Theme.label({
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromScale(0.8, 0.25),
		Font = Theme.TitleFont,
		TextColor3 = Theme.Colors.Accent,
		TextStrokeTransparency = 0,
		Text = "",
		Visible = false,
		Parent = screen,
	}, 140)
	self.BannerToken = 0

	-- Toast feed (left side, newest at the bottom)
	self.ToastList = make("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromScale(TOAST_WIDTH, 0.4),
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		make("UIListLayout", {
			Padding = UDim.new(0, 6),
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		make("UISizeConstraint", { MinSize = Vector2.new(TOAST_MIN_WIDTH, 0) }),
	})
	self.ToastCount = 0

	-- Lobby pill (bottom centre)
	self.LobbyFrame = make("Frame", {
		Name = "Lobby",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.new(0.6, 0, 0, 50),
		BackgroundColor3 = Theme.Colors.Card,
		BackgroundTransparency = 0.15,
		Visible = false,
		Parent = screen,
	}, { Theme.corner(25), Theme.make("UISizeConstraint", { MaxSize = Vector2.new(560, 50) }) })
	self.LobbyLabel = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Font = Theme.TitleFont,
		Parent = self.LobbyFrame,
	}, 26)

	self.TimerEndsAt = nil
	self.LobbyText = nil
	self.LobbyEndsAt = nil
	return self
end

-- Called every frame by the client main script.
function Hud:update()
	local now = Workspace:GetServerTimeNow()
	if self.TimerEndsAt then
		local remaining = self.TimerEndsAt - now
		self.TimerLabel.Text = Theme.formatTime(remaining)
		self.TimerLabel.TextColor3 = if remaining <= 10 then Theme.Colors.Hot else Theme.Colors.Text
	end
	if self.LobbyText then
		local text = self.LobbyText
		if self.LobbyEndsAt then
			text ..= ("  %d"):format(math.max(0, math.ceil(self.LobbyEndsAt - now)))
		end
		self.LobbyLabel.Text = text
	end
end

function Hud:setTimer(endsAt: number?)
	self.TimerEndsAt = endsAt
	self.TimerFrame.Visible = endsAt ~= nil
end

function Hud:setStatus(text: string?)
	self.StatusLabel.Text = text or ""
	self.StatusLabel.Visible = text ~= nil and text ~= ""
end

function Hud:setLobby(text: string?, endsAt: number?)
	self.LobbyText = text
	self.LobbyEndsAt = endsAt
	self.LobbyFrame.Visible = text ~= nil
end

-- Pops a big message in the middle, then fades it after `hold` seconds.
function Hud:showBanner(text: string, color: Color3?, hold: number?)
	self.BannerToken += 1
	local token = self.BannerToken
	local banner = self.Banner
	banner.Text = text
	banner.TextColor3 = color or Theme.Colors.Accent
	banner.TextTransparency = 0
	banner.TextStrokeTransparency = 0
	banner.Visible = true
	Theme.pop(banner)
	task.delay(hold or 0.8, function()
		if self.BannerToken ~= token then
			return -- replaced by a newer banner
		end
		local fade = TweenService:Create(banner, TweenInfo.new(0.25), { TextTransparency = 1, TextStrokeTransparency = 1 })
		fade:Play()
		fade.Completed:Wait()
		if self.BannerToken == token then
			banner.Visible = false
		end
	end)
end

-- Removes every toast at once (e.g. when the results card opens, so none peek out behind it).
function Hud:clearToasts()
	for _, child in self.ToastList:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
end

function Hud:toast(text: string)
	self.ToastCount += 1
	local toast = make("Frame", {
		LayoutOrder = self.ToastCount,
		Size = UDim2.new(1, 0, 0, TOAST_HEIGHT),
		BackgroundColor3 = Theme.Colors.Card,
		BackgroundTransparency = 0.2,
		Parent = self.ToastList,
	}, { Theme.corner(10), Theme.padding(6) })
	local label = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = toast,
	}, TOAST_TEXT_SIZE)

	-- Keep the feed short.
	local toasts = {}
	for _, child in self.ToastList:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	table.sort(toasts, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for i = 1, #toasts - MAX_TOASTS do
		toasts[i]:Destroy()
	end

	task.delay(TOAST_LIFETIME, function()
		if toast.Parent then
			TweenService:Create(toast, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
			TweenService:Create(label, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
			task.wait(0.3)
			toast:Destroy()
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">InputHint</string>
              <string name="Source"><![CDATA[--[[
	InputHint
	Which kind of input this player is using, and how to name a control for it:
	  "Touch"    any touch screen (phones and Studio's phone emulator can report a keyboard
	             too, so touch wins: no keyboard text on a touch screen)
	  "Gamepad"  the last input came from a controller
	  "Mouse"    everything else (mouse + keyboard)
]]

local UserInputService = game:GetService("UserInputService")

local InputHint = {}

function InputHint.mode(): string
	local last = UserInputService:GetLastInputType()
	if string.sub(last.Name, 1, 7) == "Gamepad" then
		return "Gamepad"
	end
	if UserInputService.TouchEnabled then
		return "Touch"
	end
	return "Mouse"
end

-- "TAP" / "CLICK" / "PRESS"
function InputHint.verb(mode: string): string
	return if mode == "Touch" then "TAP" elseif mode == "Gamepad" then "PRESS" else "CLICK"
end

local KEY_NAMES = {
	One = "1",
	Two = "2",
	Three = "3",
	Four = "4",
	Left = "←",
	Right = "→",
	Up = "↑",
	Down = "↓",
	Return = "ENTER",
	LeftShift = "SHIFT",
}

-- KeyCode name -> what's printed on it: "Space" -> "SPACE", "ButtonA" -> "A", "One" -> "1".
function InputHint.keyName(name: string?): string?
	if type(name) ~= "string" or name == "" then
		return nil
	end
	if KEY_NAMES[name] then
		return KEY_NAMES[name]
	end
	if string.sub(name, 1, 6) == "Button" then
		return string.upper(string.sub(name, 7))
	end
	if string.sub(name, 1, 4) == "DPad" then
		return "D-PAD " .. string.upper(string.sub(name, 5))
	end
	return string.upper(name)
end

-- The gamepad button a minigame action is bound to (Controls uses the same defaults).
local DEFAULT_GAMEPAD = { "ButtonX", "ButtonY", "ButtonB" }
function InputHint.gamepadFor(action, index: number): string?
	if type(action.Gamepads) == "table" and action.Gamepads[1] then
		return action.Gamepads[1]
	end
	return action.Gamepad or DEFAULT_GAMEPAD[index]
end

function InputHint.keyFor(action): string?
	if type(action.Keys) == "table" and action.Keys[1] then
		return action.Keys[1]
	end
	return action.Key
end

-- An action's button label as one short word: "Mash!" -> "MASH".
function InputHint.actionWord(label: string?): string
	local word = string.upper(string.gsub(label or "", "[!%.]", ""))
	return if word == "" then "GO" else word
end

return InputHint
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">InstructionsCard</string>
              <string name="Source"><![CDATA[--[[
	InstructionsCard
	"How to play" card shown while the server builds the arena and teleports everyone:
	name, layout, description, controls, and (for 1v3 / 2v2) who is on which team.
]]

local Workspace = game:GetService("Workspace")

local InputHint = require(script.Parent.InputHint)
local Theme = require(script.Parent.Theme)
local make = Theme.make

local InstructionsCard = {}
InstructionsCard.__index = InstructionsCard

function InstructionsCard.new(screen: ScreenGui)
	local self = setmetatable({}, InstructionsCard)
	self.EndsAt = nil

	self.Root = make("Frame", {
		Name = "Instructions",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.7, 0.7),
		BackgroundColor3 = Theme.Colors.Card,
		Visible = false,
		Parent = screen,
	}, {
		Theme.corner(22),
		Theme.stroke(Theme.Colors.Accent, 4),
		Theme.padding(18),
		make("UISizeConstraint", { MaxSize = Vector2.new(720, 460) }),
	})

	self.Title = Theme.label({
		Size = UDim2.fromScale(1, 0.18),
		Font = Theme.TitleFont,
		TextColor3 = Theme.Colors.Accent,
		Parent = self.Root,
	}, 52)
	self.Layout = Theme.label({
		Position = UDim2.fromScale(0, 0.19),
		Size = UDim2.fromScale(1, 0.08),
		TextColor3 = Theme.Colors.Cool,
		Parent = self.Root,
	}, 22)
	self.Description = Theme.label({
		Position = UDim2.fromScale(0, 0.3),
		Size = UDim2.fromScale(1, 0.28),
		Parent = self.Root,
	}, 26)
	self.Controls = Theme.label({
		Position = UDim2.fromScale(0, 0.6),
		Size = UDim2.fromScale(1, 0.13),
		TextColor3 = Theme.Colors.Good,
		Parent = self.Root,
	}, 24)
	self.Teams = Theme.label({
		Position = UDim2.fromScale(0, 0.74),
		Size = UDim2.fromScale(1, 0.12),
		RichText = true,
		Parent = self.Root,
	}, 20)
	self.Clock = Theme.label({
		Position = UDim2.fromScale(0, 0.88),
		Size = UDim2.fromScale(1, 0.12),
		Font = Theme.TitleFont,
		TextColor3 = Theme.Colors.Muted,
		Parent = self.Root,
	}, 24)
	return self
end

-- mode = InputHint.mode(): touch shows only the button labels, a keyboard shows the key,
-- a gamepad shows the controller button when the action has one.
function InstructionsCard.controlsText(controls, mode: string): string
	local parts = {}
	if controls.Move and controls.Jump then
		table.insert(parts, "🕹 Move + Jump")
	elseif controls.Move then
		table.insert(parts, "🕹 Move (no jumping)")
	else
		table.insert(parts, "🔒 You can't walk this round")
	end
	for index, action in controls.Actions do
		local input = if mode == "Mouse"
			then InputHint.keyName(InputHint.keyFor(action))
			elseif mode == "Gamepad" then InputHint.keyName(InputHint.gamepadFor(action, index))
			else nil
		if input then
			table.insert(parts, ("[%s] %s"):format(input, action.Label))
		else
			table.insert(parts, ("👆 %s button"):format(action.Label))
		end
	end
	return table.concat(parts, "    ")
end

local function teamsText(participants, myId: string): string
	local teams = { {}, {} }
	for _, participant in participants do
		if participant.Team then
			local name = participant.Name
			if participant.Id == myId then
				name = "<b>YOU</b>"
			end
			table.insert(teams[participant.Team], name)
		end
	end
	if #teams[1] == 0 then
		return ""
	end
	local function hex(color: Color3)
		return color:ToHex()
	end
	return ('<font color="#%s">%s</font>   vs   <font color="#%s">%s</font>'):format(
		hex(Theme.TeamColors[1]),
		table.concat(teams[1], ", "),
		hex(Theme.TeamColors[2]),
		table.concat(teams[2], ", ")
	)
end

function InstructionsCard:show(minigame, participants, endsAt: number, myId: string)
	self.EndsAt = endsAt
	self.Title.Text = minigame.Name
	self.Layout.Text = ("%s  •  %d seconds"):format(minigame.Layout, minigame.Duration)
	self.Description.Text = minigame.Description
	self.Controls.Text = InstructionsCard.controlsText(minigame.Controls, InputHint.mode())
	self.Teams.Text = teamsText(participants, myId)
	self.Root.Visible = true
	Theme.pop(self.Root)
end

function InstructionsCard:update()
	if self.Root.Visible and self.EndsAt then
		local remaining = math.max(0, math.ceil(self.EndsAt - Workspace:GetServerTimeNow()))
		self.Clock.Text = ("Get ready... %d"):format(remaining)
	end
end

function InstructionsCard:hide()
	self.Root.Visible = false
end

return InstructionsCard
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">LobbyPanel</string>
              <string name="Source"><![CDATA[--[[
	LobbyPanel
	Waiting-room card (bottom centre, so the lobby stays visible). Three parts, so every
	control stays on screen whatever the screen size:
	  * header: title, countdown and the SHOP button, plus one status line (players, host,
	    bank coins) that is cut short rather than allowed to push anything out
	  * settings body: Mode, Board, Rounds, Bots and the wardrobe row. Only this part scrolls,
	    when the screen is too short to show it all (touch drag, mouse wheel, gamepad selection)
	  * right column: START for the host, a waiting note for everyone else; never scrolls
	On touch screens the card also stays between Roblox's thumbstick and jump button.
	The card fits itself between Roblox's top bar and the bottom of the screen at the HUD scale
	Main applies (LobbyPanel.fitHeight). The host can change settings and start early; everyone
	else just sees them. Wardrobe: tap a cosmetic you own to wear it, tap again to take it off.
	The server checks every change.
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Theme = require(script.Parent.Theme)
local make = Theme.make

local LobbyPanel = {}
LobbyPanel.__index = LobbyPanel

-- Layout, in design units (Main's UIScale turns them into pixels; 52 units is 44 px at the
-- smallest waiting-room scale, 0.85).
LobbyPanel.WIDTH = 640
LobbyPanel.PADDING = 12
LobbyPanel.HEADER = 52 -- title, countdown, SHOP
LobbyPanel.INFO = 24 -- status line
LobbyPanel.GAP = 8
LobbyPanel.ROW = 52 -- one settings row (touch-sized buttons)
LobbyPanel.BOTTOM_MARGIN = 16 -- design units from the bottom of the screen
LobbyPanel.TOP_MARGIN = 8 -- pixels kept free below Roblox's top bar
LobbyPanel.CONTROL_GAP = 16 -- pixels kept free beside Roblox's thumbstick and jump button
LobbyPanel.BODY_TOP = LobbyPanel.HEADER + 4 + LobbyPanel.INFO + LobbyPanel.GAP
local BODY_TOP = LobbyPanel.BODY_TOP

--[[
	Card height (design units) for `rows` settings rows on a screen `screenHeight` pixels tall
	with `topInset` pixels of Roblox top bar, at UI scale `scale`. Tall screens show the whole
	list; shorter ones get a shorter card whose settings body scrolls. Never taller than the free
	space, never shorter than the header plus one row (so START and SHOP always fit).
	Returns height, natural height (everything showing).
]]
function LobbyPanel.fitHeight(rows: number, screenHeight: number, topInset: number, scale: number)
	local natural = LobbyPanel.PADDING * 2 + BODY_TOP + rows * LobbyPanel.ROW + math.max(0, rows - 1) * LobbyPanel.GAP
	local minimum = LobbyPanel.PADDING * 2 + BODY_TOP + LobbyPanel.ROW
	local free = (screenHeight - topInset - LobbyPanel.TOP_MARGIN) / math.max(scale, 0.01) - LobbyPanel.BOTTOM_MARGIN
	return math.max(minimum, math.min(natural, free)), natural
end

--[[
	Card width (design units): the full WIDTH, unless Roblox's touch controls sit in the bottom
	corners, in which case the card stays between them. `reserve` = pixels each side to keep
	free (0 without touch controls).
]]
function LobbyPanel.fitWidth(screenWidth: number, reserve: number, scale: number): number
	local free = (screenWidth - 2 * reserve) / math.max(scale, 0.01)
	return math.max(math.min(LobbyPanel.WIDTH, free), LobbyPanel.WIDTH * 0.7)
end

-- Pixels to keep free on each side for the thumbstick and jump button (0 when there are none).
local function touchReserve(screenWidth: number): number
	if not UserInputService.TouchEnabled then
		return 0
	end
	local touchGui = Players.LocalPlayer:FindFirstChild("PlayerGui")
		and Players.LocalPlayer.PlayerGui:FindFirstChild("TouchGui")
	local stick = touchGui and touchGui:FindFirstChild("ThumbstickStart", true)
	local jump = touchGui and touchGui:FindFirstChild("JumpButton", true)
	local left = if stick then stick.AbsolutePosition.X + stick.AbsoluteSize.X else screenWidth * 0.14
	local right = if jump then screenWidth - jump.AbsolutePosition.X else screenWidth * 0.13
	return math.max(left, right) + LobbyPanel.CONTROL_GAP
end

-- How a board id reads to players (the server sends each board's DisplayName).
local function boardName(message, id): string
	local names = message and message.BoardNames
	return names and names[id] or tostring(id)
end

function LobbyPanel.new(screen: ScreenGui, send: (any) -> ())
	local self = setmetatable(
		{ Send = send, EndsAt = nil, Inventory = nil, LastMessage = nil, Screen = screen, Rows = 5 },
		LobbyPanel
	)

	self.Root = make("Frame", {
		Name = "WaitingRoom",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -LobbyPanel.BOTTOM_MARGIN),
		Size = UDim2.fromOffset(LobbyPanel.WIDTH, 404),
		BackgroundColor3 = Theme.Colors.Card,
		BackgroundTransparency = 0.05,
		Visible = false,
		Parent = screen,
	}, { Theme.corner(20), Theme.stroke(Theme.Colors.Accent, 3), Theme.padding(LobbyPanel.PADDING) })

	-- Header: title | countdown | SHOP
	self.Title = Theme.label({
		Size = UDim2.new(0.36, 0, 0, LobbyPanel.HEADER),
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Theme.TitleFont,
		TextColor3 = Theme.Colors.Accent,
		Text = "PARTY GAMES",
		Parent = self.Root,
	}, 32)
	self.Clock = Theme.label({
		Position = UDim2.fromScale(0.36, 0),
		Size = UDim2.new(0.42, -8, 0, LobbyPanel.HEADER),
		TextXAlignment = Enum.TextXAlignment.Right,
		Font = Theme.TitleFont,
		Parent = self.Root,
	}, 30)
	-- On a narrow card (phones) the title and countdown shrink to fit instead of overlapping.
	for label, size in { [self.Title] = 32, [self.Clock] = 30 } do
		label.TextScaled = true
		make("UITextSizeConstraint", { MaxTextSize = size, MinTextSize = 14, Parent = label })
	end
	-- Opens the permanent Cosmetics Shop (bank coins). In the header so it never scrolls away.
	self.ShopButton = make("TextButton", {
		Name = "ShopButton",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.22, 0, 0, LobbyPanel.HEADER),
		BackgroundColor3 = Theme.Colors.Accent,
		Font = Theme.TitleFont,
		TextScaled = true,
		TextColor3 = Theme.Colors.Overlay,
		Text = "SHOP",
		Parent = self.Root,
	}, { Theme.corner(12), Theme.padding(8), make("UITextSizeConstraint", { MaxTextSize = 26 }) })
	self.ShopButton.Activated:Connect(function()
		if self.OnShop then
			self.OnShop()
		end
	end)
	self.Info = Theme.label({
		Position = UDim2.fromOffset(0, LobbyPanel.HEADER + 4),
		Size = UDim2.new(1, 0, 0, LobbyPanel.INFO),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Colors.Muted,
		TextTruncate = Enum.TextTruncate.AtEnd, -- long names never push the controls out
		Parent = self.Root,
	}, 20)

	-- Settings body: the only part that scrolls.
	self.SettingRows = make("ScrollingFrame", {
		Name = "Settings",
		Position = UDim2.fromOffset(0, BODY_TOP),
		Size = UDim2.new(0.72, 0, 1, -BODY_TOP),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Colors.Accent,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
		Parent = self.Root,
	}, { make("UIListLayout", { Padding = UDim.new(0, LobbyPanel.GAP), SortOrder = Enum.SortOrder.LayoutOrder }) })

	-- Right column: START (host) or a waiting note (everyone else). Never scrolls.
	self.StartButton = make("TextButton", {
		Name = "StartButton",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, BODY_TOP),
		Size = UDim2.new(0.26, 0, 1, -BODY_TOP),
		BackgroundColor3 = Theme.Colors.Good,
		Font = Theme.TitleFont,
		TextScaled = true,
		TextColor3 = Theme.Colors.Overlay,
		Text = "START",
		Visible = false,
		Parent = self.Root,
	}, { Theme.corner(16), Theme.padding(10), make("UITextSizeConstraint", { MaxTextSize = 34 }) })
	self.StartButton.Activated:Connect(function()
		self.Send({ Kind = "StartMatch" })
	end)
	self.WaitingNote = Theme.label({
		Name = "WaitingNote",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, BODY_TOP),
		Size = UDim2.new(0.26, 0, 1, -BODY_TOP),
		TextWrapped = true,
		TextColor3 = Theme.Colors.Muted,
		Text = "The host starts the match, or it starts when the timer ends",
		Visible = false,
		Parent = self.Root,
	}, 20)

	-- Re-fit whenever the screen or the HUD scale changes.
	screen:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:fit()
	end)
	self.Root:GetAttributeChangedSignal("HudScale"):Connect(function()
		self:fit()
	end)
	return self
end

-- Sizes the card to the screen (see LobbyPanel.fitHeight).
function LobbyPanel:fit()
	local screenHeight = self.Screen.AbsoluteSize.Y
	if screenHeight <= 0 then
		return
	end
	local scale = self.Root:GetAttribute("HudScale") or 1
	local inset = if self.Screen.IgnoreGuiInset then GuiService:GetGuiInset().Y else 0
	local height = LobbyPanel.fitHeight(self.Rows, screenHeight, inset, scale)
	local screenWidth = self.Screen.AbsoluteSize.X
	local width = LobbyPanel.fitWidth(screenWidth, touchReserve(screenWidth), scale)
	self.Root.Size = UDim2.fromOffset(width, height)
end

-- Owned cosmetics as toggles; the server confirms with a fresh Inventory message.
local function wardrobeRow(self, order: number)
	local inventory = self.Inventory or { Owned = {}, Equipped = {} }
	local row = make("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, LobbyPanel.ROW),
		BackgroundTransparency = 1,
		Parent = self.SettingRows,
	})
	Theme.label({
		Size = UDim2.new(0.28, 0, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "Wear",
		Parent = row,
	}, 22)
	local buttons = make("ScrollingFrame", {
		Position = UDim2.fromScale(0.28, 0),
		Size = UDim2.fromScale(0.72, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(),
		Parent = row,
	}, {
		make("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	if #inventory.Owned == 0 then
		Theme.label({
			Size = UDim2.new(1, 0, 1, 0),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Theme.Colors.Muted,
			TextWrapped = true,
			Text = "Win cosmetics at Shop and Gift spaces",
			Parent = buttons,
		}, 18)
		return
	end
	for index, item in inventory.Owned do
		local worn = inventory.Equipped[item.Slot] == item.Id
		local button = make("TextButton", {
			LayoutOrder = index,
			Size = UDim2.new(0, 120, 1, -6),
			BackgroundColor3 = if worn then Theme.Colors.Good else Theme.Colors.CardLight,
			Font = Theme.BodyFont,
			TextScaled = true,
			TextColor3 = if worn then Theme.Colors.Overlay else Theme.Colors.Text,
			Text = item.Name,
			Parent = buttons,
		}, { Theme.corner(12), Theme.padding(6), make("UITextSizeConstraint", { MaxTextSize = 20 }) })
		button.Activated:Connect(function()
			if worn then
				self.Send({ Kind = "Unequip", Slot = item.Slot })
			else
				self.Send({ Kind = "Equip", ItemId = item.Id })
			end
		end)
	end
end

-- New bank balance / wardrobe (e.g. after a shop purchase): rebuild the card's contents even
-- while the shop is covering it, without changing whether it's showing.
function LobbyPanel:setInventory(message)
	self.Inventory = message
	if self.LastMessage then
		self:render(self.LastMessage)
	end
end

local function settingRow(self, order: number, label: string, key: string, choices, selected, isHost: boolean)
	local row = make("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, LobbyPanel.ROW),
		BackgroundTransparency = 1,
		Parent = self.SettingRows,
	})
	Theme.label({
		Size = UDim2.new(0.28, 0, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = label,
		Parent = row,
	}, 22)
	local buttons = make("Frame", {
		Position = UDim2.fromScale(0.28, 0),
		Size = UDim2.fromScale(0.72, 1),
		BackgroundTransparency = 1,
		Parent = row,
	}, {
		make("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for index, choice in choices do
		local isSelected = choice == selected
		local button = make("TextButton", {
			LayoutOrder = index,
			Size = UDim2.new(1 / #choices, -6, 1, 0),
			BackgroundColor3 = if isSelected then Theme.Colors.Accent else Theme.Colors.CardLight,
			BackgroundTransparency = if isHost or isSelected then 0 else 0.5,
			AutoButtonColor = isHost,
			Font = Theme.BodyFont,
			TextScaled = true,
			TextColor3 = if isSelected then Theme.Colors.Overlay else Theme.Colors.Text,
			Text = if key == "Board" then boardName(self.LastMessage, choice) else tostring(choice),
			Parent = buttons,
		}, { Theme.corner(12), Theme.padding(6), make("UITextSizeConstraint", { MaxTextSize = 24 }) })
		if isHost then
			button.Activated:Connect(function()
				self.Send({ Kind = "Setting", Key = key, Value = choice })
			end)
		end
	end
end

-- Fills the card from a waiting-room message (status line, settings, wardrobe, START).
function LobbyPanel:render(message)
	local isHost = message.HostId == Players.LocalPlayer.UserId
	self.LastMessage = message
	self.EndsAt = message.EndsAt
	self.Info.Text = ("%d / %d players  ·  bots fill empty seats  ·  %s  ·  bank: %d coins"):format(
		message.PlayerCount or 1,
		message.Seats or 4,
		if isHost then "you're the host" else ("host: %s"):format(message.HostName or "?"),
		self.Inventory and self.Inventory.BankCoins or 0
	)
	for _, child in self.SettingRows:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local settings = message.Settings or {}
	local choices = message.Choices or {}
	local rows = 4 -- Mode, Rounds, Bots, wardrobe
	settingRow(self, 0, "Mode", "Mode", choices.Mode or {}, settings.Mode, isHost)
	if choices.Board and #choices.Board > 1 and settings.Mode == "Board" then
		settingRow(self, 1, "Board", "Board", choices.Board, settings.Board, isHost)
		rows += 1
	end
	settingRow(self, 2, "Rounds", "Rounds", choices.Rounds or {}, settings.Rounds, isHost)
	settingRow(self, 3, "Bots", "Difficulty", choices.Difficulty or {}, settings.Difficulty, isHost)
	wardrobeRow(self, 4)
	self.Rows = rows
	self:fit()
	self.StartButton.Visible = isHost
	self.WaitingNote.Visible = not isHost
end

function LobbyPanel:show(message)
	self:render(message)
	if not self.Root.Visible then
		self.Root.Visible = true
		Theme.pop(self.Root)
	end
end

function LobbyPanel:hide()
	self.Root.Visible = false
end

function LobbyPanel:update()
	if self.Root.Visible and self.EndsAt then
		self.Clock.Text = ("Starts in %ds"):format(math.max(0, math.ceil(self.EndsAt - Workspace:GetServerTimeNow())))
	end
end

return LobbyPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">PlayerChips</string>
              <string name="Source"><![CDATA[--[[
	PlayerChips
	The strip of four player chips under the timer: name, team colour, the live value the
	minigame reports with ReportProgress, and a crossed-out look once eliminated.
]]

local Theme = require(script.Parent.Theme)
local make = Theme.make

local PlayerChips = {}
PlayerChips.__index = PlayerChips

function PlayerChips.new(screen: ScreenGui)
	local self = setmetatable({}, PlayerChips)
	self.Root = make("Frame", {
		Name = "PlayerChips",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 108),
		Size = UDim2.new(0.9, 0, 0, 60),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = screen,
	}, {
		make("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		make("UISizeConstraint", { MaxSize = Vector2.new(700, 60) }),
	})
	self.Chips = {} -- Id -> widgets
	return self
end

local function buildChip(parent: Instance, order: number)
	local frame = make("Frame", {
		LayoutOrder = order,
		Size = UDim2.fromScale(0.24, 1),
		BackgroundColor3 = Theme.Colors.Card,
		BackgroundTransparency = 0.1,
		Parent = parent,
	}, { Theme.corner(12), Theme.padding(4) })
	local stroke = Theme.stroke(Theme.Colors.CardLight, 2)
	stroke.Parent = frame
	local name = Theme.label({
		Size = UDim2.fromScale(1, 0.4),
		Parent = frame,
	}, 16)
	local value = Theme.label({
		Position = UDim2.fromScale(0, 0.4),
		Size = UDim2.fromScale(1, 0.4),
		Font = Theme.TitleFont,
		TextColor3 = Theme.Colors.Accent,
		Parent = frame,
	}, 22)
	local caption = Theme.label({
		Position = UDim2.fromScale(0, 0.8),
		Size = UDim2.fromScale(1, 0.2),
		TextColor3 = Theme.Colors.Muted,
		Parent = frame,
	}, 11)
	return { Frame = frame, Stroke = stroke, Name = name, Value = value, Caption = caption }
end

function PlayerChips:update(chips, myId: string)
	local seen = {}
	for order, chip in chips do
		seen[chip.Id] = true
		local widgets = self.Chips[chip.Id] or buildChip(self.Root, order)
		self.Chips[chip.Id] = widgets
		widgets.Frame.LayoutOrder = order

		local isMe = chip.Id == myId
		widgets.Name.Text = (if chip.IsBot then "🤖 " else "") .. (if isMe then "YOU" else chip.Name)
		widgets.Value.Text = if chip.Eliminated
			then "❌ " .. (if chip.Value ~= nil then tostring(chip.Value) else "OUT")
			elseif chip.Value ~= nil then tostring(chip.Value)
			else "—"
		widgets.Caption.Text = chip.Label or ""
		widgets.Stroke.Color = if isMe
			then Theme.Colors.Accent
			elseif chip.Team then Theme.TeamColors[chip.Team]
			else Theme.Colors.CardLight
		widgets.Stroke.Thickness = if isMe then 3 else 2
		widgets.Frame.BackgroundTransparency = if chip.Eliminated then 0.6 else 0.1
		widgets.Value.TextColor3 = if chip.Eliminated then Theme.Colors.Muted else Theme.Colors.Accent
	end
	for id, widgets in self.Chips do
		if not seen[id] then
			widgets.Frame:Destroy()
			self.Chips[id] = nil
		end
	end
end

function PlayerChips:show()
	self.Root.Visible = true
end

function PlayerChips:hide()
	self.Root.Visible = false
	for id, widgets in self.Chips do
		widgets.Frame:Destroy()
		self.Chips[id] = nil
	end
end

return PlayerChips
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">ProgressBar</string>
              <string name="Source"><![CDATA[--[[
	ProgressBar
	Race bar along the top of the screen: one marker per participant sliding from the start
	(left) to the finish flag (right). Used instead of the chip strip by minigames with
	Info.ProgressBar = true. It is fed by the same chip list: a value like "37%" places the
	marker, and any value containing 🏁 counts as finished.
]]

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)
local make = Theme.make

local ProgressBar = {}
ProgressBar.__index = ProgressBar

local MARKER_SIZE = 26
local MARKER_COLORS = {
	Theme.Colors.Accent,
	Theme.Colors.Hot,
	Theme.Colors.Cool,
	Theme.Colors.Good,
}

function ProgressBar.new(screen: ScreenGui)
	local self = setmetatable({}, ProgressBar)
	self.Root = make("Frame", {
		Name = "ProgressBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 112),
		Size = UDim2.new(0.86, 0, 0, 44),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = screen,
	})
	-- The track the markers slide along (leaves room for the flag on the right).
	self.Track = make("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, MARKER_SIZE, 0.5, 0),
		Size = UDim2.new(1, -MARKER_SIZE * 3, 0, 12),
		BackgroundColor3 = Theme.Colors.Card,
		BackgroundTransparency = 0.1,
		Parent = self.Root,
	}, { Theme.corner(6), Theme.stroke(Theme.Colors.CardLight, 2) })
	Theme.label({
		Name = "Flag",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(MARKER_SIZE + 6, MARKER_SIZE + 6),
		Text = "🏁",
		Parent = self.Root,
	}, 26)
	self.Markers = {}
	return self
end

local function fractionOf(value): number
	if type(value) == "number" then
		return math.clamp(value / 100, 0, 1)
	end
	if type(value) ~= "string" then
		return 0
	end
	if value:find("🏁", 1, true) then
		return 1
	end
	local percent = tonumber(value:match("(%d+)%%"))
	return if percent then math.clamp(percent / 100, 0, 1) else 0
end

local function buildMarker(track: Frame, order: number)
	local color = MARKER_COLORS[(order - 1) % #MARKER_COLORS + 1]
	local stroke = Theme.stroke(Color3.new(1, 1, 1), 2)
	local frame = make("Frame", {
		Name = "Marker",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(MARKER_SIZE, MARKER_SIZE),
		BackgroundColor3 = color,
		Parent = track,
	}, { Theme.corner(MARKER_SIZE // 2), stroke })
	local tag = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Font = Theme.TitleFont,
		TextColor3 = Theme.Colors.Overlay,
		Text = "",
		Parent = frame,
	}, 14)
	return { Frame = frame, Stroke = stroke, Tag = tag }
end

function ProgressBar:update(chips, myId: string)
	local seen = {}
	for order, chip in chips do
		seen[chip.Id] = true
		local marker = self.Markers[chip.Id] or buildMarker(self.Track, order)
		self.Markers[chip.Id] = marker

		local isMe = chip.Id == myId
		marker.Tag.Text = if isMe then "YOU" else string.sub(chip.Name, 1, 1)
		marker.Stroke.Color = if isMe then Theme.Colors.Accent else Color3.new(1, 1, 1)
		marker.Stroke.Thickness = if isMe then 3 else 2
		marker.Frame.ZIndex = if isMe then 5 else 2
		local size = if isMe then MARKER_SIZE + 8 else MARKER_SIZE
		marker.Frame.Size = UDim2.fromOffset(size, size)

		local goal = UDim2.fromScale(fractionOf(chip.Value), 0.5)
		TweenService:Create(marker.Frame, TweenInfo.new(0.2, Enum.EasingStyle.Linear), { Position = goal }):Play()
	end
	for id, marker in self.Markers do
		if not seen[id] then
			marker.Frame:Destroy()
			self.Markers[id] = nil
		end
	end
end

function ProgressBar:show()
	self.Root.Visible = true
end

function ProgressBar:hide()
	self.Root.Visible = false
	for id, marker in self.Markers do
		marker.Frame:Destroy()
		self.Markers[id] = nil
	end
end

return ProgressBar
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">ResultsScreen</string>
              <string name="Source"><![CDATA[--[[
	ResultsScreen
	Placements and coins awarded, exactly as the server ranked them.
]]

local Theme = require(script.Parent.Theme)
local make = Theme.make

local ResultsScreen = {}
ResultsScreen.__index = ResultsScreen

function ResultsScreen.new(screen: ScreenGui)
	local self = setmetatable({}, ResultsScreen)

	self.Root = make("Frame", {
		Name = "Results",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.7, 0.75),
		BackgroundColor3 = Theme.Colors.Card,
		Visible = false,
		Parent = screen,
	}, {
		Theme.corner(22),
		Theme.stroke(Theme.Colors.Accent, 4),
		Theme.padding(18),
		make("UISizeConstraint", { MaxSize = Vector2.new(680, 500) }),
	})
	self.Title = Theme.label({
		Size = UDim2.fromScale(1, 0.16),
		Font = Theme.TitleFont,
		TextColor3 = Theme.Colors.Accent,
		Parent = self.Root,
	}, 46)
	self.List = make("Frame", {
		Position = UDim2.fromScale(0, 0.2),
		Size = UDim2.fromScale(1, 0.8),
		BackgroundTransparency = 1,
		Parent = self.Root,
	}, {
		make("UIListLayout", {
			Padding = UDim.new(0.03, 0),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	return self
end

local function buildRow(parent: Instance, index: number, row, isMe: boolean)
	local placeColor = Theme.PlacementColors[row.Placement] or Theme.PlacementColors[4]
	local frame = make("Frame", {
		LayoutOrder = index,
		Size = UDim2.fromScale(1, 0.22),
		BackgroundColor3 = if isMe then Theme.Colors.CardLight else Theme.Colors.Overlay,
		Parent = parent,
	}, { Theme.corner(12), Theme.padding(6) })
	if isMe then
		Theme.stroke(Theme.Colors.Accent, 2).Parent = frame
	end

	Theme.label({
		Size = UDim2.fromScale(0.16, 1),
		Font = Theme.TitleFont,
		TextColor3 = placeColor,
		Text = Theme.ordinal(row.Placement),
		Parent = frame,
	}, 34)
	local name = (if row.IsBot then "🤖 " else "") .. row.Name .. (if isMe then " (you)" else "")
	Theme.label({
		Position = UDim2.fromScale(0.18, 0),
		Size = UDim2.fromScale(0.46, 1),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = if row.Team then Theme.TeamColors[row.Team] else Theme.Colors.Text,
		Text = name,
		Parent = frame,
	}, 26)
	Theme.label({
		Position = UDim2.fromScale(0.64, 0),
		Size = UDim2.fromScale(0.16, 1),
		Font = Theme.TitleFont,
		TextColor3 = if row.Coins > 0 then Theme.Colors.Accent else Theme.Colors.Muted,
		Text = ("+%d 🪙"):format(row.Coins),
		Parent = frame,
	}, 28)
	Theme.label({
		Position = UDim2.fromScale(0.8, 0),
		Size = UDim2.fromScale(0.2, 1),
		TextColor3 = Theme.Colors.Muted,
		Text = ("Total %d"):format(row.Total),
		Parent = frame,
	}, 20)
end

function ResultsScreen:show(minigame, rows, myId: string)
	for _, child in self.List:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	self.Title.Text = ("🏆 %s — Results"):format(minigame.Name)
	for index, row in rows do
		buildRow(self.List, index, row, row.Id == myId)
	end
	self.Root.Visible = true
	Theme.pop(self.Root)
end

function ResultsScreen:hide()
	self.Root.Visible = false
end

return ResultsScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">ShopScreen</string>
              <string name="Source"><![CDATA[--[[
	ShopScreen
	The permanent Cosmetics Shop, opened from the waiting room (SHOP button, B key or
	gamepad Select). Functional placeholder look: one card per cosmetic with a big colour
	swatch standing in for the hero image, name, slot, rarity, bank price and state.

	  PREVIEW   shows it on your own character, only on your screen, until you close the shop
	  BUY       tap once to see the price, tap again within 3 s to confirm (server checks all)
	  WEAR / REMOVE  equip / unequip something you own

	Sits on the right so your character stays visible on the left; never covers Roblox's
	top bar. The server decides everything; this only sends requests and shows replies.
]]

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Cosmetics = require(ReplicatedStorage:WaitForChild("PartyShared"):WaitForChild("Cosmetics"))
local Theme = require(script.Parent.Theme)
local make = Theme.make

local ShopScreen = {}
ShopScreen.__index = ShopScreen

local TOGGLE_ACTION = "PartyShopToggle"
local PREVIEW_TAG = "PartyPreview"
local CONFIRM_TIME = 3
local RARITY_COLORS = {
	Common = Color3.fromRGB(200, 200, 215),
	Rare = Color3.fromRGB(90, 170, 255),
	Epic = Color3.fromRGB(200, 110, 255),
}

local function rgb(c)
	return Color3.fromRGB(c[1], c[2], c[3])
end

-- The colour that stands in for an item's hero image.
local function swatchColor(item): Color3
	local visual = item.Visual or {}
	if visual.Color then
		return rgb(visual.Color)
	elseif visual.Colors then
		return rgb(visual.Colors[1])
	end
	return Theme.Colors.CardLight
end

function ShopScreen.new(screen: ScreenGui, send: (any) -> ())
	local self = setmetatable({ Send = send, Inventory = nil, Pending = nil, PreviewId = nil, Open = false }, ShopScreen)

	self.Root = make("Frame", {
		Name = "CosmeticShop",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.fromOffset(580, 360),
		BackgroundColor3 = Theme.Colors.Card,
		BackgroundTransparency = 0.05,
		Visible = false,
		Parent = screen,
	}, { Theme.corner(18), Theme.stroke(Theme.Colors.Accent, 3), Theme.padding(10) })

	self.Title = Theme.label({
		Size = UDim2.new(0.62, 0, 0, 34),
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Theme.TitleFont,
		TextColor3 = Theme.Colors.Accent,
		Text = "COSMETICS SHOP",
		Parent = self.Root,
	}, 28)
	self.Balance = Theme.label({
		Position = UDim2.fromOffset(0, 34),
		Size = UDim2.new(0.7, 0, 0, 22),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "Bank: 0 coins",
		Parent = self.Root,
	}, 20)
	self.CloseButton = make("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(110, 52),
		BackgroundColor3 = Theme.Colors.CardLight,
		Font = Theme.TitleFont,
		TextScaled = true,
		TextColor3 = Theme.Colors.Text,
		Text = "CLOSE",
		Parent = self.Root,
	}, { Theme.corner(12), Theme.padding(8) })
	self.CloseButton.Activated:Connect(function()
		self:close()
	end)

	self.Grid = make("ScrollingFrame", {
		Name = "Cards",
		Position = UDim2.fromOffset(0, 62),
		Size = UDim2.new(1, 0, 1, -62 - 30),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = self.Root,
	}, {
		make("UIGridLayout", {
			CellSize = UDim2.fromOffset(176, 222),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	self.Status = Theme.label({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Colors.Muted,
		Text = "",
		Parent = self.Root,
	}, 20)
	return self
end

-- Preview ------------------------------------------------------------------------------------
-- Client-only parts on your own character (nobody else sees them; the server's real
-- cosmetics are left alone).

function ShopScreen:clearPreview()
	local character = Players.LocalPlayer.Character
	if character then
		for _, descendant in character:GetDescendants() do
			if string.sub(descendant.Name, 1, #PREVIEW_TAG) == PREVIEW_TAG then
				descendant:Destroy()
			end
		end
	end
	self.PreviewId = nil
end

function ShopScreen:preview(item)
	self:clearPreview()
	local character = Players.LocalPlayer.Character
	local visual = item.Visual
	if not character or not visual then
		return
	end
	local head = character:FindFirstChild("Head") :: BasePart?
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if visual.Kind == "Hat" and head then
		local hat = Instance.new("Part")
		hat.Name = PREVIEW_TAG .. "Hat"
		hat.Shape = Enum.PartType[visual.Shape] or Enum.PartType.Block
		hat.Size = Vector3.new(visual.Size[1], visual.Size[2], visual.Size[3])
		hat.Color = rgb(visual.Color)
		hat.CanCollide, hat.CanQuery, hat.CanTouch, hat.Massless = false, false, false, true
		hat.Transparency = 0.2
		local height = if hat.Shape == Enum.PartType.Cylinder then hat.Size.X else hat.Size.Y
		local tilt = if hat.Shape == Enum.PartType.Cylinder then CFrame.Angles(0, 0, math.pi / 2) else CFrame.identity
		hat.CFrame = head.CFrame * CFrame.new(0, head.Size.Y / 2 + height / 2 + 0.6, 0) * tilt -- floats above any real hat
		local weld = Instance.new("WeldConstraint")
		weld.Part0, weld.Part1 = head, hat
		weld.Parent = hat
		hat.Parent = character
	elseif visual.Kind == "Trail" and root then
		local a0 = Instance.new("Attachment")
		a0.Name, a0.Position = PREVIEW_TAG .. "Top", Vector3.new(0, 0.8, 0)
		a0.Parent = root
		local a1 = Instance.new("Attachment")
		a1.Name, a1.Position = PREVIEW_TAG .. "Bottom", Vector3.new(0, -0.8, 0)
		a1.Parent = root
		local trail = Instance.new("Trail")
		trail.Name = PREVIEW_TAG .. "Trail"
		trail.Attachment0, trail.Attachment1 = a0, a1
		trail.Lifetime = 0.45
		trail.Color = ColorSequence.new(rgb(visual.Colors[1]), rgb(visual.Colors[2]))
		trail.Parent = root
	elseif visual.Kind == "Sparkles" and root then
		local sparkles = Instance.new("Sparkles")
		sparkles.Name = PREVIEW_TAG .. "Sparkles"
		sparkles.SparkleColor = rgb(visual.Color)
		sparkles.Parent = root
	end
	self.PreviewId = item.Id
end

-- Cards --------------------------------------------------------------------------------------

local function cardButton(parent, order: number, text: string, color: Color3, textColor: Color3?)
	return make("TextButton", {
		Name = if order == 1 then "Try" else "Action",
		LayoutOrder = order,
		Size = UDim2.new(0.5, -4, 1, 0),
		BackgroundColor3 = color,
		Font = Theme.TitleFont,
		TextScaled = true,
		TextColor3 = textColor or Theme.Colors.Overlay,
		Text = text,
		Parent = parent,
	}, { Theme.corner(10), Theme.padding(6), make("UITextSizeConstraint", { MaxTextSize = 22 }) })
end

function ShopScreen:render()
	for _, child in self.Grid:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local inventory = self.Inventory or { Owned = {}, Equipped = {}, BankCoins = 0 }
	local owned, equipped = {}, inventory.Equipped or {}
	for _, entry in inventory.Owned or {} do
		owned[entry.Id] = true
	end
	self.Balance.Text = ("Bank: %d coins"):format(inventory.BankCoins or 0)

	local firstButton
	for index, item in Cosmetics.Items do
		local price = Cosmetics.bankPrice(item)
		local isOwned, isWorn = owned[item.Id] == true, equipped[item.Slot] == item.Id
		local card = make("Frame", {
			Name = "Card_" .. item.Id,
			LayoutOrder = index,
			BackgroundColor3 = if isWorn then Theme.Colors.CardLight else Theme.Colors.Overlay,
			Parent = self.Grid,
		}, { Theme.corner(12), Theme.padding(6), Theme.stroke(RARITY_COLORS[item.Rarity] or Theme.Colors.Muted, 2) })
		make("Frame", {
			Name = "Hero",
			Size = UDim2.new(1, 0, 0, 62),
			BackgroundColor3 = swatchColor(item),
			Parent = card,
		}, { Theme.corner(10) })
		Theme.label({
			Position = UDim2.fromOffset(0, 66),
			Size = UDim2.new(1, 0, 0, 24),
			Font = Theme.TitleFont,
			Text = item.Name,
			Parent = card,
		}, 22)
		Theme.label({
			Position = UDim2.fromOffset(0, 90),
			Size = UDim2.new(1, 0, 0, 20),
			TextColor3 = RARITY_COLORS[item.Rarity] or Theme.Colors.Muted,
			Text = ("%s · %s"):format(item.Slot, item.Rarity or "Common"),
			Parent = card,
		}, 18)
		Theme.label({
			Position = UDim2.fromOffset(0, 110),
			Size = UDim2.new(1, 0, 0, 22),
			TextColor3 = Theme.Colors.Accent,
			Text = if isWorn then "WEARING" elseif isOwned then "OWNED" else ("%d bank coins"):format(price),
			Parent = card,
		}, 20)
		local row = make("Frame", {
			Name = "Buttons",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.new(1, 0, 0, 56),
			BackgroundTransparency = 1,
			Parent = card,
		}, {
			make("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		local previewing = self.PreviewId == item.Id
		local previewButton = cardButton(row, 1, if previewing then "HIDE" else "TRY", Theme.Colors.Cool)
		previewButton.Activated:Connect(function()
			if self.PreviewId == item.Id then
				self:clearPreview()
			else
				self:preview(item)
			end
			self:render()
		end)
		firstButton = firstButton or previewButton

		local action
		if isWorn then
			action = cardButton(row, 2, "REMOVE", Theme.Colors.Hot) -- must stand out from the worn card
			action.Activated:Connect(function()
				self:setStatus("Taking it off...")
				self.Send({ Kind = "Unequip", Slot = item.Slot })
			end)
		elseif isOwned then
			action = cardButton(row, 2, "WEAR", Theme.Colors.Good)
			action.Activated:Connect(function()
				self:setStatus("Putting it on...")
				self.Send({ Kind = "Equip", ItemId = item.Id })
			end)
		else
			local confirming = self.Pending and self.Pending.Id == item.Id and os.clock() < self.Pending.Until
			local affordable = (inventory.BankCoins or 0) >= price
			action = cardButton(
				row,
				2,
				if confirming then ("PAY %d?"):format(price) else "BUY",
				if confirming then Theme.Colors.Hot elseif affordable then Theme.Colors.Accent else Theme.Colors.CardLight,
				if affordable or confirming then Theme.Colors.Overlay else Theme.Colors.Muted
			)
			action.Activated:Connect(function()
				if not affordable then
					self:setStatus(("You need %d more bank coins. Win matches to earn them."):format(price - (inventory.BankCoins or 0)), true)
				elseif self.Pending and self.Pending.Id == item.Id and os.clock() < self.Pending.Until then
					self.Pending = nil
					self:setStatus("Buying...")
					self.Send({ Kind = "BuyCosmetic", ItemId = item.Id })
				else
					self.Pending = { Id = item.Id, Until = os.clock() + CONFIRM_TIME }
					self:setStatus(("Tap PAY to buy the %s for %d bank coins."):format(item.Name, price))
					self:render()
					task.delay(CONFIRM_TIME, function()
						if self.Pending and self.Pending.Id == item.Id and os.clock() >= self.Pending.Until then
							self.Pending = nil
							if self.Open then
								self:render()
							end
						end
					end)
				end
			end)
		end
	end
	return firstButton
end

function ShopScreen:setStatus(text: string, isError: boolean?)
	self.Status.Text = text
	self.Status.TextColor3 = if isError then Theme.Colors.Hot else Theme.Colors.Muted
end

-- Called with every Inventory message (owned, equipped, bank coins).
function ShopScreen:setInventory(message)
	self.Inventory = message
	if self.Open then
		self:render()
	end
end

-- Called with the server's reply to a purchase.
function ShopScreen:showResult(message)
	self:setStatus(message.Text or (if message.Ok then "Done!" else "That didn't work."), not message.Ok)
	if self.Open then
		self:render()
	end
end

-- Open / close ---------------------------------------------------------------------------------

function ShopScreen:open()
	if self.Open then
		return
	end
	self.Open = true
	self.Root.Visible = true
	self:setStatus("Spend bank coins on cosmetics you keep forever.")
	local first = self:render()
	Theme.pop(self.Root)
	if UserInputService.GamepadEnabled and first then
		GuiService.SelectedObject = first -- gamepad: start on the first card
	end
	if self.OnOpenChanged then
		self.OnOpenChanged(true)
	end
end

function ShopScreen:close()
	if not self.Open then
		return
	end
	self.Open = false
	self.Root.Visible = false
	self.Pending = nil
	self:clearPreview()
	if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(self.Root) then
		GuiService.SelectedObject = nil
	end
	if self.OnOpenChanged then
		self.OnOpenChanged(false)
	end
end

function ShopScreen:toggle()
	if self.Open then
		self:close()
	else
		self:open()
	end
end

-- Keyboard B / gamepad Select open and close it, only while `allowed` (the waiting room).
function ShopScreen:setAvailable(allowed: boolean)
	if allowed then
		ContextActionService:BindAction(TOGGLE_ACTION, function(_, inputState)
			if inputState == Enum.UserInputState.Begin then
				self:toggle()
			end
			return Enum.ContextActionResult.Pass
		end, false, Enum.KeyCode.B, Enum.KeyCode.ButtonSelect)
	else
		ContextActionService:UnbindAction(TOGGLE_ACTION)
		self:close()
	end
end

return ShopScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">SpectatorBar</string>
              <string name="Source"><![CDATA[--[[
	SpectatorBar
	"👀 Spectating Pip  ◀ ▶" bar shown while the spectator camera is on.
	Buttons work with touch/mouse; Q / E (and gamepad shoulder buttons) also cycle.
]]

local ContextActionService = game:GetService("ContextActionService")

local Theme = require(script.Parent.Theme)
local make = Theme.make

local SpectatorBar = {}
SpectatorBar.__index = SpectatorBar

local BIND_NAME = "Party_SpectateCycle"

function SpectatorBar.new(screen: ScreenGui, onCycle: (number) -> ())
	local self = setmetatable({}, SpectatorBar)
	self.OnCycle = onCycle
	self.Root = make("Frame", {
		Name = "SpectatorBar",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.fromOffset(360, 56),
		BackgroundColor3 = Theme.Colors.Card,
		BackgroundTransparency = 0.15,
		Visible = false,
		Parent = screen,
	}, { Theme.corner(28) })

	local function arrow(text: string, x: number, direction: number)
		local button = make("TextButton", {
			Name = if direction < 0 then "Previous" else "Next",
			AnchorPoint = Vector2.new(x, 0.5),
			Position = UDim2.new(x, if x == 0 then 6 else -6, 0.5, 0),
			Size = UDim2.fromOffset(48, 44),
			BackgroundColor3 = Theme.Colors.CardLight,
			Font = Theme.TitleFont,
			TextScaled = true,
			TextColor3 = Theme.Colors.Text,
			Text = text,
			Parent = self.Root,
		}, { Theme.corner(22) })
		button.Activated:Connect(function()
			self.OnCycle(direction)
		end)
	end
	arrow("◀", 0, -1)
	arrow("▶", 1, 1)

	self.Label = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -120, 0.8, 0),
		Font = Theme.TitleFont,
		Parent = self.Root,
	}, 24)
	return self
end

function SpectatorBar:show(targetName: string?)
	self.Label.Text = if targetName then "👀 Watching " .. targetName else "👀 Arena"
	if self.Root.Visible then
		return
	end
	self.Root.Visible = true
	ContextActionService:BindAction(BIND_NAME, function(_, inputState, input)
		if inputState == Enum.UserInputState.Begin then
			local back = input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.ButtonL1
			self.OnCycle(if back then -1 else 1)
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.Q, Enum.KeyCode.E, Enum.KeyCode.ButtonL1, Enum.KeyCode.ButtonR1)
end

function SpectatorBar:hide()
	if self.Root.Visible then
		ContextActionService:UnbindAction(BIND_NAME)
	end
	self.Root.Visible = false
end

return SpectatorBar
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">StandingsScreen</string>
              <string name="Source"><![CDATA[--[[
	StandingsScreen
	End-of-match screens, in order (message.Stage):
	  Before   standings before the bonus awards
	  Bonus    which bonus went to whom (one Crown each)
	  Final    final standings: collectibles first, coins break ties (ranked by the server)
]]

local Theme = require(script.Parent.Theme)
local make = Theme.make

local StandingsScreen = {}
StandingsScreen.__index = StandingsScreen

function StandingsScreen.new(screen: ScreenGui)
	local self = setmetatable({}, StandingsScreen)
	self.Root = make("Frame", {
		Name = "Standings",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.7, 0.78),
		BackgroundColor3 = Theme.Colors.Card,
		Visible = false,
		Parent = screen,
	}, {
		Theme.corner(22),
		Theme.stroke(Theme.Colors.Accent, 4),
		Theme.padding(16),
		make("UISizeConstraint", { MaxSize = Vector2.new(680, 500) }),
	})
	self.Title = Theme.label({
		Size = UDim2.fromScale(1, 0.16),
		Font = Theme.TitleFont,
		TextColor3 = Theme.Colors.Accent,
		Parent = self.Root,
	}, 44)
	self.List = make("Frame", {
		Position = UDim2.fromScale(0, 0.2),
		Size = UDim2.fromScale(1, 0.8),
		BackgroundTransparency = 1,
		Parent = self.Root,
	}, { make("UIListLayout", { Padding = UDim.new(0.03, 0), SortOrder = Enum.SortOrder.LayoutOrder }) })
	return self
end

local function showBonuses(self, message, myId: string)
	self.Title.Text = "Bonus awards!"
	local plural = message.CollectiblePlural or "Crowns"
	for index, bonus in message.Bonuses or {} do
		local names, mine = {}, false
		for _, winner in bonus.Winners do
			table.insert(names, if winner.Id == myId then "You" else winner.Name)
			mine = mine or winner.Id == myId
		end
		local frame = make("Frame", {
			LayoutOrder = index,
			Size = UDim2.fromScale(1, 0.28),
			BackgroundColor3 = if mine then Theme.Colors.CardLight else Theme.Colors.Overlay,
			Parent = self.List,
		}, { Theme.corner(12), Theme.padding(6) })
		Theme.label({
			Size = UDim2.fromScale(0.5, 0.55),
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = Theme.TitleFont,
			TextColor3 = Theme.Colors.Accent,
			Text = bonus.Name,
			Parent = frame,
		}, 28)
		Theme.label({
			Position = UDim2.fromScale(0, 0.55),
			Size = UDim2.fromScale(0.5, 0.45),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Theme.Colors.Muted,
			Text = bonus.Description,
			Parent = frame,
		}, 18)
		Theme.label({
			Position = UDim2.fromScale(0.5, 0),
			Size = UDim2.fromScale(0.5, 1),
			TextXAlignment = Enum.TextXAlignment.Right,
			Text = if #names > 0
				then ("%s  +%d %s"):format(table.concat(names, ", "), bonus.Crowns, if bonus.Crowns == 1 then string.sub(plural, 1, -2) else plural)
				else "Nobody",
			Parent = frame,
		}, 24)
	end
end

function StandingsScreen:show(message, myId: string)
	for _, child in self.List:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	self.Root.Visible = true
	if message.Stage == "Bonus" then
		showBonuses(self, message, myId)
		Theme.pop(self.Root)
		return
	end
	local rows = message.Rows or {}
	local winner = rows[1]
	local tied = rows[2] ~= nil and rows[2].Placement == 1
	if message.Stage == "Before" then
		self.Title.Text = "Standings before bonuses"
	elseif not winner then
		self.Title.Text = "Match over"
	elseif tied then
		self.Title.Text = "It's a tie for 1st!"
	elseif winner.Id == myId then
		self.Title.Text = "You win the match!"
	else
		self.Title.Text = ("%s wins the match!"):format(winner.Name)
	end
	local plural = message.CollectiblePlural or "Crowns"
	for index, row in rows do
		local isMe = row.Id == myId
		local frame = make("Frame", {
			LayoutOrder = index,
			Size = UDim2.fromScale(1, 0.22),
			BackgroundColor3 = if isMe then Theme.Colors.CardLight else Theme.Colors.Overlay,
			Parent = self.List,
		}, { Theme.corner(12), Theme.padding(6) })
		if isMe then
			Theme.stroke(Theme.Colors.Accent, 2).Parent = frame
		end
		Theme.label({
			Size = UDim2.fromScale(0.16, 1),
			Font = Theme.TitleFont,
			TextColor3 = Theme.PlacementColors[row.Placement] or Theme.PlacementColors[4],
			Text = Theme.ordinal(row.Placement),
			Parent = frame,
		}, 34)
		Theme.label({
			Position = UDim2.fromScale(0.18, 0),
			Size = UDim2.fromScale(0.4, 1),
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = row.Name .. (if row.IsBot then " (bot)" else "") .. (if isMe then " (you)" else ""),
			Parent = frame,
		}, 26)
		Theme.label({
			Position = UDim2.fromScale(0.58, 0),
			Size = UDim2.fromScale(0.22, 1),
			Font = Theme.TitleFont,
			TextColor3 = Theme.Colors.Accent,
			Text = if message.Mode == "Minigames" then "" else ("%d %s"):format(row.Collectibles, plural),
			Parent = frame,
		}, 26)
		Theme.label({
			Position = UDim2.fromScale(0.8, 0),
			Size = UDim2.fromScale(0.2, 1),
			TextColor3 = Theme.Colors.Muted,
			Text = ("%d coins"):format(row.Coins) .. (if isMe and row.BankCoins then ("\n+%d bank"):format(row.BankCoins) else ""),
			Parent = frame,
		}, 22)
	end
	self.Root.Visible = true
	Theme.pop(self.Root)
end

function StandingsScreen:hide()
	self.Root.Visible = false
end

return StandingsScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--[[
	Theme
	Colours, fonts and tiny helpers for building UI in code (no Studio-made GUIs needed).
]]

local TweenService = game:GetService("TweenService")

local Theme = {}

Theme.TitleFont = Enum.Font.FredokaOne
Theme.BodyFont = Enum.Font.GothamBold

Theme.Colors = {
	Overlay = Color3.fromRGB(20, 10, 40),
	Card = Color3.fromRGB(45, 30, 80),
	CardLight = Color3.fromRGB(70, 50, 120),
	Accent = Color3.fromRGB(255, 220, 60),
	Hot = Color3.fromRGB(255, 90, 140),
	Cool = Color3.fromRGB(90, 220, 255),
	Text = Color3.fromRGB(255, 255, 255),
	Muted = Color3.fromRGB(200, 190, 230),
	Good = Color3.fromRGB(120, 255, 140),
}

Theme.TeamColors = {
	[1] = Color3.fromRGB(255, 90, 90),
	[2] = Color3.fromRGB(90, 160, 255),
}

Theme.PlacementColors = {
	Color3.fromRGB(255, 215, 0),
	Color3.fromRGB(200, 210, 225),
	Color3.fromRGB(215, 140, 70),
	Color3.fromRGB(140, 130, 170),
}

-- make("Frame", { Size = ..., Parent = x }, { children })
function Theme.make(className: string, props: { [string]: any }?, children: { Instance }?)
	local instance = Instance.new(className)
	local parent = nil
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			(instance :: any)[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	instance.Parent = parent
	return instance
end

function Theme.corner(radius: number?)
	return Theme.make("UICorner", { CornerRadius = UDim.new(0, radius or 14) })
end

function Theme.stroke(color: Color3?, thickness: number?)
	return Theme.make("UIStroke", {
		Color = color or Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Theme.padding(pixels: number)
	local p = UDim.new(0, pixels)
	return Theme.make("UIPadding", { PaddingTop = p, PaddingBottom = p, PaddingLeft = p, PaddingRight = p })
end

-- Scaled text label with a max size so it stays readable on phones and huge monitors.
function Theme.label(props: { [string]: any }, maxTextSize: number?)
	local label = Theme.make("TextLabel", {
		BackgroundTransparency = 1,
		Font = Theme.BodyFont,
		TextColor3 = Theme.Colors.Text,
		TextScaled = true,
		TextWrapped = true,
	})
	for key, value in props do
		if key ~= "Parent" then
			(label :: any)[key] = value
		end
	end
	Theme.make("UITextSizeConstraint", { MaxTextSize = maxTextSize or 28, MinTextSize = 8, Parent = label })
	label.Parent = props.Parent
	return label
end

-- Bouncy "pop in" used for cards and banners. Ends at the element's phone HUD scale
-- (the "HudScale" attribute set by the client main script), not always at 1.
function Theme.pop(guiObject: GuiObject)
	local scale = guiObject:FindFirstChildOfClass("UIScale") or Theme.make("UIScale", { Parent = guiObject })
	local target = guiObject:GetAttribute("HudScale") or 1
	scale.Scale = target * 0.6
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = target }):Play()
end

-- "1:05" style clock.
function Theme.formatTime(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return ("%d:%02d"):format(seconds // 60, seconds % 60)
end

function Theme.ordinal(n: number): string
	local suffix = "th"
	if n % 100 < 11 or n % 100 > 13 then
		suffix = ({ "st", "nd", "rd" })[n % 10] or "th"
	end
	return n .. suffix
end

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">VoteScreen</string>
              <string name="Source"><![CDATA[--[[
	VoteScreen
	Full-screen overlay with up to 3 minigame cards. Clicking a card sends a vote input;
	the counts/voter names shown are whatever the server broadcasts (never local guesses).
]]

local Workspace = game:GetService("Workspace")

local Theme = require(script.Parent.Theme)
local make = Theme.make

local VoteScreen = {}
VoteScreen.__index = VoteScreen

function VoteScreen.new(screen: ScreenGui, onVote: (number) -> ())
	local self = setmetatable({}, VoteScreen)
	self.OnVote = onVote
	self.Cards = {}
	self.Selected = nil
	self.EndsAt = nil

	self.Root = make("Frame", {
		Name = "VoteScreen",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.Overlay,
		BackgroundTransparency = 0.25,
		Visible = false,
		Parent = screen,
	})
	self.Title = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.06),
		Size = UDim2.fromScale(0.9, 0.1),
		Font = Theme.TitleFont,
		TextColor3 = Theme.Colors.Accent,
		TextStrokeTransparency = 0.4,
		Text = "VOTE FOR THE NEXT MINIGAME!",
		Parent = self.Root,
	}, 56)
	self.Clock = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.16),
		Size = UDim2.fromScale(0.5, 0.06),
		Font = Theme.TitleFont,
		Parent = self.Root,
	}, 32)
	self.Row = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.58),
		Size = UDim2.fromScale(0.92, 0.6),
		BackgroundTransparency = 1,
		Parent = self.Root,
	}, {
		make("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0.02, 0),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		make("UISizeConstraint", { MaxSize = Vector2.new(1100, 460) }),
	})
	return self
end

local function buildCard(self, index: number, choice)
	local card = make("TextButton", {
		Name = "Card" .. index,
		LayoutOrder = index,
		Size = UDim2.fromScale(0.31, 1),
		BackgroundColor3 = Theme.Colors.Card,
		AutoButtonColor = true,
		Text = "",
		Parent = self.Row,
	}, { Theme.corner(18), Theme.padding(12) })
	local stroke = Theme.stroke(Theme.Colors.CardLight, 4)
	stroke.Parent = card

	Theme.label({
		Size = UDim2.fromScale(1, 0.2),
		Font = Theme.TitleFont,
		TextColor3 = Theme.Colors.Accent,
		Text = choice.Name,
		Parent = card,
	}, 36)
	Theme.label({
		Position = UDim2.fromScale(0, 0.21),
		Size = UDim2.fromScale(1, 0.09),
		TextColor3 = Theme.Colors.Cool,
		Text = ("%s%s"):format(choice.Layout, if choice.Duration then ("  •  %ds"):format(choice.Duration) else ""),
		Parent = card,
	}, 20)
	Theme.label({
		Position = UDim2.fromScale(0, 0.33),
		Size = UDim2.fromScale(1, 0.37),
		TextColor3 = Theme.Colors.Muted,
		Font = Theme.BodyFont,
		Text = choice.Description,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = card,
	}, 20)
	local voters = Theme.label({
		Position = UDim2.fromScale(0, 0.72),
		Size = UDim2.fromScale(1, 0.12),
		TextColor3 = Theme.Colors.Text,
		Text = "",
		Parent = card,
	}, 18)
	local count = Theme.label({
		Position = UDim2.fromScale(0, 0.86),
		Size = UDim2.fromScale(1, 0.14),
		Font = Theme.TitleFont,
		Text = "0 votes",
		Parent = card,
	}, 28)

	card.Activated:Connect(function()
		self.Selected = index
		self:_refreshSelection()
		self.OnVote(index)
	end)

	return { Button = card, Stroke = stroke, Count = count, Voters = voters }
end

function VoteScreen:_refreshSelection()
	for index, card in self.Cards do
		local selected = index == self.Selected
		card.Stroke.Color = if selected then Theme.Colors.Accent else Theme.Colors.CardLight
		card.Button.BackgroundColor3 = if selected then Theme.Colors.CardLight else Theme.Colors.Card
	end
end

function VoteScreen:show(choices, endsAt: number)
	for _, card in self.Cards do
		card.Button:Destroy()
	end
	self.Cards = {}
	self.Selected = nil
	self.EndsAt = endsAt
	for index, choice in choices do
		self.Cards[index] = buildCard(self, index, choice)
	end
	self.Root.Visible = true
	Theme.pop(self.Row)
end

function VoteScreen:updateCounts(counts, voters)
	for index, card in self.Cards do
		local count = counts[index] or 0
		card.Count.Text = if count == 1 then "1 vote" else ("%d votes"):format(count)
		card.Voters.Text = table.concat(voters[index] or {}, ", ")
	end
end

function VoteScreen:update()
	if self.Root.Visible and self.EndsAt then
		local remaining = math.max(0, math.ceil(self.EndsAt - Workspace:GetServerTimeNow()))
		self.Clock.Text = ("⏱ %d"):format(remaining)
	end
end

function VoteScreen:hide()
	self.Root.Visible = false
end

return VoteScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">YouMarker</string>
              <string name="Source"><![CDATA[--[[
	YouMarker
	A "YOU" tag with a small arrow, floating above your own character (on the board and in
	minigames) so you can find yourself among four similar bodies. Only on this client: the
	BillboardGui lives in your PlayerGui, so nobody else sees it, and it's never put on bots
	or other players.

	  YouMarker.new(getCharacter, parent)   getCharacter() -> your current character (or nil)
	  marker:setActive(on)                  Main turns it on only while you're an active
	                                        participant and no full-screen card is up
	  marker:update()                       every frame: (re)attach to the current head, keep a
	                                        readable size at any camera distance

	Its arrow tip sits just above the top of the character, cosmetics included, and it stays
	upright facing the camera, as billboards do. A new character (respawn, replaced body) is picked up on the next frame.
]]

local Workspace = game:GetService("Workspace")

local Theme = require(script.Parent.Theme)
local make = Theme.make

local YouMarker = {}
YouMarker.__index = YouMarker

local HEIGHT_STUDS = 1.6 -- tag height it aims for in the world...
local MIN_PIXELS, MAX_PIXELS = 26, 40 -- ...kept between these on screen (phone readable)
local CLEARANCE = 0.8 -- studs between the top of the character (hats, buckets...) and the arrow tip
local MIN_ABOVE_HEAD = 1.5 -- never lower than this above the head's centre

function YouMarker.new(getCharacter: () -> Model?, parent: Instance)
	local self = setmetatable({ GetCharacter = getCharacter, Active = false }, YouMarker)
	self.Gui = make("BillboardGui", {
		Name = "YouMarker",
		-- Not AlwaysOnTop: it floats above the head with nothing in front of it from these
		-- cameras, and always-on-top billboards didn't render in Studio's capture.
		AlwaysOnTop = false,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Size = UDim2.fromOffset(78, 64),
		-- The gui's bottom edge (the arrow tip) sits at the anchor point, so it never hangs down
		-- over the character however big the tag is on screen.
		SizeOffset = Vector2.new(0, 0.5),
		StudsOffsetWorldSpace = Vector3.new(0, MIN_ABOVE_HEAD, 0),
		MaxDistance = 1000,
		Enabled = false,
		Parent = parent,
	})
	self.Tag = make("Frame", {
		Name = "Tag",
		Size = UDim2.fromScale(1, 0.66),
		BackgroundColor3 = Theme.Colors.Overlay,
		BackgroundTransparency = 0.05,
		Parent = self.Gui,
	}, { Theme.corner(10), Theme.stroke(Theme.Colors.Accent, 3) })
	Theme.label({
		Size = UDim2.fromScale(1, 1),
		Font = Theme.TitleFont,
		Text = "YOU",
		TextColor3 = Theme.Colors.Text,
		Parent = self.Tag,
	}, 40)
	self.Arrow = make("TextLabel", {
		Name = "Arrow",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.64),
		Size = UDim2.fromScale(0.4, 0.36),
		BackgroundTransparency = 1,
		Font = Theme.TitleFont,
		TextScaled = true,
		Text = "▼",
		TextColor3 = Theme.Colors.Accent,
		TextStrokeColor3 = Theme.Colors.Overlay,
		TextStrokeTransparency = 0,
		Parent = self.Gui,
	})
	return self
end

--[[
	Should the marker show? state = {
	  CardOpen     a full-screen card (vote, instructions, results, standings) is up
	  Phase        current Net.Phase name
	  InRound      a minigame is on for this client
	  Participant  you play this minigame (not a spectator)
	  Spectating   the spectator camera is on (watching, or knocked out)
	  OnBoard      board HUD showing
	  Seated       you hold a seat in this board match
	}
]]
function YouMarker.shouldShow(state): boolean
	if state.CardOpen then
		return false
	end
	if state.InRound then
		local live = state.Phase == "Countdown" or state.Phase == "Playing" or state.Phase == "Finished"
		return live and state.Participant == true and not state.Spectating
	end
	return state.Phase == "Board" and state.OnBoard == true and state.Seated == true
end

function YouMarker:setActive(active: boolean)
	self.Active = active
	if not active then
		self.Gui.Enabled = false
	end
end

local function headOf(character: Model?): BasePart?
	if not character or not character.Parent then
		return nil
	end
	local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
	return if head and head:IsA("BasePart") then head else nil
end

-- On-screen tag height in pixels for a head this far from the camera.
function YouMarker.pixelHeight(distance: number, viewportHeight: number, fieldOfView: number): number
	local pixelsPerStud = (viewportHeight / 2) / math.tan(math.rad(fieldOfView) / 2) / math.max(distance, 1)
	return math.clamp(HEIGHT_STUDS * pixelsPerStud, MIN_PIXELS, MAX_PIXELS)
end

function YouMarker:update()
	local head = if self.Active then headOf(self.GetCharacter()) else nil
	if not head then
		self.Gui.Enabled = false
		self.Gui.Adornee = nil
		return
	end
	if self.Gui.Adornee ~= head then
		self.Gui.Adornee = head -- first time, or a new character
	end
	-- Just above whatever is highest on the character: hats, and anything welded to it from
	-- elsewhere (Kernel Catch's popcorn bucket lives in the arena, not in the character).
	local top = head.Position.Y + head.Size.Y / 2
	local ok, parts = pcall(head.GetConnectedParts, head, true)
	for _, part in if ok then parts else {} do
		if part.Transparency < 1 then
			top = math.max(top, part.Position.Y + part.Size.Magnitude / 2)
		end
	end
	local above = math.max(MIN_ABOVE_HEAD, top - head.Position.Y + CLEARANCE)
	if math.abs(self.Gui.StudsOffsetWorldSpace.Y - above) > 0.05 then
		self.Gui.StudsOffsetWorldSpace = Vector3.new(0, above, 0)
	end
	local camera = Workspace.CurrentCamera
	if camera then
		local height = YouMarker.pixelHeight(
			(camera.CFrame.Position - head.Position).Magnitude,
			camera.ViewportSize.Y,
			camera.FieldOfView
		)
		-- Tag is 66% of the gui; the arrow hangs under it.
		local tag = height / 0.66
		self.Gui.Size = UDim2.fromOffset(math.floor(height * 1.7), math.floor(tag))
	end
	self.Gui.Enabled = true
end

function YouMarker:destroy()
	self.Gui:Destroy()
end

return YouMarker
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
