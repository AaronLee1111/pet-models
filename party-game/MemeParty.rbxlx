      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config
	Shared tuning knobs for the party framework. Safe to require from server and client.
	Everything timing/coin related lives here so designers can tweak without touching logic.
]]

local Config = {}

-- Match shape ---------------------------------------------------------------

-- Every round always has exactly this many participants; bots fill empty slots.
Config.PlayersPerMatch = 4

-- Layouts a minigame can declare in Info.Layout.
Config.Layouts = {
	FFA = "FFA", -- everyone for themselves
	OneVsThree = "1v3", -- one solo player vs a team of three
	TwoVsTwo = "2v2", -- two teams of two
}

-- Phase timings (seconds) ----------------------------------------------------

Config.IntermissionDuration = 5 -- lobby wait before the vote opens
Config.VoteChoices = 3 -- cards shown on the vote screen
Config.VoteDuration = 12
Config.InstructionsDuration = 7
Config.CountdownFrom = 3
Config.FinishBannerDuration = 2 -- "FINISH!" beat before teleporting back
Config.ResultsDuration = 8

-- Coins ----------------------------------------------------------------------

-- Coins awarded by placement. Ties share a placement, so two 1st places both get 10.
Config.CoinsByPlacement = { 10, 6, 3, 1 }

-- World layout -----------------------------------------------------------------

-- Arenas are built here, far away from the lobby so they never overlap it.
Config.ArenaOrigin = Vector3.new(0, 80, 600)
-- Eliminated participants watch from a glass box this far above the arena origin.
Config.SpectatorOffset = Vector3.new(0, 45, 0)
-- Anyone this many studs below the arena origin counts as having fallen out.
Config.FallOutDepth = 25

-- Movement defaults restored after every round.
Config.DefaultWalkSpeed = 16
Config.DefaultJumpPower = 50
Config.DefaultJumpHeight = 7.2

-- Camera ---------------------------------------------------------------------------

-- Camera modes a minigame can pick in Info.Camera.Mode. Each minigame can override any
-- of these numbers in its own Info.Camera table.
Config.CameraModes = {
	AngledOverhead = { Height = 55, Distance = 42, Follow = 0.3, Smooth = 6 }, -- whole arena, nudged toward you
	FollowBehind = { Height = 9, Distance = 16, Smooth = 10 }, -- over-the-shoulder chase cam
	SideView = { Height = 6, Distance = 48, Smooth = 8 }, -- 2D side-scroller, looks along the arena's LookVector
}
Config.DefaultCameraMode = "AngledOverhead"
-- Touch devices only (desktop and console are not affected). Zoom multiplies the mode's
-- Height and Distance so characters are bigger on a small screen; LookAhead aims the camera
-- that many studs past the arena centre, which slides the arena down out from under the HUD.
Config.TouchCamera = { AngledOverhead = { Zoom = 0.8, LookAhead = 6 } }
Config.Spectator = { Height = 28, Distance = 30, OrbitSpeed = 0.25 }

-- Player chips: how often progress updates are pushed to clients (seconds).
Config.ChipFlushInterval = 0.15

-- Bots ---------------------------------------------------------------------------

Config.BotThinkInterval = 0.2 -- how often each bot's brain runs
Config.BotVoteDelay = { 1.5, 5 } -- bots "think" about their vote for this long (min, max)
Config.BotNames = {
	"Doge",
	"Big Chungus",
	"Stonks",
	"Sus Bean",
	"Nyan",
	"Shrek",
	"Grumpy",
	"Bonk",
	"Pepe Jr",
	"Rickroll",
}

-- Networking -------------------------------------------------------------------

Config.InputRateLimit = 20 -- max inputs per second per player before they are dropped
Config.MinigameMessageRateLimit = 40 -- same, for messages a minigame's own client code sends

-- The extra vote card shown when there are fewer minigames than Config.VoteChoices.
Config.RandomChoice = {
	Id = "__random",
	Name = "🎲 Surprise Me",
	Description = "Can't decide? Let chaos pick for you.",
	Layout = "???",
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">IceDashSim</string>
          <string name="Source"><![CDATA[--[[
	IceDashSim
	The Ice Dash track layout and sliding physics, shared by server and client so both run
	exactly the same rules:

	  * the server uses it to move bots and to know what a legal move looks like
	  * each client uses it to move its own racer instantly (no waiting on the network)

	Nothing in here touches Instances; it is plain numbers.

	Track space: X = sideways (+ is the racer's right), S = distance from the start line.
]]

local Sim = {}

-- Tuning ----------------------------------------------------------------------------------

-- Ice physics
Sim.MAX_SPEED = 34 -- forward speed cap (studs/s)
Sim.FORWARD_ACCEL = 16 -- how quickly you get back up to speed
Sim.STEER_ACCEL = 42 -- sideways push while a steer button is held (studs/s^2)
Sim.ICE_FRICTION = 1.3 -- sideways speed lost per second (fraction); lower = more drift
Sim.MAX_SIDE_SPEED = 18
Sim.SLOW_DRAG = 4 -- how hard a snow drift / puddle pulls you down to its speed cap

-- Obstacles
Sim.SNOW_SLOW = 0.45 -- speed cap multiplier inside a snow drift
Sim.PUDDLE_SLOW = 0.65 -- speed cap multiplier inside a puddle
Sim.PUDDLE_STEER = 0.3 -- steering multiplier inside a puddle (you aquaplane)
Sim.BUMPER_BOUNCE = 0.9 -- bounciness of a bumper hit (0 = dead stop, 1 = perfect bounce)
Sim.BUMPER_KICK = 14 -- extra speed a bumper adds along the bounce direction
Sim.WALL_BOUNCE = 0.6 -- bounciness of side walls and barrier blocks
Sim.RACER_BOUNCE = 0.7 -- bounciness when two racers slide into each other

-- Track layout
Sim.TRACK_LENGTH = 800
Sim.TRACK_WIDTH = 36
Sim.OBSTACLE_SPACING = 30 -- studs between obstacle rows
Sim.FIRST_OBSTACLE = 55 -- clear run-up after the start line
Sim.CHECKPOINT_SPACING = 160
Sim.RESPAWN_DELAY = 1.1 -- seconds between sliding off and reappearing at the checkpoint

Sim.RACER_RADIUS = 1.6
Sim.BUMPER_RADIUS = 2.6
Sim.SNOW_SIZE = Vector2.new(13, 11) -- width, length
Sim.PUDDLE_RADIUS = 5.5
Sim.START_LANES = { -9, -3, 3, 9 }
Sim.START_S = 3

Sim.HALF_WIDTH = Sim.TRACK_WIDTH / 2

-- Layout ------------------------------------------------------------------------------------

-- Random obstacle course. Plain tables only, so it can be sent to clients as-is.
function Sim.generateLayout(rng)
	local half = Sim.HALF_WIDTH
	local layout = {
		Snow = {}, -- { X, S } centres of slow rectangles
		Puddles = {}, -- { X, S }
		Bumpers = {}, -- { X, S }
		Barriers = {}, -- { X0, X1, S0, S1 }
		Open = {}, -- { S0, S1 } stretches with no side walls
		Checkpoints = {}, -- S of each checkpoint gate
	}
	local lanes = { -13, -8, -3, 3, 8, 13 }
	local s = Sim.FIRST_OBSTACLE
	while s < Sim.TRACK_LENGTH - 30 do
		local roll = rng:NextNumber()
		if roll < 0.24 then
			table.insert(layout.Snow, { X = rng:NextNumber(-half + 7, half - 7), S = s })
		elseif roll < 0.42 then
			table.insert(layout.Puddles, { X = rng:NextNumber(-half + 6, half - 6), S = s })
		elseif roll < 0.68 then
			-- Two bumpers in different lanes.
			local first = rng:NextInteger(1, #lanes)
			local second = (first + rng:NextInteger(2, 4) - 1) % #lanes + 1
			table.insert(layout.Bumpers, { X = lanes[first], S = s })
			table.insert(layout.Bumpers, { X = lanes[second], S = s })
		elseif roll < 0.84 then
			-- A wall block sticking out from one side, or sitting in the middle.
			local width = Sim.TRACK_WIDTH * rng:NextNumber(0.3, 0.42)
			local kind = rng:NextInteger(1, 3)
			local x0 = if kind == 1 then -half elseif kind == 2 then half - width else -width / 2
			table.insert(layout.Barriers, { X0 = x0, X1 = x0 + width, S0 = s - 1.5, S1 = s + 1.5 })
		else
			-- No side walls here, and a bumper in the middle to make it interesting.
			table.insert(layout.Open, { S0 = s - Sim.OBSTACLE_SPACING / 2, S1 = s + Sim.OBSTACLE_SPACING / 2 })
			table.insert(layout.Bumpers, { X = 0, S = s })
		end
		s += Sim.OBSTACLE_SPACING
	end
	local checkpoint = Sim.CHECKPOINT_SPACING
	while checkpoint < Sim.TRACK_LENGTH - 40 do
		table.insert(layout.Checkpoints, checkpoint)
		checkpoint += Sim.CHECKPOINT_SPACING
	end
	return layout
end

function Sim.hasWall(layout, s: number): boolean
	for _, open in layout.Open do
		if s >= open.S0 and s <= open.S1 then
			return false
		end
	end
	return true
end

-- Speed-cap and steering multipliers for whatever is under (x, s).
function Sim.surface(layout, x: number, s: number): (number, number)
	local slow, steer = 1, 1
	for _, snow in layout.Snow do
		if math.abs(x - snow.X) <= Sim.SNOW_SIZE.X / 2 and math.abs(s - snow.S) <= Sim.SNOW_SIZE.Y / 2 then
			slow = math.min(slow, Sim.SNOW_SLOW)
		end
	end
	for _, puddle in layout.Puddles do
		local dx, ds = x - puddle.X, s - puddle.S
		if dx * dx + ds * ds <= Sim.PUDDLE_RADIUS * Sim.PUDDLE_RADIUS then
			slow = math.min(slow, Sim.PUDDLE_SLOW)
			steer = math.min(steer, Sim.PUDDLE_STEER)
		end
	end
	return slow, steer
end

-- The furthest checkpoint at or before s (the start line counts).
function Sim.checkpointFor(layout, s: number): number
	local best = Sim.START_S
	for _, checkpoint in layout.Checkpoints do
		if s >= checkpoint then
			best = checkpoint
		end
	end
	return best
end

-- Racers -------------------------------------------------------------------------------------

function Sim.newRacer(lane: number)
	return {
		X = lane,
		S = Sim.START_S,
		VX = 0,
		VS = 0,
		Lane = lane,
		Checkpoint = Sim.START_S,
		State = "Racing", -- "Racing" | "Falling" | "Finished"
		FallTime = 0,
	}
end

function Sim.respawn(racer)
	racer.State = "Racing"
	racer.X = racer.Lane
	racer.S = racer.Checkpoint
	racer.VX = 0
	racer.VS = 0
	racer.FallTime = 0
end

-- How far a falling racer has dropped below the ice.
function Sim.fallDrop(racer): number
	return if racer.State == "Falling" then math.min(18, 40 * racer.FallTime * racer.FallTime) else 0
end

-- Bounces the racer's velocity off a surface with normal (nx, ns).
local function bounce(racer, nx: number, ns: number, bounciness: number, kick: number)
	local into = racer.VX * nx + racer.VS * ns
	if into < 0 then
		racer.VX -= (1 + bounciness) * into * nx
		racer.VS -= (1 + bounciness) * into * ns
	end
	racer.VX += nx * kick
	racer.VS += ns * kick
end

--[[
	Advances one racer by dt seconds. `steer` is -1 (left), 0 or 1 (right).
	Returns "fell", "respawned" or "finished" when that happened this step, otherwise nil.
]]
function Sim.step(layout, racer, steer: number, dt: number): string?
	local half = Sim.HALF_WIDTH
	if racer.State == "Falling" then
		racer.FallTime += dt
		racer.X += racer.VX * dt
		racer.S += racer.VS * dt * 0.5
		if racer.FallTime >= Sim.RESPAWN_DELAY then
			Sim.respawn(racer)
			return "respawned"
		end
		return nil
	end
	if racer.State == "Finished" then
		-- Glide to a stop in the run-off area.
		racer.VS *= math.exp(-2.5 * dt)
		racer.VX *= math.exp(-3 * dt)
		racer.X = math.clamp(racer.X + racer.VX * dt, -half + Sim.RACER_RADIUS, half - Sim.RACER_RADIUS)
		racer.S = math.min(racer.S + racer.VS * dt, Sim.TRACK_LENGTH + 40)
		return nil
	end

	local slow, steerGrip = Sim.surface(layout, racer.X, racer.S)

	-- Sideways: push from steering, a little friction, lots of drift.
	racer.VX += steer * Sim.STEER_ACCEL * steerGrip * dt
	racer.VX *= math.exp(-Sim.ICE_FRICTION * dt)
	racer.VX = math.clamp(racer.VX, -Sim.MAX_SIDE_SPEED, Sim.MAX_SIDE_SPEED)

	-- Forward: always accelerating up to the cap of the surface you're on.
	local cap = Sim.MAX_SPEED * slow
	if racer.VS < cap then
		racer.VS = math.min(cap, racer.VS + Sim.FORWARD_ACCEL * dt)
	else
		racer.VS = cap + (racer.VS - cap) * math.exp(-Sim.SLOW_DRAG * dt)
	end

	racer.X += racer.VX * dt
	racer.S += racer.VS * dt

	-- Bumpers: round, bouncy, and they kick.
	for _, bumper in layout.Bumpers do
		local dx, ds = racer.X - bumper.X, racer.S - bumper.S
		local reach = Sim.BUMPER_RADIUS + Sim.RACER_RADIUS
		local distanceSquared = dx * dx + ds * ds
		if distanceSquared < reach * reach then
			local distance = math.sqrt(distanceSquared)
			local nx, ns = 0, -1
			if distance > 0.01 then
				nx, ns = dx / distance, ds / distance
			end
			racer.X = bumper.X + nx * reach
			racer.S = bumper.S + ns * reach
			bounce(racer, nx, ns, Sim.BUMPER_BOUNCE, Sim.BUMPER_KICK)
		end
	end

	-- Barrier blocks: bounce off whichever face you hit.
	for _, barrier in layout.Barriers do
		local nearestX = math.clamp(racer.X, barrier.X0, barrier.X1)
		local nearestS = math.clamp(racer.S, barrier.S0, barrier.S1)
		local dx, ds = racer.X - nearestX, racer.S - nearestS
		local distanceSquared = dx * dx + ds * ds
		if distanceSquared < Sim.RACER_RADIUS * Sim.RACER_RADIUS then
			local distance = math.sqrt(distanceSquared)
			local nx, ns
			if distance > 0.01 then
				nx, ns = dx / distance, ds / distance
			else
				nx, ns = 0, -1 -- somehow inside: shove back the way you came
			end
			racer.X = nearestX + nx * Sim.RACER_RADIUS
			racer.S = nearestS + ns * Sim.RACER_RADIUS
			bounce(racer, nx, ns, Sim.WALL_BOUNCE, 0)
		end
	end
	racer.VS = math.max(racer.VS, -Sim.MAX_SPEED * 0.6)
	racer.S = math.max(racer.S, 1)

	-- Edges: a wall bounces you back; no wall means a long drop.
	local limit = half - Sim.RACER_RADIUS
	if math.abs(racer.X) > limit then
		if Sim.hasWall(layout, racer.S) then
			local side = math.sign(racer.X)
			racer.X = side * limit
			if racer.VX * side > 0 then
				racer.VX = -racer.VX * Sim.WALL_BOUNCE
			end
		elseif math.abs(racer.X) > half + 0.5 then
			racer.State = "Falling"
			racer.FallTime = 0
			return "fell"
		end
	end

	racer.Checkpoint = math.max(racer.Checkpoint, Sim.checkpointFor(layout, racer.S))

	if racer.S >= Sim.TRACK_LENGTH then
		racer.State = "Finished"
		return "finished"
	end
	return nil
end

--[[
	Racers are solid to each other. Pushes an overlapping pair apart and trades momentum.
	moveA / moveB say which of the two this machine is allowed to change (a client only moves
	its own racer; the server only moves bots).
]]
function Sim.collide(a, b, moveA: boolean, moveB: boolean)
	if a.State ~= "Racing" or b.State ~= "Racing" then
		return
	end
	local reach = Sim.RACER_RADIUS * 2
	local dx, ds = b.X - a.X, b.S - a.S
	local distanceSquared = dx * dx + ds * ds
	if distanceSquared >= reach * reach then
		return
	end
	local distance = math.sqrt(distanceSquared)
	local nx, ns = 1, 0
	if distance > 0.01 then
		nx, ns = dx / distance, ds / distance
	end
	local overlap = (reach - distance) / 2
	-- Equal masses: swap (most of) the speed along the line between them.
	local closing = (a.VX - (b.VX or 0)) * nx + (a.VS - (b.VS or 0)) * ns
	local impulse = if closing > 0 then closing * (1 + Sim.RACER_BOUNCE) / 2 else 0
	if moveA then
		a.X -= nx * overlap
		a.S -= ns * overlap
		a.VX -= impulse * nx
		a.VS -= impulse * ns
	end
	if moveB then
		b.X += nx * overlap
		b.S += ns * overlap
		b.VX += impulse * nx
		b.VS += impulse * ns
	end
end

return Sim
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--[[
	Net
	The two RemoteEvents the whole framework uses, plus the message vocabulary.

	  PartyState  (server -> client): authoritative state. The client only ever renders this.
	  PartyInput  (client -> server): inputs only (ready / vote / minigame action).
	                                  The server validates every one of them.

	Two more remotes exist for minigames that run their own client code (Info.ClientModule):

	  PartyMinigame      reliable, both ways: setup data, corrections
	  PartyMinigameFast  unreliable, both ways: high-rate state (positions) where a lost
	                     packet doesn't matter because a newer one is right behind it

	Whatever a client sends on these goes to the active minigame's OnClientMessage, which
	must treat it as untrusted.

	The server creates the remotes; clients wait for them.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "PartyRemotes"

local Net = {}

-- Phases the server walks through each round. The client shows a screen per phase.
Net.Phase = {
	Lobby = "Lobby",
	Vote = "Vote",
	Instructions = "Instructions",
	Countdown = "Countdown",
	Playing = "Playing",
	Finished = "Finished",
	Results = "Results",
}

-- Server -> client message types (message.Type).
Net.Message = {
	Phase = "Phase", -- full phase change; carries everything needed to draw that screen
	VoteUpdate = "VoteUpdate", -- live vote counts during the Vote phase
	Status = "Status", -- persistent HUD line set by the minigame ("Doge has the potato!")
	Toast = "Toast", -- short-lived feed message ("BOOM!")
	Chips = "Chips", -- player-chip strip: every participant's live value + eliminated flag
}

-- Client -> server input kinds (payload.Kind).
Net.Input = {
	Ready = "Ready", -- client finished loading; server replies with a state snapshot
	Vote = "Vote", -- payload.Choice = index of the vote card
	Action = "Action", -- payload.Action = action name declared in the minigame's Info.Controls
}

local function getFolder(): Instance
	if RunService:IsServer() then
		local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = FOLDER_NAME
			folder.Parent = ReplicatedStorage
		end
		return folder
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME)
end

local function getRemote(name: string, className: string?): RemoteEvent
	local folder = getFolder()
	if RunService:IsServer() then
		local remote = folder:FindFirstChild(name)
		if not remote then
			remote = Instance.new(className or "RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
		return remote :: RemoteEvent
	end
	return folder:WaitForChild(name) :: RemoteEvent
end

function Net.stateRemote(): RemoteEvent
	return getRemote("PartyState")
end

function Net.inputRemote(): RemoteEvent
	return getRemote("PartyInput")
end

function Net.minigameRemote(): RemoteEvent
	return getRemote("PartyMinigame")
end

function Net.minigameFastRemote(): UnreliableRemoteEvent
	return getRemote("PartyMinigameFast", "UnreliableRemoteEvent") :: any
end

return Net
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="5">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="6">
      <Properties>
        <string name="Name">PartyServer</string>
      </Properties>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Arena</string>
          <string name="Source"><![CDATA[--[[
	Arena
	World helpers owned by the framework (minigames build their own map *inside* the arena):
	  * the lobby (built automatically if the place has no SpawnLocation)
	  * a fresh arena Folder per round, positioned at Config.ArenaOrigin
	  * the glass spectator box eliminated participants are sent to
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.PartyShared.Config)

local Arena = {}

local function makePart(props): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(part :: any)[key] = value
	end
	return part
end

-- Returns the lobby spawn, building a simple lobby first if the place has none.
function Arena.ensureLobby(): SpawnLocation
	local existing = Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
	if existing then
		return existing
	end

	local lobby = Instance.new("Model")
	lobby.Name = "PartyLobby"

	makePart({
		Name = "Floor",
		Size = Vector3.new(80, 2, 80),
		Position = Vector3.new(0, -1, 0),
		Color = Color3.fromRGB(255, 170, 230),
		Material = Enum.Material.SmoothPlastic,
		Parent = lobby,
	})

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = Vector3.new(0, 0.5, 0)
	spawn.Color = Color3.fromRGB(255, 220, 90)
	spawn.Neutral = true
	spawn.Duration = 0 -- no forcefield; it would block hot potato passes
	spawn.Parent = lobby

	lobby.Parent = Workspace
	return spawn
end

-- A spot in a ring around the lobby spawn so returning players don't stack up.
function Arena.lobbySpot(index: number): CFrame
	local spawn = Arena.ensureLobby()
	local angle = (index - 1) * (math.pi * 2 / Config.PlayersPerMatch)
	local offset = Vector3.new(math.cos(angle) * 10, 4, math.sin(angle) * 10)
	local position = spawn.Position + offset
	return CFrame.lookAt(position, Vector3.new(spawn.Position.X, position.Y, spawn.Position.Z))
end

local function buildSpectatorBox(parent: Instance, origin: CFrame): CFrame
	local box = Instance.new("Model")
	box.Name = "SpectatorBox"

	local center = origin.Position + Config.SpectatorOffset
	local size = 28
	makePart({
		Name = "Glass",
		Size = Vector3.new(size, 1, size),
		Position = center,
		Transparency = 0.7,
		Material = Enum.Material.Glass,
		Color = Color3.fromRGB(170, 230, 255),
		Parent = box,
	})
	-- Low invisible walls so spectators can't wander off the glass.
	for i = 0, 3 do
		local angle = i * math.pi / 2
		local wallCenter = center + Vector3.new(math.cos(angle) * size / 2, 4, math.sin(angle) * size / 2)
		makePart({
			Name = "Wall",
			Size = Vector3.new(1, 8, size),
			CFrame = CFrame.new(wallCenter) * CFrame.Angles(0, -angle, 0),
			Transparency = 1,
			Parent = box,
		})
	end
	box.Parent = parent
	return CFrame.new(center + Vector3.new(0, 4, 0))
end

--[[
	Creates the arena object handed to Minigame:Setup(arena, ...):
	  arena.Folder          parent everything you build here; it is destroyed after the round
	  arena.Origin          CFrame at the centre of the play space
	  arena.SpectatorCFrame where eliminated participants are sent
]]
function Arena.create(minigameName: string)
	local folder = Instance.new("Folder")
	folder.Name = "Arena_" .. minigameName
	folder.Parent = Workspace

	local origin = CFrame.new(Config.ArenaOrigin)
	return {
		Folder = folder,
		Origin = origin,
		SpectatorCFrame = buildSpectatorBox(folder, origin),
	}
end

function Arena.destroy(arena)
	if arena and arena.Folder then
		arena.Folder:Destroy()
	end
end

return Arena
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">BotService</string>
          <string name="Source"><![CDATA[--[[
	BotService
	Owns the AI players that fill empty seats.

	  BotService.getBots(count)    returns `count` bots with living bodies, creating/despawning as needed
	  BotService.setBrain(fn)      fn(bot, dt) runs every Config.BotThinkInterval for each live bot;
	                               the MinigameManager points this at the active minigame's UpdateBot
	  BotService.setActionHandler  how bot:Input(action) reaches the server (same path as player input)

	The Bot object a minigame's UpdateBot(bot, dt) receives:
	  bot.Participant              the bot's Participant for this round
	  bot.Memory                   scratch table, wiped every round - store your per-bot state here
	  bot.Skill                    0..1, use it to make some bots sloppier than others
	  bot:GetPosition()            Vector3?
	  bot:MoveTo(position)         walk towards a point
	  bot:Stop()
	  bot:Jump()
	  bot:Input(actionName)        press a minigame action exactly like a player would
	  bot:IsAlive()
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.PartyShared.Config)

local BotService = {}

local rng = Random.new()
local bots = {} -- every bot we currently own, in seat order
local nextBotNumber = 0
local brain: ((any, number) -> ())? = nil
local actionHandler: ((any, string) -> ())? = nil
local botFolder: Folder? = nil

-- Bot ------------------------------------------------------------------------------

local Bot = {}
Bot.__index = Bot

function Bot:IsAlive(): boolean
	local model = self.Model
	local humanoid = self.Humanoid
	return model ~= nil and model.Parent ~= nil and humanoid ~= nil and humanoid.Health > 0
end

function Bot:GetPosition(): Vector3?
	return if self:IsAlive() then self.Root.Position else nil
end

function Bot:MoveTo(position: Vector3)
	if self:IsAlive() then
		self.Humanoid:MoveTo(position)
	end
end

function Bot:Stop()
	if self:IsAlive() then
		self.Humanoid:MoveTo(self.Root.Position)
	end
end

function Bot:Jump()
	if self:IsAlive() then
		self.Humanoid.Jump = true
	end
end

function Bot:Input(action: string)
	if actionHandler and self.Participant then
		actionHandler(self.Participant, action)
	end
end

-- Bodies -----------------------------------------------------------------------------

local function getFolder(): Folder
	if not botFolder or not botFolder.Parent then
		local folder = Instance.new("Folder")
		folder.Name = "PartyBots"
		folder.Parent = Workspace
		botFolder = folder
	end
	return botFolder :: Folder
end

-- Plain blocky rig, only used if Roblox can't build an avatar (e.g. asset service hiccup).
local function buildFallbackRig(color: Color3): Model
	local model = Instance.new("Model")

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	root.Color = color
	root.Parent = model

	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = Vector3.new(1.6, 1.6, 1.6)
	head.Color = color
	head.CFrame = root.CFrame * CFrame.new(0, 1.8, 0)
	head.Parent = model

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = head
	weld.Parent = root

	local humanoid = Instance.new("Humanoid")
	humanoid.HipHeight = 2
	humanoid.Parent = model

	model.PrimaryPart = root
	return model
end

local function buildBody(name: string): Model
	local color = Color3.fromHSV(rng:NextNumber(), 0.6, 1)
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = color
	description.TorsoColor = color
	description.LeftArmColor = color
	description.RightArmColor = color
	description.LeftLegColor = color:Lerp(Color3.new(0, 0, 0), 0.3)
	description.RightLegColor = color:Lerp(Color3.new(0, 0, 0), 0.3)

	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("[BotService] Avatar build failed, using fallback rig:", model)
		model = buildFallbackRig(color)
	end

	model.Name = name
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	humanoid.DisplayName = "🤖 " .. name
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Subject
	return model
end

-- Gives the bot a fresh body at `cframe`, replacing a dead or missing one.
local function respawn(bot, cframe: CFrame)
	if bot.Model then
		bot.Model:Destroy()
	end
	local model = buildBody(bot.Name)
	model:PivotTo(cframe)
	model.Parent = getFolder()

	bot.Model = model
	bot.Humanoid = model:FindFirstChildOfClass("Humanoid")
	bot.Root = model:FindFirstChild("HumanoidRootPart")
	-- Server owns bot physics so MoveTo is smooth and nobody can hijack bots.
	bot.Root:SetNetworkOwner(nil)
end

local function pickName(): string
	local used = {}
	for _, bot in bots do
		used[bot.Name] = true
	end
	local candidates = {}
	for _, name in Config.BotNames do
		if not used[name] then
			table.insert(candidates, name)
		end
	end
	if #candidates == 0 then
		return "Bot " .. nextBotNumber
	end
	return candidates[rng:NextInteger(1, #candidates)]
end

local function createBot()
	nextBotNumber += 1
	local bot = setmetatable({
		Id = "bot_" .. nextBotNumber,
		Name = pickName(),
		Skill = rng:NextNumber(0.3, 1),
		Memory = {},
		Participant = nil,
		Model = nil,
		Humanoid = nil,
		Root = nil,
	}, Bot)
	return bot
end

-- Public API -------------------------------------------------------------------------

--[[
	Returns exactly `count` bots, each with a living body somewhere near `spawnAt(index)`.
	Extra bots from a previous round (e.g. a real player joined) are removed.
]]
function BotService.getBots(count: number, spawnAt: (number) -> CFrame)
	while #bots > count do
		local bot = table.remove(bots) :: any
		if bot.Model then
			bot.Model:Destroy()
		end
	end
	while #bots < count do
		table.insert(bots, createBot())
	end

	for index, bot in bots do
		bot.Memory = {}
		bot.Participant = nil
		if not bot:IsAlive() then
			respawn(bot, spawnAt(index))
		end
	end
	return table.clone(bots)
end

-- Respawns any bot whose body died during the round.
function BotService.reviveAll(spawnAt: (number) -> CFrame)
	for index, bot in bots do
		if not bot:IsAlive() then
			respawn(bot, spawnAt(index))
		end
	end
end

function BotService.setBrain(fn: ((any, number) -> ())?)
	brain = fn
	for _, bot in bots do
		bot.Memory = {}
	end
end

function BotService.setActionHandler(fn: (any, string) -> ())
	actionHandler = fn
end

-- Think loop -------------------------------------------------------------------------

local accumulated = 0
RunService.Heartbeat:Connect(function(dt)
	accumulated += dt
	if accumulated < Config.BotThinkInterval then
		return
	end
	local step = accumulated
	accumulated = 0

	local currentBrain = brain
	if not currentBrain then
		return
	end
	for _, bot in bots do
		if bot.Participant and bot:IsAlive() then
			local ok, err = pcall(currentBrain, bot, step)
			if not ok then
				warn(("[BotService] %s's brain errored: %s"):format(bot.Name, tostring(err)))
			end
		end
	end
end)

return BotService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">CoinService</string>
          <string name="Source"><![CDATA[--[[
	CoinService
	Session coin totals. Real players get a "Coins" leaderstat; bots are tracked in memory.
	(Swap this for DataStore persistence once the board game exists.)
]]

local Players = game:GetService("Players")

local CoinService = {}

local botCoins: { [string]: number } = {}

local function setupPlayer(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Parent = leaderstats
	leaderstats.Parent = player
end

local function getValue(player: Player): IntValue?
	local leaderstats = player:FindFirstChild("leaderstats")
	return leaderstats and leaderstats:FindFirstChild("Coins") :: IntValue?
end

function CoinService.get(participant): number
	if participant.IsBot then
		return botCoins[participant.Id] or 0
	end
	local value = getValue(participant.Player)
	return if value then value.Value else 0
end

-- Adds coins and returns the new total.
function CoinService.add(participant, amount: number): number
	if participant.IsBot then
		botCoins[participant.Id] = (botCoins[participant.Id] or 0) + amount
		return botCoins[participant.Id]
	end
	local value = getValue(participant.Player)
	if value then
		value.Value += amount
		return value.Value
	end
	return 0
end

Players.PlayerAdded:Connect(setupPlayer)
for _, player in Players:GetPlayers() do
	if not player:FindFirstChild("leaderstats") then
		setupPlayer(player)
	end
end

return CoinService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="10">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Main (server entry point)
	The party loop: lobby -> seat 4 participants (real players first, bots fill the rest)
	-> MinigameManager.runRound -> repeat.

	When the board game exists, it replaces this loop and calls
	MinigameManager.runRound(participants) at the end of each turn.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.PartyShared.Config)
local Arena = require(script.Parent.Arena)
local BotService = require(script.Parent.BotService)
local MinigameManager = require(script.Parent.MinigameManager)
local Participant = require(script.Parent.Participant)

Arena.ensureLobby()
MinigameManager.init()

-- First come, first seated: track join order so seats are fair when >4 players are on.
local joinOrder: { Player } = {}
for _, player in Players:GetPlayers() do
	table.insert(joinOrder, player)
end
Players.PlayerAdded:Connect(function(player)
	table.insert(joinOrder, player)
end)
Players.PlayerRemoving:Connect(function(player)
	local index = table.find(joinOrder, player)
	if index then
		table.remove(joinOrder, index)
	end
end)

local function buildParticipants()
	local participants = {}
	for _, player in joinOrder do
		if #participants >= Config.PlayersPerMatch then
			break -- extra players watch this round from the lobby
		end
		table.insert(participants, Participant.fromPlayer(player))
	end

	local realCount = #participants
	local bots = BotService.getBots(Config.PlayersPerMatch - realCount, function(index)
		return Arena.lobbySpot(realCount + index)
	end)
	for _, bot in bots do
		table.insert(participants, Participant.fromBot(bot))
	end
	return participants
end

while true do
	while #Players:GetPlayers() == 0 do
		MinigameManager.showLobby("Waiting for players...")
		Players.PlayerAdded:Wait()
	end

	MinigameManager.showLobby("Next minigame starting soon!", Config.IntermissionDuration)

	local participants = buildParticipants()
	local ok, err = xpcall(MinigameManager.runRound, debug.traceback, participants)
	if not ok then
		warn("[Party] Round crashed, returning to lobby:\n" .. tostring(err))
		MinigameManager.abort("⚠️ Minigame crashed — back to the lobby!")
	end
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">MinigameInfo</string>
          <string name="Source"><![CDATA[--[[
	MinigameInfo
	Validates a minigame module and fills in defaults for its Info table, so the rest of
	the framework (and the client) can rely on a complete, predictable shape:

	  Info = {
	    Name, Description          strings
	    Duration                   seconds
	    Layout                     "FFA" | "1v3" | "2v2"
	    Camera = {                 optional, defaults to AngledOverhead
	      Mode = "AngledOverhead" | "FollowBehind" | "SideView",
	      ...any Config.CameraModes[Mode] number to override (Height, Distance, ...)
	    },
	    Controls = {               optional, defaults to free movement + no actions
	      Move = true,             false = can't walk (server sets WalkSpeed 0)
	      Jump = true,             false = can't jump
	      WalkSpeed = 16,
	      Actions = { { Action = "Pass", Label = "Pass!", Key = "E" } },
	        per action, optional:  Keys = { "A", "Left" }  several keys instead of one Key
	                               Hold = true             OnInput gets "<Action>" on press and
	                                                       "<Action>Stop" on release
	                               Side = "Left"           on-screen button goes bottom-left
	    },
	    ProgressLabel = "Score",   optional default label for the player chips
	    ClientModule = "IceDash",  optional: name of a module in client/Minigames that Main starts
	                               for the round (its messages arrive in OnClientMessage)
	    ProgressBar = true,        optional: show a race bar along the top instead of the chips;
	                               report values like "37%" (anything with 🏁 counts as 100%)
	  }
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.PartyShared.Config)

local MinigameInfo = {}

local REQUIRED_FUNCTIONS = { "Setup", "Start", "Cleanup", "GetResults" }

-- Returns an error string, or nil if the module is usable.
function MinigameInfo.validate(definition): string?
	if type(definition) ~= "table" then
		return "module must return a table"
	end
	local info = definition.Info
	if type(info) ~= "table" then
		return "missing Info table"
	end
	if type(info.Name) ~= "string" or type(info.Description) ~= "string" then
		return "Info.Name and Info.Description must be strings"
	end
	if type(info.Duration) ~= "number" or info.Duration <= 0 then
		return "Info.Duration must be a positive number"
	end
	if not table.find({ "FFA", "1v3", "2v2" }, info.Layout) then
		return "Info.Layout must be FFA, 1v3 or 2v2"
	end
	local camera = info.Camera
	if camera ~= nil and (type(camera) ~= "table" or not Config.CameraModes[camera.Mode]) then
		return "Info.Camera.Mode must be AngledOverhead, FollowBehind or SideView"
	end
	local controls = info.Controls
	if controls ~= nil then
		if type(controls) ~= "table" then
			return "Info.Controls must be a table"
		end
		for _, action in controls.Actions or {} do
			if type(action.Action) ~= "string" or type(action.Label) ~= "string" then
				return "each Info.Controls.Actions entry needs Action and Label strings"
			end
		end
	end
	for _, name in REQUIRED_FUNCTIONS do
		if type(definition[name]) ~= "function" then
			return ("missing function %s"):format(name)
		end
	end
	return nil
end

-- Info with every optional field filled in. Safe to send to clients.
function MinigameInfo.normalize(id: string, info)
	local cameraIn = info.Camera or {}
	local mode = cameraIn.Mode or Config.DefaultCameraMode
	local camera = table.clone(Config.CameraModes[mode])
	for key, value in cameraIn do
		camera[key] = value
	end
	camera.Mode = mode

	local controlsIn = info.Controls or {}
	local actions = {}
	for _, action in controlsIn.Actions or {} do
		table.insert(actions, {
			Action = action.Action,
			Label = action.Label,
			Key = action.Key or (action.Keys and action.Keys[1]), -- Enum.KeyCode name, e.g. "E"
			Keys = action.Keys, -- optional list of Enum.KeyCode names (overrides Key for binding)
			Gamepad = action.Gamepad, -- optional Enum.KeyCode name, e.g. "ButtonX"
			Hold = action.Hold == true, -- also sends "<Action>Stop" when released
			Side = action.Side, -- "Left" puts the on-screen button in the bottom-left corner
		})
	end
	local controls = {
		Move = controlsIn.Move ~= false,
		Jump = controlsIn.Jump ~= false,
		WalkSpeed = controlsIn.WalkSpeed or Config.DefaultWalkSpeed,
		Actions = actions,
	}

	return {
		Id = id,
		Name = info.Name,
		Description = info.Description,
		Layout = info.Layout,
		Duration = info.Duration,
		Camera = camera,
		Controls = controls,
		ProgressLabel = info.ProgressLabel,
		ProgressBar = info.ProgressBar == true,
		ClientModule = if type(info.ClientModule) == "string" then info.ClientModule else nil,
	}
end

return MinigameInfo
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">MinigameManager</string>
          <string name="Source"><![CDATA[--[[
	MinigameManager
	Runs one minigame round from start to finish. The server owns all game state;
	clients only receive PartyState messages and send validated inputs.

	Round flow (MinigameManager.runRound):
	  Vote -> Instructions (arena is built + everyone teleported & frozen)
	       -> Countdown 3-2-1 -> Playing -> Finished -> back to lobby -> Results

	Minigames are ModuleScripts in PartyServer/Minigames (names starting with "_" are
	ignored, e.g. _Template). See _Template.luau for the full interface.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.PartyShared.Config)
local Net = require(ReplicatedStorage.PartyShared.Net)
local Arena = require(script.Parent.Arena)
local BotService = require(script.Parent.BotService)
local CoinService = require(script.Parent.CoinService)
local MinigameInfo = require(script.Parent.MinigameInfo)
local ResultsUtil = require(script.Parent.ResultsUtil)
local RoundContext = require(script.Parent.RoundContext)

local MinigameManager = {}

local stateRemote = Net.stateRemote()
local inputRemote = Net.inputRemote()
local rng = Random.new()

local registry = {} -- { { Id = moduleName, Definition = module table } }

local state = {
	PhaseMessage = { Type = Net.Message.Phase, Phase = Net.Phase.Lobby } :: any,
	Status = nil :: string?,
	Participants = {},
	ByPlayer = {} :: { [Player]: any },
	Vote = nil :: any, -- { Choices, Votes = { [participant] = choiceIndex } }
	Active = nil :: any, -- the round in progress, see runRound
}

local function now(): number
	return Workspace:GetServerTimeNow()
end

-- Messaging ---------------------------------------------------------------------------

local function broadcast(message)
	stateRemote:FireAllClients(message)
end

local function setPhase(phase: string, data)
	local message = data or {}
	message.Type = Net.Message.Phase
	message.Phase = phase
	state.PhaseMessage = message
	if phase ~= Net.Phase.Playing then
		state.Status = nil
	end
	broadcast(message)
end

local function setStatus(text: string?)
	state.Status = text
	broadcast({ Type = Net.Message.Status, Text = text })
end

local function describeParticipants(participants)
	local list = {}
	for _, participant in participants do
		table.insert(list, participant:Describe())
	end
	return list
end

-- Player chips ----------------------------------------------------------------------------
-- One chip per participant: name, team, live value reported by the minigame, eliminated flag.
-- Updates are batched and sent at most every Config.ChipFlushInterval seconds.

local chipFlushQueued = false

local function chipsMessage()
	local active = state.Active
	local chips = {}
	for _, participant in state.Participants do
		local chip = participant:Describe()
		local progress = active and active.Progress[participant]
		chip.Value = progress and progress.Value
		chip.Label = progress and progress.Label or (active and active.Described.ProgressLabel)
		chip.Eliminated = active ~= nil and active.Round:IsEliminated(participant)
		chip.Character = participant:GetCharacter() -- lets clients spectate this participant
		table.insert(chips, chip)
	end
	return { Type = Net.Message.Chips, Chips = chips }
end

local function queueChipFlush()
	if chipFlushQueued then
		return
	end
	chipFlushQueued = true
	task.delay(Config.ChipFlushInterval, function()
		chipFlushQueued = false
		broadcast(chipsMessage())
	end)
end

-- Counts votes per card; also returns who voted for what (shown under each card).
local function tallyVotes(vote)
	local counts, voters = {}, {}
	for i = 1, #vote.Choices do
		counts[i] = 0
		voters[i] = {}
	end
	for participant, choice in vote.Votes do
		counts[choice] += 1
		table.insert(voters[choice], participant.Name)
	end
	return counts, voters
end

local function voteUpdateMessage(vote)
	local counts, voters = tallyVotes(vote)
	return { Type = Net.Message.VoteUpdate, Counts = counts, Voters = voters }
end

-- Late joiners / reloaded clients get the current screen re-sent.
local function sendSnapshot(player: Player)
	stateRemote:FireClient(player, state.PhaseMessage)
	if state.Vote then
		stateRemote:FireClient(player, voteUpdateMessage(state.Vote))
	end
	if state.Status then
		stateRemote:FireClient(player, { Type = Net.Message.Status, Text = state.Status })
	end
	if state.Active then
		stateRemote:FireClient(player, chipsMessage())
	end
end

-- Registry ----------------------------------------------------------------------------

local function loadMinigames()
	local folder = script.Parent:WaitForChild("Minigames")
	for _, module in folder:GetChildren() do
		if not module:IsA("ModuleScript") or string.sub(module.Name, 1, 1) == "_" then
			continue
		end
		local ok, definition = pcall(require, module)
		local problem = if ok then MinigameInfo.validate(definition) else tostring(definition)
		if problem then
			warn(("[MinigameManager] Skipping minigame %s: %s"):format(module.Name, problem))
			continue
		end
		table.insert(registry, {
			Id = module.Name,
			Definition = definition,
			Described = MinigameInfo.normalize(module.Name, definition.Info),
		})
	end
	table.sort(registry, function(a, b)
		return a.Id < b.Id
	end)
	print(("[MinigameManager] Loaded %d minigame(s)"):format(#registry))
end

local function describeMinigame(entry)
	return table.clone(entry.Described)
end

local function findEntry(id: string)
	for _, entry in registry do
		if entry.Id == id then
			return entry
		end
	end
	return nil
end

-- Calls an optional minigame method, logging (not propagating) errors.
local function safeCall(instance, methodName: string, ...)
	local method = instance[methodName]
	if type(method) ~= "function" then
		return true, nil
	end
	local ok, result = pcall(method, instance, ...)
	if not ok then
		warn(("[MinigameManager] %s:%s errored: %s"):format(instance.Info.Name, methodName, tostring(result)))
	end
	return ok, result
end

-- Voting -------------------------------------------------------------------------------

local function castVote(participant, choice)
	local vote = state.Vote
	if not vote or participant.Left then
		return
	end
	-- Inputs are untrusted: must be an integer index of a real card.
	if type(choice) ~= "number" or choice % 1 ~= 0 or choice < 1 or choice > #vote.Choices then
		return
	end
	vote.Votes[participant] = choice
	broadcast(voteUpdateMessage(vote))
end

local function everyoneVoted(vote, participants): boolean
	for _, participant in participants do
		if not participant.Left and vote.Votes[participant] == nil then
			return false
		end
	end
	return true
end

local function runVote(participants)
	local pool = table.clone(registry)
	for i = #pool, 2, -1 do -- shuffle
		local j = rng:NextInteger(1, i)
		pool[i], pool[j] = pool[j], pool[i]
	end

	local choices = {}
	for i = 1, math.min(Config.VoteChoices, #pool) do
		table.insert(choices, describeMinigame(pool[i]))
	end
	if #choices < Config.VoteChoices and #registry > 1 then
		table.insert(choices, table.clone(Config.RandomChoice))
	end

	local vote = { Choices = choices, Votes = {} }
	state.Vote = vote
	local endsAt = now() + Config.VoteDuration
	setPhase(Net.Phase.Vote, { Choices = choices, EndsAt = endsAt })
	broadcast(voteUpdateMessage(vote))

	-- Bots vote after a short "thinking" delay, through the same validated path as players.
	for _, participant in participants do
		if participant.IsBot then
			task.delay(rng:NextNumber(Config.BotVoteDelay[1], Config.BotVoteDelay[2]), function()
				if state.Vote == vote then
					castVote(participant, rng:NextInteger(1, #choices))
				end
			end)
		end
	end

	while now() < endsAt and not everyoneVoted(vote, participants) do
		task.wait(0.1)
	end
	if now() < endsAt then
		task.wait(1) -- everyone voted early: let them see the final tally for a beat
	end
	state.Vote = nil

	-- Most votes wins; ties (and no votes at all) are broken randomly.
	local tally = tallyVotes(vote)
	local best, bestCount = {}, -1
	for i, count in tally do
		if count > bestCount then
			best, bestCount = { i }, count
		elseif count == bestCount then
			table.insert(best, i)
		end
	end
	local winner = choices[best[rng:NextInteger(1, #best)]]

	if winner.Id == Config.RandomChoice.Id then
		return registry[rng:NextInteger(1, #registry)]
	end
	return findEntry(winner.Id)
end

-- Teams ----------------------------------------------------------------------------------

local function assignTeams(participants, layout: string)
	local shuffled = table.clone(participants)
	for i = #shuffled, 2, -1 do
		local j = rng:NextInteger(1, i)
		shuffled[i], shuffled[j] = shuffled[j], shuffled[i]
	end
	for i, participant in shuffled do
		if layout == "1v3" then
			participant.Team = if i == 1 then 1 else 2 -- team 1 is the solo player
		elseif layout == "2v2" then
			participant.Team = if i <= 2 then 1 else 2
		else
			participant.Team = nil
		end
	end
end

-- Round lifecycle --------------------------------------------------------------------------

local function returnToLobby(participants)
	BotService.reviveAll(Arena.lobbySpot)
	for index, participant in participants do
		participant.Team = nil
		if participant:IsAlive() then
			participant:Teleport(Arena.lobbySpot(index))
			participant:ResetMovement()
		end
		-- Dead real players simply respawn at the lobby SpawnLocation.
	end
end

-- Tears down the active round. Safe to call more than once (used by abort too).
local function finishRound()
	local active = state.Active
	if not active then
		return
	end
	state.Active = nil
	BotService.setBrain(nil)
	for _, connection in active.Connections do
		connection:Disconnect()
	end
	safeCall(active.Instance, "Cleanup")
	Arena.destroy(active.Arena)
	returnToLobby(active.Round.Participants)
	if state.Status then
		setStatus(nil)
	end
end

-- A participant died, reset, or left mid-round: they are out.
local function onParticipantLost(participant, reason: string)
	local active = state.Active
	if not active or active.Round.Ended or active.Round:IsEliminated(participant) then
		return
	end
	active.Round:Eliminate(participant, true)
	active.Round:Toast(
		if reason == "Left" then ("👋 %s rage quit"):format(participant.Name) else ("💀 %s got bonked"):format(participant.Name)
	)
	safeCall(active.Instance, "OnParticipantLost", participant, reason)
end

-- Same entry point for real-player inputs (via the remote) and bot inputs (bot:Input).
local function submitAction(participant, action: string)
	local active = state.Active
	if not active or state.PhaseMessage.Phase ~= Net.Phase.Playing or active.Round.Ended then
		return
	end
	if not active.Actions[action] or active.Round:IsEliminated(participant) or not participant:IsAlive() then
		return
	end
	safeCall(active.Instance, "OnInput", participant, action)
end

local function awardCoins(results)
	local rows = {}
	for _, result in results do
		local participant = result.Participant
		local coins = if participant.Left then 0 else (Config.CoinsByPlacement[result.Placement] or 0)
		local total = CoinService.add(participant, coins)
		local row = participant:Describe()
		row.Placement = result.Placement
		row.Coins = coins
		row.Total = total
		table.insert(rows, row)
	end
	return rows
end

local function ensureBodies(participants)
	BotService.reviveAll(Arena.lobbySpot)
	for _, participant in participants do
		if not participant.IsBot and not participant.Left and not participant:IsAlive() then
			pcall(function()
				participant.Player:LoadCharacter()
			end)
		end
	end
end

--[[
	Plays one full round with exactly Config.PlayersPerMatch participants.
	Returns the normalized ranked results and the coin rows shown on the results screen.
	This is the hook a future board game calls between turns.
]]
function MinigameManager.runRound(participants)
	assert(#registry > 0, "No minigames loaded")
	state.Participants = participants
	state.ByPlayer = {}
	for _, participant in participants do
		if participant.Player then
			state.ByPlayer[participant.Player] = participant
		end
	end

	-- 1. Vote
	local entry = runVote(participants)
	local definition = entry.Definition
	local info = definition.Info
	local described = describeMinigame(entry)
	assignTeams(participants, info.Layout)

	-- 2. Build the arena + a fresh minigame instance (all per-round state lives on it)
	local arena = Arena.create(entry.Id)
	local progress = {}
	local round = RoundContext.new({
		Participants = participants,
		Arena = arena,
		Broadcast = broadcast,
		SetStatus = setStatus,
		OnProgress = function(participant, value, label)
			progress[participant] = { Value = value, Label = label }
			queueChipFlush()
		end,
		OnEliminated = queueChipFlush,
	})
	local instance = setmetatable({ Round = round, Arena = arena, Participants = participants }, { __index = definition })

	local actions = {}
	for _, control in described.Controls.Actions do
		actions[control.Action] = true
		if control.Hold then
			actions[control.Action .. "Stop"] = true
		end
	end
	state.Active = {
		Entry = entry,
		Instance = instance,
		Round = round,
		Arena = arena,
		Actions = actions,
		Described = described,
		Progress = progress,
		Connections = {},
	}

	-- 3. Instructions card; build the map and teleport while everyone reads it
	local instructionsEnd = now() + Config.InstructionsDuration
	setPhase(Net.Phase.Instructions, {
		Minigame = described,
		Participants = describeParticipants(participants),
		ArenaOrigin = arena.Origin,
		EndsAt = instructionsEnd,
	})

	local spawns = instance:Setup(arena, participants, round) or {}
	ensureBodies(participants)
	for index, participant in participants do
		local spawn = spawns[index] or (arena.Origin + Vector3.new(index * 4, 4, 0))
		participant:Teleport(spawn)
		participant:Freeze()
	end
	broadcast(chipsMessage()) -- characters exist now, so spectating works from the start
	task.wait(math.max(0, instructionsEnd - now()))

	-- 4. Countdown
	for number = Config.CountdownFrom, 1, -1 do
		setPhase(Net.Phase.Countdown, { Number = number, Minigame = described, ArenaOrigin = arena.Origin })
		task.wait(1)
	end

	-- 5. Play
	for _, participant in participants do
		local humanoid = participant:GetHumanoid()
		if humanoid then
			table.insert(
				state.Active.Connections,
				humanoid.Died:Connect(function()
					onParticipantLost(participant, "Died")
				end)
			)
		end
		if participant:IsAlive() then
			participant:ApplyControls(described.Controls) -- server-side movement locking
		else
			onParticipantLost(participant, "Died")
		end
	end

	round.EndsAt = now() + info.Duration
	setPhase(Net.Phase.Playing, {
		Minigame = described,
		Participants = describeParticipants(participants),
		ArenaOrigin = arena.Origin,
		EndsAt = round.EndsAt,
	})
	BotService.setBrain(function(bot, dt)
		if instance.UpdateBot and not round.Ended and not round:IsEliminated(bot.Participant) then
			instance:UpdateBot(bot, dt)
		end
	end)
	safeCall(instance, "Start")

	while not round.Ended and now() < round.EndsAt do
		task.wait(0.1)
	end
	local reason = if round.Ended then round.EndReason else "TimeUp"
	round:End(reason)
	BotService.setBrain(nil)
	safeCall(instance, "OnRoundEnding", reason)

	-- 6. Freeze, collect results, clean up, go home
	for _, participant in participants do
		if participant:IsAlive() then
			participant:Freeze()
		end
	end
	setPhase(Net.Phase.Finished, { Minigame = described })
	local ok, rawResults = safeCall(instance, "GetResults")
	local results = ResultsUtil.normalize(if ok then rawResults else nil, participants)
	task.wait(Config.FinishBannerDuration)
	finishRound()

	-- 7. Results screen
	local rows = awardCoins(results)
	setPhase(Net.Phase.Results, {
		Minigame = described,
		Results = rows,
		EndsAt = now() + Config.ResultsDuration,
	})
	task.wait(Config.ResultsDuration)
	return results, rows
end

-- Emergency stop if anything in runRound threw. Leaves the server ready for the next round.
function MinigameManager.abort(message: string?)
	state.Vote = nil
	finishRound()
	broadcast({ Type = Net.Message.Toast, Text = message or "Round cancelled" })
end

-- Shows the lobby screen and waits `duration` seconds (0 = just show it).
function MinigameManager.showLobby(text: string, duration: number?)
	setPhase(Net.Phase.Lobby, {
		Text = text,
		EndsAt = if duration then now() + duration else nil,
	})
	if duration then
		task.wait(duration)
	end
end

function MinigameManager.getMinigames()
	local list = {}
	for _, entry in registry do
		table.insert(list, describeMinigame(entry))
	end
	return list
end

function MinigameManager.init()
	loadMinigames()
	BotService.setActionHandler(submitAction)

	-- Messages from a minigame's own client code go to the running minigame, rate limited.
	-- The minigame must validate them: they are whatever the client chose to send.
	local messageBuckets: { [Player]: { Start: number, Count: number } } = {}
	local function onMinigameMessage(player: Player, payload)
		local clock = os.clock()
		local bucket = messageBuckets[player]
		if not bucket or clock - bucket.Start >= 1 then
			bucket = { Start = clock, Count = 0 }
			messageBuckets[player] = bucket
		end
		bucket.Count += 1
		if bucket.Count > Config.MinigameMessageRateLimit then
			return
		end
		local active = state.Active
		local participant = state.ByPlayer[player]
		if not active or not participant or state.PhaseMessage.Phase ~= Net.Phase.Playing or active.Round.Ended then
			return
		end
		if active.Round:IsEliminated(participant) then
			return
		end
		safeCall(active.Instance, "OnClientMessage", participant, payload)
	end
	Net.minigameRemote().OnServerEvent:Connect(onMinigameMessage)
	Net.minigameFastRemote().OnServerEvent:Connect(onMinigameMessage)
	Players.PlayerRemoving:Connect(function(player)
		messageBuckets[player] = nil
	end)

	-- Rate limit: at most Config.InputRateLimit inputs per player per second.
	local buckets: { [Player]: { Start: number, Count: number } } = {}
	inputRemote.OnServerEvent:Connect(function(player: Player, payload)
		if type(payload) ~= "table" then
			return
		end
		local clock = os.clock()
		local bucket = buckets[player]
		if not bucket or clock - bucket.Start >= 1 then
			bucket = { Start = clock, Count = 0 }
			buckets[player] = bucket
		end
		bucket.Count += 1
		if bucket.Count > Config.InputRateLimit then
			return
		end

		local kind = payload.Kind
		if kind == Net.Input.Ready then
			sendSnapshot(player)
			return
		end
		local participant = state.ByPlayer[player]
		if not participant then
			return -- spectators (5th+ player) can't vote or act
		end
		if kind == Net.Input.Vote then
			castVote(participant, payload.Choice)
		elseif kind == Net.Input.Action and type(payload.Action) == "string" then
			submitAction(participant, payload.Action)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
		local participant = state.ByPlayer[player]
		if not participant then
			return
		end
		participant.Left = true
		state.ByPlayer[player] = nil
		if state.Vote then
			state.Vote.Votes[participant] = nil
			broadcast(voteUpdateMessage(state.Vote))
		end
		onParticipantLost(participant, "Left")
	end)
end

return MinigameManager
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="13">
        <Properties>
          <string name="Name">Minigames</string>
        </Properties>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">FallingPlatforms</string>
            <string name="Source"><![CDATA[--[[
	Falling Platforms (FFA, elimination)
	A grid of tiles floating over the void. Any tile you stand on starts to crumble, and
	random tiles drop faster and faster as the round goes on. Fall and you're out.
	Last one standing wins; if time runs out every survivor ties for 1st.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.PartyShared.Config)
local ResultsUtil = require(script.Parent.Parent.ResultsUtil)

local FallingPlatforms = {}

FallingPlatforms.Info = {
	Name = "Falling Platforms",
	Description = "The floor is lava's lazy cousin: tiles crumble after you step on them and random ones drop out. Keep moving, don't fall!",
	Duration = 75,
	Layout = Config.Layouts.FFA,
	Camera = { Mode = "FollowBehind" },
	Controls = { Move = true, Jump = true, WalkSpeed = 18 }, -- no actions, slightly zippier
	ProgressLabel = "Survived",
}

-- Tuning ----------------------------------------------------------------------------------
-- These decide how long a round lasts. Aim: 30-45 seconds with four players.

local GRID_SIZE = 10 -- GRID_SIZE x GRID_SIZE tiles
local TILE_SIZE = 8
local GAP = 1
-- Seconds a tile survives after being stepped on: { at GO, once the round is fully sped up }.
local CRUMBLE_DELAY = { 3.0, 1.2 }
-- Random drops: warning time for the tile, and seconds between drops { at GO, sped up }.
local RANDOM_DELAY = 2.0
local RANDOM_INTERVAL = { 3.0, 0.8 }
local RAMP_TIME = 45 -- seconds after GO until both of the above reach their fastest value
local START_GRACE = 1.5 -- tiles ignore footsteps this long after GO, so nobody drops before they can react
local CHECK_INTERVAL = 0.1

local SOLID_COLOR = Color3.fromRGB(110, 220, 255)
local WARNING_COLOR = Color3.fromRGB(255, 200, 40)
local CRUMBLE_COLOR = Color3.fromRGB(255, 70, 70)

-- Setup -----------------------------------------------------------------------------------

function FallingPlatforms:Setup(arena, participants, _round)
	self.Tiles = {} -- [row][col] = { Part, State = "Solid" | "Warning" | "Fallen", Row, Col }
	self.Connections = {}

	local pitch = TILE_SIZE + GAP
	local half = (GRID_SIZE - 1) / 2
	for row = 1, GRID_SIZE do
		self.Tiles[row] = {}
		for col = 1, GRID_SIZE do
			local part = Instance.new("Part")
			part.Name = ("Tile_%d_%d"):format(row, col)
			part.Anchored = true
			part.Size = Vector3.new(TILE_SIZE, 1, TILE_SIZE)
			part.CFrame = arena.Origin * CFrame.new((col - 1 - half) * pitch, 0, (row - 1 - half) * pitch)
			-- Checkerboard tint so the grid reads well from above.
			part.Color = if (row + col) % 2 == 0 then SOLID_COLOR else SOLID_COLOR:Lerp(Color3.new(1, 1, 1), 0.3)
			part.Material = Enum.Material.SmoothPlastic
			part.Parent = arena.Folder
			self.Tiles[row][col] = { Part = part, State = "Solid", Row = row, Col = col }
		end
	end

	-- One player per corner-ish tile.
	local spawnTiles = { { 2, 2 }, { 2, GRID_SIZE - 1 }, { GRID_SIZE - 1, 2 }, { GRID_SIZE - 1, GRID_SIZE - 1 } }
	local spawns = {}
	for index = 1, #participants do
		local cell = spawnTiles[(index - 1) % #spawnTiles + 1]
		local tile = self.Tiles[cell[1]][cell[2]]
		local position = tile.Part.Position + Vector3.new(0, 4, 0)
		spawns[index] = CFrame.lookAt(position, Vector3.new(arena.Origin.X, position.Y, arena.Origin.Z))
	end
	return spawns
end

-- Tiles -----------------------------------------------------------------------------------

-- Which tile (if any) is directly under a world position.
function FallingPlatforms:_tileAt(position: Vector3)
	local localPosition = self.Arena.Origin:PointToObjectSpace(position)
	local pitch = TILE_SIZE + GAP
	local half = (GRID_SIZE - 1) / 2
	local col = math.floor(localPosition.X / pitch + half + 0.5) + 1
	local row = math.floor(localPosition.Z / pitch + half + 0.5) + 1
	local tileRow = self.Tiles[row]
	return tileRow and tileRow[col]
end

function FallingPlatforms:_crumble(tile, delay: number)
	if tile.State ~= "Solid" then
		return
	end
	tile.State = "Warning"
	tile.FallsAt = os.clock() + delay
	tile.Part.Color = WARNING_COLOR
	tile.Part.Material = Enum.Material.Neon

	task.delay(delay * 0.5, function()
		if tile.State == "Warning" and tile.Part.Parent then
			tile.Part.Color = CRUMBLE_COLOR
		end
	end)
	task.delay(delay, function()
		if tile.State ~= "Warning" or not tile.Part.Parent then
			return
		end
		tile.State = "Fallen"
		tile.Part.CanCollide = false
		tile.Part.Material = Enum.Material.Slate
		TweenService:Create(tile.Part, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			CFrame = tile.Part.CFrame * CFrame.new(0, -40, 0) * CFrame.Angles(math.rad(25), 0, math.rad(15)),
			Transparency = 1,
		}):Play()
	end)
end

-- 0 at GO, 1 once the round has fully sped up.
function FallingPlatforms:_ramp(): number
	return math.clamp((os.clock() - (self.StartedAt or os.clock())) / RAMP_TIME, 0, 1)
end

function FallingPlatforms:_crumbleDelay(): number
	return CRUMBLE_DELAY[1] + (CRUMBLE_DELAY[2] - CRUMBLE_DELAY[1]) * self:_ramp()
end

function FallingPlatforms:_solidTiles()
	local list = {}
	for _, row in self.Tiles do
		for _, tile in row do
			if tile.State == "Solid" then
				table.insert(list, tile)
			end
		end
	end
	return list
end

-- Interface -------------------------------------------------------------------------------

function FallingPlatforms:Start()
	local round = self.Round
	local startedAt = os.clock()
	self.StartedAt = startedAt
	local nextChipUpdate = 0
	local nextCheck = 0
	local nextRandomDrop = os.clock() + RANDOM_INTERVAL[1]
	local floorY = self.Arena.Origin.Y

	table.insert(
		self.Connections,
		RunService.Heartbeat:Connect(function()
			local clock = os.clock()
			if round.Ended or clock < nextCheck then
				return
			end
			nextCheck = clock + CHECK_INTERVAL

			for _, participant in round:GetAlive() do
				local position = participant:GetPosition()
				if not position then
					continue
				end
				if position.Y < floorY - Config.FallOutDepth then
					round:Eliminate(participant, true)
					round:Toast(("🪂 %s fell into the void"):format(participant.Name))
					round:ReportProgress(participant, ("🪂 %ds"):format(clock - startedAt))
				elseif position.Y < floorY + 8 and clock - startedAt >= START_GRACE then
					-- Standing (or nearly) on the grid: the tile underneath starts crumbling.
					local tile = self:_tileAt(position)
					if tile then
						self:_crumble(tile, self:_crumbleDelay())
					end
				end
			end

			-- Random drops speed up over the round.
			if clock >= nextRandomDrop then
				local progress = math.clamp((clock - startedAt) / self.Info.Duration, 0, 1)
				local interval = RANDOM_INTERVAL[1] + (RANDOM_INTERVAL[2] - RANDOM_INTERVAL[1]) * progress
				nextRandomDrop = clock + interval
				local solid = self:_solidTiles()
				if #solid > 0 then
					self:_crumble(solid[round.Rng:NextInteger(1, #solid)], RANDOM_DELAY)
				end
			end

			-- Chips: seconds survived for anyone still standing.
			if clock >= nextChipUpdate then
				nextChipUpdate = clock + 1
				for _, participant in round:GetAlive() do
					round:ReportProgress(participant, ("%ds"):format(clock - startedAt))
				end
			end

			if #round:GetAlive() <= 1 then
				round:End("LastStanding")
			end
		end)
	)
	round:SetStatus("Keep moving! 🏃")
end

--[[
	Bot behaviour: stand on a tile until it is about to drop, then step to a neighbour.
	(Leaving a tile the moment it starts to crumble would burn through the whole floor in
	seconds.) Sloppier bots cut it closer and pick worse tiles, which is funny.
]]
function FallingPlatforms:_solidNeighbours(tile)
	local list = {}
	for _, offset in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
		local row = self.Tiles[tile.Row + offset[1]]
		local neighbour = row and row[tile.Col + offset[2]]
		if neighbour and neighbour.State == "Solid" then
			table.insert(list, neighbour)
		end
	end
	return list
end

function FallingPlatforms:UpdateBot(bot, _dt)
	local position = bot:GetPosition()
	if not position then
		return
	end
	local memory = bot.Memory
	local clock = os.clock()
	local current = self:_tileAt(position)
	if current and current.State == "Fallen" then
		current = nil
	end
	if not memory.Target then
		memory.Target = current
		memory.Margin = 0.6
	end
	local target = memory.Target

	if target and target ~= current and target.State == "Solid" then
		-- On the way. Hop if the floor ahead is already gone.
		local toTarget = target.Part.Position - position
		local flat = Vector3.new(toTarget.X, 0, toTarget.Z)
		if flat.Magnitude > 1 then
			local ahead = self:_tileAt(position + flat.Unit * 4)
			if not ahead or ahead.State == "Fallen" then
				bot:Jump()
			end
		end
		bot:MoveTo(target.Part.Position + Vector3.new(0, 3, 0))
		return
	end
	if target and target == current and (current.State == "Solid" or current.FallsAt - clock > memory.Margin) then
		bot:MoveTo(current.Part.Position + Vector3.new(0, 3, 0))
		return -- this tile still has time left: stay put
	end

	-- Pick the next tile: a solid 4-neighbour, preferring ones that aren't dead ends.
	local from = current or target
	local options = if from then self:_solidNeighbours(from) else {}
	if #options == 0 then
		-- Stranded: make a run (and a jump) for the nearest solid tile anywhere.
		local best, bestDistance = nil, math.huge
		for _, tile in self:_solidTiles() do
			local distance = (tile.Part.Position - position).Magnitude
			if distance < bestDistance then
				best, bestDistance = tile, distance
			end
		end
		options = { best }
	end
	if #options == 0 then
		memory.Target = nil -- no floor left anywhere; enjoy the fall
		return
	end

	local choice = options[math.random(1, #options)]
	if math.random() < bot.Skill then
		local bestExits = -1
		for _, tile in options do
			local exits = #self:_solidNeighbours(tile) + math.random() * 0.5
			if exits > bestExits then
				choice, bestExits = tile, exits
			end
		end
	end

	memory.Target = choice
	-- How late this bot dares to leave its next tile (seconds before it drops).
	memory.Margin = 0.35 + bot.Skill * 0.25 + math.random() * 0.45
	bot:MoveTo(choice.Part.Position + Vector3.new(0, 3, 0))
end

function FallingPlatforms:GetResults()
	return ResultsUtil.fromElimination(self.Participants, self.Round)
end

function FallingPlatforms:Cleanup()
	for _, connection in self.Connections do
		connection:Disconnect()
	end
end

return FallingPlatforms
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">HotPotato</string>
            <string name="Source"><![CDATA[--[[
	Hot Potato (FFA, elimination)
	One player holds a burning potato with a hidden fuse. Get next to someone and press
	Pass to hand it over. Whoever holds it when it explodes is out. Last one standing wins.
	If time runs out, the current holder explodes and everyone left ties for 1st.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.PartyShared.Config)
local ResultsUtil = require(script.Parent.Parent.ResultsUtil)

local HotPotato = {}

HotPotato.Info = {
	Name = "Hot Potato",
	Description = "Someone's holding a spicy potato 🥔🔥. Get close and pass it before it goes BOOM. Last one standing wins!",
	Duration = 90,
	Layout = Config.Layouts.FFA,
	Camera = { Mode = "AngledOverhead", Height = 50, Distance = 38 },
	Controls = {
		Move = true,
		Jump = true,
		Actions = {
			{ Action = "Pass", Label = "Pass!", Key = "E", Gamepad = "ButtonX" },
		},
	},
	ProgressLabel = "Potato",
}

local ARENA_RADIUS = 30
local PASS_RANGE = 9 -- studs between root parts
local PASS_COOLDOWN = 1.0 -- holder can't pass again this soon after receiving
local NO_TAG_BACKS = 3.0 -- can't pass straight back to whoever just gave it to you
local RECEIVE_STUN = 0.9 -- "hot hands": a new holder is rooted this long, so everyone else can scatter
local FUSE_RANGE = { 8, 14 } -- seconds, re-rolled for every new potato
local HOLDER_SPEED = 21 -- holder is a bit faster so they can actually catch people
local NEW_POTATO_DELAY = 2

-- Bot feel. Reaction times are { sloppiest bot, sharpest bot } in seconds, plus random jitter.
local BOT_PASS_REACTION = { 1.4, 0.25 } -- in range of a victim -> actually pressing Pass
local BOT_FLEE_REACTION = { 0.55, 0.12 } -- potato changes hands -> noticing and changing direction
local BOT_COMFORT_DISTANCE = { 16, 26 } -- each bot stops running once it is this far from the holder
local BOT_PERSONAL_SPACE = 13 -- non-holders steer apart when closer than this to each other

local function now()
	return Workspace:GetServerTimeNow()
end

-- Setup ---------------------------------------------------------------------------------

function HotPotato:Setup(arena, participants, _round)
	local origin = arena.Origin

	-- Round floor (cylinder parts lie along X, so rotate it flat).
	local floor = Instance.new("Part")
	floor.Name = "Floor"
	floor.Shape = Enum.PartType.Cylinder
	floor.Size = Vector3.new(2, ARENA_RADIUS * 2, ARENA_RADIUS * 2)
	floor.CFrame = origin * CFrame.Angles(0, 0, math.rad(90))
	floor.Anchored = true
	floor.Material = Enum.Material.Sand
	floor.Color = Color3.fromRGB(255, 200, 120)
	floor.Parent = arena.Folder

	-- Ring of see-through walls so nobody runs off the edge.
	local segments = 24
	for i = 1, segments do
		local angle = (i / segments) * math.pi * 2
		local wall = Instance.new("Part")
		wall.Name = "Wall"
		wall.Anchored = true
		wall.Size = Vector3.new(2, 8, ARENA_RADIUS * 2 * math.pi / segments + 1)
		wall.CFrame = origin
			* CFrame.Angles(0, -angle, 0)
			* CFrame.new(ARENA_RADIUS, 5, 0)
		wall.Transparency = 0.6
		wall.Color = Color3.fromRGB(255, 120, 60)
		wall.Material = Enum.Material.ForceField
		wall.Parent = arena.Folder
	end

	-- The potato itself. Anchored and moved every frame above the holder's head.
	local potato = Instance.new("Part")
	potato.Name = "Potato"
	potato.Shape = Enum.PartType.Ball
	potato.Size = Vector3.new(2.5, 2.5, 2.5)
	potato.Color = Color3.fromRGB(160, 110, 60)
	potato.Material = Enum.Material.Slate
	potato.Anchored = true
	potato.CanCollide = false
	potato.CanQuery = false
	potato.CanTouch = false
	potato.Transparency = 1
	potato.CFrame = origin
	local fire = Instance.new("Fire")
	fire.Size = 4
	fire.Heat = 8
	fire.Parent = potato
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 140, 40)
	light.Range = 12
	light.Parent = potato
	potato.Parent = arena.Folder

	self.Potato = potato
	self.Fire = fire
	self.Holder = nil
	self.PreviousHolder = nil
	self.ReceivedAt = 0
	self.FuseEndsAt = math.huge
	self.Connections = {}
	self.Highlight = nil

	-- Spawns: evenly around a circle, facing the middle.
	local spawns = {}
	for index = 1, #participants do
		local angle = (index / #participants) * math.pi * 2
		local position = (origin * CFrame.new(math.cos(angle) * 14, 4, math.sin(angle) * 14)).Position
		spawns[index] = CFrame.lookAt(position, Vector3.new(origin.X, position.Y, origin.Z))
	end
	return spawns
end

-- Potato handling -----------------------------------------------------------------------

-- Player chips: who's holding it, who's safe, who's toast.
function HotPotato:_refreshChips()
	for _, participant in self.Participants do
		local value = if self.Round:IsEliminated(participant)
			then "💥 cooked"
			elseif participant == self.Holder then "🥔 HOT!"
			else "😎 safe"
		self.Round:ReportProgress(participant, value)
	end
end

function HotPotato:_setHolder(participant)
	local previous = self.Holder
	if previous then
		previous:SetMovement(Config.DefaultWalkSpeed, true)
	end
	if self.Highlight then
		self.Highlight:Destroy()
		self.Highlight = nil
	end

	self.PreviousHolder = previous
	self.Holder = participant
	self.ReceivedAt = now()
	if not participant then
		self.Potato.Transparency = 1
		self.Fire.Enabled = false
		self:_refreshChips()
		return
	end

	-- Rooted for a beat, then faster than everyone else.
	participant:SetMovement(0, false)
	local receivedAt = self.ReceivedAt
	task.delay(RECEIVE_STUN, function()
		if not self.Cleaned and not self.Round.Ended and self.Holder == participant and self.ReceivedAt == receivedAt then
			participant:SetMovement(HOLDER_SPEED, true)
		end
	end)
	local character = participant:GetCharacter()
	if character then
		local highlight = Instance.new("Highlight")
		highlight.FillColor = Color3.fromRGB(255, 80, 0)
		highlight.OutlineColor = Color3.fromRGB(255, 230, 0)
		highlight.FillTransparency = 0.5
		highlight.Parent = character
		self.Highlight = highlight
	end
	self.Potato.Transparency = 0
	self.Fire.Enabled = true
	self.Round:SetStatus(("🥔 %s has the potato!"):format(participant.Name))
	self:_refreshChips()
end

-- Hands a fresh potato (new fuse) to a random survivor.
function HotPotato:_newPotato()
	local round = self.Round
	if round.Ended then
		return
	end
	local alive = round:GetAlive()
	if #alive <= 1 then
		round:End("LastStanding")
		return
	end
	self.FuseEndsAt = now() + round.Rng:NextNumber(FUSE_RANGE[1], FUSE_RANGE[2])
	self:_setHolder(alive[round.Rng:NextInteger(1, #alive)])
	round:Toast(("🔥 New potato! %s is holding it"):format(self.Holder.Name))
end

function HotPotato:_explode(spawnNext: boolean)
	local holder = self.Holder
	if not holder then
		return
	end
	self:_setHolder(nil)
	self.FuseEndsAt = math.huge

	local position = holder:GetPosition()
	if position then
		-- Visual only: no flinging and no joint breaking.
		local explosion = Instance.new("Explosion")
		explosion.Position = position
		explosion.BlastPressure = 0
		explosion.DestroyJointRadiusPercent = 0
		explosion.Parent = self.Arena.Folder
	end
	self.Round:Toast(("💥 BOOM! %s got cooked"):format(holder.Name))
	self.Round:Eliminate(holder, true)
	self:_refreshChips()

	if spawnNext then
		if #self.Round:GetAlive() <= 1 then
			self.Round:End("LastStanding")
		else
			self.Round:SetStatus("🥔 Reheating the potato...")
			task.delay(NEW_POTATO_DELAY, function()
				if not self.Cleaned then
					self:_newPotato()
				end
			end)
		end
	end
end

-- Closest eligible survivor in pass range, or nil.
function HotPotato:_passTarget(from)
	local fromPosition = from:GetPosition()
	if not fromPosition then
		return nil
	end
	local best, bestDistance = nil, PASS_RANGE
	for _, other in self.Round:GetAlive() do
		local position = other:GetPosition()
		local isTagBack = other == self.PreviousHolder and now() - self.ReceivedAt < NO_TAG_BACKS
		if other ~= from and position and not isTagBack then
			local distance = (position - fromPosition).Magnitude
			if distance <= bestDistance then
				best, bestDistance = other, distance
			end
		end
	end
	return best
end

function HotPotato:_tryPass(from)
	if from ~= self.Holder or now() - self.ReceivedAt < PASS_COOLDOWN then
		return
	end
	local target = self:_passTarget(from)
	if target then
		self:_setHolder(target)
	end
end

-- Interface -----------------------------------------------------------------------------

function HotPotato:Start()
	self:_refreshChips()
	self:_newPotato()
	table.insert(
		self.Connections,
		RunService.Heartbeat:Connect(function()
			if self.Round.Ended or not self.Holder then
				return
			end
			-- Keep the potato floating above the holder's head.
			local position = self.Holder:GetPosition()
			if position then
				self.Potato.CFrame = CFrame.new(position + Vector3.new(0, 4, 0))
					* CFrame.Angles(0, os.clock() * 4, 0)
			end
			-- Flicker harder as the fuse gets short (we never show the real number).
			local remaining = self.FuseEndsAt - now()
			self.Fire.Size = if remaining < 3 then 7 + math.sin(os.clock() * 30) * 2 else 4
			if remaining <= 0 then
				self:_explode(true)
			end
		end)
	)
end

function HotPotato:OnInput(participant, action)
	if action == "Pass" then
		self:_tryPass(participant)
	end
end

-- Someone died or left: if they had the potato, hand out a new one.
function HotPotato:OnParticipantLost(participant)
	if participant == self.Holder then
		self:_setHolder(nil)
		task.delay(NEW_POTATO_DELAY, function()
			if not self.Cleaned then
				self:_newPotato()
			end
		end)
	elseif #self.Round:GetAlive() <= 1 then
		self.Round:End("LastStanding")
	end
end

-- Time's up: whoever is holding it explodes on the buzzer.
function HotPotato:OnRoundEnding(reason)
	if reason == "TimeUp" then
		self:_explode(false)
	end
end

--[[
	Bot behaviour: if I have the potato, chase the nearest player I'm allowed to pass to and
	hand it over after a human-ish reaction delay. Otherwise keep my distance from the holder
	and from the other runners, so the pack spreads around the ring instead of clumping.
]]
local function reaction(range, skill: number): number
	return (range[1] + (range[2] - range[1]) * skill) * (0.7 + math.random() * 0.6)
end

function HotPotato:UpdateBot(bot, _dt)
	local me = bot.Participant
	local myPosition = bot:GetPosition()
	if not myPosition then
		return
	end
	local memory = bot.Memory
	local clock = now()
	local center = self.Arena.Origin.Position

	if self.Holder == me then
		if clock - self.ReceivedAt < RECEIVE_STUN then
			return
		end
		-- Chase whoever is closest, but not the player I can't tag back yet (unless nobody else is left).
		local target, targetDistance = nil, math.huge
		local fallback, fallbackDistance = nil, math.huge
		for _, other in self.Round:GetAlive() do
			local position = other:GetPosition()
			if other ~= me and position then
				local distance = (position - myPosition).Magnitude
				local blocked = other == self.PreviousHolder and clock - self.ReceivedAt < NO_TAG_BACKS
				if blocked then
					if distance < fallbackDistance then
						fallback, fallbackDistance = other, distance
					end
				elseif distance < targetDistance then
					target, targetDistance = other, distance
				end
			end
		end
		if not target then
			target, targetDistance = fallback, fallbackDistance
		end
		if not target then
			return
		end
		-- Each time it gets the potato a bot picks who to go after. Usually the closest
		-- player, sometimes someone further away, so the chases aren't all the same length.
		if memory.VictimFor ~= self.ReceivedAt then
			memory.VictimFor = self.ReceivedAt
			memory.Victim = target
			if math.random() > 0.45 + bot.Skill * 0.35 then
				local others = {}
				for _, other in self.Round:GetAlive() do
					if other ~= me and other ~= self.PreviousHolder and other:GetPosition() then
						table.insert(others, other)
					end
				end
				if #others > 0 then
					memory.Victim = others[math.random(1, #others)]
				end
			end
		end
		local victim = memory.Victim
		local victimPosition = victim and not self.Round:IsEliminated(victim) and victim:GetPosition()
		bot:MoveTo(victimPosition or target:GetPosition())
		-- Whoever wanders into reach gets it, victim or not.
		if targetDistance <= PASS_RANGE * 0.9 then
			memory.PassAt = memory.PassAt or (clock + reaction(BOT_PASS_REACTION, bot.Skill))
			if clock >= memory.PassAt then
				memory.PassAt = nil
				bot:Input("Pass")
			end
		else
			memory.PassAt = nil
		end
		return
	end
	memory.PassAt = nil

	local holder = self.Holder
	local holderPosition = holder and holder:GetPosition()
	if not holderPosition then
		-- Nobody has it right now: wander to my own spot instead of bunching up in the middle.
		if not memory.IdleSpot or clock >= (memory.IdleUntil or 0) then
			local angle = math.random() * math.pi * 2
			local radius = 6 + math.random() * (ARENA_RADIUS - 14)
			memory.IdleSpot = center + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
			memory.IdleUntil = clock + 1.5 + math.random() * 1.5
		end
		bot:MoveTo(Vector3.new(memory.IdleSpot.X, myPosition.Y, memory.IdleSpot.Z))
		memory.SeenHolder = nil
		return
	end

	-- It takes a moment to notice the potato changed hands.
	if memory.SeenHolder ~= holder then
		memory.SeenHolder = holder
		memory.ReactAt = clock + reaction(BOT_FLEE_REACTION, bot.Skill)
	end
	if clock < (memory.ReactAt or 0) then
		return
	end
	memory.Comfort = memory.Comfort
		or (BOT_COMFORT_DISTANCE[1] + math.random() * (BOT_COMFORT_DISTANCE[2] - BOT_COMFORT_DISTANCE[1]))

	local away = myPosition - holderPosition
	away = Vector3.new(away.X, 0, away.Z)
	if away.Magnitude < 0.1 then
		away = Vector3.new(1, 0, 0)
	end

	-- Push away from the other runners too.
	local spread = Vector3.zero
	for _, other in self.Round:GetAlive() do
		local position = other ~= me and other ~= holder and other:GetPosition()
		if position then
			local apart = Vector3.new(myPosition.X - position.X, 0, myPosition.Z - position.Z)
			if apart.Magnitude < 0.1 then
				apart = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5)
			end
			if apart.Magnitude < BOT_PERSONAL_SPACE then
				spread += apart.Unit * (1 - apart.Magnitude / BOT_PERSONAL_SPACE)
			end
		end
	end

	if away.Magnitude > memory.Comfort and spread.Magnitude < 0.15 then
		bot:Stop() -- far enough and not crowded: catch a breath
		return
	end

	-- Each bot leans to one side for a while, so they don't all flee in the same straight line.
	if clock >= (memory.SwerveUntil or 0) then
		memory.Swerve = (math.random() - 0.5) * 1.2
		memory.SwerveUntil = clock + 0.8 + math.random() * 1.4
	end
	local urgency = math.clamp(1.6 - away.Magnitude / memory.Comfort, 0.2, 1.6)
	local direction = away.Unit * urgency
		+ Vector3.new(-away.Unit.Z, 0, away.Unit.X) * memory.Swerve
		+ spread * 1.4
	if direction.Magnitude < 0.05 then
		direction = away.Unit
	end
	local goal = myPosition + direction.Unit * 12
	local fromCenter = Vector3.new(goal.X - center.X, 0, goal.Z - center.Z)
	if fromCenter.Magnitude > ARENA_RADIUS - 5 then
		-- Cornered against the wall: slide around the ring instead, away from the holder.
		local tangent = Vector3.new(-fromCenter.Z, 0, fromCenter.X).Unit
		if tangent:Dot(away) < 0 then
			tangent = -tangent
		end
		goal = center + fromCenter.Unit * (ARENA_RADIUS - 7) + tangent * 8
	end
	bot:MoveTo(Vector3.new(goal.X, myPosition.Y, goal.Z))
end

function HotPotato:GetResults()
	return ResultsUtil.fromElimination(self.Participants, self.Round)
end

function HotPotato:Cleanup()
	self.Cleaned = true
	for _, connection in self.Connections do
		connection:Disconnect()
	end
	if self.Highlight then
		self.Highlight:Destroy()
	end
	-- The potato and map live in arena.Folder, which the framework destroys.
end

return HotPotato
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">IceDash</string>
            <string name="Source"><![CDATA[--[[
	Ice Dash (FFA, race)
	Everyone slides forward down a frozen track on their own; you only steer left and right.
	It's ice, so you drift: momentum carries you sideways after you let go. Snow drifts and
	puddles slow you, bumpers and walls bounce you, and some stretches have no side walls -
	slide off and you restart from the last checkpoint.
	First over the finish line wins. Everyone else is ranked by how far they got.

	Who simulates what (so it stays smooth on a laggy connection):
	  * Each player's client runs its own racer with the shared rules in PartyShared.IceDashSim
	    (see client/Minigames/IceDash) and reports its state ~20 times a second.
	  * The server checks every report (see _validateReport) and only then adopts it. It works
	    out checkpoints, falls and the finish itself, so finish order can't be faked.
	  * Bots are simulated here with the same rules.
	  * The server broadcasts everyone's accepted state ~20 times a second; clients draw the
	    other racers by interpolating between those snapshots.

	Physics and track tuning live at the top of PartyShared.IceDashSim (shared with the
	client). Network and anti-cheat tuning is below.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.PartyShared.Config)
local Net = require(ReplicatedStorage.PartyShared.Net)
local Sim = require(ReplicatedStorage.PartyShared.IceDashSim)
local ResultsUtil = require(script.Parent.Parent.ResultsUtil)

local IceDash = {}

-- Tuning ----------------------------------------------------------------------------------

local ROUND_DURATION = 40

-- Networking
local SNAPSHOT_RATE = 20 -- snapshots of every racer sent to clients per second
local FALLBACK_PLACE_RATE = 2 -- times per second the server itself moves the bodies (for late joiners)
local MAX_REPORT_AGE = 0.25 -- seconds a player's last report is projected forward in snapshots

-- Anti-cheat: how far a client's report may stray from what the rules allow before it is
-- thrown away and the client is snapped back to the last accepted state.
local CLOCK_SLACK = 0.35 -- seconds a client's race clock may run ahead of the server's
local SPEED_TOLERANCE = 1.08 -- sustained forward speed allowed, as a multiple of MAX_SPEED
local SPEED_BURST = 14 -- studs of extra forward travel allowed in a burst (bumper kicks, bounces)
local STEP_SLACK = 3 -- studs of slack on any single report's movement
local WALL_SLACK = 1 -- studs a report may poke past a wall or into a barrier
local RESPAWN_GRACE = 1.5 -- extra seconds a client gets to reappear at its checkpoint after falling

IceDash.Info = {
	Name = "Ice Dash",
	Description = "Slide down the ice ❄! You move on your own, so just steer. Dodge bumpers and snow, don't slip off the edge. First to the flag wins!",
	Duration = ROUND_DURATION,
	Layout = Config.Layouts.FFA,
	Camera = { Mode = "FollowBehind", Height = 12, Distance = 22, Smooth = 12 },
	Controls = {
		Move = false, -- you slide on your own; you only steer
		Jump = false,
		Actions = {
			{ Action = "Left", Label = "◀", Keys = { "A", "Left" }, Gamepad = "DPadLeft", Hold = true, Side = "Left" },
			{ Action = "Right", Label = "▶", Keys = { "D", "Right" }, Gamepad = "DPadRight", Hold = true },
		},
	},
	ProgressLabel = "Progress",
	ProgressBar = true,
	ClientModule = "IceDash", -- client/Minigames/IceDash runs the local racer and smooths the others
}

local HALF_WIDTH = Sim.HALF_WIDTH
local TRACK_LENGTH = Sim.TRACK_LENGTH

-- Track building ----------------------------------------------------------------------------

function IceDash:_part(properties)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in properties do
		part[key] = value
	end
	part.Parent = self.Arena.Folder
	return part
end

-- Track space -> world. x = sideways (+ is the racer's right), s = distance from the start line.
function IceDash:_at(x: number, y: number, s: number): CFrame
	return self.Frame * CFrame.new(x, y, -s)
end

-- Turns the layout (plain numbers from IceDashSim) into parts.
function IceDash:_buildTrack(layout)
	local width = Sim.TRACK_WIDTH
	local total = TRACK_LENGTH + 60
	self:_part({
		Name = "Ice",
		Size = Vector3.new(width, 1, total),
		CFrame = self:_at(0, 0, total / 2 - 10),
		Material = Enum.Material.Ice,
		Color = Color3.fromRGB(190, 235, 255),
		CanCollide = true,
	})

	for _, snow in layout.Snow do
		self:_part({
			Name = "SnowDrift",
			Size = Vector3.new(Sim.SNOW_SIZE.X, 0.8, Sim.SNOW_SIZE.Y),
			CFrame = self:_at(snow.X, 0.7, snow.S),
			Color = Color3.fromRGB(255, 255, 255),
		})
	end
	for _, puddle in layout.Puddles do
		self:_part({
			Name = "Puddle",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.2, Sim.PUDDLE_RADIUS * 2, Sim.PUDDLE_RADIUS * 2),
			CFrame = self:_at(puddle.X, 0.56, puddle.S) * CFrame.Angles(0, 0, math.rad(90)),
			Material = Enum.Material.Glass,
			Color = Color3.fromRGB(40, 110, 220),
			Transparency = 0.25,
		})
	end
	for _, bumper in layout.Bumpers do
		self:_part({
			Name = "Bumper",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(3, Sim.BUMPER_RADIUS * 2, Sim.BUMPER_RADIUS * 2),
			CFrame = self:_at(bumper.X, 2, bumper.S) * CFrame.Angles(0, 0, math.rad(90)),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(255, 80, 140),
		})
	end
	for _, barrier in layout.Barriers do
		self:_part({
			Name = "Barrier",
			Size = Vector3.new(barrier.X1 - barrier.X0, 4, barrier.S1 - barrier.S0),
			CFrame = self:_at((barrier.X0 + barrier.X1) / 2, 2.5, (barrier.S0 + barrier.S1) / 2),
			Material = Enum.Material.Brick,
			Color = Color3.fromRGB(255, 170, 60),
		})
	end

	-- Side walls everywhere except the open stretches, which get a red warning stripe.
	local function wall(s0: number, s1: number)
		if s1 - s0 < 1 then
			return
		end
		for _, side in { -1, 1 } do
			self:_part({
				Name = "SideWall",
				Size = Vector3.new(1.5, 4, s1 - s0),
				CFrame = self:_at(side * (HALF_WIDTH + 0.75), 2.5, (s0 + s1) / 2),
				Material = Enum.Material.Glass,
				Color = Color3.fromRGB(120, 200, 255),
				Transparency = 0.45,
			})
		end
	end
	local wallStart = -10
	for _, open in layout.Open do
		wall(wallStart, open.S0)
		wallStart = open.S1
		for _, side in { -1, 1 } do
			self:_part({
				Name = "EdgeWarning",
				Size = Vector3.new(2, 0.2, open.S1 - open.S0),
				CFrame = self:_at(side * (HALF_WIDTH - 1), 0.56, (open.S0 + open.S1) / 2),
				Material = Enum.Material.Neon,
				Color = Color3.fromRGB(255, 60, 60),
			})
		end
	end
	wall(wallStart, TRACK_LENGTH + 50)

	-- Start line, checkpoints and the finish arch.
	local function gate(at: number, color: Color3, name: string)
		self:_part({
			Name = name,
			Size = Vector3.new(width, 0.2, 2),
			CFrame = self:_at(0, 0.58, at),
			Material = Enum.Material.Neon,
			Color = color,
		})
		for _, side in { -1, 1 } do
			self:_part({
				Name = name .. "Post",
				Size = Vector3.new(1.5, 14, 1.5),
				CFrame = self:_at(side * (HALF_WIDTH + 0.75), 7.5, at),
				Material = Enum.Material.Neon,
				Color = color,
			})
		end
		self:_part({
			Name = name .. "Beam",
			Size = Vector3.new(width + 3, 1.5, 1.5),
			CFrame = self:_at(0, 14.5, at),
			Material = Enum.Material.Neon,
			Color = color,
		})
	end
	gate(0, Color3.fromRGB(255, 255, 255), "StartLine")
	for _, checkpoint in layout.Checkpoints do
		gate(checkpoint, Color3.fromRGB(90, 255, 140), "Checkpoint")
	end
	gate(TRACK_LENGTH, Color3.fromRGB(255, 220, 60), "FinishLine")
end

function IceDash:Setup(arena, participants, round)
	-- The track runs along the arena's +Z (away from the lobby); racers face down it.
	self.Frame = arena.Origin * CFrame.Angles(0, math.pi, 0)
	self.Connections = {}
	self.Racers = {}
	self.Anchored = {}
	self.FinishCount = 0
	self.Layout = Sim.generateLayout(round.Rng)
	self:_buildTrack(self.Layout)

	local spawns = {}
	for index, participant in participants do
		local lane = Sim.START_LANES[(index - 1) % #Sim.START_LANES + 1]
		local racer = Sim.newRacer(lane)
		racer.IsBot = participant.IsBot
		racer.Left = false -- bots only: held steer buttons
		racer.Right = false
		racer.RideHeight = 3.5
		racer.FinishTime = nil
		-- Players only: bookkeeping for checking their reports.
		racer.ClientTime = 0
		racer.Budget = SPEED_BURST
		racer.FellAt = 0
		racer.Violations = 0
		self.Racers[participant] = racer
		spawns[index] = self:_at(lane, 4, Sim.START_S)
	end
	return spawns
end

-- Racing --------------------------------------------------------------------------------------

function IceDash:_progressText(racer): string
	if racer.FinishTime then
		return ("🏁 %.1fs"):format(racer.FinishTime)
	end
	return ("%d%%"):format(math.clamp(racer.S / TRACK_LENGTH, 0, 0.99) * 100)
end

function IceDash:_finish(participant, racer)
	racer.State = "Finished"
	racer.FinishTime = os.clock() - self.StartedAt
	self.FinishCount += 1
	self.Round:Toast(("🏁 %s finished in %.1fs"):format(participant.Name, racer.FinishTime))
	self.Round:ReportProgress(participant, self:_progressText(racer))
end

-- Puts the body where the server believes the racer is.
function IceDash:_place(participant, racer)
	local character = participant:GetCharacter()
	if character then
		local lean = math.clamp(racer.VX / Sim.MAX_SIDE_SPEED, -1, 1) * 0.3
		character:PivotTo(
			self:_at(racer.X, racer.RideHeight - Sim.fallDrop(racer), racer.S) * CFrame.Angles(0, 0, -lean)
		)
	end
end

-- Tells one client to drop its own idea of where it is and use the server's.
function IceDash:_correct(participant, racer)
	Net.minigameRemote():FireClient(participant.Player, {
		Type = "Correct",
		X = racer.X,
		S = racer.S,
		VX = racer.VX,
		VS = racer.VS,
		State = racer.State,
		Checkpoint = racer.Checkpoint,
	})
end

--[[
	A player's client says "I am here, moving like this". Decide whether the rules allow that
	given the last accepted state. Returns nil if fine, or a short reason if not.
]]
function IceDash:_checkReport(racer, x: number, s: number, vx: number, vs: number, dt: number): string?
	local layout = self.Layout
	-- One report can't move further than top speed (plus a bounce) allows.
	if math.abs(s - racer.S) > (Sim.MAX_SPEED + Sim.BUMPER_KICK) * dt + STEP_SLACK then
		return "jump"
	end
	if math.abs(x - racer.X) > (Sim.MAX_SIDE_SPEED + Sim.BUMPER_KICK) * dt + STEP_SLACK then
		return "sidejump"
	end
	if math.abs(vx) > Sim.MAX_SIDE_SPEED + Sim.BUMPER_KICK + 1 or vs > Sim.MAX_SPEED + Sim.BUMPER_KICK + 1 then
		return "velocity"
	end
	-- Sustained speed: forward travel is paid for out of a budget that refills at top speed.
	local budget = math.min(SPEED_BURST, racer.Budget + Sim.MAX_SPEED * SPEED_TOLERANCE * dt)
	if s > racer.S then
		budget -= s - racer.S
	end
	if budget < 0 then
		return "speed"
	end
	-- Solid things stay solid.
	if Sim.hasWall(layout, s) and math.abs(x) > HALF_WIDTH - Sim.RACER_RADIUS + WALL_SLACK then
		return "wall"
	end
	for _, barrier in layout.Barriers do
		if
			x > barrier.X0 + WALL_SLACK
			and x < barrier.X1 - WALL_SLACK
			and s > barrier.S0 + WALL_SLACK * 0.5
			and s < barrier.S1 - WALL_SLACK * 0.5
		then
			return "barrier"
		end
	end
	for _, bumper in layout.Bumpers do
		local dx, ds = x - bumper.X, s - bumper.S
		if dx * dx + ds * ds < (Sim.BUMPER_RADIUS * 0.5) ^ 2 then
			return "bumper"
		end
	end
	racer.Budget = budget
	return nil
end

function IceDash:_validateReport(participant, racer, message)
	local t, x, s, vx, vs = message.T, message.X, message.S, message.VX, message.VS
	for _, value in { t, x, s, vx, vs } do
		if type(value) ~= "number" or value ~= value or math.abs(value) > 1e5 then
			return
		end
	end
	if racer.State == "Finished" or self.Round.Ended or not self.StartedAt then
		return
	end
	local elapsed = os.clock() - self.StartedAt
	-- The client's race clock can't run ahead of real time (that would be a speed hack), and
	-- reports can arrive out of order on the unreliable channel: drop stale ones.
	if t <= racer.ClientTime then
		return
	end
	if t > elapsed + CLOCK_SLACK then
		racer.Violations += 1
		racer.LastProblem = "clock"
		self:_correct(participant, racer)
		return
	end
	local dt = math.min(t - racer.ClientTime, 0.5)
	racer.ClientTime = t

	if racer.State == "Falling" then
		-- The only way back is the checkpoint the server has on record.
		if math.abs(s - racer.Checkpoint) < 3 and math.abs(x - racer.Lane) < 3 then
			Sim.respawn(racer)
			racer.Budget = SPEED_BURST
		elseif os.clock() - racer.FellAt > Sim.RESPAWN_DELAY + RESPAWN_GRACE then
			Sim.respawn(racer)
			racer.Budget = SPEED_BURST
			self:_correct(participant, racer)
		else
			racer.FallTime = os.clock() - racer.FellAt
			racer.X = math.clamp(x, -HALF_WIDTH - 20, HALF_WIDTH + 20)
		end
		return
	end

	local problem = self:_checkReport(racer, x, s, vx, vs, dt)
	if problem then
		racer.Violations += 1
		racer.LastProblem = problem
		self:_correct(participant, racer)
		return
	end
	racer.X, racer.S, racer.VX, racer.VS = x, s, vx, vs
	racer.AcceptedAt = os.clock()

	-- Checkpoints, falls and the finish are decided here, from accepted positions only.
	racer.Checkpoint = math.max(racer.Checkpoint, Sim.checkpointFor(self.Layout, s))
	if not Sim.hasWall(self.Layout, s) and math.abs(x) > HALF_WIDTH + 0.5 then
		racer.State = "Falling"
		racer.FallTime = 0
		racer.FellAt = os.clock()
		self.Round:Toast(("❄ %s slid off the edge"):format(participant.Name))
	elseif s >= TRACK_LENGTH then
		self:_finish(participant, racer)
	end
end

-- Interface -----------------------------------------------------------------------------

function IceDash:Start()
	local round = self.Round
	self.StartedAt = os.clock()
	local nextReport, nextSnapshot, nextPlace = 0, 0, 0

	-- Take over the bodies: anchored for the whole race. Clients position them every frame
	-- (their own racer from local simulation, everyone else from snapshots).
	local describe = {}
	for _, participant in self.Participants do
		local racer = self.Racers[participant]
		local character = participant:GetCharacter()
		local root = participant:GetRoot()
		if character and root then
			racer.RideHeight = self.Frame:PointToObjectSpace(character:GetPivot().Position).Y
			root.AssemblyLinearVelocity = Vector3.zero
			root.Anchored = true
			table.insert(self.Anchored, root)
		end
		table.insert(describe, {
			Id = participant.Id,
			Character = character,
			Lane = racer.Lane,
			RideHeight = racer.RideHeight,
		})
	end
	Net.minigameRemote():FireAllClients({
		Type = "Setup",
		Layout = self.Layout,
		Frame = self.Frame,
		Racers = describe,
	})
	round:SetStatus("Steer! ◀ ▶")

	table.insert(
		self.Connections,
		RunService.Heartbeat:Connect(function(dt)
			if round.Ended then
				return
			end
			dt = math.min(dt, 0.05)
			local clock = os.clock()
			local alive = round:GetAlive()

			-- Bots run the shared rules here. Players are driven by their own reports.
			for _, participant in alive do
				local racer = self.Racers[participant]
				if racer.IsBot then
					local steer = (if racer.Right then 1 else 0) - (if racer.Left then 1 else 0)
					local event = Sim.step(self.Layout, racer, steer, dt)
					if event == "fell" then
						round:Toast(("❄ %s slid off the edge"):format(participant.Name))
					elseif event == "finished" then
						self:_finish(participant, racer)
					end
				elseif racer.State == "Falling" then
					racer.FallTime = clock - racer.FellAt
				end
			end
			-- Bots bump into everyone; a player's own client handles the player's half.
			for i = 1, #alive do
				local a = self.Racers[alive[i]]
				for j = i + 1, #alive do
					local b = self.Racers[alive[j]]
					if a.IsBot or b.IsBot then
						Sim.collide(a, b, a.IsBot, b.IsBot)
					end
				end
			end

			if clock >= nextSnapshot then
				nextSnapshot = clock + 1 / SNAPSHOT_RATE
				local racers = {}
				for _, participant in self.Participants do
					local racer = self.Racers[participant]
					local x, s = racer.X, racer.S
					if not racer.IsBot and racer.State == "Racing" and racer.AcceptedAt then
						-- A player's report is a little old by now: project it to this instant,
						-- so everyone else sees steady motion instead of stair-steps.
						local age = math.min(clock - racer.AcceptedAt, MAX_REPORT_AGE)
						x += racer.VX * age
						s += racer.VS * age
					end
					table.insert(racers, {
						participant.Id,
						x,
						s,
						racer.VX,
						racer.VS,
						if racer.State == "Falling" then racer.FallTime else -1,
					})
				end
				Net.minigameFastRemote():FireAllClients({ T = clock, R = racers })
			end

			if clock >= nextPlace then
				nextPlace = clock + 1 / FALLBACK_PLACE_RATE
				for _, participant in alive do
					self:_place(participant, self.Racers[participant])
				end
			end

			if clock >= nextReport then
				nextReport = clock + 0.1
				for _, participant in self.Participants do
					round:ReportProgress(participant, self:_progressText(self.Racers[participant]))
				end
			end

			if self.FinishCount >= #alive then
				round:End("Finish")
			end
		end)
	)
end

-- Bots steer through the normal input path. Players steer on their own client.
function IceDash:OnInput(participant, action)
	local racer = self.Racers[participant]
	if not racer or not racer.IsBot then
		return
	end
	if action == "Left" then
		racer.Left = true
	elseif action == "LeftStop" then
		racer.Left = false
	elseif action == "Right" then
		racer.Right = true
	elseif action == "RightStop" then
		racer.Right = false
	end
end

-- A state report from a player's client (see client/Minigames/IceDash).
function IceDash:OnClientMessage(participant, message)
	local racer = self.Racers[participant]
	if racer and not racer.IsBot and type(message) == "table" then
		self:_validateReport(participant, racer, message)
	end
end

-- The round is over: put every body where the server has it, for everyone.
function IceDash:OnRoundEnding(_reason)
	for _, participant in self.Participants do
		local racer = self.Racers[participant]
		self:_place(participant, racer)
		if racer.Violations > 0 then
			print(
				("[IceDash] %s: %d report(s) rejected (last: %s)"):format(
					participant.Name,
					racer.Violations,
					tostring(racer.LastProblem)
				)
			)
		end
	end
end

--[[
	Bot behaviour: look a little way down the track, score a handful of lines across it
	(bumpers and walls are terrible, snow and puddles are bad, the edge of an open stretch is
	scary), pick the cheapest and steer for it, allowing for drift. Sloppier bots look less
	far ahead, misjudge their drift, re-plan less often and sometimes just pick a bad line.
]]
function IceDash:_lineCost(me, x: number, fromS: number, toS: number): number
	local layout = self.Layout
	local cost = 0
	local margin = Sim.RACER_RADIUS + 1.2
	-- Don't tuck in right behind (or drive into) another racer.
	for _, other in self.Racers do
		if other ~= me and other.State == "Racing" and other.S > fromS - 3 and other.S < fromS + 14 then
			if math.abs(x - other.X) < Sim.RACER_RADIUS * 2 + 0.5 then
				cost += 45
			end
		end
	end
	for _, bumper in layout.Bumpers do
		if bumper.S > fromS and bumper.S < toS and math.abs(x - bumper.X) < Sim.BUMPER_RADIUS + margin then
			cost += 120
		end
	end
	for _, barrier in layout.Barriers do
		if barrier.S1 > fromS and barrier.S0 < toS and x > barrier.X0 - margin and x < barrier.X1 + margin then
			cost += 150
		end
	end
	for _, snow in layout.Snow do
		if snow.S > fromS - 4 and snow.S < toS and math.abs(x - snow.X) < Sim.SNOW_SIZE.X / 2 + 1 then
			cost += 35
		end
	end
	for _, puddle in layout.Puddles do
		if puddle.S > fromS - 4 and puddle.S < toS and math.abs(x - puddle.X) < Sim.PUDDLE_RADIUS + 1 then
			cost += 28
		end
	end
	for _, open in layout.Open do
		if open.S1 > fromS and open.S0 < toS and math.abs(x) > HALF_WIDTH - 6 then
			cost += 70
		end
	end
	return cost
end

function IceDash:UpdateBot(bot, _dt)
	local racer = self.Racers[bot.Participant]
	if not racer or racer.State ~= "Racing" then
		return
	end
	local memory = bot.Memory
	local clock = os.clock()

	if clock >= (memory.PlanAt or 0) then
		memory.PlanAt = clock + 0.2 + (1 - bot.Skill) * 0.45
		local lookAhead = 24 + bot.Skill * 30
		if math.random() < (1 - bot.Skill) * 0.07 then
			-- Brain fart: commit to a random line for a moment.
			memory.TargetX = (math.random() - 0.5) * (Sim.TRACK_WIDTH - 6)
			memory.PlanAt = clock + 0.7
		else
			local best, bestCost = racer.X, math.huge
			for x = -HALF_WIDTH + 3, HALF_WIDTH - 3, 3 do
				local cost = self:_lineCost(racer, x, racer.S + 1, racer.S + lookAhead)
					+ math.abs(x - racer.X) * 0.7 -- don't cross the whole track for nothing
					+ math.abs(x) * 0.2 -- the middle leaves the most options
					+ math.random() * (1 - bot.Skill) * 25 -- sloppy judgement
				if cost < bestCost then
					best, bestCost = x, cost
				end
			end
			memory.TargetX = best
		end
	end

	-- Steer for the line, allowing for how far the current drift will carry me.
	local anticipation = 0.15 + bot.Skill * 0.45
	local miss = (memory.TargetX or racer.X) - (racer.X + racer.VX * anticipation)
	local wantLeft, wantRight = miss < -1.3, miss > 1.3
	if wantLeft ~= memory.Left then
		memory.Left = wantLeft
		bot:Input(if wantLeft then "Left" else "LeftStop")
	end
	if wantRight ~= memory.Right then
		memory.Right = wantRight
		bot:Input(if wantRight then "Right" else "RightStop")
	end
end

function IceDash:GetResults()
	return ResultsUtil.fromScores(self.Participants, function(participant)
		local racer = self.Racers[participant]
		-- Finishers beat everyone still on the track; earlier finish = better.
		return if racer.FinishTime then 1e6 - racer.FinishTime else racer.S
	end)
end

function IceDash:Cleanup()
	for _, connection in self.Connections do
		connection:Disconnect()
	end
	for _, root in self.Anchored do
		if root.Parent then
			root.Anchored = false
		end
	end
	-- The track lives in arena.Folder, which the framework destroys.
end

return IceDash
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">KernelCatch</string>
            <string name="Source"><![CDATA[--[[
	Kernel Catch (FFA, score)
	Popcorn and rocks rain from the sky. Every drop shows a shadow on the floor about a
	second before it lands. Stand under popcorn to catch it in your head bucket (+1);
	a rock knocks kernels out of the bucket and stuns you for a moment.
	Most popcorn when the timer runs out wins.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.PartyShared.Config)
local ResultsUtil = require(script.Parent.Parent.ResultsUtil)

local KernelCatch = {}

-- Tuning ----------------------------------------------------------------------------------

local ROUND_DURATION = 30
-- Seconds between drops: { at GO, at the buzzer }. Smaller = more stuff falling.
local DROP_INTERVAL = { 0.45, 0.15 }
-- Chance that a drop is a rock instead of popcorn: { at GO, at the buzzer }.
local ROCK_RATIO = { 0.22, 0.38 }
local WARNING_TIME = 1.0 -- the shadow shows up this long before impact
local AIMED_POPCORN_CHANCE = 0.3 -- share of kernels aimed near a random player instead of anywhere
local AIMED_ROCK_CHANCE = 0.7 -- share of rocks aimed near a random player
local AIM_SPREAD = 6 -- studs of scatter around the player an aimed drop targets

local POPCORN_POINTS = 1
local ROCK_PENALTY = 4 -- kernels lost per rock hit (score never goes below 0)
local STUN_TIME = 1.2 -- seconds a rock hit roots you (you can't catch while stunned)
local STUN_IMMUNITY = 0.6 -- extra seconds after a stun before another rock can hit you

local CATCH_RADIUS = 3.2 -- how close (flat distance) your bucket must be to a landing kernel
local ROCK_RADIUS = 3.6 -- how close a landing rock must be to hit you
local ARENA_RADIUS = 26
-- Nothing lands in this strip along the edge nearest the camera, where a falling drop would
-- fill the screen and cross the HUD.
local NEAR_EDGE_MARGIN = 9
local DROP_HEIGHT = 30
local WALK_SPEED = 18

KernelCatch.Info = {
	Name = "Kernel Catch",
	Description = "It's raining popcorn 🍿! Stand on the shadows to catch kernels in your head bucket. Dodge the rocks or lose your snacks!",
	Duration = ROUND_DURATION,
	Layout = Config.Layouts.FFA,
	Camera = { Mode = "AngledOverhead", Height = 42, Distance = 32 },
	Controls = { Move = true, Jump = true, WalkSpeed = WALK_SPEED },
	ProgressLabel = "Popcorn",
}

local POPCORN_COLOR = Color3.fromRGB(255, 244, 190)
local ROCK_COLOR = Color3.fromRGB(110, 110, 120)

local function now()
	return Workspace:GetServerTimeNow()
end

local function lerp(range, alpha: number): number
	return range[1] + (range[2] - range[1]) * alpha
end

local function flat(vector: Vector3): Vector3
	return Vector3.new(vector.X, 0, vector.Z)
end

-- Setup ---------------------------------------------------------------------------------

-- A striped popcorn bucket welded on top of the head. It lives in `parent` (the arena folder),
-- not in the character, so Highlights on the character (the stun flash) don't tint it.
local function makeBucket(character: Model, parent: Instance): Model?
	local head = character:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return nil
	end
	local bucket = Instance.new("Model")
	bucket.Name = "KernelBucket"

	local function piece(name: string, size: Vector3, offset: CFrame, color: Color3, shape)
		local part = Instance.new("Part")
		part.Name = name
		part.Shape = shape
		part.Size = size
		part.Color = color
		part.Material = Enum.Material.SmoothPlastic
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Massless = true
		part.CFrame = head.CFrame * CFrame.new(0, head.Size.Y / 2, 0) * offset
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = head
		weld.Part1 = part
		weld.Parent = part
		part.Parent = bucket
		return part
	end

	-- Cylinders lie along X, so stand them upright.
	local upright = CFrame.Angles(0, 0, math.rad(90))
	piece("Tub", Vector3.new(1.6, 2.4, 2.4), CFrame.new(0, 0.8, 0) * upright, Color3.fromRGB(230, 60, 60), Enum.PartType.Cylinder)
	piece("Stripe", Vector3.new(0.5, 2.5, 2.5), CFrame.new(0, 0.8, 0) * upright, Color3.fromRGB(255, 255, 255), Enum.PartType.Cylinder)
	piece("Rim", Vector3.new(0.25, 2.8, 2.8), CFrame.new(0, 1.6, 0) * upright, Color3.fromRGB(255, 255, 255), Enum.PartType.Cylinder)
	local kernels = piece("Kernels", Vector3.new(2.2, 2.2, 2.2), CFrame.new(0, 1.5, 0), POPCORN_COLOR, Enum.PartType.Ball)
	kernels.Transparency = 1 -- shown once there is popcorn in the bucket

	bucket.Parent = parent
	return bucket
end

function KernelCatch:Setup(arena, participants, _round)
	local origin = arena.Origin
	self.Connections = {}
	self.Score = {}
	self.StunnedUntil = {}
	self.Buckets = {}
	self.Highlights = {}
	self.Drops = {}

	-- Round floor (cylinder parts lie along X, so rotate it flat).
	local floor = Instance.new("Part")
	floor.Name = "Floor"
	floor.Shape = Enum.PartType.Cylinder
	floor.Size = Vector3.new(2, ARENA_RADIUS * 2, ARENA_RADIUS * 2)
	floor.CFrame = origin * CFrame.Angles(0, 0, math.rad(90))
	floor.Anchored = true
	floor.Material = Enum.Material.SmoothPlastic
	floor.Color = Color3.fromRGB(120, 60, 160)
	floor.Parent = arena.Folder

	-- Ring of see-through walls so nobody runs off the edge.
	local segments = 24
	for i = 1, segments do
		local angle = (i / segments) * math.pi * 2
		local wall = Instance.new("Part")
		wall.Name = "Wall"
		wall.Anchored = true
		wall.Size = Vector3.new(2, 8, ARENA_RADIUS * 2 * math.pi / segments + 1)
		wall.CFrame = origin * CFrame.Angles(0, -angle, 0) * CFrame.new(ARENA_RADIUS, 5, 0)
		wall.Transparency = 0.6
		wall.Color = Color3.fromRGB(255, 220, 90)
		wall.Material = Enum.Material.ForceField
		wall.Parent = arena.Folder
	end

	local spawns = {}
	for index, participant in participants do
		self.Score[participant] = 0
		self.StunnedUntil[participant] = 0
		local angle = (index / #participants) * math.pi * 2
		local position = (origin * CFrame.new(math.cos(angle) * 12, 4, math.sin(angle) * 12)).Position
		spawns[index] = CFrame.lookAt(position, Vector3.new(origin.X, position.Y, origin.Z))

		local character = participant:GetCharacter()
		if character then
			self.Buckets[participant] = makeBucket(character, arena.Folder)
		end
	end
	return spawns
end

-- Scoring -------------------------------------------------------------------------------

function KernelCatch:_setScore(participant, score: number)
	self.Score[participant] = score
	self.Round:ReportProgress(participant, ("🍿 %d"):format(score))
	local bucket = self.Buckets[participant]
	local kernels = bucket and bucket:FindFirstChild("Kernels")
	if kernels then
		kernels.Transparency = if score > 0 then 0 else 1
	end
end

function KernelCatch:_isStunned(participant): boolean
	return now() < self.StunnedUntil[participant]
end

function KernelCatch:_hitByRock(participant, position: Vector3)
	local stunEnds = now() + STUN_TIME
	self.StunnedUntil[participant] = stunEnds + STUN_IMMUNITY
	self:_setScore(participant, math.max(0, self.Score[participant] - ROCK_PENALTY))
	participant:SetMovement(0, false)
	self.Round:Toast(("💥 %s got bonked!"):format(participant.Name))

	-- Hit effect: a puff at the impact point and a red flash on the victim while stunned.
	local burst = Instance.new("Explosion")
	burst.Position = position
	burst.BlastPressure = 0
	burst.DestroyJointRadiusPercent = 0
	burst.Parent = self.Arena.Folder

	local character = participant:GetCharacter()
	local highlight
	if character then
		highlight = Instance.new("Highlight")
		highlight.FillColor = Color3.fromRGB(255, 40, 40)
		highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		highlight.FillTransparency = 0.35
		highlight.Parent = character
		self.Highlights[highlight] = true
	end

	task.delay(STUN_TIME, function()
		if highlight then
			self.Highlights[highlight] = nil
			highlight:Destroy()
		end
		if not self.Cleaned and not self.Round.Ended then
			participant:SetMovement(WALK_SPEED, true)
		end
	end)
end

-- Drops ---------------------------------------------------------------------------------

function KernelCatch:_spawnDrop(progress: number)
	local round = self.Round
	local origin = self.Arena.Origin

	local isRock = round.Rng:NextNumber() < lerp(ROCK_RATIO, progress)

	-- Where it lands (arena-local X/Z): near a random player, or anywhere on the floor.
	local offset
	local alive = round:GetAlive()
	local aimedChance = if isRock then AIMED_ROCK_CHANCE else AIMED_POPCORN_CHANCE
	if #alive > 0 and round.Rng:NextNumber() < aimedChance then
		local target = alive[round.Rng:NextInteger(1, #alive)]
		local position = target:GetPosition()
		if position then
			local angle = round.Rng:NextNumber() * math.pi * 2
			offset = flat(origin:PointToObjectSpace(position))
				+ Vector3.new(math.cos(angle), 0, math.sin(angle)) * round.Rng:NextNumber() * AIM_SPREAD
		end
	end
	if not offset then
		local angle = round.Rng:NextNumber() * math.pi * 2
		local radius = math.sqrt(round.Rng:NextNumber()) * (ARENA_RADIUS - 3)
		offset = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
	end
	if offset.Magnitude > ARENA_RADIUS - 3 then
		offset = offset.Unit * (ARENA_RADIUS - 3)
	end
	-- The overhead camera sits on the arena's +Z side: keep drops out of the strip closest to it.
	local nearLimit = ARENA_RADIUS - 3 - NEAR_EDGE_MARGIN
	if offset.Z > nearLimit then
		offset = Vector3.new(offset.X, 0, nearLimit)
	end
	local landing = origin:PointToWorldSpace(Vector3.new(offset.X, 1, offset.Z))

	local size = if isRock then 3.4 else 1.8

	local object = Instance.new("Part")
	object.Name = if isRock then "Rock" else "Popcorn"
	object.Shape = Enum.PartType.Ball
	object.Size = Vector3.new(size, size, size)
	object.Color = if isRock then ROCK_COLOR else POPCORN_COLOR
	object.Material = if isRock then Enum.Material.Slate else Enum.Material.SmoothPlastic
	object.Anchored = true
	object.CanCollide = false
	object.CanQuery = false
	object.CanTouch = false
	object.Position = landing + Vector3.new(0, DROP_HEIGHT, 0)
	object.Parent = self.Arena.Folder

	-- Shadow: a flat disc that grows as the drop gets closer. Rocks cast a darker, redder one.
	local shadow = Instance.new("Part")
	shadow.Name = "Shadow"
	shadow.Shape = Enum.PartType.Cylinder
	shadow.Anchored = true
	shadow.CanCollide = false
	shadow.CanQuery = false
	shadow.CanTouch = false
	shadow.Material = Enum.Material.Neon
	shadow.Color = if isRock then Color3.fromRGB(60, 0, 10) else Color3.fromRGB(255, 225, 90)
	shadow.Transparency = 0.6
	shadow.Size = Vector3.new(0.1, 1, 1)
	shadow.CFrame = CFrame.new(landing + Vector3.new(0, 0.06, 0)) * CFrame.Angles(0, 0, math.rad(90))
	shadow.Parent = self.Arena.Folder

	table.insert(self.Drops, {
		IsRock = isRock,
		Position = landing,
		LandsAt = now() + WARNING_TIME,
		Object = object,
		Shadow = shadow,
		ShadowSize = if isRock then ROCK_RADIUS * 2 else CATCH_RADIUS * 2,
	})
end

function KernelCatch:_land(drop)
	drop.Shadow:Destroy()
	local caught = false

	if drop.IsRock then
		for _, participant in self.Round:GetAlive() do
			local position = participant:GetPosition()
			if
				position
				and now() >= self.StunnedUntil[participant]
				and flat(position - drop.Position).Magnitude <= ROCK_RADIUS
			then
				self:_hitByRock(participant, drop.Position)
			end
		end
	else
		-- The closest bucket in reach gets the kernel.
		local best, bestDistance = nil, CATCH_RADIUS
		for _, participant in self.Round:GetAlive() do
			local position = participant:GetPosition()
			if position and not self:_isStunned(participant) then
				local distance = flat(position - drop.Position).Magnitude
				if distance <= bestDistance then
					best, bestDistance = participant, distance
				end
			end
		end
		if best then
			caught = true
			self:_setScore(best, self.Score[best] + POPCORN_POINTS)
		end
	end

	if caught then
		drop.Object:Destroy()
	else
		-- Missed kernels and rocks sit on the floor for a moment, then vanish.
		local object = drop.Object
		object.Position = drop.Position + Vector3.new(0, object.Size.Y / 2, 0)
		object.Transparency = 0.4
		task.delay(0.5, function()
			object:Destroy()
		end)
	end
end

-- Interface -----------------------------------------------------------------------------

function KernelCatch:Start()
	local round = self.Round
	local startedAt = now()
	local nextDropAt = startedAt + 0.5
	for _, participant in self.Participants do
		self:_setScore(participant, 0)
	end
	round:SetStatus("Catch the popcorn! 🍿")

	table.insert(
		self.Connections,
		RunService.Heartbeat:Connect(function()
			if round.Ended then
				return
			end
			local clock = now()
			local progress = math.clamp((clock - startedAt) / ROUND_DURATION, 0, 1)

			while clock >= nextDropAt do
				nextDropAt += lerp(DROP_INTERVAL, progress)
				self:_spawnDrop(progress)
			end

			for index = #self.Drops, 1, -1 do
				local drop = self.Drops[index]
				local remaining = drop.LandsAt - clock
				if remaining <= 0 then
					table.remove(self.Drops, index)
					self:_land(drop)
				else
					local alpha = 1 - remaining / WARNING_TIME -- 0 = just spawned, 1 = impact
					local height = DROP_HEIGHT * (1 - alpha * alpha) -- speeds up as it falls
					drop.Object.Position = drop.Position + Vector3.new(0, height + drop.Object.Size.Y / 2, 0)
					local diameter = drop.ShadowSize * (0.35 + 0.65 * alpha)
					drop.Shadow.Size = Vector3.new(0.1, diameter, diameter)
					drop.Shadow.Transparency = 0.6 - 0.35 * alpha
				end
			end
		end)
	)
end

--[[
	Bot behaviour: step out from under any rock that is about to land, otherwise run to the
	best popcorn shadow it can still reach. Sloppier bots notice rocks later, re-think less
	often and sometimes run for kernels that have a rock coming down beside them.
]]
function KernelCatch:UpdateBot(bot, _dt)
	local me = bot.Participant
	local myPosition = bot:GetPosition()
	if not myPosition or self:_isStunned(me) then
		return
	end
	local memory = bot.Memory
	local clock = now()
	local center = self.Arena.Origin.Position

	local function inside(goal: Vector3): Vector3
		local fromCenter = flat(goal - center)
		if fromCenter.Magnitude > ARENA_RADIUS - 4 then
			fromCenter = fromCenter.Unit * (ARENA_RADIUS - 4)
		end
		return Vector3.new(center.X + fromCenter.X, myPosition.Y, center.Z + fromCenter.Z)
	end

	-- Dodge: a rock landing on top of me soon wins over everything else.
	local noticeTime = 0.2 + bot.Skill * 0.5
	local dodge = Vector3.zero
	for _, drop in self.Drops do
		if drop.IsRock and drop.LandsAt - clock < noticeTime then
			local away = flat(myPosition - drop.Position)
			if away.Magnitude < ROCK_RADIUS + 1.5 then
				if away.Magnitude < 0.1 then
					away = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5)
				end
				dodge += away.Unit
			end
		end
	end
	if dodge.Magnitude > 0.05 then
		memory.Goal = nil
		bot:MoveTo(inside(myPosition + dodge.Unit * 8))
		return
	end

	-- Keep the current plan for a beat instead of re-deciding every tick.
	if memory.Goal and clock < (memory.DecideAt or 0) and memory.Goal.LandsAt > clock then
		bot:MoveTo(inside(memory.Goal.Position))
		return
	end
	memory.DecideAt = clock + 0.15 + (1 - bot.Skill) * 0.35 + math.random() * 0.15

	local carefulness = 0.35 + bot.Skill * 0.65
	local best, bestCost = nil, math.huge
	for _, drop in self.Drops do
		if not drop.IsRock then
			local distance = flat(drop.Position - myPosition).Magnitude
			local timeLeft = drop.LandsAt - clock
			local reachable = distance - CATCH_RADIUS * 0.6 <= WALK_SPEED * timeLeft
			-- Skip kernels with a rock coming down right beside them (if this bot is paying attention).
			local risky = false
			for _, other in self.Drops do
				if
					other.IsRock
					and math.abs(other.LandsAt - drop.LandsAt) < 0.7
					and flat(other.Position - drop.Position).Magnitude < ROCK_RADIUS + 1
				then
					risky = true
					break
				end
			end
			-- Leave kernels that someone else is clearly going to reach first, so the pack spreads out.
			local cost = distance
			for _, other in self.Round:GetAlive() do
				local position = other ~= me and other:GetPosition()
				local claimed = other.IsBot and other.Bot.Memory.Goal == drop
				if position and (claimed or flat(drop.Position - position).Magnitude < distance - 1) then
					cost += 25
				end
			end
			if reachable and not (risky and math.random() < carefulness) and cost < bestCost then
				best, bestCost = drop, cost
			end
		end
	end

	-- Only fight over a contested kernel when it is right next to me.
	if best and bestCost >= 25 and bestCost - 25 > CATCH_RADIUS * 2 then
		best = nil
	end
	memory.Goal = best
	if best then
		bot:MoveTo(inside(best.Position))
	elseif not memory.Wander or clock >= (memory.WanderUntil or 0) then
		-- Nothing worth chasing: patrol my own side of the ring so the bots cover the floor.
		memory.HomeAngle = memory.HomeAngle or math.random() * math.pi * 2
		local angle = memory.HomeAngle + (math.random() - 0.5) * 1.6
		local radius = ARENA_RADIUS * (0.25 + math.random() * 0.4)
		memory.Wander = center + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
		memory.WanderUntil = clock + 1 + math.random()
		bot:MoveTo(inside(memory.Wander))
	end
end

function KernelCatch:GetResults()
	return ResultsUtil.fromScores(self.Participants, function(participant)
		return self.Score[participant]
	end)
end

function KernelCatch:Cleanup()
	self.Cleaned = true
	for _, connection in self.Connections do
		connection:Disconnect()
	end
	for _, bucket in self.Buckets do
		bucket:Destroy()
	end
	for highlight in self.Highlights do
		highlight:Destroy()
	end
	-- Drops, shadows and the map live in arena.Folder, which the framework destroys.
end

return KernelCatch
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">MashDash</string>
            <string name="Source"><![CDATA[--[[
	Mash Dash (2v2, side view)
	Everyone is locked in their lane (no walking, no jumping). Every Mash press scoots you
	forward. First runner across the line wins it for their team; if time runs out, the
	team that covered the most total distance wins.

	Exercises: SideView camera, movement locking, an action button (keyboard + mobile),
	ReportProgress chips, and the 2v2 team layout.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.PartyShared.Config)
local ResultsUtil = require(script.Parent.Parent.ResultsUtil)

local MashDash = {}

MashDash.Info = {
	Name = "Mash Dash",
	Description = "Mash to run! First one over the finish line wins it for their team. Your thumbs will hate you 👍💥",
	Duration = 30,
	Layout = Config.Layouts.TwoVsTwo,
	Camera = { Mode = "SideView", Distance = 55, Height = 10 },
	Controls = {
		Move = false, -- lane-locked: the server moves you
		Jump = false,
		Actions = {
			{ Action = "Mash", Label = "MASH!", Key = "Space", Gamepad = "ButtonA" },
		},
	},
	ProgressLabel = "Progress",
}

local TRACK_LENGTH = 80
local STEP = 1.2 -- studs per press
local PRESS_COOLDOWN = 0.08 -- caps mashing at ~12 presses/s, so autoclickers don't win outright
local LANE_SPACING = 5
local TEAM_COLORS = { Color3.fromRGB(255, 90, 90), Color3.fromRGB(90, 160, 255) }

function MashDash:Setup(arena, participants, _round)
	self.Distance = {}
	self.LastPress = {}
	self.Lanes = {}
	self.Finished = nil

	-- Lanes sorted by team so teammates run next to each other.
	local ordered = table.clone(participants)
	table.sort(ordered, function(a, b)
		return (a.Team or 0) < (b.Team or 0)
	end)

	local startX = -TRACK_LENGTH / 2
	for laneIndex, participant in ordered do
		local z = (laneIndex - (#ordered + 1) / 2) * LANE_SPACING
		local lane = Instance.new("Part")
		lane.Name = "Lane_" .. participant.Name
		lane.Anchored = true
		lane.Size = Vector3.new(TRACK_LENGTH + 10, 1, LANE_SPACING - 0.5)
		lane.CFrame = arena.Origin * CFrame.new(0, 0, z)
		lane.Color = TEAM_COLORS[participant.Team or 1]
		lane.Material = Enum.Material.SmoothPlastic
		lane.Parent = arena.Folder

		self.Lanes[participant] = arena.Origin * CFrame.new(startX, 4, z)
		self.Distance[participant] = 0
		self.LastPress[participant] = 0
	end

	local finish = Instance.new("Part")
	finish.Name = "FinishLine"
	finish.Anchored = true
	finish.CanCollide = false
	finish.Size = Vector3.new(1, 0.2, LANE_SPACING * #ordered)
	finish.CFrame = arena.Origin * CFrame.new(TRACK_LENGTH / 2, 0.6, 0)
	finish.Material = Enum.Material.Neon
	finish.Color = Color3.fromRGB(255, 255, 255)
	finish.Parent = arena.Folder

	local spawns = {}
	for index, participant in participants do
		spawns[index] = self:_laneCFrame(participant)
	end
	return spawns
end

-- Where a participant should stand right now, facing down the track (+X).
function MashDash:_laneCFrame(participant): CFrame
	local base = self.Lanes[participant] * CFrame.new(self.Distance[participant], 0, 0)
	return CFrame.lookAt(base.Position, base.Position + self.Arena.Origin.RightVector)
end

function MashDash:Start()
	for _, participant in self.Participants do
		self.Round:ReportProgress(participant, "0%")
	end
	self.Round:SetStatus("MASH! 🏃💨")
end

function MashDash:OnInput(participant, action)
	if action ~= "Mash" or self.Finished then
		return
	end
	local clock = os.clock()
	if clock - self.LastPress[participant] < PRESS_COOLDOWN then
		return
	end
	self.LastPress[participant] = clock

	local distance = math.min(TRACK_LENGTH, self.Distance[participant] + STEP)
	self.Distance[participant] = distance
	participant:Teleport(self:_laneCFrame(participant))
	self.Round:ReportProgress(participant, ("%d%%"):format(distance / TRACK_LENGTH * 100))

	if distance >= TRACK_LENGTH then
		self.Finished = participant
		self.Round:Toast(("🏁 %s crossed the line for team %d!"):format(participant.Name, participant.Team or 1))
		self.Round:End("Finish")
	end
end

function MashDash:UpdateBot(bot, _dt)
	-- Bots mash 3-5 times a second depending on skill.
	if math.random() < 0.55 + bot.Skill * 0.4 then
		bot:Input("Mash")
	end
end

function MashDash:_teamTotals()
	local totals = {}
	for _, participant in self.Participants do
		local team = participant.Team or 1
		totals[team] = (totals[team] or 0) + self.Distance[participant]
	end
	return totals
end

function MashDash:GetResults()
	local totals = self:_teamTotals()
	return ResultsUtil.fromScores(self.Participants, function(participant)
		local team = participant.Team or 1
		-- Crossing the line beats any distance total.
		local bonus = if self.Finished and self.Finished.Team == participant.Team then 1e6 else 0
		return totals[team] + bonus
	end)
end

function MashDash:Cleanup()
	-- Everything lives in arena.Folder; nothing else to undo.
end

return MashDash
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">_Template</string>
            <string name="Source"><![CDATA[--[[
	_Template — copy this file to start a new minigame.
	Files whose names start with "_" are ignored by the MinigameManager, so rename the copy
	(e.g. "CoinRush") and it will show up in the vote automatically.

	Lifecycle (all called by the MinigameManager on a fresh instance each round, so keep
	per-round state on `self`):

	  Setup(arena, participants, round) -> { CFrame }   REQUIRED
	      Build your map inside arena.Folder (around arena.Origin). Return one spawn CFrame
	      per participant, same order as `participants`. Players are teleported there and
	      frozen while the instructions card + 3-2-1 countdown play.
	  Start()                                           REQUIRED
	      GO! Connect your loops here. Movement is already unfrozen.
	  GetResults() -> results                           REQUIRED
	      Ranked array { { Participant = p, Placement = 1 }, ... }. Use ResultsUtil
	      (fromElimination(self.Participants, self.Round) / fromScores / fromTeams) - ties share a placement.
	  Cleanup()                                         REQUIRED
	      Disconnect everything and remove anything you put outside arena.Folder
	      (e.g. Highlights on characters). arena.Folder itself is destroyed for you.

	  OnInput(participant, action)          optional - a player or bot pressed one of Info.Controls
	  UpdateBot(bot, dt)                    optional - bot brain, runs every Config.BotThinkInterval
	  OnParticipantLost(participant, why)   optional - why = "Died" | "Left" (already eliminated)
	  OnRoundEnding(reason)                 optional - reason = "TimeUp" or whatever you passed to round:End()

	Available on self: self.Round (RoundContext), self.Arena, self.Participants, self.Info.
	Handy RoundContext calls: Eliminate(p) (they get a spectator camera), ReportProgress(p, value,
	label?) (player chips), SetStatus(text), Toast(text), End(reason), GetAlive(), GetTeam(n).
	Each participant has a .Team (1 or 2) in 1v3 / 2v2 layouts; team 1 is the solo side in 1v3.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.PartyShared.Config)
local ResultsUtil = require(script.Parent.Parent.ResultsUtil)

local Template = {}

Template.Info = {
	Name = "My Minigame",
	Description = "One or two sentences shown on the vote card and instructions screen.",
	Duration = 60, -- seconds; the round ends automatically when this runs out
	Layout = Config.Layouts.FFA, -- FFA | OneVsThree ("1v3") | TwoVsTwo ("2v2")

	-- Each player's camera. Modes: "AngledOverhead", "FollowBehind", "SideView".
	-- Any number from Config.CameraModes[Mode] (Height, Distance, ...) can be overridden here.
	Camera = { Mode = "AngledOverhead" },

	-- Movement locking + action buttons. Actions get a keyboard key, a gamepad button and
	-- an on-screen button on phones/tablets automatically, and arrive in OnInput.
	Controls = {
		Move = true, -- false = can't walk (enforced on the server)
		Jump = true,
		WalkSpeed = 16,
		Actions = {
			{ Action = "Smack", Label = "Smack!", Key = "E", Gamepad = "ButtonX" },
		},
	},

	-- Caption under each player chip; values come from self.Round:ReportProgress(p, value).
	ProgressLabel = "Score",
}

function Template:Setup(arena, participants, _round)
	self.Connections = {}
	self.Score = {}

	local floor = Instance.new("Part")
	floor.Anchored = true
	floor.Size = Vector3.new(60, 2, 60)
	floor.CFrame = arena.Origin
	floor.Parent = arena.Folder

	local spawns = {}
	for index, participant in participants do
		self.Score[participant] = 0
		spawns[index] = arena.Origin * CFrame.new((index - 2.5) * 8, 4, 0)
	end
	return spawns
end

function Template:Start()
	table.insert(
		self.Connections,
		RunService.Heartbeat:Connect(function()
			-- game logic; call self.Round:End() to finish early
		end)
	)
end

function Template:OnInput(participant, action)
	if action == "Smack" then
		self.Score[participant] += 1
		self.Round:ReportProgress(participant, self.Score[participant])
	end
end

function Template:UpdateBot(bot, _dt)
	bot:MoveTo(self.Arena.Origin.Position)
	if math.random() < 0.2 then
		bot:Input("Smack")
	end
end

function Template:GetResults()
	return ResultsUtil.fromScores(self.Participants, function(participant)
		return self.Score[participant]
	end)
end

function Template:Cleanup()
	for _, connection in self.Connections do
		connection:Disconnect()
	end
end

return Template
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Participant</string>
          <string name="Source"><![CDATA[--[[
	Participant
	One seat in a round. Wraps either a real Player or a Bot behind the same API,
	so minigames never need to care which one they are dealing with.

	Fields:
	  Id      unique string ("player_123" / "bot_1"), also what the client sees
	  Name    display name
	  IsBot   true for bots
	  Player  the Player (real players only)
	  Bot     the Bot object from BotService (bots only)
	  Team    team number for 1v3 / 2v2 layouts, nil in FFA
	  Left    true once a real player leaves mid-round
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.PartyShared.Config)

local Participant = {}
Participant.__index = Participant

function Participant.fromPlayer(player: Player)
	return setmetatable({
		Id = "player_" .. player.UserId,
		Name = player.DisplayName,
		IsBot = false,
		Player = player,
		Bot = nil,
		Team = nil,
		Left = false,
	}, Participant)
end

function Participant.fromBot(bot)
	local self = setmetatable({
		Id = bot.Id,
		Name = bot.Name,
		IsBot = true,
		Player = nil,
		Bot = bot,
		Team = nil,
		Left = false,
	}, Participant)
	bot.Participant = self
	return self
end

function Participant:GetCharacter(): Model?
	if self.IsBot then
		return self.Bot.Model
	end
	return self.Player.Character
end

function Participant:GetHumanoid(): Humanoid?
	local character = self:GetCharacter()
	return character and character:FindFirstChildOfClass("Humanoid")
end

function Participant:GetRoot(): BasePart?
	local character = self:GetCharacter()
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function Participant:GetPosition(): Vector3?
	local root = self:GetRoot()
	return root and root.Position
end

-- True if the participant is still in the game and has a living body in the world.
function Participant:IsAlive(): boolean
	if self.Left then
		return false
	end
	local character = self:GetCharacter()
	local humanoid = self:GetHumanoid()
	return character ~= nil
		and character.Parent ~= nil
		and humanoid ~= nil
		and humanoid.Health > 0
		and self:GetRoot() ~= nil
end

-- Moves the whole character, killing any leftover momentum.
function Participant:Teleport(cframe: CFrame)
	local character = self:GetCharacter()
	local root = self:GetRoot()
	if not character or not root then
		return
	end
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	character:PivotTo(cframe)
	if self.IsBot then
		self.Bot:Stop()
	end
end

function Participant:SetMovement(walkSpeed: number, canJump: boolean)
	local humanoid = self:GetHumanoid()
	if not humanoid then
		return
	end
	humanoid.WalkSpeed = walkSpeed
	-- Set both so it works whichever of UseJumpPower the place uses.
	humanoid.JumpPower = if canJump then Config.DefaultJumpPower else 0
	humanoid.JumpHeight = if canJump then Config.DefaultJumpHeight else 0
end

function Participant:Freeze()
	self:SetMovement(0, false)
	if self.IsBot then
		self.Bot:Stop()
	end
end

function Participant:ResetMovement()
	self:SetMovement(Config.DefaultWalkSpeed, true)
end

-- Applies a minigame's normalized Info.Controls (see MinigameInfo). Done on the server so
-- movement locks hold even if a client ignores them.
function Participant:ApplyControls(controls)
	self:SetMovement(if controls.Move then controls.WalkSpeed else 0, controls.Jump)
end

-- Data the client needs to draw this participant (names, bot icon, team colour).
function Participant:Describe()
	return {
		Id = self.Id,
		Name = self.Name,
		IsBot = self.IsBot,
		Team = self.Team,
	}
end

return Participant
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">ResultsUtil</string>
          <string name="Source"><![CDATA[--[[
	ResultsUtil
	Helpers for the ranked results table every minigame returns from GetResults().

	A results table is an array sorted best-first:
	    { { Participant = p, Placement = 1 }, { Participant = q, Placement = 2 }, ... }
	Ties share a placement using standard competition ranking (1, 1, 3, 4).
]]

local ResultsUtil = {}

-- Ranks participants by a score. Higher is better unless lowerIsBetter is true.
function ResultsUtil.fromScores(participants, scoreOf: (any) -> number, lowerIsBetter: boolean?)
	local entries = {}
	for index, participant in participants do
		table.insert(entries, { Participant = participant, Score = scoreOf(participant), Index = index })
	end
	table.sort(entries, function(a, b)
		if a.Score == b.Score then
			return a.Index < b.Index -- keep the sort deterministic
		end
		if lowerIsBetter then
			return a.Score < b.Score
		end
		return a.Score > b.Score
	end)

	local results = {}
	for i, entry in entries do
		local placement = i
		if i > 1 and entries[i - 1].Score == entry.Score then
			placement = results[i - 1].Placement
		end
		results[i] = { Participant = entry.Participant, Placement = placement }
	end
	return results
end

-- Survivors tie for 1st; everyone else ranks by how long they lasted (last out = best).
-- Participants knocked out in the same instant (e.g. two falling on one tick) tie.
function ResultsUtil.fromElimination(participants, round)
	return ResultsUtil.fromScores(participants, function(participant)
		return round.EliminatedAt[participant] or math.huge
	end)
end

-- Every member of winningTeam ties for 1st, everyone else ties for the next placement.
function ResultsUtil.fromTeams(participants, winningTeam: number)
	return ResultsUtil.fromScores(participants, function(participant)
		return if participant.Team == winningTeam then 1 else 0
	end)
end

--[[
	Makes whatever a minigame returned safe to use:
	  * drops entries for unknown participants and duplicates
	  * appends anyone missing (and anyone who left mid-round) at the bottom
	  * recomputes placements so they are consistent competition ranks
]]
function ResultsUtil.normalize(rawResults, participants)
	local known = {}
	for _, participant in participants do
		known[participant] = true
	end

	local seen = {}
	local entries = {}
	if type(rawResults) == "table" then
		for _, entry in rawResults do
			local participant = type(entry) == "table" and entry.Participant
			local placement = type(entry) == "table" and tonumber(entry.Placement)
			if participant and known[participant] and not seen[participant] and not participant.Left then
				seen[participant] = true
				table.insert(entries, { Participant = participant, Placement = placement or math.huge })
			end
		end
	end

	-- Missing participants share last place; leavers go below them.
	for _, participant in participants do
		if not seen[participant] then
			table.insert(entries, {
				Participant = participant,
				Placement = if participant.Left then math.huge else 1e6,
			})
		end
	end

	for i, entry in entries do
		entry.Order = i
	end
	table.sort(entries, function(a, b)
		if a.Placement == b.Placement then
			return a.Order < b.Order
		end
		return a.Placement < b.Placement
	end)

	local results = {}
	for i, entry in entries do
		local placement = i
		if i > 1 and entries[i - 1].Placement == entry.Placement then
			placement = results[i - 1].Placement
		end
		results[i] = { Participant = entry.Participant, Placement = placement }
	end
	return results
end

return ResultsUtil
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">RoundContext</string>
          <string name="Source"><![CDATA[--[[
	RoundContext
	The toolbox the framework hands to a minigame for one round (third argument of Setup,
	and stored on the minigame instance as self.Round). Minigames use it instead of
	touching framework internals:

	  round.Participants        all four participants (real players + bots)
	  round.Arena               the arena object (Folder / Origin / SpectatorCFrame)
	  round.Rng                 a Random for this round
	  round.EliminationOrder    participants in the order they were eliminated
	  round.EliminatedAt        participant -> server time they were eliminated

	  round:Eliminate(p)        mark p out and send them to the spectator box
	  round:IsEliminated(p)
	  round:GetAlive()          participants still in play
	  round:GetTeam(n)          participants on team n (1v3 / 2v2)
	  round:End()               finish the round early (e.g. one player left)
	  round:TimeLeft()
	  round:Toast(text)         short feed message on every client
	  round:SetStatus(text)     persistent HUD line on every client
	  round:ReportProgress(p, value, label?)
	                            update p's player chip (score / progress / lives / any short text)
]]

local Workspace = game:GetService("Workspace")

local RoundContext = {}
RoundContext.__index = RoundContext

function RoundContext.new(params)
	return setmetatable({
		Participants = params.Participants,
		Arena = params.Arena,
		Rng = Random.new(),
		EliminationOrder = {},
		EliminatedAt = {},
		Ended = false,
		EndReason = nil,
		EndsAt = math.huge,
		_eliminated = {},
		_broadcast = params.Broadcast,
		_setStatus = params.SetStatus,
		_onProgress = params.OnProgress,
		_onEliminated = params.OnEliminated,
	}, RoundContext)
end

function RoundContext:Eliminate(participant, silent: boolean?)
	if self._eliminated[participant] then
		return
	end
	self._eliminated[participant] = true
	table.insert(self.EliminationOrder, participant)
	self.EliminatedAt[participant] = Workspace:GetServerTimeNow()

	if participant:IsAlive() then
		local jitter = Vector3.new(self.Rng:NextNumber(-6, 6), 0, self.Rng:NextNumber(-6, 6))
		participant:Teleport(self.Arena.SpectatorCFrame + jitter)
		participant:ResetMovement() -- spectators may walk around the glass box
	end
	if not silent then
		self:Toast(("❌ %s is out!"):format(participant.Name))
	end
	self._onEliminated(participant)
end

function RoundContext:IsEliminated(participant): boolean
	return self._eliminated[participant] == true
end

function RoundContext:GetAlive()
	local alive = {}
	for _, participant in self.Participants do
		if not self._eliminated[participant] and not participant.Left then
			table.insert(alive, participant)
		end
	end
	return alive
end

function RoundContext:GetTeam(team: number)
	local members = {}
	for _, participant in self.Participants do
		if participant.Team == team then
			table.insert(members, participant)
		end
	end
	return members
end

function RoundContext:End(reason: string?)
	if not self.Ended then
		self.Ended = true
		self.EndReason = reason or "Ended"
	end
end

function RoundContext:TimeLeft(): number
	return math.max(0, self.EndsAt - Workspace:GetServerTimeNow())
end

function RoundContext:Toast(text: string)
	self._broadcast({ Type = "Toast", Text = text })
end

function RoundContext:SetStatus(text: string?)
	self._setStatus(text)
end

-- value: number or short string ("3 ❤️", "45%"). label: optional caption, defaults to
-- Info.ProgressLabel. Cheap to call every frame; updates are batched.
function RoundContext:ReportProgress(participant, value: number | string, label: string?)
	if type(value) == "number" then
		value = math.floor(value * 10 + 0.5) / 10 -- keep chips tidy
	end
	self._onProgress(participant, value, label)
end

return RoundContext
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="23">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="24">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="25">
        <Properties>
          <string name="Name">PartyClient</string>
        </Properties>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">CameraController</string>
            <string name="Source"><![CDATA[--[[
	CameraController
	Per-player scripted camera for minigames. Every client runs its own, so each player
	gets their own view of the one shared world.

	  start(cameraConfig, arenaOrigin)   CameraType -> Scriptable, mode from Info.Camera
	  setSpectating(on)                  switch to the spectator orbit cam (eliminated / spectators)
	  setTargets(chips)                  who can be spectated (alive participants)
	  cycle(direction)                   next / previous spectate target
	  stop()                             restore the normal Roblox camera

	Modes (numbers come from Config.CameraModes, overridable per minigame):
	  AngledOverhead  fixed angle over the arena centre, drifting toward you by `Follow`
	  FollowBehind    chase cam behind your character
	  SideView        side-scroller; tracks you along the arena's RightVector
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("PartyShared"):WaitForChild("Config"))

local CameraController = {}

local player = Players.LocalPlayer
local active = false
local params = nil
local arenaOrigin = CFrame.new()
local spectating = false
local targets = {} -- { { Id, Name, Character } }
local targetId = nil
local focus: Vector3? = nil
local heading: Vector3? = nil
local orbit = 0

local function myRoot(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function currentTarget()
	for _, target in targets do
		if target.Id == targetId then
			return target
		end
	end
	return targets[1]
end

function CameraController.start(cameraConfig, origin: CFrame)
	params = table.clone(cameraConfig)
	local touch = UserInputService.TouchEnabled and Config.TouchCamera[params.Mode]
	if touch then
		params.Height *= touch.Zoom
		params.Distance *= touch.Zoom
		params.LookAhead = touch.LookAhead
	end
	arenaOrigin = origin
	active = true
	focus = nil
	heading = nil
	Workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
end

function CameraController.isActive(): boolean
	return active
end

function CameraController.setSpectating(on: boolean)
	if on and not spectating then
		focus = nil
	end
	spectating = on
end

function CameraController.isSpectating(): boolean
	return spectating
end

-- chips: the server's player-chip list; anyone not eliminated with a body can be watched.
function CameraController.setTargets(chips)
	targets = {}
	for _, chip in chips do
		if not chip.Eliminated and chip.Character and chip.Character.Parent then
			table.insert(targets, { Id = chip.Id, Name = chip.Name, Character = chip.Character })
		end
	end
	if not currentTarget() or currentTarget().Id ~= targetId then
		local first = targets[1]
		targetId = first and first.Id
	end
end

function CameraController.cycle(direction: number)
	if #targets == 0 then
		return
	end
	local index = 1
	for i, target in targets do
		if target.Id == targetId then
			index = i
		end
	end
	index = (index - 1 + direction) % #targets + 1
	targetId = targets[index].Id
	focus = nil
end

function CameraController.getTargetName(): string?
	local target = currentTarget()
	return target and target.Name
end

function CameraController.stop()
	if not active then
		return
	end
	active = false
	spectating = false
	local camera = Workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Custom
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

-- Per-frame camera placement ------------------------------------------------------------------

local function smoothTowards(goal: Vector3, rate: number, dt: number): Vector3
	if not focus then
		focus = goal
		return goal
	end
	local alpha = 1 - math.exp(-rate * dt)
	focus = (focus :: Vector3):Lerp(goal, alpha)
	return focus :: Vector3
end

local function spectatorCFrame(dt: number): CFrame
	local settings = Config.Spectator
	local target = currentTarget()
	local root = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
	local center = if root then root.Position else arenaOrigin.Position
	local point = smoothTowards(center, 5, dt)
	orbit += dt * settings.OrbitSpeed
	local offset = Vector3.new(math.sin(orbit) * settings.Distance, settings.Height, math.cos(orbit) * settings.Distance)
	return CFrame.lookAt(point + offset, point)
end

local function angledOverhead(dt: number): CFrame
	local center = arenaOrigin.Position
	local root = myRoot()
	local goal = if root then center:Lerp(root.Position, params.Follow) else center
	local point = smoothTowards(goal, params.Smooth, dt)
	local offset = arenaOrigin:VectorToWorldSpace(Vector3.new(0, params.Height, params.Distance))
	local aim = point + arenaOrigin:VectorToWorldSpace(Vector3.new(0, 0, -(params.LookAhead or 0)))
	return CFrame.lookAt(point + offset, aim)
end

local function followBehind(dt: number): CFrame
	local root = myRoot()
	if not root then
		return Workspace.CurrentCamera.CFrame
	end
	local point = smoothTowards(root.Position, params.Smooth, dt)
	-- Heading turns slower than the character so quick spins don't whip the camera.
	local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if look.Magnitude < 0.01 then
		look = Vector3.new(0, 0, -1)
	end
	heading = if heading then (heading :: Vector3):Lerp(look.Unit, 1 - math.exp(-3 * dt)) else look.Unit
	local back = (heading :: Vector3).Unit * -params.Distance + Vector3.new(0, params.Height, 0)
	return CFrame.lookAt(point + back, point + Vector3.new(0, 2, 0) + (heading :: Vector3).Unit * 6)
end

local function sideView(dt: number): CFrame
	local center = arenaOrigin.Position
	local right = arenaOrigin.RightVector
	local root = myRoot()
	local along = if root then (root.Position - center):Dot(right) else 0
	local point = smoothTowards(center + right * along, params.Smooth, dt)
	-- Stand on the side the arena faces away from, so the arena's +RightVector is screen-right.
	local eye = point - arenaOrigin.LookVector * params.Distance + Vector3.new(0, params.Height, 0)
	return CFrame.lookAt(eye, point + Vector3.new(0, 2, 0))
end

local MODES = {
	AngledOverhead = angledOverhead,
	FollowBehind = followBehind,
	SideView = sideView,
}

RunService.RenderStepped:Connect(function(dt)
	if not active then
		return
	end
	local camera = Workspace.CurrentCamera
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable -- respawns reset it
	end
	if spectating then
		camera.CFrame = spectatorCFrame(dt)
	else
		local mode = MODES[params.Mode] or angledOverhead
		camera.CFrame = mode(dt)
	end
end)

return CameraController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Controls</string>
            <string name="Source"><![CDATA[--[[
	Controls
	Applies a minigame's Info.Controls on this client:
	  * Actions -> keyboard key + gamepad button (ContextActionService) AND a big on-screen
	    button (ActionBar), so keyboard, controller and touch all work out of the box
	  * Move / Jump = false -> the default Roblox movement controls (thumbstick, WASD,
	    jump button) are switched off. The server enforces the same lock independently.

	Pressing anything only *sends an input*; the server decides what happens.
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")

local Controls = {}

local DEFAULT_GAMEPAD = { "ButtonX", "ButtonY", "ButtonB" }
local bound: { string } = {}
local actionBar = nil
local movementDisabled = false

-- Roblox's PlayerModule owns WASD / thumbstick / jump. It may not exist (e.g. custom setups).
local function getPlayerControls()
	local playerScripts = Players.LocalPlayer:FindFirstChild("PlayerScripts")
	local module = playerScripts and playerScripts:FindFirstChild("PlayerModule")
	if not module then
		return nil
	end
	local ok, playerModule = pcall(require, module)
	return ok and playerModule and playerModule:GetControls() or nil
end

local function keyCode(name: string?): EnumItem?
	if type(name) ~= "string" then
		return nil
	end
	local ok, item = pcall(function()
		return (Enum.KeyCode :: any)[name]
	end)
	return if ok then item else nil
end

-- The on-screen buttons live in UI/ActionBar; Main hands it over once at startup.
function Controls.setActionBar(bar)
	actionBar = bar
end

function Controls.bind(controls, send: (string) -> ())
	Controls.unbind()

	for index, action in controls.Actions do
		local bindName = "Party_" .. action.Action
		local inputs = {}
		for _, name in action.Keys or { action.Key } do
			local key = keyCode(name)
			if key then
				table.insert(inputs, key)
			end
		end
		local pad = keyCode(action.Gamepad or DEFAULT_GAMEPAD[index])
		if pad then
			table.insert(inputs, pad)
		end
		ContextActionService:BindActionAtPriority(bindName, function(_, inputState)
			if inputState == Enum.UserInputState.Begin then
				send(action.Action)
			elseif inputState == Enum.UserInputState.End and action.Hold then
				send(action.Action .. "Stop")
			end
			return Enum.ContextActionResult.Sink
		end, false, Enum.ContextActionPriority.High.Value, table.unpack(inputs))
		table.insert(bound, bindName)
	end

	if actionBar then
		actionBar:show(controls.Actions, send, not controls.Move)
	end

	if not controls.Move or not controls.Jump then
		local playerControls = getPlayerControls()
		if playerControls and not controls.Move then
			playerControls:Disable()
			movementDisabled = true
		end
	end
end

function Controls.unbind()
	for _, bindName in bound do
		ContextActionService:UnbindAction(bindName)
	end
	table.clear(bound)
	if actionBar then
		actionBar:hide()
	end
	if movementDisabled then
		movementDisabled = false
		local playerControls = getPlayerControls()
		if playerControls then
			playerControls:Enable()
		end
	end
end

return Controls
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="28">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	Main (client entry point)
	Renders whatever state the server sends and forwards inputs. No game logic lives here:
	the client never decides who won, who has the potato, or when a round ends.
	It does own purely local presentation: this player's camera, UI and control bindings.
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = require(ReplicatedStorage:WaitForChild("PartyShared"):WaitForChild("Net"))
local CameraController = require(script.Parent:WaitForChild("CameraController"))
local Controls = require(script.Parent:WaitForChild("Controls"))
local UI = script.Parent:WaitForChild("UI")
local Theme = require(UI:WaitForChild("Theme"))
local ActionBar = require(UI:WaitForChild("ActionBar"))
local Hud = require(UI:WaitForChild("Hud"))
local InstructionsCard = require(UI:WaitForChild("InstructionsCard"))
local PlayerChips = require(UI:WaitForChild("PlayerChips"))
local ProgressBar = require(UI:WaitForChild("ProgressBar"))
local ResultsScreen = require(UI:WaitForChild("ResultsScreen"))
local SpectatorBar = require(UI:WaitForChild("SpectatorBar"))
local VoteScreen = require(UI:WaitForChild("VoteScreen"))

local player = Players.LocalPlayer
local myId = "player_" .. player.UserId
local stateRemote = Net.stateRemote()
local inputRemote = Net.inputRemote()

local function sendInput(payload)
	inputRemote:FireServer(payload)
end

-- Some minigames run their own client code for the round (Info.ClientModule), e.g. Ice Dash
-- simulates your racer locally. Those modules live in the Minigames folder next to this script.
local minigameClients = script.Parent:FindFirstChild("Minigames")
local activeMinigameClient = nil

local function stopMinigameClient()
	if activeMinigameClient then
		local client = activeMinigameClient
		activeMinigameClient = nil
		client.stop()
	end
end

local function startMinigameClient(name: string?)
	stopMinigameClient()
	local module = name and minigameClients and minigameClients:FindFirstChild(name)
	if module and module:IsA("ModuleScript") then
		local ok, client = pcall(require, module)
		if ok and type(client) == "table" then
			activeMinigameClient = client
			client.start()
		else
			warn("[PartyClient] Could not load minigame client " .. tostring(name) .. ": " .. tostring(client))
		end
	end
end

local function sendAction(action: string)
	-- The minigame's client code gets first go; if it handles the action, the server needn't hear.
	if activeMinigameClient and activeMinigameClient.onAction and activeMinigameClient.onAction(action) then
		return
	end
	sendInput({ Kind = Net.Input.Action, Action = action })
end

-- Screens ---------------------------------------------------------------------------------

local screen = Theme.make("ScreenGui", {
	Name = "PartyUI",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	DisplayOrder = 10, -- draw the vote / results cards over the mobile thumbstick and jump button
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

local hud = Hud.new(screen)
local voteScreen = VoteScreen.new(screen, function(choice)
	sendInput({ Kind = Net.Input.Vote, Choice = choice })
end)
local instructions = InstructionsCard.new(screen)
local results = ResultsScreen.new(screen)
local chips = PlayerChips.new(screen)
local progressBar = ProgressBar.new(screen)
local spectatorBar
spectatorBar = SpectatorBar.new(screen, function(direction)
	CameraController.cycle(direction)
	spectatorBar:show(CameraController.getTargetName())
end)
Controls.setActionBar(ActionBar.new(screen))

-- The top/bottom HUD strips are sized in pixels for a desktop window. On a phone they would
-- cover almost half the screen, so shrink them (and their pixel offsets) with the viewport.
local HUD_STRIPS = { "Timer", "Status", "PlayerChips", "ProgressBar", "SpectatorBar", "Lobby" }
local HUD_DESIGN_HEIGHT = 720
local hudBasePositions = {}

local function fitHudToScreen()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local scale = math.clamp(camera.ViewportSize.Y / HUD_DESIGN_HEIGHT, 0.55, 1)
	for _, name in HUD_STRIPS do
		local strip = screen:FindFirstChild(name)
		if strip and strip:IsA("GuiObject") then
			local base = hudBasePositions[name] or strip.Position
			hudBasePositions[name] = base
			local uiScale = strip:FindFirstChildOfClass("UIScale") or Theme.make("UIScale", { Parent = strip })
			uiScale.Scale = scale
			strip.Position = UDim2.new(base.X.Scale, base.X.Offset * scale, base.Y.Scale, base.Y.Offset * scale)
		end
	end
end

fitHudToScreen()
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fitHudToScreen)

-- While a full-screen card (vote, instructions, results) is up, the mobile thumbstick and
-- jump button are switched off entirely, so they can never sit on top of the card.
local function setCardOpen(open: boolean)
	pcall(function()
		GuiService.TouchControlsEnabled = not open
	end)
end

local function hideOverlays()
	voteScreen:hide()
	instructions:hide()
	results:hide()
	setCardOpen(false)
end

local function isParticipant(participants): boolean
	for _, participant in participants or {} do
		if participant.Id == myId then
			return true
		end
	end
	return false
end

-- Round presentation state -----------------------------------------------------------------

local inRound = false -- true from Instructions until Results/Lobby
local amParticipant = false
local useProgressBar = false -- this minigame shows a race bar instead of the chip strip

local function showRoundHud()
	if useProgressBar then
		progressBar:show()
	else
		chips:show()
	end
end

local function beginRound(message)
	if inRound then
		return
	end
	inRound = true
	amParticipant = isParticipant(message.Participants)
	useProgressBar = message.Minigame.ProgressBar == true
	startMinigameClient(message.Minigame.ClientModule)
	CameraController.start(message.Minigame.Camera, message.ArenaOrigin)
	CameraController.setSpectating(not amParticipant)
end

local function endRound()
	inRound = false
	stopMinigameClient()
	Controls.unbind()
	CameraController.stop()
	spectatorBar:hide()
	chips:hide()
	progressBar:hide()
end

local function refreshSpectator()
	if CameraController.isActive() and CameraController.isSpectating() then
		spectatorBar:show(CameraController.getTargetName())
	else
		spectatorBar:hide()
	end
end

local function onChips(list)
	if not inRound then
		return
	end
	chips:update(list, myId)
	progressBar:update(list, myId)
	CameraController.setTargets(list)
	for _, chip in list do
		if chip.Id == myId and chip.Eliminated and not CameraController.isSpectating() then
			-- Knocked out: lose the controls, switch to the spectator camera.
			Controls.unbind()
			CameraController.setSpectating(true)
			hud:showBanner("ELIMINATED", Theme.Colors.Hot, 1.2)
		end
	end
	refreshSpectator()
end

-- Phase handlers ------------------------------------------------------------------------------

local Phase = Net.Phase
local phaseHandlers = {}

phaseHandlers[Phase.Lobby] = function(message)
	hideOverlays()
	endRound()
	hud:setTimer(nil)
	hud:setStatus(nil)
	hud:setLobby(message.Text or "Lobby", message.EndsAt)
end

phaseHandlers[Phase.Vote] = function(message)
	hideOverlays()
	hud:setLobby(nil)
	setCardOpen(true)
	voteScreen:show(message.Choices, message.EndsAt)
end

phaseHandlers[Phase.Instructions] = function(message)
	hideOverlays()
	hud:setLobby(nil)
	setCardOpen(true)
	instructions:show(message.Minigame, message.Participants, message.EndsAt, myId)
	beginRound(message)
	if not amParticipant then
		hud:setStatus("👀 Spectating this round")
	end
	refreshSpectator()
end

phaseHandlers[Phase.Countdown] = function(message)
	hideOverlays()
	showRoundHud() -- not during Instructions: the strip would sit on top of the card
	hud:showBanner(tostring(message.Number), nil, 0.7)
end

phaseHandlers[Phase.Playing] = function(message)
	hideOverlays()
	beginRound(message) -- no-op normally; covers joining mid-round
	showRoundHud()
	hud:showBanner("GO!", Theme.Colors.Good, 0.8)
	hud:setTimer(message.EndsAt)
	if amParticipant and not CameraController.isSpectating() then
		Controls.bind(message.Minigame.Controls, sendAction)
	end
end

phaseHandlers[Phase.Finished] = function(_message)
	stopMinigameClient() -- hand the bodies back to the server before it sends everyone home
	Controls.unbind()
	hud:setTimer(nil)
	hud:showBanner("FINISH!", Theme.Colors.Hot, 1.5)
end

phaseHandlers[Phase.Results] = function(message)
	hideOverlays()
	endRound() -- everyone is back in the lobby: normal camera + controls
	hud:setStatus(nil)
	setCardOpen(true)
	results:show(message.Minigame, message.Results, myId)
end

-- Message routing ------------------------------------------------------------------------------

stateRemote.OnClientEvent:Connect(function(message)
	if type(message) ~= "table" then
		return
	end
	if message.Type == Net.Message.Phase then
		local handler = phaseHandlers[message.Phase]
		if handler then
			handler(message)
		end
	elseif message.Type == Net.Message.VoteUpdate then
		voteScreen:updateCounts(message.Counts, message.Voters)
	elseif message.Type == Net.Message.Status then
		hud:setStatus(message.Text)
	elseif message.Type == Net.Message.Toast then
		hud:toast(message.Text)
	elseif message.Type == Net.Message.Chips then
		onChips(message.Chips)
	end
end)

RunService.RenderStepped:Connect(function()
	hud:update()
	voteScreen:update()
	instructions:update()
end)

-- Ask for the current state in case we joined mid-round.
sendInput({ Kind = Net.Input.Ready })
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="29">
          <Properties>
            <string name="Name">Minigames</string>
          </Properties>
          <Item class="ModuleScript" referent="30">
            <Properties>
              <string name="Name">IceDash</string>
              <string name="Source"><![CDATA[--[[
	Ice Dash (client side)
	Keeps the race smooth whatever the connection is like:

	  * Your own racer is simulated right here with the shared rules (PartyShared.IceDashSim),
	    so steering responds on the very next frame. Your state is reported to the server
	    ~20 times a second; the server checks it and can snap you back ("Correct").
	  * Every other racer is drawn a moment in the past, gliding between the snapshots the
	    server broadcasts, so they move every frame even though news of them arrives in bursts.

	The server anchors every body for the race; this module places them each frame, just
	before the camera updates. Nothing here decides who wins: the server does.

	Main starts and stops this module (Info.ClientModule = "IceDash").
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("PartyShared")
local Net = require(Shared:WaitForChild("Net"))
local Sim = require(Shared:WaitForChild("IceDashSim"))

local IceDashClient = {}

-- Tuning ----------------------------------------------------------------------------------

local REPORT_RATE = 20 -- state reports sent to the server per second
local INTERPOLATION_DELAY = 0.15 -- seconds in the past other racers are drawn (3 snapshots' worth)
local MAX_EXTRAPOLATION = 0.25 -- seconds to keep a racer coasting when snapshots stop arriving
local SNAPSHOT_HISTORY = 40
local BIND_NAME = "PartyIceDashClient"

local player = Players.LocalPlayer
local myId = "player_" .. player.UserId

local running = false
local connections = {}
local layout = nil
local frame = CFrame.new()
local bodies = {} -- [id] = { Character, RideHeight, Lane }
local mine = nil -- my racer (IceDashSim state), nil if I'm only watching
local left, right = false, false
local raceTime = 0 -- seconds my racer has been simulated; sent with every report
local reportTimer = 0
local snapshots = {} -- oldest first: { T = server clock, R = { [id] = { X, S, VX, VS, Fall } } }
local playback = nil -- server-clock time currently being drawn for other racers
local lastStepAt = 0 -- os.clock() of the last simulation step

local function trackCFrame(x: number, y: number, s: number): CFrame
	return frame * CFrame.new(x, y, -s)
end

local function place(body, x: number, s: number, vx: number, drop: number)
	local character = body.Character
	if character and character.Parent then
		local lean = math.clamp(vx / Sim.MAX_SIDE_SPEED, -1, 1) * 0.3
		character:PivotTo(trackCFrame(x, body.RideHeight - drop, s) * CFrame.Angles(0, 0, -lean))
	end
end

-- Where a racer was at server time `t`, blending the two snapshots around it.
local function sample(id: string, t: number)
	local before, after
	for index = #snapshots, 1, -1 do
		local snapshot = snapshots[index]
		if snapshot.R[id] then
			if snapshot.T <= t then
				before = snapshot
				break
			end
			after = snapshot
		end
	end
	if before and after then
		local a, b = before.R[id], after.R[id]
		-- A respawn is a teleport, not something to glide through.
		if math.abs(b.S - a.S) > 25 then
			return b
		end
		local alpha = (t - before.T) / math.max(after.T - before.T, 1e-3)
		return {
			X = a.X + (b.X - a.X) * alpha,
			S = a.S + (b.S - a.S) * alpha,
			VX = a.VX + (b.VX - a.VX) * alpha,
			VS = b.VS,
			Fall = if a.Fall >= 0 and b.Fall >= 0 then a.Fall + (b.Fall - a.Fall) * alpha else b.Fall,
		}
	end
	if before then
		-- Ran out of news: coast on the last known velocity for a moment.
		local state = before.R[id]
		local ahead = math.min(t - before.T, MAX_EXTRAPOLATION)
		if state.Fall >= 0 then
			return state
		end
		return { X = state.X + state.VX * ahead, S = state.S + state.VS * ahead, VX = state.VX, VS = state.VS, Fall = -1 }
	end
	return after and after.R[id]
end

local function fallDrop(fallTime: number): number
	return if fallTime >= 0 then math.min(18, 40 * fallTime * fallTime) else 0
end

local function step(dt: number)
	if not running or not layout then
		return
	end
	dt = math.min(dt, 0.1)
	lastStepAt = os.clock()

	-- Other racers: a steady clock that trails the newest snapshot by INTERPOLATION_DELAY.
	local newest = snapshots[#snapshots]
	local others = {}
	if newest then
		local target = newest.T - INTERPOLATION_DELAY
		if not playback or math.abs(target - playback) > 0.5 then
			playback = target
		else
			playback += dt
			playback += (target - playback) * math.min(1, dt * 2) -- ease out any drift
		end
		for id, body in bodies do
			if not (mine and id == myId) then
				local state = sample(id, playback)
				if state then
					place(body, state.X, state.S, state.VX, fallDrop(state.Fall))
					if state.Fall < 0 then
						table.insert(others, { X = state.X, S = state.S, VX = state.VX, VS = state.VS, State = "Racing" })
					end
				end
			end
		end
	end

	-- My racer: simulated here, right now.
	if mine then
		local steer = (if right then 1 else 0) - (if left then 1 else 0)
		-- Small fixed-size steps keep fast frames and slow frames behaving the same.
		local remaining = dt
		while remaining > 1e-4 do
			local slice = math.min(remaining, 1 / 60)
			Sim.step(layout, mine, steer, slice)
			remaining -= slice
		end
		for _, other in others do
			Sim.collide(mine, other, true, false)
		end
		raceTime += dt
		local body = bodies[myId]
		if body then
			place(body, mine.X, mine.S, mine.VX, Sim.fallDrop(mine))
		end

		reportTimer += dt
		if reportTimer >= 1 / REPORT_RATE then
			reportTimer = 0
			Net.minigameFastRemote():FireServer({ T = raceTime, X = mine.X, S = mine.S, VX = mine.VX, VS = mine.VS })
		end
	end
end

local function onSetup(message)
	layout = message.Layout
	frame = message.Frame
	bodies = {}
	mine = nil
	for _, racer in message.Racers do
		bodies[racer.Id] = { Character = racer.Character, RideHeight = racer.RideHeight, Lane = racer.Lane }
		if racer.Id == myId then
			mine = Sim.newRacer(racer.Lane)
		end
	end
	raceTime = 0
	reportTimer = 0
end

local function onCorrect(message)
	if not mine then
		return
	end
	mine.X, mine.S, mine.VX, mine.VS = message.X, message.S, message.VX, message.VS
	mine.Checkpoint = message.Checkpoint
	if message.State == "Racing" and mine.State == "Falling" then
		mine.State = "Racing"
		mine.FallTime = 0
	end
end

local function onSnapshot(message)
	if type(message) ~= "table" or type(message.T) ~= "number" or type(message.R) ~= "table" then
		return
	end
	-- The fast channel can deliver out of order: ignore anything older than what we have.
	local newest = snapshots[#snapshots]
	if newest and message.T <= newest.T then
		return
	end
	local racers = {}
	for _, entry in message.R do
		racers[entry[1]] = { X = entry[2], S = entry[3], VX = entry[4], VS = entry[5], Fall = entry[6] }
	end
	table.insert(snapshots, { T = message.T, R = racers })
	if #snapshots > SNAPSHOT_HISTORY then
		table.remove(snapshots, 1)
	end
end

-- Interface (called by Main) -------------------------------------------------------------------

function IceDashClient.start()
	IceDashClient.stop()
	running = true
	layout = nil
	mine = nil
	left, right = false, false
	snapshots = {}
	playback = nil
	table.insert(
		connections,
		Net.minigameRemote().OnClientEvent:Connect(function(message)
			if type(message) ~= "table" then
				return
			end
			if message.Type == "Setup" then
				onSetup(message)
			elseif message.Type == "Correct" then
				onCorrect(message)
			end
		end)
	)
	table.insert(connections, Net.minigameFastRemote().OnClientEvent:Connect(onSnapshot))
	-- Just before the camera, so the chase cam follows this frame's position.
	RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value - 5, step)
	-- Render steps stop when the window isn't being drawn (minimised, display asleep). Keep
	-- the racer going from Heartbeat in that case, or it would sit still until you came back.
	table.insert(
		connections,
		RunService.Heartbeat:Connect(function(dt)
			if os.clock() - lastStepAt > 0.25 then
				step(dt)
			end
		end)
	)
end

function IceDashClient.stop()
	if not running then
		return
	end
	running = false
	RunService:UnbindFromRenderStep(BIND_NAME)
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	layout = nil
	mine = nil
	bodies = {}
	snapshots = {}
end

-- A steer button went down or up. Returns true: handled here, nothing to send to the server.
function IceDashClient.onAction(action: string): boolean
	if action == "Left" then
		left = true
	elseif action == "LeftStop" then
		left = false
	elseif action == "Right" then
		right = true
	elseif action == "RightStop" then
		right = false
	end
	return true
end

return IceDashClient
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="31">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="32">
            <Properties>
              <string name="Name">ActionBar</string>
              <string name="Source"><![CDATA[--[[
	ActionBar
	Big round on-screen buttons for the minigame's actions, bottom-right above the jump
	button. Work with touch and mouse; show the keyboard key on devices with a keyboard.
]]

local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Theme)
local make = Theme.make

local ActionBar = {}
ActionBar.__index = ActionBar

local BUTTON_SIZE = 96
local ABOVE_JUMP_BUTTON = -170 -- bottom offset that clears Roblox's mobile jump button
local BOTTOM_CORNER = -28 -- used when movement is locked, so there is no jump button to clear

function ActionBar.new(screen: ScreenGui)
	local self = setmetatable({}, ActionBar)
	self.Root = make("Frame", {
		Name = "ActionBar",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -24, 1, -170), -- clears Roblox's mobile jump button
		Size = UDim2.fromOffset(BUTTON_SIZE, BUTTON_SIZE * 3 + 24),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = screen,
	}, {
		make("UIListLayout", {
			Padding = UDim.new(0, 12),
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	-- Second column in the bottom-left corner for actions with Side = "Left" (e.g. steer left).
	self.LeftRoot = make("Frame", {
		Name = "ActionBarLeft",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 24, 1, -170),
		Size = UDim2.fromOffset(BUTTON_SIZE, BUTTON_SIZE * 3 + 24),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = screen,
	}, {
		make("UIListLayout", {
			Padding = UDim.new(0, 12),
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	self.Connections = {}
	return self
end

-- `low` = sit in the bottom corners (thumb reach) instead of above the jump button.
function ActionBar:show(actions, send: (string) -> (), low: boolean?)
	self:hide()
	local offset = if low then BOTTOM_CORNER else ABOVE_JUMP_BUTTON
	self.Root.Position = UDim2.new(1, -24, 1, offset)
	self.LeftRoot.Position = UDim2.new(0, 24, 1, offset)
	if #actions == 0 then
		return
	end
	local showKeys = UserInputService.KeyboardEnabled
	for index, action in actions do
		local button = make("TextButton", {
			Name = "Action_" .. action.Action,
			LayoutOrder = index,
			Size = UDim2.fromOffset(BUTTON_SIZE, BUTTON_SIZE),
			BackgroundColor3 = Theme.Colors.Hot,
			BackgroundTransparency = 0.1,
			Text = "",
			AutoButtonColor = true,
			Parent = if action.Side == "Left" then self.LeftRoot else self.Root,
		}, { Theme.corner(BUTTON_SIZE // 2), Theme.stroke(Color3.new(1, 1, 1), 3) })
		Theme.label({
			Size = UDim2.fromScale(1, if showKeys then 0.7 else 1),
			Font = Theme.TitleFont,
			Text = action.Label,
			Parent = button,
		}, 26)
		if showKeys and action.Key then
			Theme.label({
				Position = UDim2.fromScale(0, 0.65),
				Size = UDim2.fromScale(1, 0.25),
				TextColor3 = Theme.Colors.Accent,
				Text = "[" .. action.Key .. "]",
				Parent = button,
			}, 16)
		end
		if action.Hold then
			-- Press and hold: send on finger/mouse down, "<Action>Stop" when that same input ends.
			table.insert(
				self.Connections,
				button.InputBegan:Connect(function(input)
					if
						input.UserInputType ~= Enum.UserInputType.Touch
						and input.UserInputType ~= Enum.UserInputType.MouseButton1
					then
						return
					end
					send(action.Action)
					local released
					released = input.Changed:Connect(function()
						if input.UserInputState == Enum.UserInputState.End then
							released:Disconnect()
							send(action.Action .. "Stop")
						end
					end)
					table.insert(self.Connections, released)
				end)
			)
		else
			table.insert(
				self.Connections,
				button.Activated:Connect(function()
					send(action.Action)
				end)
			)
		end
	end
	self.Root.Visible = true
	self.LeftRoot.Visible = true
end

function ActionBar:hide()
	for _, connection in self.Connections do
		connection:Disconnect()
	end
	table.clear(self.Connections)
	for _, root in { self.Root, self.LeftRoot } do
		for _, child in root:GetChildren() do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		root.Visible = false
	end
end

return ActionBar
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="33">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--[[
	Hud
	Always-on pieces of the screen: round timer, minigame status line, the big centre
	banner (3-2-1 / GO! / FINISH!), the toast feed, and the lobby message pill.
]]

local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Theme = require(script.Parent.Theme)
local make = Theme.make

local Hud = {}
Hud.__index = Hud

-- Phones get a smaller, shorter-lived feed so it doesn't cover the left side of the arena.
local TOUCH = game:GetService("UserInputService").TouchEnabled
local MAX_TOASTS = if TOUCH then 2 else 4
local TOAST_LIFETIME = if TOUCH then 2.5 else 3.5
local TOAST_HEIGHT = if TOUCH then 26 else 36
local TOAST_TEXT_SIZE = if TOUCH then 14 else 20
local TOAST_WIDTH = if TOUCH then 0.24 else 0.3
local TOAST_MIN_WIDTH = if TOUCH then 170 else 220

function Hud.new(screen: ScreenGui)
	local self = setmetatable({}, Hud)

	-- Timer pill (top centre)
	self.TimerFrame = make("Frame", {
		Name = "Timer",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.fromOffset(150, 52),
		BackgroundColor3 = Theme.Colors.Card,
		Visible = false,
		Parent = screen,
	}, { Theme.corner(26), Theme.stroke(Theme.Colors.Accent, 3) })
	self.TimerLabel = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Font = Theme.TitleFont,
		Text = "0:00",
		Parent = self.TimerFrame,
	}, 40)

	-- Status line under the timer
	self.StatusLabel = Theme.label({
		Name = "Status",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.new(0.8, 0, 0, 34),
		TextStrokeTransparency = 0.3,
		Text = "",
		Visible = false,
		Parent = screen,
	}, 30)

	-- Big centre banner
	self.Banner = Theme.label({
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromScale(0.8, 0.25),
		Font = Theme.TitleFont,
		TextColor3 = Theme.Colors.Accent,
		TextStrokeTransparency = 0,
		Text = "",
		Visible = false,
		Parent = screen,
	}, 140)
	self.BannerToken = 0

	-- Toast feed (left side, newest at the bottom)
	self.ToastList = make("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromScale(TOAST_WIDTH, 0.4),
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		make("UIListLayout", {
			Padding = UDim.new(0, 6),
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		make("UISizeConstraint", { MinSize = Vector2.new(TOAST_MIN_WIDTH, 0) }),
	})
	self.ToastCount = 0

	-- Lobby pill (bottom centre)
	self.LobbyFrame = make("Frame", {
		Name = "Lobby",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.new(0.6, 0, 0, 50),
		BackgroundColor3 = Theme.Colors.Card,
		BackgroundTransparency = 0.15,
		Visible = false,
		Parent = screen,
	}, { Theme.corner(25), Theme.make("UISizeConstraint", { MaxSize = Vector2.new(560, 50) }) })
	self.LobbyLabel = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Font = Theme.TitleFont,
		Parent = self.LobbyFrame,
	}, 26)

	self.TimerEndsAt = nil
	self.LobbyText = nil
	self.LobbyEndsAt = nil
	return self
end

-- Called every frame by the client main script.
function Hud:update()
	local now = Workspace:GetServerTimeNow()
	if self.TimerEndsAt then
		local remaining = self.TimerEndsAt - now
		self.TimerLabel.Text = Theme.formatTime(remaining)
		self.TimerLabel.TextColor3 = if remaining <= 10 then Theme.Colors.Hot else Theme.Colors.Text
	end
	if self.LobbyText then
		local text = self.LobbyText
		if self.LobbyEndsAt then
			text ..= ("  %d"):format(math.max(0, math.ceil(self.LobbyEndsAt - now)))
		end
		self.LobbyLabel.Text = text
	end
end

function Hud:setTimer(endsAt: number?)
	self.TimerEndsAt = endsAt
	self.TimerFrame.Visible = endsAt ~= nil
end

function Hud:setStatus(text: string?)
	self.StatusLabel.Text = text or ""
	self.StatusLabel.Visible = text ~= nil and text ~= ""
end

function Hud:setLobby(text: string?, endsAt: number?)
	self.LobbyText = text
	self.LobbyEndsAt = endsAt
	self.LobbyFrame.Visible = text ~= nil
end

-- Pops a big message in the middle, then fades it after `hold` seconds.
function Hud:showBanner(text: string, color: Color3?, hold: number?)
	self.BannerToken += 1
	local token = self.BannerToken
	local banner = self.Banner
	banner.Text = text
	banner.TextColor3 = color or Theme.Colors.Accent
	banner.TextTransparency = 0
	banner.TextStrokeTransparency = 0
	banner.Visible = true
	Theme.pop(banner)
	task.delay(hold or 0.8, function()
		if self.BannerToken ~= token then
			return -- replaced by a newer banner
		end
		local fade = TweenService:Create(banner, TweenInfo.new(0.25), { TextTransparency = 1, TextStrokeTransparency = 1 })
		fade:Play()
		fade.Completed:Wait()
		if self.BannerToken == token then
			banner.Visible = false
		end
	end)
end

function Hud:toast(text: string)
	self.ToastCount += 1
	local toast = make("Frame", {
		LayoutOrder = self.ToastCount,
		Size = UDim2.new(1, 0, 0, TOAST_HEIGHT),
		BackgroundColor3 = Theme.Colors.Card,
		BackgroundTransparency = 0.2,
		Parent = self.ToastList,
	}, { Theme.corner(10), Theme.padding(6) })
	local label = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Text = text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = toast,
	}, TOAST_TEXT_SIZE)

	-- Keep the feed short.
	local toasts = {}
	for _, child in self.ToastList:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	table.sort(toasts, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for i = 1, #toasts - MAX_TOASTS do
		toasts[i]:Destroy()
	end

	task.delay(TOAST_LIFETIME, function()
		if toast.Parent then
			TweenService:Create(toast, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
			TweenService:Create(label, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
			task.wait(0.3)
			toast:Destroy()
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="34">
            <Properties>
              <string name="Name">InstructionsCard</string>
              <string name="Source"><![CDATA[--[[
	InstructionsCard
	"How to play" card shown while the server builds the arena and teleports everyone:
	name, layout, description, controls, and (for 1v3 / 2v2) who is on which team.
]]

local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Theme = require(script.Parent.Theme)
local make = Theme.make

local InstructionsCard = {}
InstructionsCard.__index = InstructionsCard

function InstructionsCard.new(screen: ScreenGui)
	local self = setmetatable({}, InstructionsCard)
	self.EndsAt = nil

	self.Root = make("Frame", {
		Name = "Instructions",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.7, 0.7),
		BackgroundColor3 = Theme.Colors.Card,
		Visible = false,
		Parent = screen,
	}, {
		Theme.corner(22),
		Theme.stroke(Theme.Colors.Accent, 4),
		Theme.padding(18),
		make("UISizeConstraint", { MaxSize = Vector2.new(720, 460) }),
	})

	self.Title = Theme.label({
		Size = UDim2.fromScale(1, 0.18),
		Font = Theme.TitleFont,
		TextColor3 = Theme.Colors.Accent,
		Parent = self.Root,
	}, 52)
	self.Layout = Theme.label({
		Position = UDim2.fromScale(0, 0.19),
		Size = UDim2.fromScale(1, 0.08),
		TextColor3 = Theme.Colors.Cool,
		Parent = self.Root,
	}, 22)
	self.Description = Theme.label({
		Position = UDim2.fromScale(0, 0.3),
		Size = UDim2.fromScale(1, 0.28),
		Parent = self.Root,
	}, 26)
	self.Controls = Theme.label({
		Position = UDim2.fromScale(0, 0.6),
		Size = UDim2.fromScale(1, 0.13),
		TextColor3 = Theme.Colors.Good,
		Parent = self.Root,
	}, 24)
	self.Teams = Theme.label({
		Position = UDim2.fromScale(0, 0.74),
		Size = UDim2.fromScale(1, 0.12),
		RichText = true,
		Parent = self.Root,
	}, 20)
	self.Clock = Theme.label({
		Position = UDim2.fromScale(0, 0.88),
		Size = UDim2.fromScale(1, 0.12),
		Font = Theme.TitleFont,
		TextColor3 = Theme.Colors.Muted,
		Parent = self.Root,
	}, 24)
	return self
end

local function controlsText(controls): string
	local parts = {}
	if controls.Move and controls.Jump then
		table.insert(parts, "🕹 Move + Jump")
	elseif controls.Move then
		table.insert(parts, "🕹 Move (no jumping)")
	else
		table.insert(parts, "🔒 You can't walk this round")
	end
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	for _, action in controls.Actions do
		if touch or not action.Key then
			table.insert(parts, ("👆 %s button"):format(action.Label))
		else
			table.insert(parts, ("[%s] %s"):format(action.Key, action.Label))
		end
	end
	return table.concat(parts, "    ")
end

local function teamsText(participants, myId: string): string
	local teams = { {}, {} }
	for _, participant in participants do
		if participant.Team then
			local name = participant.Name
			if participant.Id == myId then
				name = "<b>YOU</b>"
			end
			table.insert(teams[participant.Team], name)
		end
	end
	if #teams[1] == 0 then
		return ""
	end
	local function hex(color: Color3)
		return color:ToHex()
	end
	return ('<font color="#%s">%s</font>   vs   <font color="#%s">%s</font>'):format(
		hex(Theme.TeamColors[1]),
		table.concat(teams[1], ", "),
		hex(Theme.TeamColors[2]),
		table.concat(teams[2], ", ")
	)
end

function InstructionsCard:show(minigame, participants, endsAt: number, myId: string)
	self.EndsAt = endsAt
	self.Title.Text = minigame.Name
	self.Layout.Text = ("%s  •  %d seconds"):format(minigame.Layout, minigame.Duration)
	self.Description.Text = minigame.Description
	self.Controls.Text = controlsText(minigame.Controls)
	self.Teams.Text = teamsText(participants, myId)
	self.Root.Visible = true
	Theme.pop(self.Root)
end

function InstructionsCard:update()
	if self.Root.Visible and self.EndsAt then
		local remaining = math.max(0, math.ceil(self.EndsAt - Workspace:GetServerTimeNow()))
		self.Clock.Text = ("Get ready... %d"):format(remaining)
	end
end

function InstructionsCard:hide()
	self.Root.Visible = false
end

return InstructionsCard
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">PlayerChips</string>
              <string name="Source"><![CDATA[--[[
	PlayerChips
	The strip of four player chips under the timer: name, team colour, the live value the
	minigame reports with ReportProgress, and a crossed-out look once eliminated.
]]

local Theme = require(script.Parent.Theme)
local make = Theme.make

local PlayerChips = {}
PlayerChips.__index = PlayerChips

function PlayerChips.new(screen: ScreenGui)
	local self = setmetatable({}, PlayerChips)
	self.Root = make("Frame", {
		Name = "PlayerChips",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 108),
		Size = UDim2.new(0.9, 0, 0, 60),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = screen,
	}, {
		make("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		make("UISizeConstraint", { MaxSize = Vector2.new(700, 60) }),
	})
	self.Chips = {} -- Id -> widgets
	return self
end

local function buildChip(parent: Instance, order: number)
	local frame = make("Frame", {
		LayoutOrder = order,
		Size = UDim2.fromScale(0.24, 1),
		BackgroundColor3 = Theme.Colors.Card,
		BackgroundTransparency = 0.1,
		Parent = parent,
	}, { Theme.corner(12), Theme.padding(4) })
	local stroke = Theme.stroke(Theme.Colors.CardLight, 2)
	stroke.Parent = frame
	local name = Theme.label({
		Size = UDim2.fromScale(1, 0.4),
		Parent = frame,
	}, 16)
	local value = Theme.label({
		Position = UDim2.fromScale(0, 0.4),
		Size = UDim2.fromScale(1, 0.4),
		Font = Theme.TitleFont,
		TextColor3 = Theme.Colors.Accent,
		Parent = frame,
	}, 22)
	local caption = Theme.label({
		Position = UDim2.fromScale(0, 0.8),
		Size = UDim2.fromScale(1, 0.2),
		TextColor3 = Theme.Colors.Muted,
		Parent = frame,
	}, 11)
	return { Frame = frame, Stroke = stroke, Name = name, Value = value, Caption = caption }
end

function PlayerChips:update(chips, myId: string)
	local seen = {}
	for order, chip in chips do
		seen[chip.Id] = true
		local widgets = self.Chips[chip.Id] or buildChip(self.Root, order)
		self.Chips[chip.Id] = widgets
		widgets.Frame.LayoutOrder = order

		local isMe = chip.Id == myId
		widgets.Name.Text = (if chip.IsBot then "🤖 " else "") .. (if isMe then "YOU" else chip.Name)
		widgets.Value.Text = if chip.Eliminated
			then "❌ " .. (if chip.Value ~= nil then tostring(chip.Value) else "OUT")
			elseif chip.Value ~= nil then tostring(chip.Value)
			else "—"
		widgets.Caption.Text = chip.Label or ""
		widgets.Stroke.Color = if isMe
			then Theme.Colors.Accent
			elseif chip.Team then Theme.TeamColors[chip.Team]
			else Theme.Colors.CardLight
		widgets.Stroke.Thickness = if isMe then 3 else 2
		widgets.Frame.BackgroundTransparency = if chip.Eliminated then 0.6 else 0.1
		widgets.Value.TextColor3 = if chip.Eliminated then Theme.Colors.Muted else Theme.Colors.Accent
	end
	for id, widgets in self.Chips do
		if not seen[id] then
			widgets.Frame:Destroy()
			self.Chips[id] = nil
		end
	end
end

function PlayerChips:show()
	self.Root.Visible = true
end

function PlayerChips:hide()
	self.Root.Visible = false
	for id, widgets in self.Chips do
		widgets.Frame:Destroy()
		self.Chips[id] = nil
	end
end

return PlayerChips
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">ProgressBar</string>
              <string name="Source"><![CDATA[--[[
	ProgressBar
	Race bar along the top of the screen: one marker per participant sliding from the start
	(left) to the finish flag (right). Used instead of the chip strip by minigames with
	Info.ProgressBar = true. It is fed by the same chip list: a value like "37%" places the
	marker, and any value containing 🏁 counts as finished.
]]

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)
local make = Theme.make

local ProgressBar = {}
ProgressBar.__index = ProgressBar

local MARKER_SIZE = 26
local MARKER_COLORS = {
	Theme.Colors.Accent,
	Theme.Colors.Hot,
	Theme.Colors.Cool,
	Theme.Colors.Good,
}

function ProgressBar.new(screen: ScreenGui)
	local self = setmetatable({}, ProgressBar)
	self.Root = make("Frame", {
		Name = "ProgressBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 112),
		Size = UDim2.new(0.86, 0, 0, 44),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = screen,
	})
	-- The track the markers slide along (leaves room for the flag on the right).
	self.Track = make("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, MARKER_SIZE, 0.5, 0),
		Size = UDim2.new(1, -MARKER_SIZE * 3, 0, 12),
		BackgroundColor3 = Theme.Colors.Card,
		BackgroundTransparency = 0.1,
		Parent = self.Root,
	}, { Theme.corner(6), Theme.stroke(Theme.Colors.CardLight, 2) })
	Theme.label({
		Name = "Flag",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(MARKER_SIZE + 6, MARKER_SIZE + 6),
		Text = "🏁",
		Parent = self.Root,
	}, 26)
	self.Markers = {}
	return self
end

local function fractionOf(value): number
	if type(value) == "number" then
		return math.clamp(value / 100, 0, 1)
	end
	if type(value) ~= "string" then
		return 0
	end
	if value:find("🏁", 1, true) then
		return 1
	end
	local percent = tonumber(value:match("(%d+)%%"))
	return if percent then math.clamp(percent / 100, 0, 1) else 0
end

local function buildMarker(track: Frame, order: number)
	local color = MARKER_COLORS[(order - 1) % #MARKER_COLORS + 1]
	local stroke = Theme.stroke(Color3.new(1, 1, 1), 2)
	local frame = make("Frame", {
		Name = "Marker",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(MARKER_SIZE, MARKER_SIZE),
		BackgroundColor3 = color,
		Parent = track,
	}, { Theme.corner(MARKER_SIZE // 2), stroke })
	local tag = Theme.label({
		Size = UDim2.fromScale(1, 1),
		Font = Theme.TitleFont,
		TextColor3 = Theme.Colors.Overlay,
		Text = "",
		Parent = frame,
	}, 14)
	return { Frame = frame, Stroke = stroke, Tag = tag }
end

function ProgressBar:update(chips, myId: string)
	local seen = {}
	for order, chip in chips do
		seen[chip.Id] = true
		local marker = self.Markers[chip.Id] or buildMarker(self.Track, order)
		self.Markers[chip.Id] = marker

		local isMe = chip.Id == myId
		marker.Tag.Text = if isMe then "YOU" else string.sub(chip.Name, 1, 1)
		marker.Stroke.Color = if isMe then Theme.Colors.Accent else Color3.new(1, 1, 1)
		marker.Stroke.Thickness = if isMe then 3 else 2
		marker.Frame.ZIndex = if isMe then 5 else 2
		local size = if isMe then MARKER_SIZE + 8 else MARKER_SIZE
		marker.Frame.Size = UDim2.fromOffset(size, size)

		local goal = UDim2.fromScale(fractionOf(chip.Value), 0.5)
		TweenService:Create(marker.Frame, TweenInfo.new(0.2, Enum.EasingStyle.Linear), { Position = goal }):Play()
	end
	for id, marker in self.Markers do
		if not seen[id] then
			marker.Frame:Destroy()
			self.Markers[id] = nil
		end
	end
end

function ProgressBar:show()
	self.Root.Visible = true
end

function ProgressBar:hide()
	self.Root.Visible = false
	for id, marker in self.Markers do
		marker.Frame:Destroy()
		self.Markers[id] = nil
	end
end

return ProgressBar
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">ResultsScreen</string>
              <string name="Source"><![CDATA[--[[
	ResultsScreen
	Placements and coins awarded, exactly as the server ranked them.
]]

local Theme = require(script.Parent.Theme)
local make = Theme.make

local ResultsScreen = {}
ResultsScreen.__index = ResultsScreen

function ResultsScreen.new(screen: ScreenGui)
	local self = setmetatable({}, ResultsScreen)

	self.Root = make("Frame", {
		Name = "Results",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.7, 0.75),
		BackgroundColor3 = Theme.Colors.Card,
		Visible = false,
		Parent = screen,
	}, {
		Theme.corner(22),
		Theme.stroke(Theme.Colors.Accent, 4),
		Theme.padding(18),
		make("UISizeConstraint", { MaxSize = Vector2.new(680, 500) }),
	})
	self.Title = Theme.label({
		Size = UDim2.fromScale(1, 0.16),
		Font = Theme.TitleFont,
		TextColor3 = Theme.Colors.Accent,
		Parent = self.Root,
	}, 46)
	self.List = make("Frame", {
		Position = UDim2.fromScale(0, 0.2),
		Size = UDim2.fromScale(1, 0.8),
		BackgroundTransparency = 1,
		Parent = self.Root,
	}, {
		make("UIListLayout", {
			Padding = UDim.new(0.03, 0),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	return self
end

local function buildRow(parent: Instance, index: number, row, isMe: boolean)
	local placeColor = Theme.PlacementColors[row.Placement] or Theme.PlacementColors[4]
	local frame = make("Frame", {
		LayoutOrder = index,
		Size = UDim2.fromScale(1, 0.22),
		BackgroundColor3 = if isMe then Theme.Colors.CardLight else Theme.Colors.Overlay,
		Parent = parent,
	}, { Theme.corner(12), Theme.padding(6) })
	if isMe then
		Theme.stroke(Theme.Colors.Accent, 2).Parent = frame
	end

	Theme.label({
		Size = UDim2.fromScale(0.16, 1),
		Font = Theme.TitleFont,
		TextColor3 = placeColor,
		Text = Theme.ordinal(row.Placement),
		Parent = frame,
	}, 34)
	local name = (if row.IsBot then "🤖 " else "") .. row.Name .. (if isMe then " (you)" else "")
	Theme.label({
		Position = UDim2.fromScale(0.18, 0),
		Size = UDim2.fromScale(0.46, 1),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = if row.Team then Theme.TeamColors[row.Team] else Theme.Colors.Text,
		Text = name,
		Parent = frame,
	}, 26)
	Theme.label({
		Position = UDim2.fromScale(0.64, 0),
		Size = UDim2.fromScale(0.16, 1),
		Font = Theme.TitleFont,
		TextColor3 = if row.Coins > 0 then Theme.Colors.Accent else Theme.Colors.Muted,
		Text = ("+%d 🪙"):format(row.Coins),
		Parent = frame,
	}, 28)
	Theme.label({
		Position = UDim2.fromScale(0.8, 0),
		Size = UDim2.fromScale(0.2, 1),
		TextColor3 = Theme.Colors.Muted,
		Text = ("Total %d"):format(row.Total),
		Parent = frame,
	}, 20)
end

function ResultsScreen:show(minigame, rows, myId: string)
	for _, child in self.List:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	self.Title.Text = ("🏆 %s — Results"):format(minigame.Name)
	for index, row in rows do
		buildRow(self.List, index, row, row.Id == myId)
	end
	self.Root.Visible = true
	Theme.pop(self.Root)
end

function ResultsScreen:hide()
	self.Root.Visible = false
end

return ResultsScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">SpectatorBar</string>
              <string name="Source"><![CDATA[--[[
	SpectatorBar
	"👀 Spectating Doge  ◀ ▶" bar shown while the spectator camera is on.
	Buttons work with touch/mouse; Q / E (and gamepad shoulder buttons) also cycle.
]]

local ContextActionService = game:GetService("ContextActionService")

local Theme = require(script.Parent.Theme)
local make = Theme.make

local SpectatorBar = {}
SpectatorBar.__index = SpectatorBar

local BIND_NAME = "Party_SpectateCycle"

function SpectatorBar.new(screen: ScreenGui, onCycle: (number) -> ())
	local self = setmetatable({}, SpectatorBar)
	self.OnCycle = onCycle
	self.Root = make("Frame", {
		Name = "SpectatorBar",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.fromOffset(360, 56),
		BackgroundColor3 = Theme.Colors.Card,
		BackgroundTransparency = 0.15,
		Visible = false,
		Parent = screen,
	}, { Theme.corner(28) })

	local function arrow(text: string, x: number, direction: number)
		local button = make("TextButton", {
			Name = if direction < 0 then "Previous" else "Next",
			AnchorPoint = Vector2.new(x, 0.5),
			Position = UDim2.new(x, if x == 0 then 6 else -6, 0.5, 0),
			Size = UDim2.fromOffset(48, 44),
			BackgroundColor3 = Theme.Colors.CardLight,
			Font = Theme.TitleFont,
			TextScaled = true,
			TextColor3 = Theme.Colors.Text,
			Text = text,
			Parent = self.Root,
		}, { Theme.corner(22) })
		button.Activated:Connect(function()
			self.OnCycle(direction)
		end)
	end
	arrow("◀", 0, -1)
	arrow("▶", 1, 1)

	self.Label = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -120, 0.8, 0),
		Font = Theme.TitleFont,
		Parent = self.Root,
	}, 24)
	return self
end

function SpectatorBar:show(targetName: string?)
	self.Label.Text = "👀 " .. (targetName or "Arena")
	if self.Root.Visible then
		return
	end
	self.Root.Visible = true
	ContextActionService:BindAction(BIND_NAME, function(_, inputState, input)
		if inputState == Enum.UserInputState.Begin then
			local back = input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.ButtonL1
			self.OnCycle(if back then -1 else 1)
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.Q, Enum.KeyCode.E, Enum.KeyCode.ButtonL1, Enum.KeyCode.ButtonR1)
end

function SpectatorBar:hide()
	if self.Root.Visible then
		ContextActionService:UnbindAction(BIND_NAME)
	end
	self.Root.Visible = false
end

return SpectatorBar
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--[[
	Theme
	Colours, fonts and tiny helpers for building UI in code (no Studio-made GUIs needed).
]]

local TweenService = game:GetService("TweenService")

local Theme = {}

Theme.TitleFont = Enum.Font.FredokaOne
Theme.BodyFont = Enum.Font.GothamBold

Theme.Colors = {
	Overlay = Color3.fromRGB(20, 10, 40),
	Card = Color3.fromRGB(45, 30, 80),
	CardLight = Color3.fromRGB(70, 50, 120),
	Accent = Color3.fromRGB(255, 220, 60),
	Hot = Color3.fromRGB(255, 90, 140),
	Cool = Color3.fromRGB(90, 220, 255),
	Text = Color3.fromRGB(255, 255, 255),
	Muted = Color3.fromRGB(200, 190, 230),
	Good = Color3.fromRGB(120, 255, 140),
}

Theme.TeamColors = {
	[1] = Color3.fromRGB(255, 90, 90),
	[2] = Color3.fromRGB(90, 160, 255),
}

Theme.PlacementColors = {
	Color3.fromRGB(255, 215, 0),
	Color3.fromRGB(200, 210, 225),
	Color3.fromRGB(215, 140, 70),
	Color3.fromRGB(140, 130, 170),
}

-- make("Frame", { Size = ..., Parent = x }, { children })
function Theme.make(className: string, props: { [string]: any }?, children: { Instance }?)
	local instance = Instance.new(className)
	local parent = nil
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			(instance :: any)[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	instance.Parent = parent
	return instance
end

function Theme.corner(radius: number?)
	return Theme.make("UICorner", { CornerRadius = UDim.new(0, radius or 14) })
end

function Theme.stroke(color: Color3?, thickness: number?)
	return Theme.make("UIStroke", {
		Color = color or Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Theme.padding(pixels: number)
	local p = UDim.new(0, pixels)
	return Theme.make("UIPadding", { PaddingTop = p, PaddingBottom = p, PaddingLeft = p, PaddingRight = p })
end

-- Scaled text label with a max size so it stays readable on phones and huge monitors.
function Theme.label(props: { [string]: any }, maxTextSize: number?)
	local label = Theme.make("TextLabel", {
		BackgroundTransparency = 1,
		Font = Theme.BodyFont,
		TextColor3 = Theme.Colors.Text,
		TextScaled = true,
		TextWrapped = true,
	})
	for key, value in props do
		if key ~= "Parent" then
			(label :: any)[key] = value
		end
	end
	Theme.make("UITextSizeConstraint", { MaxTextSize = maxTextSize or 28, MinTextSize = 8, Parent = label })
	label.Parent = props.Parent
	return label
end

-- Bouncy "pop in" used for cards and banners.
function Theme.pop(guiObject: GuiObject)
	local scale = guiObject:FindFirstChildOfClass("UIScale") or Theme.make("UIScale", { Parent = guiObject })
	scale.Scale = 0.6
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

-- "1:05" style clock.
function Theme.formatTime(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return ("%d:%02d"):format(seconds // 60, seconds % 60)
end

function Theme.ordinal(n: number): string
	local suffix = "th"
	if n % 100 < 11 or n % 100 > 13 then
		suffix = ({ "st", "nd", "rd" })[n % 10] or "th"
	end
	return n .. suffix
end

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">VoteScreen</string>
              <string name="Source"><![CDATA[--[[
	VoteScreen
	Full-screen overlay with up to 3 minigame cards. Clicking a card sends a vote input;
	the counts/voter names shown are whatever the server broadcasts (never local guesses).
]]

local Workspace = game:GetService("Workspace")

local Theme = require(script.Parent.Theme)
local make = Theme.make

local VoteScreen = {}
VoteScreen.__index = VoteScreen

function VoteScreen.new(screen: ScreenGui, onVote: (number) -> ())
	local self = setmetatable({}, VoteScreen)
	self.OnVote = onVote
	self.Cards = {}
	self.Selected = nil
	self.EndsAt = nil

	self.Root = make("Frame", {
		Name = "VoteScreen",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.Overlay,
		BackgroundTransparency = 0.25,
		Visible = false,
		Parent = screen,
	})
	self.Title = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.06),
		Size = UDim2.fromScale(0.9, 0.1),
		Font = Theme.TitleFont,
		TextColor3 = Theme.Colors.Accent,
		TextStrokeTransparency = 0.4,
		Text = "VOTE FOR THE NEXT MINIGAME!",
		Parent = self.Root,
	}, 56)
	self.Clock = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.16),
		Size = UDim2.fromScale(0.5, 0.06),
		Font = Theme.TitleFont,
		Parent = self.Root,
	}, 32)
	self.Row = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.58),
		Size = UDim2.fromScale(0.92, 0.6),
		BackgroundTransparency = 1,
		Parent = self.Root,
	}, {
		make("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0.02, 0),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		make("UISizeConstraint", { MaxSize = Vector2.new(1100, 460) }),
	})
	return self
end

local function buildCard(self, index: number, choice)
	local card = make("TextButton", {
		Name = "Card" .. index,
		LayoutOrder = index,
		Size = UDim2.fromScale(0.31, 1),
		BackgroundColor3 = Theme.Colors.Card,
		AutoButtonColor = true,
		Text = "",
		Parent = self.Row,
	}, { Theme.corner(18), Theme.padding(12) })
	local stroke = Theme.stroke(Theme.Colors.CardLight, 4)
	stroke.Parent = card

	Theme.label({
		Size = UDim2.fromScale(1, 0.2),
		Font = Theme.TitleFont,
		TextColor3 = Theme.Colors.Accent,
		Text = choice.Name,
		Parent = card,
	}, 36)
	Theme.label({
		Position = UDim2.fromScale(0, 0.21),
		Size = UDim2.fromScale(1, 0.09),
		TextColor3 = Theme.Colors.Cool,
		Text = ("%s%s"):format(choice.Layout, if choice.Duration then ("  •  %ds"):format(choice.Duration) else ""),
		Parent = card,
	}, 20)
	Theme.label({
		Position = UDim2.fromScale(0, 0.33),
		Size = UDim2.fromScale(1, 0.37),
		TextColor3 = Theme.Colors.Muted,
		Font = Theme.BodyFont,
		Text = choice.Description,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = card,
	}, 20)
	local voters = Theme.label({
		Position = UDim2.fromScale(0, 0.72),
		Size = UDim2.fromScale(1, 0.12),
		TextColor3 = Theme.Colors.Text,
		Text = "",
		Parent = card,
	}, 18)
	local count = Theme.label({
		Position = UDim2.fromScale(0, 0.86),
		Size = UDim2.fromScale(1, 0.14),
		Font = Theme.TitleFont,
		Text = "0 votes",
		Parent = card,
	}, 28)

	card.Activated:Connect(function()
		self.Selected = index
		self:_refreshSelection()
		self.OnVote(index)
	end)

	return { Button = card, Stroke = stroke, Count = count, Voters = voters }
end

function VoteScreen:_refreshSelection()
	for index, card in self.Cards do
		local selected = index == self.Selected
		card.Stroke.Color = if selected then Theme.Colors.Accent else Theme.Colors.CardLight
		card.Button.BackgroundColor3 = if selected then Theme.Colors.CardLight else Theme.Colors.Card
	end
end

function VoteScreen:show(choices, endsAt: number)
	for _, card in self.Cards do
		card.Button:Destroy()
	end
	self.Cards = {}
	self.Selected = nil
	self.EndsAt = endsAt
	for index, choice in choices do
		self.Cards[index] = buildCard(self, index, choice)
	end
	self.Root.Visible = true
	Theme.pop(self.Row)
end

function VoteScreen:updateCounts(counts, voters)
	for index, card in self.Cards do
		local count = counts[index] or 0
		card.Count.Text = if count == 1 then "1 vote" else ("%d votes"):format(count)
		card.Voters.Text = table.concat(voters[index] or {}, ", ")
	end
end

function VoteScreen:update()
	if self.Root.Visible and self.EndsAt then
		local remaining = math.max(0, math.ceil(self.EndsAt - Workspace:GetServerTimeNow()))
		self.Clock.Text = ("⏱ %d"):format(remaining)
	end
end

function VoteScreen:hide()
	self.Root.Visible = false
end

return VoteScreen
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
